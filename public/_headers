# Cloudflare Pages headers. Format: https://developers.cloudflare.com/pages/configuration/headers/
#
# CSP keeps 'unsafe-inline' because the site has many inline <script> and
# inline style attributes (per-letter animations, IntersectionObserver setup,
# cookie consent, etc.). Migrating those to nonces requires a build-time
# rewrite and is out of scope for this hardening pass. The whitelist still
# blocks externally-loaded malicious scripts (the most common XSS payload),
# and frame-ancestors/base-uri/object-src close common pivots.
#
# The script/connect allowlist is kept tight: only jsDelivr + cdnjs (GSAP,
# Prism, Twemoji, fontsource) plus Google Fonts and the API origin. Stale
# entries — cdn.tailwindcss.com (now build-time PostCSS), the Google ad domains
# (no ads), and the origin-locked *.fly.dev — were removed: they served no live
# resource and only widened the attack surface. frame-src allows only the
# homepage's Faldrop live-demo embed (faldrop.luci-studio.com), nothing else.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com data:; connect-src 'self' https://api.luci-studio.com; frame-src 'self' https://faldrop.luci-studio.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
