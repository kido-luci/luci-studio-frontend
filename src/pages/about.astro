    <div class="flex flex-col items-center py-8 opacity-40">
      <div class="w-0.5 h-12 bg-gradient-to-b from-pink-500 to-transparent"></div>
    </div>

    <!-- SKILLS -->
    <section id="skills" class="py-16 px-4 md:px-6">
      <div class="max-w-7xl mx-auto">
        <div data-reveal class="mb-20">
          <span class="text-xs font-black text-emerald-500 uppercase tracking-[0.3em] mb-3 block">The Stack</span>
          <h2 data-ml9 class="text-6xl md:text-8xl font-black tracking-tighter">SKILLS<span class="text-emerald-500">.</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
          <div data-reveal class="group p-5 sm:p-8 rounded-2xl border border-white/5 bg-white/[0.02] hover:border-violet-500/20 transition-all duration-500 relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-violet-500/10 rounded-full blur-2xl group-hover:bg-violet-500/20 transition-all"></div>
            <h3 class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-8 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-violet-500"></span>Mobile
            </h3>
            <div class="flex flex-wrap gap-2">
              {['Flutter','Dart','BLoC','Riverpod','Clean Architecture','Custom UI','Animations','ObjectBox'].map(s => (
                <span class="px-3 py-2 bg-white/5 border border-white/10 rounded-xl text-[11px] font-bold text-gray-400 hover:text-white hover:border-violet-500/40 hover:bg-violet-500/10 transition-all cursor-default">{s}</span>
              ))}
            </div>
          </div>
          <div data-reveal data-delay="1" class="group p-8 rounded-2xl border border-white/5 bg-white/[0.02] hover:border-blue-500/20 transition-all duration-500 relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-blue-500/10 rounded-full blur-2xl group-hover:bg-blue-500/20 transition-all"></div>
            <h3 class="text-xs font-black text-blue-500 uppercase tracking-[0.3em] mb-8 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>Backend
            </h3>
            <div class="flex flex-wrap gap-2">
              {['Golang','gRPC','REST API','Firebase','GCP','PostgreSQL','MySQL','Redis'].map(s => (
                <span class="px-3 py-2 bg-white/5 border border-white/10 rounded-xl text-[11px] font-bold text-gray-400 hover:text-white hover:border-blue-500/40 hover:bg-blue-500/10 transition-all cursor-default">{s}</span>
              ))}
            </div>
          </div>
          <div data-reveal data-delay="2" class="group p-8 rounded-2xl border border-white/5 bg-white/[0.02] hover:border-cyan-500/20 transition-all duration-500 relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-cyan-500/10 rounded-full blur-2xl group-hover:bg-cyan-500/20 transition-all"></div>
            <h3 class="text-xs font-black text-cyan-500 uppercase tracking-[0.3em] mb-8 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-cyan-500"></span>DevOps
            </h3>
            <div class="flex flex-wrap gap-2">
              {['Docker','CI/CD','GitHub Actions','Jenkins','Cloudflare','Docker Compose','Linux'].map(s => (
                <span class="px-3 py-2 bg-white/5 border border-white/10 rounded-xl text-[11px] font-bold text-gray-400 hover:text-white hover:border-cyan-500/40 hover:bg-cyan-500/10 transition-all cursor-default">{s}</span>
              ))}
            </div>
          </div>
          <div data-reveal data-delay="3" class="group p-8 rounded-2xl border border-white/5 bg-white/[0.02] hover:border-pink-500/20 transition-all duration-500 relative overflow-hidden">
            <div class="absolute -right-4 -top-4 w-24 h-24 bg-pink-500/10 rounded-full blur-2xl group-hover:bg-pink-500/20 transition-all"></div>
            <h3 class="text-xs font-black text-pink-500 uppercase tracking-[0.3em] mb-8 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-pink-500"></span>Specialized
            </h3>
            <div class="flex flex-wrap gap-2">
              {['RSA/AES','Web3','Blockchain','Local LLM','llama.cpp','On-device AI','Security'].map(s => (
                <span class="px-3 py-2 bg-white/5 border border-white/10 rounded-xl text-[11px] font-bold text-gray-400 hover:text-white hover:border-pink-500/40 hover:bg-pink-500/10 transition-all cursor-default">{s}</span>
              ))}
            </div>
          </div>
          <div data-reveal data-delay="4" class="group p-8 rounded-2xl border border-white/5 bg-white/[0.02] hover:border-amber-500/20 transition-all duration-500 relative overflow-hidden md:col-span-2 lg:col-span-4">
            <div class="absolute -right-8 -top-8 w-48 h-48 bg-amber-500/8 rounded-full blur-3xl group-hover:bg-amber-500/15 transition-all"></div>
            <div class="flex flex-col md:flex-row md:items-start gap-8">
              <div class="flex-shrink-0 md:w-56">
                <h3 class="text-xs font-black text-amber-500 uppercase tracking-[0.3em] mb-4 flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-amber-500"></span>Art & Creative
                </h3>
                <p class="text-gray-600 text-sm leading-relaxed">Traditional and digital — portraits, character illustration, watercolor, and pixel art. A creative practice running parallel to the engineering work since 2016.</p>
              </div>
              <div class="flex flex-wrap gap-2 content-start">
                {['Pencil Portrait','Ballpoint Pen','Anime · Manga','Watercolor','Digital Illustration','Pixel Art','Character Design','Ink & Sketch','Figure Drawing','Eye Studies'].map(s => (
                  <span class="px-3 py-2 bg-white/5 border border-white/10 rounded-xl text-[11px] font-bold text-gray-400 hover:text-white hover:border-amber-500/40 hover:bg-amber-500/10 transition-all cursor-default">{s}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="flex flex-col items-center py-8 opacity-40">
      <div class="w-0.5 h-12 bg-gradient-to-b from-violet-500 to-transparent"></div>
    </div>

    <!-- Footer CTA -->
    <section class="py-24 px-4 md:px-6 text-center">
      <div class="max-w-2xl mx-auto">
        <p data-reveal class="text-xs font-black text-gray-600 uppercase tracking-[0.3em] mb-6">Enough talking.</p>
        <h2 data-reveal class="text-5xl md:text-7xl font-black tracking-tighter mb-10">LET'S BUILD<span class="text-violet-500">.</span></h2>
        <div data-reveal class="flex flex-wrap items-center justify-center gap-4">
          <a href="mailto:lapl1412.work@gmail.com" class="px-8 py-4 bg-white text-black font-black rounded-full hover:bg-violet-500 hover:text-white transition-all duration-300 uppercase tracking-widest text-sm">Email Me</a>
          <a href="/" class="px-8 py-4 border border-white/20 font-black rounded-full hover:border-violet-500/60 transition-all duration-300 uppercase tracking-widest text-sm text-gray-400 hover:text-white">Back Home</a>
        </div>
