---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Luci | Flutter Developer & Software Engineer">

  <!-- NAV -->
  <nav class="fixed top-0 w-full z-50 transition-all duration-500 border-b border-white/5" style="background:rgba(3,3,3,0.1);backdrop-filter:blur(12px)">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <div class="relative w-9 h-9 rounded-xl overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-tr from-violet-600 to-blue-500 animate-gradient-xy"></div>
          <div class="absolute inset-[2px] bg-black rounded-[9px] flex items-center justify-center">
            <span class="text-lg font-black text-transparent bg-clip-text bg-gradient-to-tr from-violet-400 to-blue-400">L</span>
          </div>
        </div>
        <span class="text-xl font-black tracking-tighter">LUCI<span class="text-violet-500">.</span></span>
      </a>
      <div class="hidden md:flex items-center gap-8">
        {['Work','Art','Blog'].map(l => (
          <a href={`#${l.toLowerCase()}`} class="text-xs font-bold text-gray-500 hover:text-white transition-all duration-300 uppercase tracking-[0.2em]">{l}</a>
        ))}
      </div>
      <a href="#contact" class="magnetic px-5 py-2.5 bg-white text-black text-xs font-black rounded-full hover:bg-violet-500 hover:text-white transition-all duration-300 uppercase tracking-widest">Let's Talk</a>
    </div>
  </nav>

  <main>

    <!-- HERO -->
    <section class="relative min-h-screen flex flex-col justify-center items-center pt-20 px-6 overflow-hidden">
      <!-- Orbs -->
      <div class="absolute inset-0 -z-10">
        <div class="absolute top-1/4 left-1/4 w-[700px] h-[700px] bg-violet-700/15 rounded-full blur-[140px]" style="animation:float 8s ease-in-out infinite"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[600px] h-[600px] bg-blue-700/15 rounded-full blur-[140px]" style="animation:float 10s ease-in-out infinite reverse"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-pink-700/10 rounded-full blur-[100px]" style="animation:float 6s ease-in-out infinite 2s"></div>
      </div>
      <!-- Grid lines -->
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:80px_80px]"></div>

      <div class="relative z-10 text-center max-w-6xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-violet-500/30 bg-violet-500/10 mb-10" style="opacity:0;animation:fadeSlideUp 0.8s 0.2s forwards">
          <span class="relative flex h-2 w-2"><span class="animate-ping absolute inset-0 rounded-full bg-violet-400 opacity-75"></span><span class="relative rounded-full h-2 w-2 bg-violet-500"></span></span>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-violet-300">Based in Ho Chi Minh City - Vietnam</span>
        </div>

        <h1 class="text-[clamp(3rem,10vw,9rem)] font-black tracking-[-0.04em] leading-[0.9] mb-8" data-word-reveal>
          {['FLUTTER', 'DEVELOPER', '&', 'SOFTWARE', 'ENGINEER'].map((w, i) => (
            <span class="reveal-word" style={`transition-delay:${i*90}ms`}>
              <span class={w === '&' ? 'text-shimmer mx-4' : 'text-white'}>{w} </span>
            </span>
          ))}
        </h1>

        <p class="text-lg md:text-xl text-gray-500 max-w-xl mx-auto mb-12" style="opacity:0;animation:fadeSlideUp 0.8s 0.7s forwards">
          Crafting production-grade Flutter apps with clean architecture, BLoC state management, and end-to-end encryption. 5+ years shipping real products.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-5" style="opacity:0;animation:fadeSlideUp 0.8s 0.9s forwards">
          <a href="#work" class="magnetic group relative px-8 py-4 bg-white text-black text-sm font-black rounded-full overflow-hidden hover:shadow-[0_0_60px_rgba(139,92,246,0.4)] transition-all duration-500">
            <span class="relative z-10 uppercase tracking-widest">View Work</span>
            <div class="absolute inset-0 bg-gradient-to-r from-violet-600 to-blue-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <span class="absolute inset-0 z-10 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 font-black uppercase tracking-widest transition-opacity duration-500">View Work</span>
          </a>
          <a href="#art" class="px-8 py-4 border border-white/10 text-sm font-bold rounded-full text-gray-400 hover:text-white hover:border-white/30 transition-all duration-300 uppercase tracking-widest">
            See Art →
          </a>
        </div>
      </div>

      <!-- Scroll hint -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-30">
        <span class="text-xs uppercase tracking-widest">Scroll</span>
        <div class="w-px h-16 bg-gradient-to-b from-white to-transparent" style="animation:float 2s ease-in-out infinite"></div>
      </div>
    </section>

    <!-- MARQUEE STRIP -->
    <div class="relative py-6 border-y border-white/5 bg-black/40 overflow-hidden">
      <div class="flex whitespace-nowrap animate-marquee">
        {['Flutter','Dart','BLoC','Riverpod','Firebase','Go Router','Freezed','Retrofit','gRPC','WebSocket','Docker','GitHub Actions','ObjectBox','GCP','Clean Architecture','Flutter Test','Mocktail','Figma','Rive','Custom Paint'].flatMap(t => [
          <span class="mx-8 text-xs font-black uppercase tracking-[0.3em] text-gray-600">{t}</span>,
          <span class="mx-4 text-gray-800 text-lg">✦</span>
        ])}
        {['Flutter','Dart','BLoC','Riverpod','Firebase','Go Router','Freezed','Retrofit','gRPC','WebSocket','Docker','GitHub Actions','ObjectBox','GCP','Clean Architecture','Flutter Test','Mocktail','Figma','Rive','Custom Paint'].flatMap(t => [
          <span class="mx-8 text-xs font-black uppercase tracking-[0.3em] text-gray-600">{t}</span>,
          <span class="mx-4 text-gray-800 text-lg">✦</span>
        ])}
      </div>
    </div>

    <!-- STATS -->
    <section class="py-6 px-6 border-b border-white/5">
      <div class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-1">
        {[
          { n: 5, suffix: '+', label: 'Years', sub: 'Flutter experience' },
          { n: 5, suffix: '+', label: 'Projects', sub: 'shipped to production' },
          { n: 5, suffix: '', label: 'Platforms', sub: 'Android · iOS · macOS · Web · Windows' },
          { n: 50, suffix: '%', label: 'Scholarship', sub: 'FPT University · Full Course' },
        ].map((s, i) => (
          <div data-reveal data-delay={String(i+1)} class="tilt-card p-8 border border-white/5 rounded-[32px] text-center hover:border-violet-500/20 transition-all duration-500 bg-white/[0.02]">
            <div class="text-6xl md:text-7xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-br from-white to-gray-500 mb-2">
              <span class="count-up" data-count={s.n} data-suffix={s.suffix}>0{s.suffix}</span>
            </div>
            <div class="text-white font-bold mb-1">{s.label}</div>
            <div class="text-xs text-gray-600 uppercase tracking-widest">{s.sub}</div>
          </div>
        ))}
      </div>
    </section>
    <div class="flex flex-col items-center py-6 opacity-20">
      <div class="w-px h-12 bg-gradient-to-b from-white to-transparent"></div>
    </div>
    <!-- BLOG -->
    <section id="blog" class="py-16 px-6 bg-black/30">
      <div class="max-w-7xl mx-auto">
        <div data-reveal class="mb-20 text-center">
          <span class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-3 block">Writing</span>
          <h2 class="text-6xl md:text-8xl font-black tracking-tighter">THOUGHTS<span class="text-violet-500">.</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { title: 'Building an encrypted diary with Flutter BLoC', date: 'Apr 17, 2026', read: '8 min', tag: 'Engineering', img: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&q=80&w=800' },
            { title: 'Generative art with code: where math meets beauty', date: 'Apr 10, 2026', read: '6 min', tag: 'Art & Code', img: 'https://images.unsplash.com/photo-1550684848-fac1c5b4e853?auto=format&fit=crop&q=80&w=800' },
            { title: 'Why I chose Astro for my portfolio in 2026', date: 'Apr 1, 2026', read: '4 min', tag: 'Web Dev', img: 'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&q=80&w=800' },
          ].map((p, i) => (
            <article data-reveal data-delay={String(i+1)} class="tilt-card group cursor-pointer">
              <div class="aspect-video rounded-3xl overflow-hidden mb-6 border border-white/5 group-hover:border-violet-500/20 transition-all duration-500">
                <img src={p.img} alt={p.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              </div>
              <div class="flex items-center gap-3 mb-4">
                <span class="text-xs font-black text-violet-400 uppercase tracking-widest">{p.tag}</span>
                <span class="w-1 h-1 bg-gray-700 rounded-full"></span>
                <span class="text-xs text-gray-600">{p.date}</span>
                <span class="w-1 h-1 bg-gray-700 rounded-full"></span>
                <span class="text-xs text-gray-600">{p.read} read</span>
              </div>
              <h3 class="text-xl font-bold leading-snug group-hover:text-violet-400 transition-colors duration-300">{p.title}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>
    <div class="flex flex-col items-center py-6 opacity-20">
      <div class="w-px h-12 bg-gradient-to-b from-white to-transparent"></div>
    </div>


    <!-- WORK -->
    <section id="work" class="py-16 px-6">
      <div class="max-w-7xl mx-auto">
        <div data-reveal class="mb-20">
          <span class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-3 block">Selected Work</span>
          <h2 class="text-6xl md:text-8xl font-black tracking-tighter">PORTFOLIO<span class="text-violet-500">.</span></h2>
          <div data-reveal class="line-draw h-px bg-gradient-to-r from-violet-500 to-transparent mt-6 max-w-xs"></div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {[
            { title: 'memoirMe', year: '2024–Now', desc: 'AI diary with RSA/AES E2E encryption, geolocation, IAP subscriptions & resumable uploads. For The Nartus, Australia.', tags: ['Flutter','BLoC','Firebase','Crypto'], img: 'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?auto=format&fit=crop&q=80&w=900' },
            { title: 'TBchat', year: '2024–Now', desc: 'Blockchain messaging platform with crypto wallet, miner staking, real-time location & audio waveforms. For Nexsoft, Vietnam/HK.', tags: ['Flutter','BLoC','ObjectBox','WebSocket'], img: 'https://images.unsplash.com/photo-1611532736597-de2d4265fba3?auto=format&fit=crop&q=80&w=900' },
            { title: 'QuanhTa', year: '2022–2024', desc: 'Real estate marketplace with polygon Maps search, gRPC chat, Flutter Web & Jenkins/Docker CD pipeline. For Vidieu, Vietnam.', tags: ['Flutter','Riverpod','gRPC','Docker'], img: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&q=80&w=900' },
            { title: 'Luci Studio', year: '2026', desc: 'The very portfolio you are viewing — blazing-fast static site with premium animations, deployed to Cloudflare Edge.', tags: ['Astro','Tailwind','Cloudflare'], img: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&q=80&w=900' },
          ].map((p, i) => (
            <div data-reveal="scale" data-delay={String((i%2)+1)} class="tilt-card group relative aspect-[4/3] rounded-[40px] overflow-hidden border border-white/8 hover:border-violet-500/30 transition-all duration-700 cursor-pointer">
              <img src={p.img} alt={p.title} class="absolute inset-0 w-full h-full object-cover transition-all duration-700 group-hover:scale-110 group-hover:brightness-50" />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent"></div>
              <div class="absolute inset-0 p-10 flex flex-col justify-between">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase tracking-widest text-gray-400 bg-black/40 px-3 py-1 rounded-full border border-white/10">{p.year}</span>
                  <span class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:translate-x-0 translate-x-4">↗</span>
                </div>
                <div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                  <h3 class="text-4xl font-black tracking-tight mb-3">{p.title}</h3>
                  <p class="text-gray-400 text-sm mb-5 opacity-0 group-hover:opacity-100 transition-opacity duration-500">{p.desc}</p>
                  <div class="flex gap-2">{p.tags.map(t => <span class="text-xs font-bold bg-white/10 px-3 py-1 rounded-full border border-white/10">{t}</span>)}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
    <div class="flex flex-col items-center py-6 opacity-20">
      <div class="w-px h-12 bg-gradient-to-b from-white to-transparent"></div>
    </div>


    
    <!-- EXPERIENCE -->
    <section class="py-16 px-6">
      <div class="max-w-7xl mx-auto">
        <div data-reveal class="mb-20">
          <span class="text-xs font-black text-pink-500 uppercase tracking-[0.3em] mb-3 block">Journey</span>
          <h2 class="text-6xl md:text-8xl font-black tracking-tighter">EXPERIENCE<span class="text-pink-500">.</span></h2>
        </div>

        <div class="mb-12">
          <h3 data-reveal class="text-xs font-black text-gray-500 uppercase tracking-[0.3em] mb-8 flex items-center gap-4">
            Professional Experience
            <div class="h-px flex-1 bg-white/5"></div>
          </h3>
          <div class="space-y-4">
            { [
            { 
              y: '2024–Now', 
              role: 'Frontend Flutter Developer', 
              co: 'TBchat · Nexsoft', 
              loc: 'Vietnam & Hong Kong', 
              desc: 'Building a blockchain messaging platform across Android, iOS, macOS, and Windows.',
              details: [
                'Engineered foundational deep-linking architecture for cross-module content sharing.',
                'Implemented real-time location sharing using WebSockets, Isolates, and background tracking.',
                'Developed audio chat with custom waveforms and secure on-device speech-to-text transcription.',
                'Built crypto wallet functionality with gas fee monitoring and offline L1 transaction signing.',
                'Architected multi-environment configurations using Flutter Flavors (Dev, Staging, Prod).'
              ],
              tech: ['Bloc', 'ObjectBox', 'WebSocket', 'Retrofit', 'Go Router', 'Freezed'],
              links: [
                { label: 'App Store', url: 'https://apps.apple.com/us/app/tbchat-web3/id6739870518' },
              ]
            },
            { 
              y: '2024–Now', 
              role: 'Full Stack Flutter Developer', 
              co: 'memoirMe · The Nartus', 
              loc: 'Australia (Freelance)', 
              desc: 'Architected an interactive E2E encrypted diary application with enterprise-grade security.',
              details: [
                'Architected zero-knowledge E2E encryption using RSA and AES cryptographic algorithms.',
                'Engineered subscription management with In-App Purchases (IAP) to drive monetization.',
                'Built resilient media management with resumable background upload/download capabilities.',
                'Integrated Firebase Analytics & Crashlytics for robust production health monitoring.',
                'Developed local auto-save and offline-first data synchronization logic.'
              ],
              tech: ['Firebase Cloud Functions', 'RSA/AES', 'IAP', 'Background Fetch'],
              links: [{ label: 'The Nartus', url: 'https://www.thenartus.com/' }]
            },
            { 
              y: '2022–2024', 
              role: 'Full Stack Flutter Developer', 
              co: 'QuanhTa · Vidieu', 
              loc: 'Vietnam', 
              desc: 'Real estate marketplace with advanced map-based search and automated data processing.',
              details: [
                'Engineered custom Google Maps integration with polygon-based area selection and filters.',
                'Implemented real-time chat facilitating buyer-seller communication using gRPC.',
                'Optimized Flutter Web performance and resolved Safari-specific CanvasKit renderer issues.',
                'Built automated web scraping pipeline using Python, Selenium, and Scrapy.',
                'Established complete CD pipeline for Flutter apps using Jenkins and Docker.'
              ],
              tech: ['Riverpod', 'Isar', 'gRPC', 'Python/Selenium', 'Jenkins', 'Docker'],
              links: [
                { label: 'Web App', url: 'https://quanhta.vn/map/land' },
                { label: 'App Store', url: 'https://apps.apple.com/vn/app/quanh-ta/id6453535963' },
                { label: 'Play Store', url: 'https://play.google.com/store/apps/details?id=vn.quanhta.superapp&hl=en' }
              ]
            },
          ].map((j, i) => (
              <div data-reveal data-delay={String(i+1)} class="timeline-item group cursor-pointer p-8 rounded-[36px] border border-white/5 hover:border-pink-500/20 bg-white/[0.02] transition-all duration-500 overflow-hidden">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                  <div class="md:col-span-2 flex items-start pt-1">
                    <span class="text-xs font-black text-pink-500 uppercase tracking-widest">{j.y}</span>
                  </div>
                  <div class="md:col-span-10">
                    <div class="flex items-center justify-between mb-1">
                      <h3 class="text-2xl font-black text-white">{j.role} <span class="text-gray-600 font-medium text-lg">— {j.co}</span></h3>
                      <div class="flex items-center gap-4">
                        <span class="text-[10px] font-black text-pink-500/0 group-hover:text-pink-500/60 uppercase tracking-[0.2em] transition-all duration-500 translate-x-4 group-hover:translate-x-0 hidden sm:block">Tap to explore</span>
                        <div class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-gray-500 group-hover:text-pink-500 group-hover:border-pink-500/30 group-hover:bg-pink-500/5 transition-all duration-500 shadow-lg group-hover:shadow-pink-500/10">
                          <svg class="w-5 h-5 transform group-[.active]:rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"/></svg>
                        </div>
                      </div>
                    </div>
                    <p class="text-xs text-pink-500/70 uppercase tracking-widest mb-4">{j.loc}</p>
                    <p class="text-gray-400 text-sm leading-relaxed mb-0 group-[.active]:mb-6 transition-all duration-500">{j.desc}</p>
                    
                    {/* Faded Preview (Hidden when active) */}
                    <div class="group-[.active]:opacity-0 group-[.active]:h-0 relative mt-4 transition-all duration-500 overflow-hidden max-h-32">
                      <div class="grid grid-cols-2 gap-4 opacity-50">
                        <div>
                          <h4 class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-2">Key Achievements</h4>
                          <ul class="space-y-1">
                            {j.details.slice(0, 3).map(item => (
                              <li class="flex items-start gap-1 text-[11px] leading-tight text-gray-400">
                                <span class="text-pink-500">▹</span>
                                <span class="truncate">{item}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                        <div>
                          <h4 class="text-[10px] font-black text-gray-500 uppercase tracking-[0.2em] mb-2">Stack</h4>
                          <div class="flex flex-wrap gap-1">
                            {j.tech.slice(0, 3).map(t => (
                              <span class="px-2 py-0.5 bg-white/5 border border-white/10 rounded-full text-[9px] font-black text-gray-400 uppercase tracking-wider">{t}</span>
                            ))}
                          </div>
                        </div>
                      </div>
                      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-[rgba(3,3,3,0.7)] pointer-events-none"></div>
                    </div>

                    {/* Bottom Indicator Arrow (Hidden when active) */}
                    <div class="group-[.active]:hidden flex justify-center mt-2 opacity-30 group-hover:opacity-100 transition-all duration-500">
                      <svg class="w-4 h-4 text-pink-500 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"/></svg>
                    </div>
                    
                    <div class="timeline-details h-0 opacity-0 group-[.active]:h-auto group-[.active]:opacity-100 transition-all duration-500">
                      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 pt-6 border-t border-white/5">
                        <div>
                          <h4 class="text-xs font-black text-gray-500 uppercase tracking-[0.2em] mb-4">Key Achievements</h4>
                          <ul class="space-y-3">
                            {j.details.map(item => (
                              <li class="flex items-start gap-3 text-sm text-gray-400 leading-snug">
                                <span class="text-pink-500 mt-1">▹</span>
                                {item}
                              </li>
                            ))}
                          </ul>
                        </div>
                        <div>
                          <h4 class="text-xs font-black text-gray-500 uppercase tracking-[0.2em] mb-4">Stack</h4>
                          <div class="flex flex-wrap gap-2 mb-8">
                            {j.tech.map(t => (
                              <span class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] font-black text-gray-400 uppercase tracking-wider">{t}</span>
                            ))}
                          </div>
                          <h4 class="text-xs font-black text-gray-500 uppercase tracking-[0.2em] mb-4">Links</h4>
                          <div class="flex flex-wrap gap-3">
                            {j.links.map(l => (
                              <a href={l.url} target="_blank" class="magnetic px-4 py-2 bg-pink-500/10 border border-pink-500/20 rounded-full text-[10px] font-black text-pink-500 uppercase tracking-widest hover:bg-pink-500 hover:text-white transition-all duration-300">
                                {l.label} ↗
                              </a>
                            ))}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div>
          <h3 data-reveal class="text-xs font-black text-gray-500 uppercase tracking-[0.3em] mb-8 flex items-center gap-4">
            Independent & University Projects
            <div class="h-px flex-1 bg-white/5"></div>
          </h3>
          <div class="space-y-4">
            { [
            { 
              y: '2026', 
              role: 'Founder & Full Stack Developer', 
              co: 'Luci Studio', 
              loc: 'Vietnam', 
              desc: 'Built the high-performance web portfolio and technical blog you are currently viewing.',
              details: [
                'Designed a premium, motion-rich UX/UI with custom-built interactive components.',
                'Engineered for maximum performance (95+ Lighthouse score) using Astro static generation.',
                'Implemented complex responsive layouts and magnetic hover interactions.',
                'Deployed a global-first infrastructure using Cloudflare Pages edge delivery.'
              ],
              tech: ['Astro', 'Tailwind CSS', 'JavaScript', 'Cloudflare Pages'],
              links: [{ label: 'Live Site', url: 'https://luci-studio.com/' }]
            },
            { 
              y: '2024', 
              role: 'Full Stack Developer', 
              co: 'UwU EBOOK', 
              loc: 'Owner Project', 
              desc: 'Digital publishing platform for Vietnamese content with full-stack automation.',
              details: [
                'Architected microservices backend using Golang and the Ent framework.',
                'Built complex data crawler system with Python and Scrapy for automated content gathering.',
