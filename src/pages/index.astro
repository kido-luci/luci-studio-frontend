/* ── Mobile overrides (< 480px) ── */
@media (max-width: 480px) {
  .hero-badge {
    margin-bottom: 1.2rem;
  }
  .hero-headline {
    margin-bottom: 1.2rem;
  }
  .hero-line {
    /* Stack each word on its own line on very small screens */
    flex-direction: column;
    align-items: center;
    gap: 0.05em;
  }
  .hero-line-top {
    /* Each word becomes its own full-width line */
    font-size: clamp(2.6rem, 18vw, 4.5rem);
    letter-spacing: -0.03em;
  }
  .hero-line-bottom {
    font-size: clamp(1.8rem, 12vw, 3rem);
    letter-spacing: -0.02em;
  }
  .hero-divider {
    width: 70vw;
    margin: 0.4rem 0 0.2rem;
  }
  .hero-subtitle {
    font-size: 0.88rem;
    margin-bottom: 1.5rem;
    line-height: 1.65;
  }
  .hero-stats {
    margin-top: 1.5rem;
    gap: 6px;
  }
  .hero-stat-sep {
    display: none;
  }
}

/* ── Tablet overrides (480–768px) ── */
@media (min-width: 481px) and (max-width: 768px) {
  .hero-line-top {
    font-size: clamp(2.4rem, 9vw, 6rem);
  }
  .hero-line-bottom {
    font-size: clamp(1.6rem, 6.5vw, 4rem);
  }
}

