---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Luci | Fullstack Developer & Digital Artist">

  <!-- NAV -->
  <nav class="fixed top-0 w-full z-50 transition-all duration-500 border-b border-white/5" style="background:rgba(3,3,3,0.1);backdrop-filter:blur(12px)">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <div class="relative w-9 h-9 rounded-xl overflow-hidden">
          <div class="absolute inset-0 bg-gradient-to-tr from-violet-600 to-blue-500 animate-gradient-xy"></div>
          <div class="absolute inset-[2px] bg-black rounded-[9px] flex items-center justify-center">
            <span class="text-lg font-black text-transparent bg-clip-text bg-gradient-to-tr from-violet-400 to-blue-400">L</span>
          </div>
        </div>
        <span class="text-xl font-black tracking-tighter">LUCI<span class="text-violet-500">.</span></span>
      </a>
      <div class="hidden md:flex items-center gap-8">
        {['Work','Art','Blog'].map(l => (
          <a href={`#${l.toLowerCase()}`} class="text-xs font-bold text-gray-500 hover:text-white transition-all duration-300 uppercase tracking-[0.2em]">{l}</a>
        ))}
      </div>
      <a href="#contact" class="magnetic px-5 py-2.5 bg-white text-black text-xs font-black rounded-full hover:bg-violet-500 hover:text-white transition-all duration-300 uppercase tracking-widest">Let's Talk</a>
    </div>
  </nav>

  <main>

    <!-- HERO -->
    <section class="relative min-h-screen flex flex-col justify-center items-center px-6 overflow-hidden">
      <!-- Orbs -->
      <div class="absolute inset-0 -z-10">
        <div class="absolute top-1/4 left-1/4 w-[700px] h-[700px] bg-violet-700/15 rounded-full blur-[140px]" style="animation:float 8s ease-in-out infinite"></div>
        <div class="absolute bottom-1/4 right-1/4 w-[600px] h-[600px] bg-blue-700/15 rounded-full blur-[140px]" style="animation:float 10s ease-in-out infinite reverse"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-pink-700/10 rounded-full blur-[100px]" style="animation:float 6s ease-in-out infinite 2s"></div>
      </div>
      <!-- Grid lines -->
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:80px_80px]"></div>

      <div class="relative z-10 text-center max-w-6xl mx-auto">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-violet-500/30 bg-violet-500/10 mb-10" style="opacity:0;animation:fadeSlideUp 0.8s 0.2s forwards">
          <span class="relative flex h-2 w-2"><span class="animate-ping absolute inset-0 rounded-full bg-violet-400 opacity-75"></span><span class="relative rounded-full h-2 w-2 bg-violet-500"></span></span>
          <span class="text-xs font-bold uppercase tracking-[0.2em] text-violet-300">Open for collaboration</span>
        </div>

        <h1 class="text-[clamp(3rem,10vw,9rem)] font-black tracking-[-0.04em] leading-[0.9] mb-8" data-word-reveal>
          {['FULLSTACK', 'ENGINEER', '&', 'DIGITAL', 'ARTIST'].map((w, i) => (
            <span class="reveal-word" style={`transition-delay:${i*90}ms`}>
              <span class={w === '&' ? 'text-shimmer mx-4' : 'text-white'}>{w} </span>
            </span>
          ))}
        </h1>

        <p class="text-lg md:text-xl text-gray-500 max-w-xl mx-auto mb-12" style="opacity:0;animation:fadeSlideUp 0.8s 0.7s forwards">
          Building products at the intersection of engineering precision and artistic vision.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-5" style="opacity:0;animation:fadeSlideUp 0.8s 0.9s forwards">
          <a href="#work" class="magnetic group relative px-8 py-4 bg-white text-black text-sm font-black rounded-full overflow-hidden hover:shadow-[0_0_60px_rgba(139,92,246,0.4)] transition-all duration-500">
            <span class="relative z-10 uppercase tracking-widest">View Work</span>
            <div class="absolute inset-0 bg-gradient-to-r from-violet-600 to-blue-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <span class="absolute inset-0 z-10 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 font-black uppercase tracking-widest transition-opacity duration-500">View Work</span>
          </a>
          <a href="#art" class="px-8 py-4 border border-white/10 text-sm font-bold rounded-full text-gray-400 hover:text-white hover:border-white/30 transition-all duration-300 uppercase tracking-widest">
            See Art →
          </a>
        </div>
      </div>

      <!-- Scroll hint -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-30">
        <span class="text-xs uppercase tracking-widest">Scroll</span>
        <div class="w-px h-16 bg-gradient-to-b from-white to-transparent" style="animation:float 2s ease-in-out infinite"></div>
      </div>
    </section>

    <!-- MARQUEE STRIP -->
    <div class="relative py-6 border-y border-white/5 bg-black/40 overflow-hidden">
      <div class="flex whitespace-nowrap animate-marquee">
        {['TypeScript','React','Next.js','Astro','Flutter','Node.js','PostgreSQL','Docker','Figma','WebGL','Generative Art','Three.js','Cloudflare','Motion Design'].flatMap(t => [
          <span class="mx-8 text-xs font-black uppercase tracking-[0.3em] text-gray-600">{t}</span>,
          <span class="mx-4 text-gray-800 text-lg">✦</span>
        ])}
        {['TypeScript','React','Next.js','Astro','Flutter','Node.js','PostgreSQL','Docker','Figma','WebGL','Generative Art','Three.js','Cloudflare','Motion Design'].flatMap(t => [
          <span class="mx-8 text-xs font-black uppercase tracking-[0.3em] text-gray-600">{t}</span>,
          <span class="mx-4 text-gray-800 text-lg">✦</span>
        ])}
      </div>
    </div>

    <!-- STATS -->
    <section class="py-28 px-6 border-b border-white/5">
      <div class="max-w-5xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-1">
        {[
          { n: 5, suffix: '+', label: 'Years', sub: 'of experience' },
          { n: 30, suffix: '+', label: 'Projects', sub: 'shipped to production' },
          { n: 50, suffix: '+', label: 'Artworks', sub: 'created & published' },
          { n: 100, suffix: '%', label: 'Passion', sub: 'in every pixel' },
        ].map((s, i) => (
          <div data-reveal data-delay={String(i+1)} class="tilt-card p-8 border border-white/5 rounded-[32px] text-center hover:border-violet-500/20 transition-all duration-500 bg-white/[0.02]">
            <div class="text-6xl md:text-7xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-br from-white to-gray-500 mb-2">
              <span class="count-up" data-count={s.n} data-suffix={s.suffix}>0{s.suffix}</span>
            </div>
            <div class="text-white font-bold mb-1">{s.label}</div>
            <div class="text-xs text-gray-600 uppercase tracking-widest">{s.sub}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- IDENTITY -->
    <section class="py-32 px-6">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div data-reveal="left" class="tilt-card group p-12 rounded-[48px] border border-white/5 bg-gradient-to-br from-violet-950/40 to-black hover:border-violet-500/30 transition-all duration-700 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-violet-600/10 rounded-full blur-3xl group-hover:bg-violet-600/20 transition-all duration-700"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center mb-8">
              <svg class="w-7 h-7 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
            </div>
            <h2 class="text-5xl font-black tracking-tighter mb-6">THE <span class="text-violet-400">ENGINEER.</span></h2>
            <p class="text-gray-400 leading-relaxed mb-8">Crafting scalable systems with clean architecture. Obsessed with performance, developer experience, and shipping things that last.</p>
            <div class="flex flex-wrap gap-2">
              {['TypeScript','React','Next.js','Node.js','PostgreSQL','Docker'].map(t => (
                <span class="px-3 py-1 bg-violet-500/10 border border-violet-500/20 rounded-full text-xs font-bold text-violet-300 uppercase tracking-wider">{t}</span>
              ))}
            </div>
          </div>
        </div>

        <div data-reveal="right" data-delay="2" class="tilt-card group p-12 rounded-[48px] border border-white/5 bg-gradient-to-br from-blue-950/40 to-black hover:border-blue-500/30 transition-all duration-700 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/10 rounded-full blur-3xl group-hover:bg-blue-600/20 transition-all duration-700"></div>
          <div class="relative z-10">
            <div class="w-14 h-14 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center mb-8">
              <svg class="w-7 h-7 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <h2 class="text-5xl font-black tracking-tighter mb-6">THE <span class="text-blue-400">ARTIST.</span></h2>
            <p class="text-gray-400 leading-relaxed mb-8">Exploring generative systems, 3D spaces, and the language of color. Every piece is an algorithm made beautiful.</p>
            <div class="flex flex-wrap gap-2">
              {['Generative Art','3D Modeling','UI/UX','Motion','Illustration'].map(t => (
                <span class="px-3 py-1 bg-blue-500/10 border border-blue-500/20 rounded-full text-xs font-bold text-blue-300 uppercase tracking-wider">{t}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- WORK -->
    <section id="work" class="py-32 px-6">
      <div class="max-w-7xl mx-auto">
        <div data-reveal class="mb-20">
          <span class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-3 block">Selected Work</span>
          <h2 class="text-6xl md:text-8xl font-black tracking-tighter">PORTFOLIO<span class="text-violet-500">.</span></h2>
          <div data-reveal class="line-draw h-px bg-gradient-to-r from-violet-500 to-transparent mt-6 max-w-xs"></div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {[
            { title: 'Memoir Me', year: '2024', desc: 'Encrypted diary with geolocation, BLoC architecture & end-to-end privacy.', tags: ['Flutter','Dart','PostgreSQL'], img: 'https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?auto=format&fit=crop&q=80&w=900', color: 'violet' },
            { title: 'Luci Studio', year: '2026', desc: 'This very portfolio — blazing-fast static site deployed to Cloudflare Edge.', tags: ['Astro','Tailwind','Cloudflare'], img: 'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&q=80&w=900', color: 'blue' },
          ].map((p, i) => (
            <div data-reveal="scale" data-delay={String(i+1)} class="tilt-card group relative aspect-[4/3] rounded-[40px] overflow-hidden border border-white/8 hover:border-violet-500/30 transition-all duration-700 cursor-pointer">
              <img src={p.img} alt={p.title} class="absolute inset-0 w-full h-full object-cover transition-all duration-700 group-hover:scale-110 group-hover:brightness-50" />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent"></div>
              <div class="absolute inset-0 p-10 flex flex-col justify-between">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-bold uppercase tracking-widest text-gray-400 bg-black/40 px-3 py-1 rounded-full border border-white/10">{p.year}</span>
                  <span class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:translate-x-0 translate-x-4">↗</span>
                </div>
                <div class="translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                  <h3 class="text-4xl font-black tracking-tight mb-3">{p.title}</h3>
                  <p class="text-gray-400 text-sm mb-5 opacity-0 group-hover:opacity-100 transition-opacity duration-500">{p.desc}</p>
                  <div class="flex gap-2">{p.tags.map(t => <span class="text-xs font-bold bg-white/10 px-3 py-1 rounded-full border border-white/10">{t}</span>)}</div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ART GALLERY -->
    <section id="art" class="py-32 px-6 bg-black/30">
      <div class="max-w-7xl mx-auto">
        <div data-reveal class="mb-20 flex flex-col md:flex-row md:items-end justify-between gap-8">
          <div>
            <span class="text-xs font-black text-blue-500 uppercase tracking-[0.3em] mb-3 block">Creative Works</span>
            <h2 class="text-6xl md:text-8xl font-black tracking-tighter">THE ART<span class="text-blue-500">.</span></h2>
          </div>
          <p class="text-gray-500 max-w-xs text-sm leading-relaxed">Where code meets canvas. Math, color theory, and human emotion rendered in pixels.</p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-12 grid-rows-2 gap-4" style="min-height:600px">
          {[
            { cols: 'md:col-span-7', img: 'https://images.unsplash.com/photo-1633356122544-f134324a6cee?auto=format&fit=crop&q=80&w=1200', label: 'Neon Currents', year: '2024' },
            { cols: 'md:col-span-5', img: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&q=80&w=800', label: 'Deep Space', year: '2024' },
            { cols: 'md:col-span-4', img: 'https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?auto=format&fit=crop&q=80&w=800', label: 'Bloom', year: '2024' },
            { cols: 'md:col-span-4', img: 'https://images.unsplash.com/photo-1614850523296-d8c1af93d400?auto=format&fit=crop&q=80&w=800', label: 'Ember', year: '2023' },
            { cols: 'md:col-span-4', img: 'https://images.unsplash.com/photo-1550684848-fac1c5b4e853?auto=format&fit=crop&q=80&w=800', label: 'Circuit', year: '2023' },
          ].map((a, i) => (
            <div data-reveal="scale" data-delay={String(i+1)} class={`group relative ${a.cols} rounded-3xl overflow-hidden cursor-pointer`}>
              <img src={a.img} alt={a.label} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
              <div class="absolute inset-0 bg-black/20 group-hover:bg-black/50 transition-colors duration-500"></div>
              <div class="absolute inset-0 p-6 flex items-end opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                <div>
                  <p class="font-bold text-white">{a.label}</p>
                  <p class="text-xs text-gray-400 uppercase tracking-widest">{a.year} · Digital Art</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section class="py-32 px-6">
      <div class="max-w-7xl mx-auto">
        <div data-reveal class="mb-20">
          <span class="text-xs font-black text-pink-500 uppercase tracking-[0.3em] mb-3 block">Journey</span>
          <h2 class="text-6xl md:text-8xl font-black tracking-tighter">EXPERIENCE<span class="text-pink-500">.</span></h2>
        </div>
        <div class="space-y-4">
          {[
            { y: '2023–Now', role: 'Senior Fullstack Developer', co: 'Creative Tech Solutions', desc: 'Leading immersive web & AI-driven product development.' },
            { y: '2021–2023', role: 'Frontend Architect', co: 'Digital Art Studio', desc: 'Complex animation systems for art installations and interactive platforms.' },
            { y: '2019–2021', role: 'Fullstack Developer', co: 'Startup Lab', desc: 'Building SaaS products from scratch with a focus on performance.' },
          ].map((j, i) => (
            <div data-reveal data-delay={String(i+1)} class="tilt-card group grid grid-cols-1 md:grid-cols-12 gap-6 p-8 rounded-[36px] border border-white/5 hover:border-pink-500/20 bg-white/[0.02] transition-all duration-500">
              <div class="md:col-span-2 flex items-center">
                <span class="text-xs font-black text-pink-500 uppercase tracking-widest">{j.y}</span>
              </div>
              <div class="md:col-span-10">
                <h3 class="text-2xl font-black text-white mb-1">{j.role} <span class="text-gray-600 font-medium text-lg">— {j.co}</span></h3>
                <p class="text-gray-500 text-sm">{j.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- BLOG -->
    <section id="blog" class="py-32 px-6 bg-black/30">
      <div class="max-w-7xl mx-auto">
        <div data-reveal class="mb-20 text-center">
          <span class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-3 block">Writing</span>
          <h2 class="text-6xl md:text-8xl font-black tracking-tighter">THOUGHTS<span class="text-violet-500">.</span></h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {[
            { title: 'Building an encrypted diary with Flutter BLoC', date: 'Apr 17, 2026', read: '8 min', tag: 'Engineering', img: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&q=80&w=800' },
            { title: 'Generative art with code: where math meets beauty', date: 'Apr 10, 2026', read: '6 min', tag: 'Art & Code', img: 'https://images.unsplash.com/photo-1550684848-fac1c5b4e853?auto=format&fit=crop&q=80&w=800' },
            { title: 'Why I chose Astro for my portfolio in 2026', date: 'Apr 1, 2026', read: '4 min', tag: 'Web Dev', img: 'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?auto=format&fit=crop&q=80&w=800' },
          ].map((p, i) => (
            <article data-reveal data-delay={String(i+1)} class="tilt-card group cursor-pointer">
              <div class="aspect-video rounded-3xl overflow-hidden mb-6 border border-white/5 group-hover:border-violet-500/20 transition-all duration-500">
                <img src={p.img} alt={p.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              </div>
              <div class="flex items-center gap-3 mb-4">
                <span class="text-xs font-black text-violet-400 uppercase tracking-widest">{p.tag}</span>
                <span class="w-1 h-1 bg-gray-700 rounded-full"></span>
                <span class="text-xs text-gray-600">{p.date}</span>
                <span class="w-1 h-1 bg-gray-700 rounded-full"></span>
                <span class="text-xs text-gray-600">{p.read} read</span>
              </div>
              <h3 class="text-xl font-bold leading-snug group-hover:text-violet-400 transition-colors duration-300">{p.title}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="contact" class="py-40 px-6">
      <div class="max-w-5xl mx-auto text-center">
        <div data-reveal class="mb-6">
          <span class="text-xs font-black text-gray-600 uppercase tracking-[0.3em]">Ready to collaborate?</span>
        </div>
        <h2 data-word-reveal class="text-[clamp(3rem,9vw,8rem)] font-black tracking-[-0.04em] leading-none mb-12">
          {["LET'S","BUILD","SOMETHING"].map((w,i) => (
            <span class="reveal-word block" style={`transition-delay:${i*100}ms`}>
              <span class={i===1 ? 'text-shimmer' : 'text-white'}>{w}</span>
            </span>
          ))}
          <span class="reveal-word block" style="transition-delay:300ms"><span class="text-white">AMAZING</span><span class="text-violet-500">.</span></span>
        </h2>
        <div data-reveal class="flex flex-col sm:flex-row items-center justify-center gap-5">
          <a href="mailto:hello@luci.dev" class="magnetic group relative px-10 py-5 rounded-full bg-white text-black font-black uppercase tracking-widest overflow-hidden hover:shadow-[0_0_80px_rgba(139,92,246,0.5)] transition-all duration-500">
            <span class="relative z-10">Say Hello</span>
            <div class="absolute inset-0 bg-gradient-to-r from-violet-600 to-blue-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <span class="absolute inset-0 z-10 flex items-center justify-center text-white font-black uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity duration-500">Say Hello</span>
          </a>
          <a href="#" class="magnetic text-sm font-bold text-gray-500 hover:text-white transition-colors duration-300 uppercase tracking-widest flex items-center gap-2">View Resume <span>↗</span></a>
        </div>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="py-16 border-t border-white/5 px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
      <span class="text-2xl font-black tracking-tighter">LUCI<span class="text-violet-500">.</span></span>
      <div class="flex items-center gap-8">
        {[['GitHub','#'],['Twitter','#'],['Dribbble','#']].map(([l,h]) => (
          <a href={h} class="text-xs font-bold text-gray-600 hover:text-white transition-colors uppercase tracking-widest">{l}</a>
        ))}
      </div>
      <p class="text-xs text-gray-700 uppercase tracking-widest">© 2026 Luci Studio</p>
    </div>
  </footer>

</Layout>

<style>
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-24px); }
}
</style>
