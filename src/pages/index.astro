}

/* ── Main Headline ── */
.hero-headline {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  margin-bottom: 2rem;
  font-family: 'Outfit', sans-serif;
}
.hero-line {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
  gap: 0.25em;
  line-height: 1.2;
}
.hero-line-top {
  font-size: clamp(3.5rem, 11vw, 9.5rem);
  font-weight: 900;
  letter-spacing: -0.005em;
}
.hero-line-bottom {
  font-size: clamp(0.85rem, 3.5vw, 3.2rem);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.45);
}
.hero-word-main,
.hero-word-accent,
.hero-word-sub {
  display: inline-block;
  overflow: hidden;
  vertical-align: middle;
  padding: 0.15em 0.05em; /* Increased vertical and added horizontal padding */
  margin: -0.15em -0.05em;
}

/* ── Divider ── */
.hero-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  width: min(480px, 80vw);
  margin: 0.6rem 0 0.4rem;
}
.hero-divider-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(139,92,246,0.5), rgba(59,130,246,0.4), transparent);
  opacity: 0;
  animation: divider-expand 1.2s cubic-bezier(0.16,1,0.3,1) 0.8s forwards;
}
.hero-divider-diamond {
  font-size: 0.55rem;
  color: rgba(139,92,246,0.7);
  animation: diamond-spin 8s linear infinite;
  flex-shrink: 0;
}

/* ── Subtitle ── */
.hero-subtitle {
  font-size: clamp(0.88rem, 2vw, 1.15rem);
  color: rgba(156,163,175,0.85);
  max-width: 720px;
  margin: 0 auto 2rem;
  line-height: 1.75;
  padding: 0 0.5rem;
  min-height: 6.5em;
}

/* ── Stat pills ── */
.hero-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 2.5rem;
}
.hero-stat-pill {
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: rgba(156,163,175,0.6);
  padding: 4px 12px;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 999px;
  background: rgba(255,255,255,0.02);
  transition: color 0.3s, border-color 0.3s;
}
.hero-stat-pill:hover {
  color: rgba(255,255,255,0.8);
  border-color: rgba(139,92,246,0.3);
}
.hero-stat-sep {
  color: rgba(255,255,255,0.15);
  font-size: 1rem;
}

/* ── Timeline ── */
.timeline-item.active {
