---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TimelineItem from "../components/TimelineItem.astro";
import { postService } from "../services/posts";
import { calculateReadTime, formatDate, slugify } from "../utils/blog";

const projects = [
  { title: 'memoirMe', year: '2024–Now', desc: 'A secure AI-powered digital sanctuary featuring zero-knowledge RSA/AES encryption, interactive geolocation mapping, and high-performance media synchronization. Engineered for absolute privacy and seamless cross-platform continuity.', links: [{ label: 'App Store', url: 'https://apps.apple.com/au/app/memoirme/id1640973202' }, { label: 'Play Store', url: 'https://play.google.com/store/apps/details?id=com.nartus.interactiveDiary&pcampaignid=web_share' }, { label: 'The Nartus', url: 'https://www.thenartus.com/' }], img: 'https://media.luci-studio.com/MEMOIRME.png', logo: 'https://media.luci-studio.com/MEMOIRME-LOGO.webp' },
  { title: 'TBchat', year: '2024–Now', desc: 'Next-generation Web3 messaging ecosystem integrating decentralized crypto wallets, proof-of-stake miner orchestration, and immersive real-time audio visualization. Bridging blockchain security with high-fidelity social interaction.', links: [{ label: 'App Store', url: 'https://apps.apple.com/us/app/tbchat-web3/id6739870518' }, { label: 'Chain-Views', url: 'https://www.chainviews.net/' }], img: 'https://media.luci-studio.com/TBCHAT.png', logo: 'https://media.luci-studio.com/TBCHAT-LOGO.webp' },
  { title: 'IU PETSHOP', year: '2021–2022', desc: 'A comprehensive pet care infrastructure leveraging blockchain for immutable identity tracking and secure, low-latency payment gateways. Orchestrated as a capstone innovation combining fintech and pet-tech ecosystems.', links: [{ label: 'GitHub', url: 'https://github.com/binhtt13122000/PetCare_User_Mobile' }, { label: 'Demo Video', url: 'https://drive.google.com/file/d/1tYOotBwaK2GCclhNcoFpm_q9G9nu00Rf/view' }], img: 'https://media.luci-studio.com/IUPET-shop.png', logo: 'https://media.luci-studio.com/IU-PET-LOGO.png' },
  { title: 'Survive in Shadow', year: '2018', desc: 'An atmospheric top-down survival experience crafted with Unity. Showcasing procedural generation algorithms, dynamic shadow-casting systems, and optimized resource management mechanics for immersive gameplay.', links: [{ label: 'itch.io', url: 'https://lapl1412.itch.io/survive-in-shadow' }], img: 'https://media.luci-studio.com/SURVIVE-GAME.png' },
];

const experience = [
  { id: 'TBchat', y: '2024–Now', role: 'Frontend Flutter Developer', co: 'TBchat · Nexsoft', loc: 'Vietnam & Hong Kong', desc: 'Building a blockchain messaging platform across Android, iOS, macOS, and Windows.', details: ['Engineered foundational deep-linking architecture for cross-module content sharing.', 'Implemented real-time location sharing using WebSockets, Isolates, and background tracking.', 'Developed audio chat with custom waveforms and secure on-device speech-to-text transcription.', 'Built crypto wallet functionality with gas fee monitoring and offline L1 transaction signing.', 'Architected multi-environment configurations using Flutter Flavors (Dev, Staging, Prod).'], tech: ['Flutter', 'BLoC', 'ObjectBox', 'WebSocket', 'Go Router', 'Freezed'], img: 'https://media.luci-studio.com/TBCHAT.png', logo: 'https://media.luci-studio.com/TBCHAT-LOGO.webp', links: [{ label: 'App Store', url: 'https://apps.apple.com/us/app/tbchat-web3/id6739870518' }, { label: 'Chain-Views', url: 'https://www.chainviews.net/' }] },
  { id: 'memoirMe', y: '2024–Now', role: 'Full Stack Flutter Developer', co: 'memoirMe · The Nartus', loc: 'Australia (Freelance)', desc: 'Architected an interactive E2E encrypted diary application with enterprise-grade security.', details: ['Architected zero-knowledge E2E encryption using RSA and AES cryptographic algorithms.', 'Engineered subscription management with In-App Purchases (IAP) to drive monetization.', 'Built resilient media management with resumable background upload/download capabilities.', 'Integrated Firebase Analytics & Crashlytics for robust production health monitoring.', 'Developed local auto-save and offline-first data synchronization logic.'], tech: ['Flutter', 'Firebase', 'BLoC', 'RSA/AES', 'IAP', 'Crashlytics'], img: 'https://media.luci-studio.com/MEMOIRME.png', logo: 'https://media.luci-studio.com/MEMOIRME-LOGO.webp', links: [{ label: 'The Nartus', url: 'https://www.thenartus.com/' }] },
  { id: 'QuanhTa', y: '2022–2024', role: 'Full Stack Flutter Developer', co: 'QuanhTa · Vidieu', loc: 'Vietnam', desc: 'Real estate marketplace with advanced map-based search and automated data processing.', details: ['Engineered custom Google Maps integration with polygon-based area selection and filters.', 'Implemented real-time chat facilitating buyer-seller communication using gRPC.', 'Optimized Flutter Web performance and resolved Safari-specific CanvasKit renderer issues.', 'Built automated web scraping pipeline using Python, Selenium, and Scrapy.', 'Established complete CD pipeline for Flutter apps using Jenkins and Docker.'], tech: ['Flutter', 'Riverpod', 'Isar', 'gRPC', 'Python', 'Scrapy', 'Jenkins', 'Docker'], img: 'https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&q=80&w=900', links: [{ label: 'Web App', url: 'https://quanhta.vn/map/land' }, { label: 'App Store', url: 'https://apps.apple.com/vn/app/quanh-ta/id6453535963' }, { label: 'Play Store', url: 'https://play.google.com/store/apps/details?id=vn.quanhta.superapp&hl=en' }] },
  { id: 'IU PETSHOP', y: '2021–2022', role: 'Flutter Developer & UI/UX Designer', co: 'IU PETSHOP · FPT University', loc: 'Captain Project', desc: 'Pet care ecosystem with blockchain identification and secure payment processing.', details: ['Implemented blockchain-based microchip identification system for pet tracking.', 'Integrated VNPay payment gateway through WebView for sandbox testing environment.', 'Designed complete mobile interface using Adobe XD and custom Flutter animations.', 'Integrated Firebase OAuth for secure user authentication across the platform.'], tech: ['Flutter', 'GetX', 'Hasura GraphQL', 'VNPay', 'Firebase Auth', 'Adobe XD'], img: 'https://media.luci-studio.com/IUPET-shop.png', logo: 'https://media.luci-studio.com/IU-PET-LOGO.png', links: [{ label: 'GitHub', url: 'https://github.com/binhtt13122000/PetCare_User_Mobile' }, { label: 'Demo Video', url: 'https://drive.google.com/file/d/1tYOotBwaK2GCclhNcoFpm_q9G9nu00Rf/view' }] },
];

const indieProjects = [
  { id: 'Luci Studio', y: '2026', role: 'Founder & Full Stack Developer', co: 'Luci Studio', loc: 'Vietnam', desc: 'Built the high-performance web portfolio and technical blog you are currently viewing.', details: ['Designed a premium, motion-rich UX/UI with custom-built interactive components.', 'Engineered for maximum performance (95+ Lighthouse score) using Astro static generation.', 'Implemented complex responsive layouts and magnetic hover interactions.', 'Deployed a global-first infrastructure using Cloudflare Pages edge delivery.'], tech: ['Astro', 'Go', 'PostgreSQL', 'Cloudflare Pages', 'Fly.io', 'Cloudflare R2', 'Tailwind CSS'], img: 'https://media.luci-studio.com/LUCI-STUDIO.png', logo: '/images/logo_icon.png', links: [{ label: 'Live Site', url: 'https://luci-studio.com/' }] },
  { id: 'UwU EBOOK', y: '2024', role: 'Full Stack Developer', co: 'UwU EBOOK', loc: 'Owner Project', desc: 'Digital publishing platform for Vietnamese content with full-stack automation.', details: ['Architected microservices backend using Golang and the Ent framework.', 'Built complex data crawler system with Python and Scrapy for automated content gathering.', 'Deployed containerized infrastructure using Docker for seamless scalability.'], tech: ['Go', 'Ent', 'MySQL', 'Python', 'Scrapy', 'Docker'], img: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&q=80&w=800', links: [] },
  { id: 'Survive in Shadow', y: '2018', role: 'Game Developer', co: 'Survive in Shadow', loc: 'Independent Project', desc: 'A minimalist 2D top-down survival game built with Unity.', details: ['Designed core survival mechanics including resource management and procedural enemy spawning.', 'Implemented custom 2D lighting system to enhance atmospheric tension.', 'Developed responsive player controls and inventory management systems.'], tech: ['Unity', 'C#', '2D Art'], img: 'https://media.luci-studio.com/SURVIVE-GAME.png', links: [{ label: 'itch.io', url: 'https://lapl1412.itch.io/survive-in-shadow' }] },
];

const rawPosts = await postService.getAll();
const blogPosts = rawPosts
  .filter(p => !p.topics?.some(t => t.toLowerCase().includes('art')))
  .map(p => ({
  id: p.id,
  title: p.title,
  subtitle: p.subtitle || '',
  date: formatDate(p.created_at),
  read: calculateReadTime(p.content),
  tag: (p.topics && p.topics.length > 0) ? p.topics[0] : 'Engineering',
  img: p.cover_image_url || 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&q=80&w=800',
  likes: p.likes ?? 0,
}));
const API_URL = import.meta.env.PUBLIC_API_URL || '';

const artItems: { img: string; label: string; year: string; url?: string }[] =
  rawPosts.some(p => p.topics?.some(t => t.toLowerCase().includes('art')))
    ? rawPosts
        .filter(p => p.topics?.some(t => t.toLowerCase().includes('art')))
        .map(p => ({
          img: p.cover_image_url || 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&q=80&w=800',
          label: p.title,
          year: new Date(p.created_at).getFullYear().toString(),
          url: `/blog/${slugify(p.title)}-${p.id}`,
        }))
    : [
        { img: 'https://images.unsplash.com/photo-1633356122544-f134324a6cee?auto=format&fit=crop&q=80&w=1200', label: 'Neon Currents', year: '2024' },
        { img: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&q=80&w=800', label: 'Deep Space', year: '2024' },
        { img: 'https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?auto=format&fit=crop&q=80&w=800', label: 'Bloom', year: '2024' },
        { img: 'https://images.unsplash.com/photo-1614850523296-d8c1af93d400?auto=format&fit=crop&q=80&w=800', label: 'Ember', year: '2023' },
        { img: 'https://images.unsplash.com/photo-1550684848-fac1c5b4e853?auto=format&fit=crop&q=80&w=800', label: 'Circuit', year: '2023' },
      ];
---

<Layout title="Luci Studio | Tech Blog, Digital Art & Innovative Apps">

  <!-- NAV -->
  <nav class="fixed top-0 w-full z-50 border-b border-white/5" style="background:var(--nav-bg);backdrop-filter:blur(16px)">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <img src="/images/logo_icon.png" alt="Luci Studio Logo" class="h-9 w-9 rounded-xl shadow-lg group-hover:shadow-violet-500/50 transition-all duration-300" />
        <span class="text-xl font-black tracking-[0em]">LUCI <span class="text-shimmer">STUDIO</span><span class="text-violet-500">.</span></span>
      </a>
      <div class="hidden md:flex items-center gap-8">
        {['About','Work','Art','Blog'].map(l => (
          <a href={`#${l.toLowerCase()}`} class="text-xs font-bold text-gray-400 hover:text-white transition-all duration-300 uppercase tracking-[0.2em]">{l}</a>
        ))}
        <a href="https://medium.com/@lapl1412.work" target="_blank" class="text-xs font-bold text-gray-400 hover:text-white transition-all duration-300 uppercase tracking-[0.2em]">Medium</a>
        <a href="https://www.linkedin.com/in/trung-l%E1%BA%ADp-luci-ba0b6a339/" target="_blank" class="text-xs font-bold text-gray-400 hover:text-white transition-all duration-300 uppercase tracking-[0.2em]">LinkedIn</a>
      </div>

      <div class="flex items-center gap-4">
        <!-- Theme Toggle Button -->
        <button 
          id="theme-toggle" 
          onclick="window.toggleTheme()"
          class="w-10 h-10 flex items-center justify-center rounded-full border border-white/10 hover:border-violet-500/40 hover:bg-white/5 transition-all duration-300 group"
          aria-label="Toggle theme"
        >
          <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors dark-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
          <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors light-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </button>

        <a href="#contact" class="magnetic hidden sm:block px-5 py-2.5 bg-white text-black text-xs font-black rounded-full hover:bg-violet-500 hover:text-white transition-all duration-300 uppercase tracking-widest">Let's Talk</a>
        
        <!-- Mobile Menu Toggle -->
        <button id="mobile-menu-toggle" class="md:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5 z-[100] group">
          <span class="w-6 h-0.5 transition-transform duration-300 group-[.active]:rotate-45 group-[.active]:translate-y-2" style="background-color: var(--text-primary);"></span>
          <span class="w-6 h-0.5 transition-opacity duration-300 group-[.active]:opacity-0" style="background-color: var(--text-primary);"></span>
          <span class="w-6 h-0.5 transition-transform duration-300 group-[.active]:-rotate-45 group-[.active]:-translate-y-2" style="background-color: var(--text-primary);"></span>
        </button>
      </div>
    </div>

    <!-- Mobile Menu Overlay -->
    <div id="mobile-menu" class="fixed inset-0 bg-black/95 backdrop-blur-3xl z-[90] flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-all duration-500">
      {['About','Work','Art','Blog'].map(l => (
        <a href={`#${l.toLowerCase()}`} class="mobile-nav-link text-4xl font-black tracking-tighter hover:text-violet-500 transition-colors">{l}</a>
      ))}
      <div class="h-px w-12 bg-white/10 my-4"></div>
      <a href="https://medium.com/@lapl1412.work" target="_blank" class="mobile-nav-link text-xl font-bold text-gray-400 uppercase tracking-widest">Medium</a>
      <a href="https://www.linkedin.com/in/trung-l%E1%BA%ADp-luci-ba0b6a339/" target="_blank" class="mobile-nav-link text-xl font-bold text-gray-400 uppercase tracking-widest">LinkedIn</a>
      <a href="#contact" class="mobile-nav-link mt-8 px-8 py-4 bg-white text-black font-black rounded-full uppercase tracking-widest">Let's Talk</a>
    </div>
  </nav>

  <main data-api-url={API_URL}>

    <!-- HERO -->
    <section class="relative min-h-screen flex flex-col justify-center items-center pt-20 px-6">
      <!-- Vanta.js halo is handled in Layout.astro -->

      <!-- Floating orbs for depth -->
      <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-2" aria-hidden="true"></div>

      <div class="relative z-10 text-center max-w-6xl mx-auto">



        <!-- Main Headline -->
        <h1 class="hero-headline" data-word-reveal>
          <!-- Line 1: LUCI STUDIO -->
          <span class="hero-line hero-line-top">
            <span class="reveal-word hero-word-main">
              <span class="text-white">LUCI</span>
            </span>
            <span class="reveal-word hero-word-accent">
              <span class="text-shimmer">STUDIO</span>
            </span>
          </span>

          <!-- Divider line -->
          <span class="hero-divider" aria-hidden="true">
            <span class="hero-divider-line"></span>
            <span class="hero-divider-diamond">◆</span>
            <span class="hero-divider-line"></span>
          </span>

          <!-- Line 2: BLOG • ART • APPS -->
          <span class="hero-line hero-line-bottom">
            <span class="reveal-word hero-word-sub">
              <span class="text-gray-400">TECH BLOG</span>
            </span>
            <span class="reveal-word hero-word-sub">
              <span class="text-gray-500 mx-2">•</span>
            </span>
            <span class="reveal-word hero-word-sub">
              <span class="text-white">DIGITAL ART</span>
            </span>
            <span class="reveal-word hero-word-sub">
              <span class="text-gray-500 mx-2">•</span>
            </span>
            <span class="reveal-word hero-word-sub hero-word-last">
              <span class="text-violet-400">APPS</span>
            </span>
          </span>
        </h1>

        <!-- Subtitle -->
        <p class="hero-subtitle">
          A creative engineering studio dedicated to exploring the intersection of code, art, and innovation. From technical deep-dives and digital experiments to building high-performance applications.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
          <a href="#work" class="magnetic group relative px-8 py-4 hero-cta-primary text-sm font-black rounded-full overflow-hidden hover:shadow-[0_0_60px_rgba(139,92,246,0.4)] transition-all duration-500 hover:scale-105">
            <span class="relative z-10 uppercase tracking-widest">View Work</span>
            <div class="absolute inset-0 bg-gradient-to-r from-violet-600 to-blue-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <span class="absolute inset-0 z-10 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 font-black uppercase tracking-widest transition-opacity duration-500">View Work</span>
            <div class="absolute -inset-1 bg-gradient-to-r from-violet-600 to-blue-600 rounded-full opacity-0 group-hover:opacity-20 blur transition-opacity duration-500"></div>
          </a>
          <a href="#art" class="magnetic hero-cta-secondary px-8 py-4 border text-sm font-bold rounded-full transition-all duration-300 uppercase tracking-widest hover:scale-105">
            See Art →
          </a>
        </div>

        <!-- Quick stat pills -->
        <div class="hero-stats">
          <span class="hero-stat-pill">5+ yrs Flutter</span>
          <span class="hero-stat-sep">·</span>
          <span class="hero-stat-pill">Android · iOS · Web · macOS</span>
          <span class="hero-stat-sep">·</span>
          <span class="hero-stat-pill">BLoC · Clean Arch</span>
        </div>
      </div>

      <!-- Scroll hint -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-30">
        <span class="text-xs uppercase tracking-widest">Scroll</span>
        <div class="w-px h-16 bg-gradient-to-b from-white to-transparent" style="animation:float 2s ease-in-out infinite"></div>
      </div>
    </section>

    <!-- MARQUEE STRIP -->
    <div class="relative py-6 border-y border-white/5 bg-black/40 overflow-hidden">
      <div class="flex whitespace-nowrap animate-marquee">
        {['Flutter','Dart','BLoC','Riverpod','Firebase','Go Router','Freezed','Retrofit','gRPC','WebSocket','Docker','GitHub Actions','ObjectBox','GCP','Clean Architecture','Flutter Test','Mocktail','Figma','Rive','Custom Paint'].flatMap(t => [
          <span class="mx-8 text-xs font-black uppercase tracking-[0.3em] text-gray-400">{t}</span>,
          <span class="mx-4 text-gray-700 text-lg">✦</span>
        ])}
        {['Flutter','Dart','BLoC','Riverpod','Firebase','Go Router','Freezed','Retrofit','gRPC','WebSocket','Docker','GitHub Actions','ObjectBox','GCP','Clean Architecture','Flutter Test','Mocktail','Figma','Rive','Custom Paint'].flatMap(t => [
          <span class="mx-8 text-xs font-black uppercase tracking-[0.3em] text-gray-400">{t}</span>,
          <span class="mx-4 text-gray-700 text-lg">✦</span>
        ])}
      </div>
    </div>


    <!-- CONTENT WRAPPER FOR SMOOTH TRANSITIONS -->
    <div class="relative bg-black/60 backdrop-blur-2xl border-t border-white/5 light-mode:bg-white/80" style="background-color: var(--bg-secondary); border-color: var(--border-color);">
      
            <!-- BLOG -->
      <section id="blog" class="py-16 px-6">
        <div class="max-w-7xl mx-auto">
          <div data-reveal class="mb-20 text-center">
            <span class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-3 block">Writing</span>
            <h2 class="text-6xl md:text-8xl font-black tracking-tighter">THOUGHTS<span class="text-violet-500">.</span></h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {blogPosts.map((p, i) => (
              <div class="relative" data-post-id={p.id} data-post-likes={p.likes}>
                <a href={`/blog/${slugify(p.title)}-${p.id}`} class="block no-underline">
                  <article data-reveal data-delay={String(i+1)} class="tilt-card group cursor-pointer p-5 sm:p-6 rounded-2xl border border-white/5 hover:border-violet-500/20 transition-all duration-500 bg-white/[0.02]">
                    <div class="aspect-video rounded-2xl overflow-hidden mb-6 border border-white/5 group-hover:border-violet-500/20 transition-all duration-500">
                      <img src={p.img} alt={p.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                    </div>
                    <div class="flex items-center gap-3 mb-4">
                      <span class="text-xs font-black text-violet-400 uppercase tracking-widest">{p.tag}</span>
                      <span class="w-1 h-1 bg-gray-700 rounded-full"></span>
                      <span class="text-xs text-gray-600">{p.date}</span>
                      <span class="w-1 h-1 bg-gray-700 rounded-full"></span>
                      <span class="text-xs text-gray-600">{p.read} read</span>
                    </div>
                    <h3 class="text-xl font-bold leading-snug group-hover:text-violet-400 transition-colors duration-300 line-clamp-2">{p.title}</h3>
                    {p.subtitle && <p class="text-sm text-gray-500 mt-2 leading-relaxed line-clamp-3">{p.subtitle}</p>}
                    <div class="mt-4 pt-4 border-t border-white/5 flex items-center justify-between">
                      <span class="text-xs text-gray-600">Read more →</span>
                      <span class="tile-like-area flex items-center gap-1.5 cursor-pointer group/like" data-id={p.id}>
                        <svg class="tile-like-icon w-4 h-4 text-gray-500 group-hover/like:text-rose-400 transition-colors duration-200" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                        </svg>
                        <span class="tile-like-count text-xs text-gray-500 group-hover/like:text-rose-400 transition-colors duration-200">{p.likes}</span>
                      </span>
                    </div>
                  </article>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>

      <div class="flex flex-col items-center py-8 opacity-40">
        <div class="w-0.5 h-12 bg-gradient-to-b from-pink-500 to-transparent"></div>
      </div>

      <!-- WORK -->
      <section id="work" class="py-16 px-6">
        <div class="max-w-7xl mx-auto">
          <div data-reveal class="mb-20">
            <span class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-3 block">Selected Work</span>
            <h2 class="text-6xl md:text-8xl font-black tracking-tighter">PORTFOLIO<span class="text-violet-500">.</span></h2>
            <div data-reveal class="line-draw h-px bg-gradient-to-r from-violet-500 to-transparent mt-6 max-w-xs"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {projects.map((p, i) => (
              <ProjectCard {...p} index={i} />
            ))}
          </div>
        </div>
      </section>

      <div class="flex flex-col items-center py-8 opacity-40">
        <div class="w-0.5 h-12 bg-gradient-to-b from-pink-500 to-transparent"></div>
      </div>

      <!-- ART GALLERY -->
