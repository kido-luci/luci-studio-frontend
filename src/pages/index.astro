---
import Layout from "../layouts/Layout.astro";
import RepoCard from "../components/RepoCard.astro";
import TopNav from "../components/TopNav.astro";
import SeriesCard from "../components/SeriesCard.astro";
import PostCard from "../components/PostCard.astro";
import { postService } from "../services/posts";
import { playlistService } from "../services/playlists";
import { buildSeriesViews } from "../utils/series";
import { galleryService } from "../services/gallery";
import { projectService } from "../services/projects";
import { buildLabCards } from "../utils/labCards";
import { profileService } from "../services/profile";
import { buildPostSlug, calculateReadTime, calculateReadTimeFromWordCount, formatDate } from "../utils/blog";
import FooterLinks from "../components/FooterLinks.astro";
import "../styles/lab-cards.css";

const LAB_ACCENT = "#6c4cf1";

const profile = await profileService.getProfile();

// The homepage LAB section reuses the /lab editorial RepoCard, built from the
// same `projects` entity via the shared buildLabCards mapping. Apps lead with
// their cover; source repos with the GitHub social-preview (OG) banner.
const labProjects = await projectService.getAll();
const { apps: labApps, sources: labSources } = buildLabCards(labProjects);
// Homepage previews just the first 2 of each group (released apps + public
// source); the full list lives on /lab via the "Explore the Lab" link.
const labCards = [...labApps.slice(0, 2), ...labSources.slice(0, 2)];

const [rawPosts, rawPlaylists] = await Promise.all([
  postService.getAll(),
  playlistService.getAll(),
]);
const blogPosts = rawPosts
  .filter(p => !p.topics?.some(t => t.toLowerCase().startsWith('art')))
  .map(p => ({
  id: p.id,
  title: p.title,
  subtitle: p.subtitle || '',
  date: formatDate(p.created_at),
  read: p.word_count ? calculateReadTimeFromWordCount(p.word_count) : calculateReadTime(p.content || ''),
  tags: (p.topics && p.topics.length > 0) ? p.topics : ['Engineering'],
  // empty cover → PostCard renders the gradient + tag-word fallback (same as /blog)
  img: p.cover_image_url || '',
  likes: p.likes ?? 0,
  views: p.views ?? 0,
}));

const homePlaylists = buildSeriesViews(rawPlaylists, rawPosts).slice(0, 3);
const API_URL = import.meta.env.PUBLIC_API_URL || '';

const galleryItems = await galleryService.getAll();
const artItems: { img: string; label: string; year: string; date: string; topic: string; url?: string; id?: string; likes?: number }[] =
  galleryItems.length > 0
    ? galleryItems.map(g => ({
          img: g.cover_image_url || 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&q=80&w=800',
          label: g.title,
          year: new Date(g.created_at).getFullYear().toString(),
          date: formatDate(g.created_at),
          topic: 'Art',
          url: `/art/${buildPostSlug(g.title, g.id)}/`,
          id: g.id,
          likes: g.likes ?? 0,
        }))
    : [
        { img: 'https://images.unsplash.com/photo-1633356122544-f134324a6cee?auto=format&fit=crop&q=80&w=1200', label: 'Neon Currents', year: '2024', date: 'Jan 2024', topic: 'Digital Art' },
        { img: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&q=80&w=800', label: 'Deep Space', year: '2024', date: 'Mar 2024', topic: 'Digital Art' },
        { img: 'https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?auto=format&fit=crop&q=80&w=800', label: 'Bloom', year: '2024', date: 'Jun 2024', topic: 'Illustration' },
        { img: 'https://images.unsplash.com/photo-1614850523296-d8c1af93d400?auto=format&fit=crop&q=80&w=800', label: 'Ember', year: '2023', date: 'Nov 2023', topic: 'Digital Art' },
        { img: 'https://images.unsplash.com/photo-1550684848-fac1c5b4e853?auto=format&fit=crop&q=80&w=800', label: 'Circuit', year: '2023', date: 'Aug 2023', topic: 'Digital Art' },
      ];

const SITE_URL = 'https://luci-studio.com';
const homepageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Luci Studio',
  url: SITE_URL,
  description: 'A creative engineering studio — technical blog, digital art, and high-performance cross-platform applications.',
  logo: { '@type': 'ImageObject', url: `${SITE_URL}/images/logo_icon.png` },
  sameAs: [
    'https://medium.com/@lapl1412.work',
    'https://www.linkedin.com/in/kido-luci/',
  ],
};
---

<Layout
  title="Luci Studio | Creative Engineering — Tech Blog, Digital Art & Cross-Platform Apps"
  description="Luci Studio is a creative engineering space. Technical blog, digital art, and high-performance cross-platform applications built with rigorous architecture."
  canonical={`${SITE_URL}/`}
  keywords="Flutter, Dart, Go, mobile development, tech blog, digital art, cross-platform, clean architecture, Luci Studio"
  structuredData={homepageSchema}
>

  <Fragment slot="head">
    <!-- Preload the LCP hero background. It's a CSS background-image, so the browser
         can't discover it until the stylesheet parses (~600ms late on mobile). Preloading
         starts the fetch at HTML parse with high priority. Variants match the .hero-bg-img
         portrait/landscape media rules so only the needed one is fetched. -->
    <link rel="preload" as="image" fetchpriority="high" href="https://media.luci-studio.com/hero/luci-hero-portrait.webp" media="(orientation: portrait)" />
    <link rel="preload" as="image" fetchpriority="high" href="https://media.luci-studio.com/hero/luci-hero-landscape.webp" media="(orientation: landscape)" />
    <!-- Editorial display fonts for the LAB section RepoCards (same as /lab; Space Mono already in Layout). -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400..900;1,400..900&family=Hanken+Grotesk:wght@400..800&display=swap" />
  </Fragment>

  <TopNav active="home" ctaLabel="Let's Talk" ctaHref="#contact" />

  <main data-api-url={API_URL}>

    <!-- HERO -->
    <section class="relative min-h-screen flex flex-col pt-20">
      <div class="hero-bg-img absolute inset-0 pointer-events-none z-[0]" style="background-size:cover;background-position:center;background-repeat:no-repeat;"></div>
      <!-- Vanta.js halo is handled in Layout.astro -->

      <!-- Floating orbs for depth -->
      <div class="hero-orb hero-orb-1" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-2" aria-hidden="true"></div>

      <!-- Patch-reveal overlay: tiles generated by JS, GSAP staggers them out to reveal the hero -->
      <div data-hero-patches aria-hidden="true" class="absolute inset-0 pointer-events-none z-30"></div>

      <div class="relative z-10 flex-1 flex flex-col justify-center items-center text-center max-w-6xl mx-auto w-full px-4 md:px-6">

        <!-- Main Headline -->
        <h1 class="hero-headline" data-word-reveal>
          <!-- Line 1: LUCI STUDIO -->
          <span class="hero-line hero-line-top">
            <span class="reveal-word hero-word-main">
              <span class="text-white">LUCI</span>
            </span>
            <span class="reveal-word hero-word-accent">
              <span class="text-shimmer">STUDIO</span>
            </span>
          </span>

          <!-- Divider line -->
          <span class="hero-divider" aria-hidden="true">
            <span class="hero-divider-line"></span>
            <span class="hero-divider-diamond">◆</span>
            <span class="hero-divider-line"></span>
          </span>

        </h1>

        <!-- Subtitle -->
        <p class="hero-subtitle" style="color: white !important;">{profile?.hero_tagline ?? ''}</p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-5">
          <a href="#work" class="magnetic group relative px-8 py-4 hero-cta-primary text-sm font-black rounded-full overflow-hidden hover:shadow-[0_0_60px_rgba(139,92,246,0.4)] transition-all duration-500 hover:scale-105">
            <span class="relative z-10 uppercase tracking-widest">View Work</span>
            <div class="absolute inset-0 bg-gradient-to-r from-violet-600 to-blue-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            <span class="absolute inset-0 z-10 flex items-center justify-center text-white opacity-0 group-hover:opacity-100 font-black uppercase tracking-widest transition-opacity duration-500">View Work</span>
            <div class="absolute -inset-1 bg-gradient-to-r from-violet-600 to-blue-600 rounded-full opacity-0 group-hover:opacity-20 blur transition-opacity duration-500"></div>
          </a>
          <a href="#art" class="magnetic hero-cta-secondary px-8 py-4 border text-sm font-bold rounded-full transition-all duration-300 uppercase tracking-widest hover:scale-105">
            See Art →
          </a>
        </div>
      </div>

      <!-- Pillars: full-width bar pinned to the bottom of the hero -->
      <div class="hero-pillars relative z-10" data-reveal>
        <a href="/blog" class="hp-card" style="--hp:#a78bfa">
          <span class="hp-num">01</span>
          <span class="hp-title">TECH BLOG</span>
          <span class="hp-sub">Notes on Flutter, Go &amp; on-device AI</span>
          <span class="hp-arrow" aria-hidden="true">→</span>
        </a>
        <a href="#art" class="hp-card" style="--hp:#f472b6">
          <span class="hp-num">02</span>
          <span class="hp-title">DIGITAL ART</span>
          <span class="hp-sub">Generative &amp; hand-crafted pieces</span>
          <span class="hp-arrow" aria-hidden="true">→</span>
        </a>
        <a href="#work" class="hp-card" style="--hp:#22d3ee">
          <span class="hp-num">03</span>
          <span class="hp-title">APPS</span>
          <span class="hp-sub">Shipped on 5 platforms</span>
          <span class="hp-arrow" aria-hidden="true">→</span>
        </a>

        <!-- Scroll cue floating just above the bar — signals more content below -->
        <a href="#blog" class="hero-scroll-cue" aria-label="Scroll down for more">
          <span class="hero-scroll-text">SCROLL</span>
          <svg class="hero-scroll-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </a>
      </div>
    </section>

    <!-- MARQUEE STRIP -->
    <div class="relative py-6 border-y border-white/5 bg-black/40 overflow-hidden">
      <div class="flex whitespace-nowrap animate-marquee">
        {(profile?.tech_marquee ?? []).flatMap((t) => [
          <span class="mx-8 text-xs font-black uppercase tracking-[0.3em] text-gray-400">{t}</span>,
          <span class="mx-4 text-gray-700 text-lg">✦</span>,
        ])}
        {(profile?.tech_marquee ?? []).flatMap((t) => [
          <span class="mx-8 text-xs font-black uppercase tracking-[0.3em] text-gray-400">{t}</span>,
          <span class="mx-4 text-gray-700 text-lg">✦</span>,
        ])}
      </div>
    </div>


    <!-- CONTENT WRAPPER FOR SMOOTH TRANSITIONS -->
    <div class="relative bg-black/60 border-t border-white/5 light-mode:bg-white/80" style="background-color: var(--bg-secondary); border-color: var(--border-color);">
      
            <!-- BLOG -->
      <section id="blog" class="py-16 px-4 md:px-6">
        <div class="max-w-7xl mx-auto">
          <div data-reveal class="mb-20 text-center">
            <span class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-3 block">Raw Output</span>
            <h2 data-ml9 class="text-6xl md:text-8xl font-black tracking-normal">THOUGHTS<span class="text-violet-500">.</span></h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 items-stretch md:auto-rows-fr gap-8" id="home-blog-grid">
            {blogPosts.slice(0, 6).map((p) => (
              <PostCard
                href={`/blog/${buildPostSlug(p.title, p.id)}/`}
                title={p.title}
                subtitle={p.subtitle}
                tags={p.tags}
                date={p.date}
                read={p.read}
                img={p.img}
                id={p.id}
                views={p.views}
                likes={p.likes}
                interactive
              />
            ))}
          </div>
          {blogPosts.length > 6 && (
            <div data-reveal class="mt-12 text-center">
              <a href="/blog" class="magnetic !inline-flex items-center gap-2 px-7 py-3 border border-violet-500/30 text-xs font-black uppercase tracking-widest text-violet-400 rounded-full hover:border-violet-500/70 hover:bg-violet-500/10 hover:text-violet-300 transition-all duration-300">
                View all {blogPosts.length} posts
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          )}
          {homePlaylists.length > 0 && (
            <div data-reveal class="home-playlists mt-16 pt-12">
              <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <span class="text-xs font-black text-[#8b5cf6] uppercase tracking-[0.3em] mb-2 block">Reading Paths</span>
                  <h3 class="text-3xl md:text-4xl font-black tracking-normal">SERIES<span class="text-[#8b5cf6]">.</span></h3>
                </div>
                <a href="/blog/series" class="playlist-see-all">View series</a>
              </div>

              <ol class="series-strip list-none p-0 m-0">
                {homePlaylists.map((p) => (
                  <li><SeriesCard series={p} /></li>
                ))}
              </ol>
            </div>
          )}
        </div>
      </section>

      <div class="flex flex-col items-center py-8 opacity-40">
        <div class="w-0.5 h-12 bg-gradient-to-b from-pink-500 to-transparent"></div>
      </div>

      <!-- LAB -->
      <section id="work" class="py-16 px-4 md:px-6">
        <div class="max-w-7xl mx-auto">
          <div data-reveal class="mb-20">
            <span class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-3 block">Open Source &amp; Apps</span>
            <h2 data-ml9 class="text-6xl md:text-8xl font-black tracking-normal">LAB<span class="text-violet-500">.</span></h2>
            <div data-reveal class="line-draw h-px bg-gradient-to-r from-violet-500 to-transparent mt-6 max-w-xs"></div>
          </div>
          <div class="lab-palette grid grid-cols-1 md:grid-cols-2 gap-7" style="font-family:'Hanken Grotesk',system-ui,sans-serif;">
            {labCards.map((c) => (
              <RepoCard {...c} accent={LAB_ACCENT} />
            ))}
          </div>
          {labCards.length > 0 && (
            <div data-reveal class="mt-12 text-center">
              <a href="/lab" class="magnetic !inline-flex items-center gap-2 px-7 py-3 border border-violet-500/30 text-xs font-black uppercase tracking-widest text-violet-400 rounded-full hover:border-violet-500/70 hover:bg-violet-500/10 hover:text-violet-300 transition-all duration-300">
                Explore the Lab
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          )}
        </div>
      </section>

      <div class="flex flex-col items-center py-8 opacity-40">
        <div class="w-0.5 h-12 bg-gradient-to-b from-pink-500 to-transparent"></div>
      </div>

      <!-- ART GALLERY -->
      <section id="art" class="py-16 px-4 md:px-6 relative">
        <div class="absolute inset-0 pointer-events-none" style="clip-path: inset(0);">
          <div id="art-bg" class="sticky top-0 w-full h-screen" style="background-size:cover;background-position:center;background-repeat:no-repeat"></div>
        </div>
        <div class="relative max-w-7xl mx-auto">
          <div data-reveal class="mb-20 flex flex-col md:flex-row md:items-end justify-between gap-8">
            <div>
              <span class="text-xs font-black uppercase tracking-[0.3em] mb-3 block" style="background:linear-gradient(90deg,#f472b6,#a78bfa,#60a5fa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">Off-Clock</span>
              <h2 data-ml9 class="text-6xl md:text-8xl font-black tracking-normal" style="color:white">THE ART<span style="color:#60a5fa">.</span></h2>
            </div>
            <p class="text-white/50 max-w-xs text-sm leading-relaxed">Rigorous aesthetic discipline. Where raw engineering logic meets deliberate visual hierarchy.</p>
          </div>

          <div class="masonry-art-grid">
            {artItems.map((a) => {
              const infoBar = (
                <div class="px-3 py-2 flex items-start justify-between gap-2 rounded-xl" style="background:rgba(10,10,20,0.85)">
                  <div class="flex-1 min-w-0">
                    <p class="font-bold text-sm leading-snug line-clamp-2" style="color:#fff">{a.label}</p>
                    <p class="text-[10px] uppercase tracking-widest mt-0.5 truncate" style="color:#93c5fd">{a.topic} · {a.date}</p>
                  </div>
                  {a.id != null && (
                    <span
                      class="art-like-area flex items-center gap-1 cursor-pointer flex-shrink-0 group/like mt-0.5"
                      data-id={String(a.id)}
                      data-likes={String(a.likes ?? 0)}
                    >
                      <svg class="art-like-icon w-3.5 h-3.5 group-hover/like:text-rose-400 transition-colors duration-200" style="color:#cbd5e1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                      </svg>
                      <span class="art-like-count text-[10px] group-hover/like:text-rose-400 transition-colors duration-200" style="color:#cbd5e1">{a.likes ?? 0}</span>
                    </span>
                  )}
                </div>
              );
              return a.url ? (
                <a href={a.url} class="masonry-art-item group block" data-art-card>
                  <div class="art-img-frame relative rounded-2xl overflow-hidden border-4 border-white/40 hover:border-purple-400/80 transition-all duration-500">
                    <img src={a.img} alt={a.label} class="w-full h-auto block transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/70 to-transparent pointer-events-none"></div>
                  </div>
                  {infoBar}
                </a>
              ) : (
                <div class="masonry-art-item group" data-art-card>
                  <div class="art-img-frame relative rounded-2xl overflow-hidden border-4 border-white/40 hover:border-purple-400/80 transition-all duration-500">
                    <img src={a.img} alt={a.label} class="w-full h-auto block transition-transform duration-700 group-hover:scale-105" loading="lazy" />
                    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/70 to-transparent pointer-events-none"></div>
                  </div>
                  {infoBar}
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <div class="flex flex-col items-center py-8 opacity-40">
        <div class="w-0.5 h-12 bg-gradient-to-b from-pink-500 to-transparent"></div>
      </div>

    </div>

      
<!-- CTA -->
      <section id="contact" class="py-40 px-4 md:px-6">
        <div class="max-w-5xl mx-auto text-center">
          <div data-reveal class="mb-6">
            <span class="text-xs font-black text-gray-600 uppercase tracking-[0.3em]">Enough talking.</span>
          </div>
          <h2 data-word-reveal class="text-[clamp(2.5rem,7vw,6rem)] font-black tracking-[0.02em] leading-none mb-12">
            {["LET'S","SHIP","SOMETHING"].map((w,i) => (
              <span class="reveal-word !block" style={`transition-delay:${i*100}ms`}>
                <span class={i===1 ? 'text-shimmer' : 'text-white'}>{w}</span>
              </span>
            ))}
            <span class="reveal-word !block" style="transition-delay:300ms"><span class="text-white">REAL</span><span class="text-violet-500">.</span></span>
          </h2>
          <div data-reveal class="flex flex-col sm:flex-row items-center justify-center gap-5">
            <a href="mailto:lapl1412.work@gmail.com" class="magnetic group relative px-10 py-5 rounded-full hero-cta-primary font-black uppercase tracking-widest overflow-hidden hover:shadow-[0_0_80px_rgba(139,92,246,0.5)] transition-all duration-500">
              <span class="relative z-10">Say Hello</span>
              <div class="absolute inset-0 bg-gradient-to-r from-violet-600 to-blue-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <span class="absolute inset-0 z-10 flex items-center justify-center text-white font-black uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity duration-500">Say Hello</span>
            </a>
            <a href="https://www.linkedin.com/in/kido-luci/" target="_blank" class="magnetic text-sm font-bold text-gray-500 hover:text-white transition-colors duration-300 uppercase tracking-widest !flex items-center gap-2">LinkedIn <span>↗</span></a>
          </div>
        </div>
      </section>

      <!-- FOOTER -->
      <footer class="py-16 border-t border-white/5 px-4 md:px-6">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
          <a href="/" class="flex items-center gap-3 opacity-80 hover:opacity-100 transition-opacity">
            <img src="/images/logo_icon.png" alt="Luci Studio Logo" loading="lazy" class="h-8 w-8 rounded-lg" />
            <span class="text-2xl font-normal tracking-wide" style="font-family: 'Limelight', sans-serif;">LUCI-STUDIO<span class="text-violet-500">.</span></span>
          </a>
          <div class="flex flex-wrap items-center justify-center gap-6 md:gap-8">
            {(profile?.social_links ?? []).map((l) => (
              <a href={l.url} target="_blank" rel="noopener" class="text-xs font-bold text-gray-600 hover:text-white transition-colors uppercase tracking-widest">{l.label}</a>
            ))}
            <FooterLinks linkColor="text-gray-600" />
          </div>
          <div class="flex flex-col items-center md:items-end gap-3">
            <div class="flex flex-col items-center md:items-end gap-1">
              <a href={`mailto:${profile?.contact_email}`} class="text-xs font-bold text-gray-500 hover:text-white transition-colors uppercase tracking-widest">{profile?.contact_email}</a>
              <a href={`tel:${profile?.contact_phone?.replace(/\s/g, '')}`} class="text-xs font-bold text-gray-500 hover:text-white transition-colors uppercase tracking-widest">{profile?.contact_phone}</a>
            </div>
            <p class="text-xs text-gray-700 uppercase tracking-widest">{profile?.copyright}</p>
          </div>
        </div>
      </footer>

  </main>

</Layout>

<style>
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(30px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-24px); }
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.7); }
}
@keyframes orb-float-1 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(30px, -40px) scale(1.05); }
  66% { transform: translate(-20px, 20px) scale(0.97); }
}
@keyframes orb-float-2 {
  0%, 100% { transform: translate(0, 0) scale(1); }
  40% { transform: translate(-35px, 30px) scale(1.08); }
  70% { transform: translate(25px, -25px) scale(0.95); }
}
@keyframes divider-expand {
  from { width: 0; opacity: 0; }
  to { width: 100%; opacity: 1; }
}
@keyframes diamond-spin {
  0%  { transform: rotate(0deg) scale(1); }
  50% { transform: rotate(180deg) scale(1.3); }
  100%{ transform: rotate(360deg) scale(1); }
}

