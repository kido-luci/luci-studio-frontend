---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Luci | Fullstack Developer & Artist">
  <!-- Noise Texture Overlay -->
  <div
    class="fixed inset-0 z-[100] pointer-events-none opacity-[0.03] bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
  >
  </div>

  <!-- Background Elements -->
  <div class="fixed inset-0 -z-10 bg-[#050505]">
    <div
      class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-purple-600/20 rounded-full blur-[120px] animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-blue-600/20 rounded-full blur-[120px] animate-pulse"
      style="animation-delay: 2s;"
    >
    </div>
  </div>

  <!-- Navigation -->
  <nav
    class="fixed top-0 w-full z-50 transition-all duration-300 border-b border-white/5 backdrop-blur-xl bg-black/20"
  >
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="/" class="group flex items-center gap-3">
        <div class="relative w-10 h-10 overflow-hidden rounded-xl">
          <div
            class="absolute inset-0 bg-gradient-to-tr from-purple-600 to-blue-500 animate-gradient-xy"
          >
          </div>
          <div
            class="absolute inset-[2px] bg-black rounded-[10px] flex items-center justify-center"
          >
            <span
              class="text-xl font-black bg-clip-text text-transparent bg-gradient-to-tr from-purple-400 to-blue-400"
              >L</span
            >
          </div>
        </div>
        <span class="text-2xl font-black tracking-tighter text-white"
          >LUCI<span class="text-purple-500">.</span></span
        >
      </a>

      <div class="hidden md:flex items-center gap-10">
        <a
          href="#work"
          class="text-sm font-medium text-gray-400 hover:text-white transition-colors uppercase tracking-widest"
          >Work</a
        >
        <a
          href="#art"
          class="text-sm font-medium text-gray-400 hover:text-white transition-colors uppercase tracking-widest"
          >Art</a
        >
        <a
          href="#blog"
          class="text-sm font-medium text-gray-400 hover:text-white transition-colors uppercase tracking-widest"
          >Blog</a
        >
        <a
          href="#about"
          class="text-sm font-medium text-gray-400 hover:text-white transition-colors uppercase tracking-widest"
          >About</a
        >
      </div>

      <a
        href="#contact"
        class="px-6 py-2.5 bg-white text-black text-sm font-bold rounded-full hover:bg-purple-500 hover:text-white transition-all duration-300 hover:scale-105 active:scale-95 shadow-lg shadow-white/5"
      >
        Let's Talk
      </a>
    </div>
  </nav>

  <main>
    <!-- Hero Section -->
    <section
      class="relative min-h-screen flex flex-col items-center justify-center pt-20 px-6 overflow-hidden"
    >
      <div class="relative z-10 text-center max-w-5xl mx-auto">
        <div
          class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/5 border border-white/10 mb-8 animate-fade-in-up"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-2 w-2 bg-purple-500"
            ></span>
          </span>
          <span
            class="text-xs font-bold uppercase tracking-[0.2em] text-gray-400"
            >Available for projects</span
          >
        </div>

        <h1
          class="text-6xl md:text-8xl lg:text-[120px] font-black tracking-tighter leading-[0.9] mb-12 animate-fade-in-up"
          style="animation-delay: 0.2s;"
        >
          CRAFTING <br />
          <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-500 to-blue-500"
            >DIGITAL ART</span
          >
          <br />
          WITH CODE
        </h1>

        <p
          class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto mb-12 leading-relaxed animate-fade-in-up"
          style="animation-delay: 0.4s;"
        >
          Fullstack Developer by day, Digital Artist by night. I build scalable
          applications and create immersive visual experiences.
        </p>

        <div
          class="flex flex-col sm:flex-row items-center justify-center gap-6 animate-fade-in-up"
          style="animation-delay: 0.6s;"
        >
          <a
            href="#work"
            class="group relative px-10 py-5 bg-purple-600 rounded-2xl overflow-hidden transition-all duration-300 hover:scale-105 hover:shadow-[0_0_40px_rgba(147,51,234,0.3)]"
          >
            <div
              class="absolute inset-0 bg-gradient-to-r from-purple-600 to-blue-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            >
            </div>
            <span
              class="relative text-lg font-bold text-white uppercase tracking-widest"
              >Explore Work</span
            >
          </a>
          <a
            href="#art"
            class="px-10 py-5 bg-white/5 border border-white/10 rounded-2xl text-lg font-bold text-white uppercase tracking-widest hover:bg-white/10 transition-all duration-300"
          >
            View Art
          </a>
        </div>
      </div>

      <!-- Floating Art Elements -->
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full pointer-events-none -z-10"
      >
        <div
          class="absolute top-[10%] left-[5%] w-64 h-64 bg-purple-500/10 blur-[100px] animate-blob"
        >
        </div>
        <div
          class="absolute bottom-[10%] right-[5%] w-64 h-64 bg-blue-500/10 blur-[100px] animate-blob"
          style="animation-delay: 4s;"
        >
        </div>
        <div
          class="absolute top-[40%] right-[10%] w-32 h-32 bg-pink-500/10 blur-[80px] animate-blob"
          style="animation-delay: 2s;"
        >
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div
        class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce opacity-50"
      >
        <div
          class="w-6 h-10 border-2 border-white/20 rounded-full flex justify-center"
        >
          <div class="w-1 h-2 bg-white/40 rounded-full mt-2"></div>
        </div>
      </div>
    </section>

    <!-- Expertise / Services -->
    <section class="py-32 px-6 border-b border-white/5">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          {
            [
              {
                title: "Bespoke Web Apps",
                desc: "High-performance applications built with engineering precision and modern architectural patterns.",
                icon: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
              },
              {
                title: "3D Web Experiences",
                desc: "Immersive, interactive 3D worlds and components that live directly in your browser.",
                icon: "M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5",
              },
              {
                title: "Generative Art",
                desc: "Custom-coded visual systems and digital art pieces tailored for brands and collectors.",
                icon: "M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z",
              },
            ].map((service, i) => (
              <div data-reveal data-reveal-delay={String(i * 200)} class="p-8 bg-white/5 rounded-3xl border border-white/5 hover:border-white/20 transition-all duration-300">
                <div class="w-12 h-12 bg-purple-600/10 rounded-2xl flex items-center justify-center mb-6">
                  <svg
                    class="w-6 h-6 text-purple-500"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d={service.icon}
                    />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-white mb-4">
                  {service.title}
                </h3>
                <p class="text-gray-400 leading-relaxed text-sm">
                  {service.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Split Section: Dev & Art -->
    <section class="py-32 px-6">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Developer Side -->
        <div
          data-reveal="left"
          class="group relative p-12 bg-[#0a0a0a] border border-white/5 rounded-[40px] overflow-hidden hover:border-purple-500/30 transition-all duration-500"
        >
          <div class="absolute top-0 right-0 p-8">
            <svg
              class="w-12 h-12 text-purple-500/20 group-hover:text-purple-500/40 transition-colors"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M24 12l-5.657 5.657-1.414-1.414L21.172 12l-4.243-4.243 1.414-1.414L24 12zM2.828 12l4.243 4.243-1.414 1.414L0 12l5.657-5.657 1.414 1.414L2.828 12zm9.172 0l-2 2-1.414-1.414L10 12l-1.414-1.414L10 9.172l2-2 1.414 1.414L12 10l1.414 1.414L12 14.828z"
              ></path></svg
            >
          </div>
          <h2 class="text-4xl font-black mb-6 tracking-tight">
            THE <br /><span class="text-purple-500">ENGINEER.</span>
          </h2>
          <p class="text-gray-400 text-lg mb-8 leading-relaxed">
            Specializing in building robust, high-performance web applications
            using modern technologies like React, Next.js, Astro, and Node.js.
            Focused on clean code and user-centric architecture.
          </p>
          <div class="flex flex-wrap gap-3">
            {
              ["TypeScript", "React", "Node.js", "PostgreSQL", "Docker"].map(
                (tech) => (
                  <span class="px-4 py-1.5 bg-white/5 border border-white/10 rounded-full text-xs font-bold text-gray-400 uppercase tracking-widest">
                    {tech}
                  </span>
                ),
              )
            }
          </div>
        </div>

        <!-- Artist Side -->
        <div
          data-reveal="right"
          data-reveal-delay="200"
          class="group relative p-12 bg-[#0a0a0a] border border-white/5 rounded-[40px] overflow-hidden hover:border-blue-500/30 transition-all duration-500"
        >
          <div class="absolute top-0 right-0 p-8">
            <svg
              class="w-12 h-12 text-blue-500/20 group-hover:text-blue-500/40 transition-colors"
              fill="currentColor"
              viewBox="0 0 24 24"
              ><path
                d="M12 0L15.39 8.26L24 9.27L17.5 15.14L19.27 24L12 19.56L4.73 24L6.5 15.14L0 9.27L8.61 8.26L12 0Z"
              ></path></svg
            >
          </div>
          <h2 class="text-4xl font-black mb-6 tracking-tight">
            THE <br /><span class="text-blue-500">ARTIST.</span>
          </h2>
          <p class="text-gray-400 text-lg mb-8 leading-relaxed">
            Exploring the boundaries of generative art, digital illustration,
            and 3D modeling. Creating visual narratives that blend mathematical
            precision with organic creativity.
          </p>
          <div class="flex flex-wrap gap-3">
            {
              [
                "Generative Art",
                "3D Modeling",
                "UI/UX Design",
                "Illustration",
                "Motion",
              ].map((skill) => (
                <span class="px-4 py-1.5 bg-white/5 border border-white/10 rounded-full text-xs font-bold text-gray-400 uppercase tracking-widest">
                  {skill}
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Strip -->
    <section class="py-20 border-y border-white/5 bg-[#080808]">
      <div
        class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-12 text-center"
      >
        {
          [
            { number: "5+", label: "Years of Experience" },
            { number: "30+", label: "Projects Shipped" },
            { number: "15+", label: "Artworks Created" },
            { number: "∞", label: "Curiosity" },
          ].map((stat, i) => (
            <div data-reveal data-reveal-delay={String(i * 150)}>
              <div class="text-5xl md:text-7xl font-black tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-blue-400 mb-3">
                {stat.number}
              </div>
              <div class="text-xs font-bold uppercase tracking-[0.2em] text-gray-500">
                {stat.label}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Client / Collaboration Strip -->
    <section class="py-12 border-b border-white/5 bg-black/40">
      <div class="max-w-7xl mx-auto px-6">
        <div
          class="flex flex-wrap items-center justify-center md:justify-between gap-12 opacity-30 grayscale hover:grayscale-0 transition-all duration-700"
        >
          {
            [
              "TechFlow",
              "Artify",
              "CreativeLabs",
              "NebulaJS",
              "PixelPerfect",
            ].map((client) => (
              <span class="text-xl font-black tracking-tighter text-white uppercase italic">
                {client}
              </span>
            ))
          }
        </div>
      </div>
    </section>

    <!-- The Philosophy / Process -->
    <section class="py-32 px-6">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-24 items-center">
          <div data-reveal="left">
            <span
              class="text-pink-500 font-bold uppercase tracking-[0.3em] text-xs mb-4 block"
              >Mindset</span
            >
            <h2
              class="text-5xl md:text-7xl font-black tracking-tighter mb-10 leading-tight"
            >
              WHERE RIGOR <br />MEETS MAGIC.
            </h2>
            <p class="text-xl text-gray-400 mb-8 leading-relaxed">
              I believe that great software is like great art: it requires both
              technical discipline and creative intuition. My process is a loop
              of exploration and optimization.
            </p>
            <div class="space-y-6">
              {
                [
                  {
                    title: "Research & Sketch",
                    desc: "Understanding the problem and sketching technical and visual architectures.",
                  },
                  {
                    title: "Code & Compose",
                    desc: "Building robust logic while maintaining a high standard for visual fidelity.",
                  },
                  {
                    title: "Refine & Polish",
                    desc: "Obsessing over the details—from core performance metrics to micro-animations.",
                  },
                ].map((step, i) => (
                  <div class="flex gap-6">
                    <div class="flex-shrink-0 w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center font-bold text-gray-500">
                      {i + 1}
                    </div>
                    <div>
                      <h4 class="text-lg font-bold text-white mb-1">
                        {step.title}
                      </h4>
                      <p class="text-gray-500 text-sm">{step.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
          <div data-reveal="right" data-reveal-delay="200" class="relative aspect-square rounded-[60px] overflow-hidden">
            <div
              class="absolute inset-0 bg-gradient-to-tr from-purple-600/20 to-blue-600/20 animate-pulse"
            >
            </div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div
                class="w-2/3 h-2/3 border-2 border-white/5 rounded-full animate-spin-slow"
              >
              </div>
              <div
                class="absolute w-1/2 h-1/2 border-2 border-white/10 rounded-full animate-reverse-spin"
              >
              </div>
              <div
                class="absolute w-20 h-20 bg-white/10 backdrop-blur-3xl rounded-3xl border border-white/20 flex items-center justify-center"
              >
                <svg
                  class="w-10 h-10 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  ><path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                  ></path></svg
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Selected Work -->
    <section id="work" class="py-32 bg-[#080808]">
      <div class="max-w-7xl mx-auto px-6">
        <div
          data-reveal
          class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-8"
        >
          <div>
            <span
              class="text-purple-500 font-bold uppercase tracking-[0.3em] text-xs mb-4 block"
              >Portfolio</span
            >
            <h2 class="text-5xl md:text-7xl font-black tracking-tighter">
              SELECTED WORK
            </h2>
          </div>
          <a
            href="#"
            class="text-sm font-bold uppercase tracking-widest text-gray-400 hover:text-white transition-colors flex items-center gap-2 group"
          >
            View All Projects
            <svg
              class="w-4 h-4 transform group-hover:translate-x-2 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              ><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
            >
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {
            [
              {
                title: "Memoir Me",
                desc: "An encrypted diary app with geolocation markers, BLoC architecture, and end-to-end privacy. Built for iOS & Android.",
                tags: ["Flutter", "Dart", "PostgreSQL"],
                image:
                  "https://images.unsplash.com/photo-1512941937669-90a1b58e7e9c?auto=format&fit=crop&q=80&w=800",
              },
              {
                title: "Luci Studio",
                desc: "This portfolio — a blazing-fast static site combining engineering precision with artistic identity, deployed on Cloudflare Workers.",
                tags: ["Astro", "Tailwind CSS", "Cloudflare"],
                image:
                  "https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&q=80&w=800",
              },
            ].map((project, i) => (
              <div data-reveal="scale" data-reveal-delay={String(i * 200)} class="group relative aspect-[4/3] rounded-[40px] overflow-hidden border border-white/10 hover:border-purple-500/30 transition-all duration-500">
                <img
                  src={project.image}
                  alt={project.title}
                  class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover:opacity-20 transition-opacity duration-500"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-80 group-hover:opacity-95 transition-opacity" />
                <div class="absolute bottom-0 left-0 p-10 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                  <h3 class="text-3xl font-black mb-3">{project.title}</h3>
                  <p class="text-gray-400 mb-6 max-w-sm leading-relaxed">
                    {project.desc}
                  </p>
                  <div class="flex flex-wrap gap-3">
                    {project.tags.map((tag) => (
                      <span class="text-xs font-bold uppercase tracking-widest px-3 py-1 bg-white/10 border border-white/10 rounded-full">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Art Gallery Section -->
    <section id="art" class="py-32 px-6 bg-[#050505]">
      <div class="max-w-7xl mx-auto">
        <div
          class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-8"
        >
          <div>
            <span
              class="text-blue-500 font-bold uppercase tracking-[0.3em] text-xs mb-4 block"
              >Creative Works</span
            >
            <h2 class="text-5xl md:text-7xl font-black tracking-tighter">
              THE ART.
            </h2>
          </div>
          <p class="text-gray-400 max-w-sm leading-relaxed">
            Where code meets canvas. Each piece is an experiment at the
            intersection of mathematics, color theory, and human emotion.
          </p>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {
            [
              {
                span: "md:col-span-2 md:row-span-2",
                image:
                  "https://images.unsplash.com/photo-1633356122544-f134324a6cee?auto=format&fit=crop&q=80&w=1200",
                label: "Neon Currents",
                year: "2024",
              },
              {
                span: "",
                image:
                  "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&q=80&w=800",
                label: "Deep Space",
                year: "2024",
              },
              {
                span: "",
                image:
                  "https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?auto=format&fit=crop&q=80&w=800",
                label: "Bloom",
                year: "2024",
              },
              {
                span: "",
                image:
                  "https://images.unsplash.com/photo-1614850523296-d8c1af93d400?auto=format&fit=crop&q=80&w=800",
                label: "Ember",
                year: "2023",
              },
              {
                span: "",
                image:
                  "https://images.unsplash.com/photo-1550684848-fac1c5b4e853?auto=format&fit=crop&q=80&w=800",
                label: "Circuit",
                year: "2023",
              },
            ].map((art, i) => (
              <div
                data-reveal="scale"
                data-reveal-delay={String(i * 100)}
                class={`group relative ${art.span} aspect-square rounded-3xl overflow-hidden cursor-pointer`}
              >
                <img
                  src={art.image}
                  alt={art.label}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                />
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-all duration-500 flex items-end p-6">
                  <div>
                    <p class="text-white font-bold text-lg">{art.label}</p>
                    <p class="text-gray-400 text-xs uppercase tracking-widest">
                      {art.year} · Digital Art
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="py-32 px-6 bg-[#080808]">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-20">
          <span
            class="text-purple-500 font-bold uppercase tracking-[0.3em] text-xs mb-4 block"
            >Toolkit</span
          >
          <h2 class="text-5xl md:text-7xl font-black tracking-tighter">
            BUILT WITH.
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            [
              {
                category: "Frontend",
                color: "purple",
                tools: [
