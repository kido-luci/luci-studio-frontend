---
import Layout from "../layouts/Layout.astro";

const rawBaseUrl = (import.meta.env.PUBLIC_API_URL as string | undefined) || '';
const API_BASE = rawBaseUrl.endsWith('/') ? rawBaseUrl.slice(0, -1) : rawBaseUrl;
const CHAT_ENDPOINT = `${API_BASE}/chat`;
---

<Layout
	title="Kido · Luci Studio"
	description="Chat with Kido — Luci Studio's AI assistant. Ask anything."
	hideChatFab={true}
>
	<div id="chat-page" data-endpoint={CHAT_ENDPOINT} style="display:flex;flex-direction:column;min-height:100vh;padding-top:0;position:relative;z-index:0;">

		<!-- Header -->
		<header style="
			display:flex;align-items:center;justify-content:space-between;
			padding:1rem 1.5rem;
			border-bottom:1px solid var(--border-color);
			background:var(--nav-bg-scroll);
			backdrop-filter:blur(12px);
			-webkit-backdrop-filter:blur(12px);
			position:sticky;top:0;z-index:100;
		">
			<a href="/" style="
				display:flex;align-items:center;gap:0.65rem;
				text-decoration:none;color:var(--text-primary);
			">
				<img src="/images/logo_icon.png" alt="Luci Studio" style="width:36px;height:36px;border-radius:10px;" />
				<span style="font-size:1rem;font-weight:900;letter-spacing:0em;line-height:1;">
					LUCI <span class="text-shimmer">STUDIO</span><span style="color:#8b5cf6;">.</span>
				</span>
			</a>
			<div style="display:flex;align-items:center;gap:0.5rem;">
				<button
					id="chat-theme-toggle"
					onclick="window.toggleTheme && window.toggleTheme()"
					aria-label="Toggle theme"
					style="
						width:34px;height:34px;
						display:flex;align-items:center;justify-content:center;
						border-radius:8px;border:1px solid var(--border-color);
						background:transparent;color:var(--text-secondary);
						cursor:pointer;transition:color 150ms ease,border-color 150ms ease;
					"
					onmouseover="this.style.color='var(--text-primary)';this.style.borderColor='rgba(139,92,246,0.4)'"
					onmouseout="this.style.color='var(--text-secondary)';this.style.borderColor='var(--border-color)'"
				>
					<!-- Moon: shown in dark mode -->
					<svg id="chat-icon-dark" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
					</svg>
					<!-- Sun: shown in light mode -->
					<svg id="chat-icon-light" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
						<circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
					</svg>
				</button>

				<button id="chat-clear" style="
					font-size:0.72rem;padding:0.3rem 0.65rem;
					border-radius:8px;border:1px solid var(--border-color);
					background:transparent;color:var(--text-secondary);
					cursor:pointer;transition:color 150ms ease,border-color 150ms ease;
					font-family:inherit;
				" onmouseover="this.style.color='var(--text-primary)';this.style.borderColor='rgba(139,92,246,0.4)'" onmouseout="this.style.color='var(--text-secondary)';this.style.borderColor='var(--border-color)'">
					Clear
				</button>
			</div>
		</header>

		<!-- Config panel -->
		<aside id="config-panel" aria-label="AI configuration" style="
			position:fixed;top:0;left:0;height:100vh;width:272px;
			background:var(--bg-card);
			backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
			border-right:1px solid var(--border-color);
			z-index:95;
			display:flex;flex-direction:column;
			overflow:visible;
		">
			<div style="padding:1.25rem 1.1rem 0.5rem;border-bottom:1px solid var(--border-color);display:flex;align-items:center;justify-content:space-between;">
				<span style="font-size:0.78rem;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-secondary);">Config</span>
				<button id="config-reset" style="
					font-size:0.7rem;padding:0.2rem 0.5rem;border-radius:6px;
					border:1px solid var(--border-color);background:transparent;
					color:var(--text-secondary);cursor:pointer;font-family:inherit;
					transition:color 150ms,border-color 150ms;
				" onmouseover="this.style.color='var(--text-primary)';this.style.borderColor='rgba(139,92,246,0.4)'" onmouseout="this.style.color='var(--text-secondary)';this.style.borderColor='var(--border-color)'">Reset</button>
			</div>

			<div style="padding:1rem 1.1rem;display:flex;flex-direction:column;gap:1.4rem;flex:1;overflow-y:auto;overflow-x:visible;">

				<!-- Model -->
				<div class="cfg-group">
					<div class="cfg-label-row">
						<label class="cfg-label" for="cfg-model">
							Model
							<span class="cfg-info" data-tip="The language model used to generate responses. Larger models are more capable; smaller ones are faster.">
								<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
							</span>
						</label>
					</div>
					<select id="cfg-model" class="cfg-select">
						<option value="llama-3.3-70b-versatile">Llama 3.3 70B</option>
						<option value="llama-3.1-70b-versatile">Llama 3.1 70B</option>
						<option value="llama-3.1-8b-instant">Llama 3.1 8B (fast)</option>
						<option value="mixtral-8x7b-32768">Mixtral 8x7B</option>
						<option value="gemma2-9b-it">Gemma 2 9B</option>
					</select>
				</div>

				<!-- Temperature -->
				<div class="cfg-group">
					<div class="cfg-label-row">
						<label class="cfg-label" for="cfg-temperature">
							Temperature
							<span class="cfg-info" data-tip="Controls randomness. 0 = deterministic and focused. 2 = highly creative and unpredictable. Keep between 0.5–1.0 for most tasks.">
								<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
							</span>
						</label>
						<span id="cfg-temperature-val" class="cfg-val">0.7</span>
					</div>
					<input id="cfg-temperature" type="range" min="0" max="2" step="0.05" value="0.7" class="cfg-range" />
				</div>

				<!-- Max Tokens -->
				<div class="cfg-group">
					<div class="cfg-label-row">
						<label class="cfg-label" for="cfg-max-tokens">
							Max Tokens
							<span class="cfg-info" data-tip="Maximum number of tokens the model can generate in a single response. One token ≈ 0.75 words.">
								<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
							</span>
						</label>
						<span id="cfg-max-tokens-val" class="cfg-val">1024</span>
					</div>
					<input id="cfg-max-tokens" type="range" min="64" max="4096" step="64" value="1024" class="cfg-range" />
				</div>

				<!-- Top P -->
				<div class="cfg-group">
					<div class="cfg-label-row">
						<label class="cfg-label" for="cfg-top-p">
							Top P
							<span class="cfg-info" data-tip="Nucleus sampling. The model considers only the top P% most likely tokens. Lower values make output more focused. Recommended: keep at 1.0 when tuning Temperature.">
								<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
							</span>
						</label>
						<span id="cfg-top-p-val" class="cfg-val">1.0</span>
					</div>
					<input id="cfg-top-p" type="range" min="0" max="1" step="0.05" value="1.0" class="cfg-range" />
				</div>

				<!-- Frequency Penalty -->
				<div class="cfg-group">
					<div class="cfg-label-row">
						<label class="cfg-label" for="cfg-freq-pen">
							Freq. Penalty
							<span class="cfg-info" data-tip="Penalises tokens that have already appeared often in the output. Positive values reduce repetition. Range: -2 to 2.">
								<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
							</span>
						</label>
						<span id="cfg-freq-pen-val" class="cfg-val">0</span>
					</div>
					<input id="cfg-freq-pen" type="range" min="-2" max="2" step="0.1" value="0" class="cfg-range" />
				</div>

				<!-- Presence Penalty -->
				<div class="cfg-group">
					<div class="cfg-label-row">
						<label class="cfg-label" for="cfg-pres-pen">
							Pres. Penalty
							<span class="cfg-info" data-tip="Penalises tokens that have appeared at all so far, encouraging the model to explore new topics. Range: -2 to 2.">
								<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
							</span>
						</label>
						<span id="cfg-pres-pen-val" class="cfg-val">0</span>
					</div>
					<input id="cfg-pres-pen" type="range" min="-2" max="2" step="0.1" value="0" class="cfg-range" />
				</div>

			</div>
		</aside>

		<!-- Messages -->
		<div id="chat-messages" role="log" aria-live="polite" style="
			flex:1 1 auto;
			overflow-y:auto;
			padding:1.5rem clamp(1rem, 3vw, 2rem) 12rem;
			display:flex;flex-direction:column;gap:0.85rem;
			max-width:760px;
			margin-left:calc(272px + max(1rem, (100vw - 272px - 760px) / 2));
			margin-right:auto;
			box-sizing:border-box;
		">
			<div class="msg msg-assistant">
				<div class="msg-bubble">
					Hi there! I'm Kido, your AI assistant at Luci Studio. I'm here to help with whatever you need — whether that's writing or debugging code, explaining system design, answering general knowledge questions, helping with creative writing, solving math problems, or just having a thoughtful conversation. There's no topic off-limits. What's on your mind?
				</div>
			</div>
		</div>

		<!-- Floating input -->
		<form id="chat-form" autocomplete="off" style="
			position:fixed;bottom:2rem;
			left:272px;right:0;margin:0 auto;
			width:min(680px, calc(100vw - 272px - 2rem));
			background:var(--bg-card);
			backdrop-filter:blur(16px);
			-webkit-backdrop-filter:blur(16px);
			border:1px solid rgba(139,92,246,0.35);
			border-radius:16px;
			box-shadow:0 8px 40px rgba(0,0,0,0.3),0 0 0 1px rgba(139,92,246,0.08),0 1px 0 rgba(255,255,255,0.05) inset;
			transition:border-color 200ms ease,box-shadow 200ms ease;
			z-index:50;
		">
			<textarea
				id="chat-input"
				rows="2"
				placeholder="Ask me anything…"
				maxlength="4000"
				aria-label="Message"
				style="
					display:block;width:100%;resize:none;max-height:240px;
					padding:0.95rem 1.1rem 0.5rem 1.1rem;
					border-radius:16px 16px 0 0;
					border:none;
					background:transparent;
					color:var(--text-primary);
					font-family:inherit;font-size:0.93rem;line-height:1.5;
					outline:none;box-sizing:border-box;
				"
			></textarea>
			<div style="
				display:flex;align-items:center;justify-content:space-between;
				padding:0.4rem 0.6rem 0.5rem 0.75rem;
				border-top:1px solid rgba(139,92,246,0.12);
			">
				<div style="position:relative;display:inline-flex;align-items:center;">
				<svg style="position:absolute;left:0;pointer-events:none;color:var(--text-secondary);" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
				<select id="cfg-model-bar" aria-label="Model" style="
					-webkit-appearance:none;-moz-appearance:none;appearance:none;
					background:transparent;
					border:none;outline:none;
					color:var(--text-secondary);
					font-family:inherit;font-size:0.75rem;
					cursor:pointer;
					padding:0.15rem 0.1rem 0.15rem 1.1rem;
					border-radius:6px;
					transition:color 150ms ease;
					width:auto;
				">
					<option value="llama-3.3-70b-versatile">Llama 3.3 70B</option>
					<option value="llama-3.1-70b-versatile">Llama 3.1 70B</option>
					<option value="llama-3.1-8b-instant">Llama 3.1 8B (fast)</option>
					<option value="mixtral-8x7b-32768">Mixtral 8x7B</option>
					<option value="gemma2-9b-it">Gemma 2 9B</option>
				</select>
			</div>
				<button type="submit" id="chat-send" aria-label="Send" style="
					width:36px;height:36px;
					border-radius:10px;
					border:1px solid rgba(139,92,246,0.4);
					background:linear-gradient(135deg,rgba(139,92,246,0.95),rgba(99,102,241,0.95));
					color:#fff;display:flex;align-items:center;justify-content:center;
					cursor:pointer;transition:opacity 150ms ease,transform 150ms ease;
					flex-shrink:0;
				">
					<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
						<path fill="currentColor" d="M3.4 20.4 21 12 3.4 3.6c-.6-.3-1.4.3-1.2 1L4 11l11 1-11 1-1.8 6.4c-.2.7.6 1.3 1.2 1Z"/>
					</svg>
				</button>
			</div>
		</form>
	</div>
	<div id="cfg-tooltip" role="tooltip"></div>
</Layout>

<style is:global>
	.msg { display:flex; }
	.msg-user { justify-content:flex-end; }
	.msg-assistant { justify-content:flex-start; }

	.msg-bubble {
		max-width:min(78%, 580px);
		padding:0.65rem 0.95rem;
		border-radius:16px;
		font-size:0.92rem;
		line-height:1.55;
		white-space:pre-wrap;
		word-wrap:break-word;
	}
	.msg-assistant .msg-bubble {
		background: var(--bg-card);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border: 1px solid var(--border-color);
		border-bottom-left-radius: 4px;
	}
	.msg-user .msg-bubble {
		background: linear-gradient(135deg, rgba(139,92,246,0.92), rgba(99,102,241,0.92));
		color: #fff;
		border-bottom-right-radius: 4px;
	}
	.msg-bubble code {
		background:rgba(0,0,0,0.35);
		padding:0.1em 0.35em;
		border-radius:4px;
		font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
		font-size:0.84em;
	}
	.msg-bubble pre {
		background:rgba(0,0,0,0.4);
		border:1px solid rgba(255,255,255,0.06);
		border-radius:8px;
		padding:0.75rem 1rem;
		overflow-x:auto;
		font-size:0.84em;
		margin:0.4em 0;
	}
	.msg-bubble pre code { background:none;padding:0; }
	.msg-bubble a {
		color:rgba(167,139,250,1);
		text-decoration:underline;
		text-underline-offset:2px;
	}
	.msg-bubble strong { color:inherit; }

	body.light-mode .msg-assistant .msg-bubble {
		background: rgba(255,255,255,0.88);
	}
	body.light-mode .msg-bubble pre {
		background: rgba(0,0,0,0.06);
		border-color: rgba(0,0,0,0.1);
	}

	.luci-typing {
		display:inline-flex;gap:5px;align-items:center;padding:2px 0;
	}
	.luci-typing span {
		width:7px;height:7px;border-radius:9999px;
		background:var(--text-secondary);opacity:0.4;
		animation:luci-dot 1.2s infinite ease-in-out;
	}
	.luci-typing span:nth-child(2){animation-delay:0.15s;}
	.luci-typing span:nth-child(3){animation-delay:0.3s;}
	@keyframes luci-dot {
		0%,80%,100%{transform:translateY(0);opacity:0.4;}
		40%{transform:translateY(-5px);opacity:1;}
	}

	#chat-input:focus {
		border-color:rgba(139,92,246,0.55) !important;
		background:rgba(255,255,255,0.06) !important;
	}
	#chat-send:hover { transform:scale(1.06); }
	#chat-send:disabled { opacity:0.45;cursor:not-allowed;transform:none !important; }
	#chat-form:focus-within {
		border-color:rgba(139,92,246,0.65);
		box-shadow:0 8px 40px rgba(0,0,0,0.3),0 0 0 3px rgba(139,92,246,0.12),0 1px 0 rgba(255,255,255,0.05) inset;
	}

	body.light-mode #chat-input {
		color:rgb(17,24,39) !important;
	}
	body.light-mode #chat-form {
		border-color:rgba(139,92,246,0.4);
		box-shadow:0 8px 40px rgba(0,0,0,0.12),0 0 0 1px rgba(139,92,246,0.1),0 1px 0 rgba(255,255,255,0.8) inset;
	}
	#cfg-model-bar option { background:var(--bg-card); color:var(--text-primary); }

	body.light-mode #chat-form:focus-within {
		border-color:rgba(139,92,246,0.7);
		box-shadow:0 8px 40px rgba(0,0,0,0.12),0 0 0 3px rgba(139,92,246,0.15),0 1px 0 rgba(255,255,255,0.8) inset;
	}

	/* Config panel */
	.cfg-group { display:flex;flex-direction:column;gap:0.4rem; }
	.cfg-label-row { display:flex;align-items:center;justify-content:space-between; }
	.cfg-label {
		font-size:0.78rem;font-weight:600;color:var(--text-primary);
		display:flex;align-items:center;gap:0.3rem;
	}
	.cfg-info {
		display:inline-flex;align-items:center;justify-content:center;
		color:var(--text-tertiary);cursor:default;flex-shrink:0;
		transition:color 150ms ease;
	}
	.cfg-info:hover { color:rgba(139,92,246,0.8); }
	#cfg-tooltip {
		position:fixed;
		width:200px;
		background:rgba(15,15,20,0.97);
		color:#e5e7eb;
		font-size:0.7rem;font-weight:400;
		line-height:1.45;
		padding:0.4rem 0.6rem;
		border-radius:7px;
		border:1px solid rgba(255,255,255,0.08);
		box-shadow:0 4px 16px rgba(0,0,0,0.4);
		pointer-events:none;
		white-space:normal;text-align:left;
		z-index:9999;
		opacity:0;visibility:hidden;
		transition:opacity 120ms ease,visibility 120ms ease;
	}
	#cfg-tooltip.visible { opacity:1;visibility:visible; }
	body.light-mode #cfg-tooltip {
		background:rgba(25,25,35,0.97);
		border-color:rgba(0,0,0,0.18);
	}
	.cfg-val {
		font-size:0.72rem;font-weight:600;
		color:rgba(139,92,246,0.9);
		background:rgba(139,92,246,0.1);
		border-radius:4px;padding:0.1em 0.4em;
		min-width:2.5rem;text-align:center;
	}
	.cfg-hint { font-size:0.7rem;color:var(--text-tertiary);line-height:1.3; }

	.cfg-select {
		width:100%;padding:0.45rem 0.65rem;
		border-radius:8px;
		border:1px solid var(--border-color);
		background:rgba(255,255,255,0.03);
		color:var(--text-primary);
		font-family:inherit;font-size:0.82rem;
		outline:none;cursor:pointer;
		transition:border-color 150ms ease;
	}
	.cfg-select:focus { border-color:rgba(139,92,246,0.5); }

	.cfg-range {
		width:100%;height:4px;
		-webkit-appearance:none;appearance:none;
		background:rgba(255,255,255,0.1);
		border-radius:9999px;outline:none;cursor:pointer;
		accent-color:rgba(139,92,246,0.9);
	}
	.cfg-range::-webkit-slider-thumb {
		-webkit-appearance:none;appearance:none;
		width:14px;height:14px;border-radius:9999px;
		background:rgba(139,92,246,0.95);
		border:2px solid rgba(139,92,246,0.4);
		cursor:pointer;
	}
	.cfg-range::-moz-range-thumb {
		width:14px;height:14px;border-radius:9999px;
		background:rgba(139,92,246,0.95);
		border:2px solid rgba(139,92,246,0.4);
		cursor:pointer;
	}

	body.light-mode .cfg-select {
		background:rgba(0,0,0,0.03);
	}
	body.light-mode .cfg-range {
		background:rgba(0,0,0,0.12);
	}
</style>

<script is:inline>
	(() => {
		// ── Info tooltips ─────────────────────────────────────────────────────────
		const tooltip = document.getElementById('cfg-tooltip');
		document.querySelectorAll('.cfg-info').forEach(el => {
			el.addEventListener('mouseenter', () => {
				const tip = el.dataset.tip;
				if (!tip || !tooltip) return;
				tooltip.textContent = tip;
				const r = el.getBoundingClientRect();
				const left = r.right + 8;
				let top = r.top + r.height / 2 - tooltip.offsetHeight / 2;
				// clamp within viewport vertically
				const margin = 8;
				top = Math.max(margin, Math.min(top, window.innerHeight - tooltip.offsetHeight - margin));
				tooltip.style.left = left + 'px';
				tooltip.style.top = top + 'px';
				tooltip.classList.add('visible');
			});
			el.addEventListener('mouseleave', () => tooltip && tooltip.classList.remove('visible'));
		});
	})();

	(() => {
		const page = document.getElementById('chat-page');
		if (!page) return;
		const ENDPOINT = page.dataset.endpoint || '/chat';

		const syncThemeIcon = () => {
			const isLight = document.body.classList.contains('light-mode');
			document.getElementById('chat-icon-dark').style.display = isLight ? 'none' : '';
			document.getElementById('chat-icon-light').style.display = isLight ? '' : 'none';
		};
		syncThemeIcon();
		document.getElementById('chat-theme-toggle').addEventListener('click', () => {
			requestAnimationFrame(syncThemeIcon);
		});

		const messagesEl = document.getElementById('chat-messages');
		const form = document.getElementById('chat-form');
		const input = document.getElementById('chat-input');
		const sendBtn = document.getElementById('chat-send');
		const clearBtn = document.getElementById('chat-clear');

		// ── Config panel ──────────────────────────────────────────────────────────
		const configReset = document.getElementById('config-reset');

		// Live value display for each range input
		const sliders = [
			{ id: 'cfg-temperature', valId: 'cfg-temperature-val', decimals: 2 },
			{ id: 'cfg-max-tokens',  valId: 'cfg-max-tokens-val',  decimals: 0 },
			{ id: 'cfg-top-p',       valId: 'cfg-top-p-val',       decimals: 2 },
			{ id: 'cfg-freq-pen',    valId: 'cfg-freq-pen-val',    decimals: 1 },
			{ id: 'cfg-pres-pen',    valId: 'cfg-pres-pen-val',    decimals: 1 },
		];
		sliders.forEach(({ id, valId, decimals }) => {
			const el = document.getElementById(id);
			const display = document.getElementById(valId);
			el.addEventListener('input', () => { display.textContent = parseFloat(el.value).toFixed(decimals); });
		});

		// Keep panel model select and bar model select in sync
		const modelPanel = document.getElementById('cfg-model');
		const modelBar   = document.getElementById('cfg-model-bar');
		modelPanel.addEventListener('change', () => { modelBar.value = modelPanel.value; });
		modelBar.addEventListener('change',   () => { modelPanel.value = modelBar.value; });

		const DEFAULTS = { temperature:'0.7', maxTokens:'1024', topP:'1.0', freqPen:'0', presPen:'0', model:'llama-3.3-70b-versatile' };
		configReset.addEventListener('click', () => {
			document.getElementById('cfg-temperature').value = DEFAULTS.temperature;
			document.getElementById('cfg-temperature-val').textContent = DEFAULTS.temperature;
			document.getElementById('cfg-max-tokens').value = DEFAULTS.maxTokens;
			document.getElementById('cfg-max-tokens-val').textContent = DEFAULTS.maxTokens;
			document.getElementById('cfg-top-p').value = DEFAULTS.topP;
			document.getElementById('cfg-top-p-val').textContent = DEFAULTS.topP;
			document.getElementById('cfg-freq-pen').value = DEFAULTS.freqPen;
			document.getElementById('cfg-freq-pen-val').textContent = DEFAULTS.freqPen;
			document.getElementById('cfg-pres-pen').value = DEFAULTS.presPen;
			document.getElementById('cfg-pres-pen-val').textContent = DEFAULTS.presPen;
			modelPanel.value = DEFAULTS.model;
			modelBar.value   = DEFAULTS.model;
		});

		const getConfig = () => ({
			model:             modelBar.value,
			temperature:       parseFloat(document.getElementById('cfg-temperature').value),
			max_tokens:        parseInt(document.getElementById('cfg-max-tokens').value, 10),
			top_p:             parseFloat(document.getElementById('cfg-top-p').value),
			frequency_penalty: parseFloat(document.getElementById('cfg-freq-pen').value),
			presence_penalty:  parseFloat(document.getElementById('cfg-pres-pen').value),
		});

		const STORAGE_KEY = 'luci-chat-history-v1';
		let history = [];
		let streaming = false;

		const esc = (s) => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

		const md = (text) => {
			const e = esc(text);
			return e
				.replace(/```([\s\S]*?)```/g, (_,c) => `<pre><code>${c.trim()}</code></pre>`)
				.replace(/`([^`]+)`/g, '<code>$1</code>')
				.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
				.replace(/\*([^*]+)\*/g, '<em>$1</em>')
				.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
		};

		const scrollBottom = () => requestAnimationFrame(() => {
			messagesEl.scrollTop = messagesEl.scrollHeight;
		});

		const appendMsg = (role, text) => {
			const wrap = document.createElement('div');
			wrap.className = `msg msg-${role}`;
			const bubble = document.createElement('div');
			bubble.className = 'msg-bubble';
			bubble.innerHTML = role === 'assistant' ? md(text) : esc(text);
			wrap.appendChild(bubble);
			messagesEl.appendChild(wrap);
			scrollBottom();
			return bubble;
		};

		const showTyping = () => {
			const wrap = document.createElement('div');
			wrap.className = 'msg msg-assistant';
			wrap.dataset.typing = '1';
			const bubble = document.createElement('div');
			bubble.className = 'msg-bubble';
			bubble.innerHTML = '<span class="luci-typing"><span></span><span></span><span></span></span>';
			wrap.appendChild(bubble);
			messagesEl.appendChild(wrap);
			scrollBottom();
			return wrap;
		};

		const loadHistory = () => {
			try {
				const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
				if (!Array.isArray(parsed)) return;
				history = parsed.filter(m => m && (m.role==='user'||m.role==='assistant') && typeof m.content==='string');
				history.forEach(m => appendMsg(m.role, m.content));
			} catch {}
		};

		const saveHistory = () => {
			try { localStorage.setItem(STORAGE_KEY, JSON.stringify(history.slice(-20))); } catch {}
		};

		const autosize = () => {
			input.style.height = 'auto';
			input.style.height = Math.min(input.scrollHeight, 240) + 'px';
		};

		input.addEventListener('input', autosize);
		input.addEventListener('keydown', e => {
			if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
		});

		clearBtn.addEventListener('click', () => {
			if (streaming) return;
			history = [];
			messagesEl.innerHTML = '';
			appendMsg('assistant', "Conversation cleared! Fresh start — what would you like to talk about? I'm ready to help with code, writing, questions, or anything else on your mind.");
			saveHistory();
		});

		const send = async (text) => {
			if (streaming) return;
			streaming = true;
			sendBtn.disabled = true;

			history.push({ role: 'user', content: text });
			saveHistory();
			appendMsg('user', text);

			const typingEl = showTyping();
			let bubble = null;
			let acc = '';

			try {
				const res = await fetch(ENDPOINT, {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ messages: history, ...getConfig() }),
				});

				if (!res.ok || !res.body) {
					let msg = 'Something went wrong. Try again.';
					try { const d = await res.json(); if (d?.error) msg = d.error; } catch {}
					typingEl.remove();
					appendMsg('assistant', msg);
					return;
				}

				const reader = res.body.getReader();
				const dec = new TextDecoder();
				while (true) {
					const { value, done } = await reader.read();
					if (done) break;
					const chunk = dec.decode(value, { stream: true });
					if (!chunk) continue;
					if (!bubble) { typingEl.remove(); bubble = appendMsg('assistant', ''); }
					acc += chunk;
					bubble.innerHTML = md(acc);
					scrollBottom();
				}

				if (!bubble) { typingEl.remove(); appendMsg('assistant', '(no response)'); }
				else if (acc.trim()) { history.push({ role: 'assistant', content: acc }); saveHistory(); }
			} catch (err) {
				typingEl.remove();
				appendMsg('assistant', `Network error: ${err?.message || 'unknown'}`);
			} finally {
				streaming = false;
				sendBtn.disabled = false;
				input.focus();
			}
		};

		form.addEventListener('submit', e => {
			e.preventDefault();
			const text = input.value.trim();
			if (!text || streaming) return;
			input.value = '';
			autosize();
			send(text);
		});

		loadHistory();
	})();
</script>
