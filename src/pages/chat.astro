<script is:inline>
	(() => {
		// ── Info tooltips ─────────────────────────────────────────────────────────
		const tooltip = document.getElementById('cfg-tooltip');
		document.querySelectorAll('.cfg-info').forEach(el => {
			el.addEventListener('mouseenter', () => {
				const tip = el.dataset.tip;
				if (!tip || !tooltip) return;
				tooltip.textContent = tip;
				const r = el.getBoundingClientRect();
				const left = r.right + 8;
				let top = r.top + r.height / 2 - tooltip.offsetHeight / 2;
				// clamp within viewport vertically
				const margin = 8;
				top = Math.max(margin, Math.min(top, window.innerHeight - tooltip.offsetHeight - margin));
				tooltip.style.left = left + 'px';
				tooltip.style.top = top + 'px';
				tooltip.classList.add('visible');
			});
			el.addEventListener('mouseleave', () => tooltip && tooltip.classList.remove('visible'));
		});
	})();

	(() => {
		const page = document.getElementById('chat-page');
		if (!page) return;
		const ENDPOINT = page.dataset.endpoint || '/chat';

		const syncThemeIcon = () => {
			const isLight = document.documentElement.classList.contains('light-mode');
			document.getElementById('chat-icon-dark').style.display = isLight ? 'none' : '';
			document.getElementById('chat-icon-light').style.display = isLight ? '' : 'none';
		};
		syncThemeIcon();
		document.getElementById('chat-theme-toggle').addEventListener('click', () => {
			requestAnimationFrame(syncThemeIcon);
		});

		const messagesEl = document.getElementById('chat-messages');
		const form = document.getElementById('chat-form');
		const input = document.getElementById('chat-input');
		const sendBtn = document.getElementById('chat-send');
		const clearBtn = document.getElementById('chat-clear');
		const totalTokensEl = document.getElementById('chat-total-tokens');

		// ── Config panel ──────────────────────────────────────────────────────────
		const configReset = document.getElementById('config-reset');

		// Live value display + purple fill track for each range input
		const trackEmpty = () => document.documentElement.classList.contains('light-mode')
			? 'rgba(0,0,0,0.12)' : 'rgba(255,255,255,0.1)';
		const updateTrack = (el) => {
			const pct = ((parseFloat(el.value) - parseFloat(el.min)) / (parseFloat(el.max) - parseFloat(el.min))) * 100;
			el.style.background = `linear-gradient(to right, rgba(139,92,246,0.9) ${pct}%, ${trackEmpty()} ${pct}%)`;
		};

		const sliders = [
			{ id: 'cfg-temperature', valId: 'cfg-temperature-val', decimals: 2 },
			{ id: 'cfg-max-tokens',  valId: 'cfg-max-tokens-val',  decimals: 0 },
			{ id: 'cfg-top-p',       valId: 'cfg-top-p-val',       decimals: 2 },
			{ id: 'cfg-freq-pen',    valId: 'cfg-freq-pen-val',    decimals: 1 },
			{ id: 'cfg-pres-pen',    valId: 'cfg-pres-pen-val',    decimals: 1 },
		];
		sliders.forEach(({ id, valId, decimals }) => {
			const el = document.getElementById(id);
			const display = document.getElementById(valId);
			updateTrack(el);
			el.addEventListener('input', () => {
				display.textContent = parseFloat(el.value).toFixed(decimals);
				updateTrack(el);
			});
		});

		// Keep panel model select and bar model select in sync
		const modelPanel = document.getElementById('cfg-model');
		const modelBar   = document.getElementById('cfg-model-bar');

		// Auto-size the chatbox model select to fit its currently-selected label
		// (default <select width:auto> sizes to longest option in Chrome/Safari)
		const sizeModelBar = () => {
			const opt = modelBar.options[modelBar.selectedIndex];
			if (!opt) return;
			const cs = getComputedStyle(modelBar);
			const m = document.createElement('span');
			m.style.cssText = `position:absolute;visibility:hidden;white-space:nowrap;font-family:${cs.fontFamily};font-size:${cs.fontSize};font-weight:${cs.fontWeight};letter-spacing:${cs.letterSpacing};`;
			m.textContent = opt.textContent;
			document.body.appendChild(m);
			const textW = m.offsetWidth;
			m.remove();
			// +20px buffer for left chevron padding + native dropdown spacing
			modelBar.style.width = Math.ceil(textW + 20) + 'px';
		};

		modelPanel.addEventListener('change', () => { modelBar.value = modelPanel.value; sizeModelBar(); });
		modelBar.addEventListener('change',   () => { modelPanel.value = modelBar.value; sizeModelBar(); });
		sizeModelBar();


		const DEFAULTS = { temperature:'0.7', maxTokens:'1024', topP:'1.0', freqPen:'0', presPen:'0', model:'llama-3.3-70b-versatile' };
		configReset.addEventListener('click', () => {
			document.getElementById('cfg-temperature').value = DEFAULTS.temperature;
			document.getElementById('cfg-temperature-val').textContent = DEFAULTS.temperature;
			document.getElementById('cfg-max-tokens').value = DEFAULTS.maxTokens;
			document.getElementById('cfg-max-tokens-val').textContent = DEFAULTS.maxTokens;
			document.getElementById('cfg-top-p').value = DEFAULTS.topP;
			document.getElementById('cfg-top-p-val').textContent = DEFAULTS.topP;
			document.getElementById('cfg-freq-pen').value = DEFAULTS.freqPen;
			document.getElementById('cfg-freq-pen-val').textContent = DEFAULTS.freqPen;
			document.getElementById('cfg-pres-pen').value = DEFAULTS.presPen;
			document.getElementById('cfg-pres-pen-val').textContent = DEFAULTS.presPen;
			modelPanel.value = DEFAULTS.model;
			modelBar.value   = DEFAULTS.model;
			sizeModelBar();
			sliders.forEach(({ id }) => updateTrack(document.getElementById(id)));
		});

		const getConfig = () => ({
			model:             modelBar.value,
			temperature:       parseFloat(document.getElementById('cfg-temperature').value),
			max_tokens:        parseInt(document.getElementById('cfg-max-tokens').value, 10),
			top_p:             parseFloat(document.getElementById('cfg-top-p').value),
			frequency_penalty: parseFloat(document.getElementById('cfg-freq-pen').value),
			presence_penalty:  parseFloat(document.getElementById('cfg-pres-pen').value),
		});

		const STORAGE_KEY = 'luci-chat-history-v1';
		let history = [];
		let streaming = false;

		const esc = (s) => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');

		const md = (text) => {
			const e = esc(text);
			return e
				.replace(/```(\w*)\n?([\s\S]*?)```/g, (_, lang, c) => {
					const cls = lang ? ` class="language-${lang}"` : '';
					return `<pre><code${cls}>${c.trim()}</code></pre>`;
				})
				.replace(/`([^`]+)`/g, '<code>$1</code>')
				.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
				.replace(/\*([^*]+)\*/g, '<em>$1</em>')
				.replace(/\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
		};

		const highlight = (el) => { if (window.Prism) Prism.highlightAllUnder(el); };

		const scrollBottom = () => requestAnimationFrame(() => {
			messagesEl.scrollTop = messagesEl.scrollHeight;
		});

		const makeCopyBtn = (getBubble) => {
			const btn = document.createElement('button');
			btn.className = 'msg-copy';
			btn.innerHTML = '<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Copy';
			btn.addEventListener('click', () => {
				const txt = getBubble().textContent || '';
				navigator.clipboard.writeText(txt).then(() => {
					btn.innerHTML = '<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>Copied';
					btn.classList.add('copied');
					setTimeout(() => {
						btn.innerHTML = '<svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Copy';
						btn.classList.remove('copied');
					}, 2000);
				});
			});
			return btn;
		};

		const estimateTokens = (t) => Math.max(1, Math.ceil(t.length / 4));

		const appendMsg = (role, text) => {
			const wrap = document.createElement('div');
			wrap.className = `msg msg-${role}`;
			const inner = document.createElement('div');
			inner.style.cssText = `display:flex;flex-direction:column;gap:0.3rem;align-items:${role === 'user' ? 'flex-end' : 'flex-start'};`;
			const bubble = document.createElement('div');
			bubble.className = 'msg-bubble';

			const content = document.createElement('div');
			content.className = 'msg-content';
			content.innerHTML = role === 'assistant' ? md(text) : esc(text);
			bubble.appendChild(content);

			const footer = document.createElement('div');
			footer.className = 'msg-footer';
			const tokenEl = document.createElement('span');
			tokenEl.className = 'msg-tokens';
			tokenEl.textContent = text ? `~${estimateTokens(text)} tokens` : '';
			footer.appendChild(makeCopyBtn(() => content));
			footer.appendChild(tokenEl);

			bubble.appendChild(footer);
			inner.appendChild(bubble);
			wrap.appendChild(inner);
			messagesEl.appendChild(wrap);
			if (role === 'assistant') highlight(content);
			scrollBottom();
			bubble._content = content;
			bubble._setTokens = (t) => { tokenEl.textContent = `~${estimateTokens(t)} tokens`; };
			return bubble;
		};

		const showTyping = () => {
			const wrap = document.createElement('div');
			wrap.className = 'msg msg-assistant';
			wrap.dataset.typing = '1';
			const bubble = document.createElement('div');
			bubble.className = 'msg-bubble';
			bubble.innerHTML = '<span class="luci-typing"><span></span><span></span><span></span></span>';
			wrap.appendChild(bubble);
			messagesEl.appendChild(wrap);
			scrollBottom();
			return wrap;
		};

		const loadHistory = () => {
			try {
				const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
				if (!Array.isArray(parsed)) return;
				history = parsed.filter(m => m && (m.role==='user'||m.role==='assistant') && typeof m.content==='string');
				history.forEach(m => appendMsg(m.role, m.content));
			} catch {}
		};

		const saveHistory = () => {
			try { localStorage.setItem(STORAGE_KEY, JSON.stringify(history.slice(-20))); } catch {}
			const total = history.reduce((s, m) => s + estimateTokens(m.content), 0);
			if (totalTokensEl) totalTokensEl.textContent = total > 0 ? `~${total} ctx tokens` : '';
		};

		const autosize = () => {
			input.style.height = 'auto';
			input.style.height = Math.min(input.scrollHeight, 240) + 'px';
		};

		input.addEventListener('input', autosize);
		input.addEventListener('keydown', e => {
			if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
		});

		const clearModal = document.getElementById('clear-confirm');
		const clearCancel = document.getElementById('clear-cancel');
		const clearYes = document.getElementById('clear-confirm-yes');

		const openClearModal = () => { clearModal.style.display = 'flex'; };
		const closeClearModal = () => { clearModal.style.display = 'none'; };

		clearBtn.addEventListener('click', () => {
			if (streaming) return;
			openClearModal();
		});
		clearCancel.addEventListener('click', closeClearModal);
		clearModal.addEventListener('click', (e) => { if (e.target === clearModal) closeClearModal(); });
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && clearModal.style.display === 'flex') closeClearModal();
		});
		clearYes.addEventListener('click', () => {
			closeClearModal();
			history = [];
			messagesEl.innerHTML = '';
			appendMsg('assistant', "Conversation cleared! Fresh start — what would you like to talk about? I'm ready to help with code, writing, questions, or anything else on your mind.");
			saveHistory();
		});

		const send = async (text) => {
			if (streaming) return;
			streaming = true;
			sendBtn.disabled = true;

			history.push({ role: 'user', content: text });
			saveHistory();
			appendMsg('user', text);

			const typingEl = showTyping();
			let bubble = null;
			let acc = '';

			try {
				const tok = localStorage.getItem('user_token');
				const res = await fetch(ENDPOINT, {
					method: 'POST',
					headers: {
						'content-type': 'application/json',
						...(tok ? { 'Authorization': `Bearer ${tok}` } : {}),
					},
					body: JSON.stringify({ messages: history, ...getConfig() }),
				});

				if (!res.ok || !res.body) {
					let msg = 'Something went wrong. Try again.';
					try { const d = await res.json(); if (d?.error) msg = d.error; } catch {}
					typingEl.remove();
					appendMsg('assistant', msg);
					return;
				}

				const reader = res.body.getReader();
				const dec = new TextDecoder();
				while (true) {
					const { value, done } = await reader.read();
					if (done) break;
					const chunk = dec.decode(value, { stream: true });
					if (!chunk) continue;
					if (!bubble) { typingEl.remove(); bubble = appendMsg('assistant', ''); }
					acc += chunk;
					bubble._content.innerHTML = md(acc);
					scrollBottom();
				}

				if (!bubble) { typingEl.remove(); appendMsg('assistant', 'No response received. The selected model may be unavailable — try switching to a different model.'); }
				else if (acc.trim()) { highlight(bubble._content); if (bubble._setTokens) bubble._setTokens(acc); history.push({ role: 'assistant', content: acc }); saveHistory(); }
			} catch (err) {
				typingEl.remove();
				appendMsg('assistant', `Network error: ${err?.message || 'unknown'}`);
			} finally {
				streaming = false;
				sendBtn.disabled = false;
				input.focus();
			}
		};

		form.addEventListener('submit', e => {
			e.preventDefault();
			const text = input.value.trim();
			if (!text || streaming) return;
			input.value = '';
			autosize();
			send(text);
		});

		loadHistory();
		saveHistory();

		// ── Google Sign-In (same redirect flow as blog comments) ─────────────────
		const API_URL = page.dataset.apiUrl || '';
		const TOKEN_KEY = 'user_token';

		const getToken   = () => localStorage.getItem(TOKEN_KEY);
		const setTokenLS = (t) => localStorage.setItem(TOKEN_KEY, t);
		const clearToken = () => localStorage.removeItem(TOKEN_KEY);

		const parseJWT = (token) => {
			try {
				const base64 = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
				const bytes = atob(base64).split('').map(c => '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)).join('');
				return JSON.parse(decodeURIComponent(bytes));
			} catch { return null; }
		};
		const isTokenValid = (token) => {
			if (!token) return false;
			const p = parseJWT(token);
			return p && p.role === 'user' && p.exp > Math.floor(Date.now() / 1000);
		};

		// Capture token returned by the OAuth redirect (?user_token=...)
		const params = new URLSearchParams(window.location.search);
		const urlToken = params.get('user_token');
		if (urlToken) {
			setTokenLS(urlToken);
			params.delete('user_token');
			const newSearch = params.toString();
			window.history.replaceState({}, '', window.location.pathname + (newSearch ? '?' + newSearch : ''));
		}

		const loginOverlay = document.getElementById('chat-login');
		const loginBtn     = document.getElementById('login-google');
		const userBox      = document.getElementById('chat-user');
		const userBtn      = document.getElementById('chat-user-btn');
		const userMenu     = document.getElementById('chat-user-menu');
		const userAvatar   = document.getElementById('chat-user-avatar');
		const userName     = document.getElementById('chat-user-name');
		const userEmail    = document.getElementById('chat-user-email');
		const signOutBtn   = document.getElementById('chat-signout');

		const renderAuthUI = () => {
			const token = getToken();
			if (isTokenValid(token)) {
				const p = parseJWT(token);
				userAvatar.src = p.avatar || '';
				userAvatar.alt = p.name || '';
				userName.textContent = p.name || '';
				userEmail.textContent = p.email || '';
				userBox.style.display = '';
				loginOverlay.style.display = 'none';
			} else {
				if (token) clearToken();
				userBox.style.display = 'none';
				userMenu.style.display = 'none';
				loginOverlay.style.display = 'flex';
			}
		};

		loginBtn.addEventListener('click', () => {
			const returnTo = encodeURIComponent(window.location.href);
			window.location.href = `${API_URL}/auth/google?return_to=${returnTo}`;
		});

		userBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			userMenu.style.display = userMenu.style.display === 'block' ? 'none' : 'block';
		});
		document.addEventListener('click', (e) => {
			if (!userBox.contains(e.target)) userMenu.style.display = 'none';
		});

		signOutBtn.addEventListener('click', () => {
			clearToken();
			renderAuthUI();
		});

		renderAuthUI();
	})();
</script>
