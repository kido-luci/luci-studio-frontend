---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import RepoCard from "../components/RepoCard.astro";
import { projectService } from "../services/projects";
import { getRepoStats, parseGitHub } from "../services/github";

const ACCENT = "#6c4cf1";
const BARS = ["#16a394", "#3aa0ff", "#ec5a9b", "#6c4cf1"];

// Short lowercase monogram from a repo/app name (initials of word-parts, max 3).
function monogram(name: string): string {
  const parts = name.split(/[-_\s]+/).filter(Boolean);
  let initials = parts.map((p) => p[0]).join("");
  if (initials.length > 3) initials = initials.slice(0, 2) + initials.slice(-1);
  return (initials || name.slice(0, 2)).toLowerCase();
}

const num = (n: number | null) => (n === null ? null : n.toLocaleString("en-US"));

const projects = await projectService.getAll();
const sourceProjects = projects.filter((p: any) => p.type === "source");
const appProjects = projects.filter((p: any) => p.type === "app");

// Build source cards with live GitHub stats (deduped + fail-safe in the service).
const sources = await Promise.all(
  sourceProjects.map(async (p: any, i: number) => {
    const link = (p.links || []).find((l: any) => /github\.com/i.test(l.url)) ?? (p.links || [])[0];
    const url = link?.url ?? "";
    const gh = parseGitHub(url);
    let host = "github.com";
    try { if (url) host = new URL(url).hostname.replace(/^www\./, ""); } catch {}

    const stats: { n: string; label: string }[] = [];
    if (gh) {
      const s = await getRepoStats(gh.owner, gh.repo);
      if (s.contributors !== null) stats.push({ n: num(s.contributors)!, label: s.contributors === 1 ? "Contributor" : "Contributors" });
      if (s.issues !== null) stats.push({ n: num(s.issues)!, label: s.issues === 1 ? "Issue" : "Issues" });
      if (s.stars !== null) stats.push({ n: num(s.stars)!, label: s.stars === 1 ? "Star" : "Stars" });
      if (s.forks !== null) stats.push({ n: num(s.forks)!, label: s.forks === 1 ? "Fork" : "Forks" });
    }

    return {
      url,
      owner: gh?.owner,
      name: gh ? gh.repo : p.title,
      monogram: monogram(gh ? gh.repo : p.title),
      bar: BARS[i % BARS.length],
      logo: p.logo_url || undefined,
      preview: gh ? `https://opengraph.githubassets.com/lab/${gh.owner}/${gh.repo}` : undefined,
      desc: p.description || "",
      tags: Array.isArray(p.tech) ? p.tech : [],
      stats,
      host,
    };
  }),
);

const apps = appProjects.map((p: any, i: number) => {
  const link = (p.links || [])[0];
  const url = link?.url ?? "";
  let host = "";
  try { if (url) host = new URL(url).hostname.replace(/^www\./, ""); } catch {}
  return {
    url,
    name: p.title,
    monogram: monogram(p.title),
    bar: BARS[i % BARS.length],
    logo: p.logo_url || p.cover_image_url || undefined,
    desc: p.description || "",
    tags: Array.isArray(p.tech) ? p.tech : [],
    stats: [],
    host: host || "app",
  };
});

const repoCount = String(sources.length).padStart(2, "0");
---

<Layout
  title="Lab · Luci Studio"
  description="Public source repositories and released apps — mine, and a few others worth a look."
>
  <!-- Editorial display fonts (Space Mono is already loaded by Layout). -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400..900;1,400..900&family=Hanken+Grotesk:wght@400..800&display=swap"
  />

  <TopNav active="lab" />

  <div class="lab-root" style={`--accent:${ACCENT};`}>

    <!-- decorative confetti -->
    <div style="position:absolute; inset:0; pointer-events:none; z-index:0;">
      <span style="position:absolute; left:24%; top:9%; width:7px; height:7px; border-radius:50%; background:var(--accent); --r:0deg; animation:lab-floaty 7s ease-in-out infinite;"></span>
      <span style="position:absolute; left:46%; top:6%; width:22px; height:3px; border-radius:3px; background:#ec5a9b; transform:rotate(-32deg); --r:-32deg; animation:lab-floaty 9s ease-in-out .4s infinite;"></span>
      <span style="position:absolute; left:62%; top:13%; width:9px; height:9px; border:2px solid #3aa0ff; border-radius:50%;"></span>
      <span style="position:absolute; left:74%; top:7%; width:6px; height:6px; border-radius:50%; background:#16a394;"></span>
      <span style="position:absolute; left:84%; top:20%; width:20px; height:3px; border-radius:3px; background:#3aa0ff; transform:rotate(40deg); --r:40deg; animation:lab-floaty 8s ease-in-out 1s infinite;"></span>
      <span style="position:absolute; left:12%; top:30%; width:8px; height:8px; border:2px solid var(--accent); border-radius:50%;"></span>
      <span style="position:absolute; left:33%; top:38%; width:18px; height:3px; border-radius:3px; background:#ec5a9b; transform:rotate(58deg); --r:58deg; animation:lab-floaty 10s ease-in-out .2s infinite;"></span>
      <span style="position:absolute; left:90%; top:34%; width:7px; height:7px; border-radius:50%; background:var(--accent);"></span>
      <span style="position:absolute; left:6%; top:64%; width:7px; height:7px; border:2px solid #ec5a9b; border-radius:50%;"></span>
      <span style="position:absolute; left:95%; top:58%; width:18px; height:3px; border-radius:3px; background:#16a394; transform:rotate(-24deg); --r:-24deg; animation:lab-floaty 9s ease-in-out .6s infinite;"></span>
    </div>

    <div style="position:relative; z-index:1; max-width:1180px; margin:0 auto; padding:0 40px;">

      <!-- released apps (top) -->
      {apps.length > 0 && (
        <div id="released-apps" style="padding:36px 0 18px; scroll-margin-top:96px;">
          <div style="font-family:'Space Mono',monospace; font-size:12px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent); margin-bottom:22px;">// {String(apps.length).padStart(2, "0")} apps</div>
          <h1 style="margin:0; font-family:'Bodoni Moda',serif; font-weight:800; font-size:clamp(40px,6.5vw,78px); line-height:1; letter-spacing:-.01em; color:var(--lab-text);">RELEASED APPS<span style="color:var(--accent);">.</span></h1>
          <p style="margin:30px 0 0; max-width:540px; font-size:20px; line-height:1.5; color:var(--lab-muted);">Public source repositories and released apps — mine, and a few others worth a look.</p>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(420px,1fr)); gap:28px; margin-top:64px;">
            {apps.map((a) => (
              <RepoCard {...a} accent={ACCENT} />
            ))}
          </div>
        </div>
      )}

      <!-- public source -->
      <div id="public-source" style={`padding:${apps.length > 0 ? "96px" : "36px"} 0 18px; scroll-margin-top:96px;`}>
        <div style="font-family:'Space Mono',monospace; font-size:12px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent); margin-bottom:22px;">// {repoCount} repositories</div>
        <h2 style="margin:0; font-family:'Bodoni Moda',serif; font-weight:800; font-size:clamp(34px,5vw,60px); line-height:1; letter-spacing:-.01em; color:var(--lab-text);">PUBLIC SOURCE<span style="color:var(--accent);">.</span></h2>
        {apps.length === 0 && (
          <p style="margin:30px 0 0; max-width:540px; font-size:20px; line-height:1.5; color:var(--lab-muted);">Public source repositories and released apps — mine, and a few others worth a look.</p>
        )}
        {sources.length > 0 ? (
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(420px,1fr)); gap:28px; margin-top:64px;">
            {sources.map((r) => (
              <RepoCard {...r} accent={ACCENT} />
            ))}
          </div>
        ) : (
          <p style="margin-top:64px; font-family:'Space Mono',monospace; font-size:13px; letter-spacing:.06em; text-transform:uppercase; color:var(--lab-stat-label);">No repositories yet.</p>
        )}
      </div>

    </div>
  </div>
</Layout>

<style is:global>
  /* /lab is an editorial page inside the site shell (keeps the standard TopNav).
     Its palette is driven by --lab-* variables so it follows the site's theme
     toggle: light defaults below, dark override keyed off <html> (set
     synchronously by the theme init, so no flash). Its opaque surface covers
     the shell background; keyframes live here because the confetti uses them. */
  .lab-root {
    --lab-bg: radial-gradient(120% 80% at 80% -10%, #efeae0 0%, #f4f2ec 60%);
    --lab-text: #13151d;
    --lab-muted: #5c606b;
    --lab-card-bg: #ffffff;
    --lab-card-border: rgba(19, 21, 29, 0.08);
    --lab-card-shadow: 0 1px 2px rgba(19, 21, 29, 0.04);
    --lab-card-shadow-hover: 0 22px 50px -18px rgba(19, 21, 29, 0.28);
    --lab-card-border-hover: rgba(19, 21, 29, 0.16);
    --lab-tile-grad: radial-gradient(120% 120% at 30% 20%, #2a2d3a 0%, #0c0d12 70%);
    --lab-tile-text: #e9e6df;
    --lab-owner: #9a9ea8;
    --lab-name: #13151d;
    --lab-desc: #5c606b;
    --lab-tag-bg: #f7f5f0;
    --lab-tag-border: rgba(19, 21, 29, 0.1);
    --lab-tag-text: #41454f;
    --lab-divider: rgba(19, 21, 29, 0.08);
    --lab-stat-n: #13151d;
    --lab-stat-label: #9a9ea8;
    --lab-footer-bg: #fbfaf7;
    --lab-footer-border: rgba(19, 21, 29, 0.07);
    --lab-footer-text: #13151d;
    --lab-dot: #13151d;

    position: relative;
    min-height: 100vh;
    width: 100%;
    background: var(--lab-bg);
    overflow: hidden;
    padding: 96px 0 100px;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    color: var(--lab-text);
  }

  html:not(.light-mode) .lab-root {
    --lab-bg: radial-gradient(120% 80% at 80% -10%, #1b1e27 0%, #0e0f14 60%);
    --lab-text: #f1efe9;
    --lab-muted: #a5a9b4;
    --lab-card-bg: #17191f;
    --lab-card-border: rgba(255, 255, 255, 0.08);
    --lab-card-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
    --lab-card-shadow-hover: 0 22px 50px -18px rgba(0, 0, 0, 0.7);
    --lab-card-border-hover: rgba(255, 255, 255, 0.18);
    --lab-tile-grad: radial-gradient(120% 120% at 30% 20%, #343a4d 0%, #181b24 70%);
    --lab-tile-text: #ece9e1;
    --lab-owner: #7f8390;
    --lab-name: #f1efe9;
    --lab-desc: #a5a9b4;
    --lab-tag-bg: rgba(255, 255, 255, 0.04);
    --lab-tag-border: rgba(255, 255, 255, 0.1);
    --lab-tag-text: #c6cad2;
    --lab-divider: rgba(255, 255, 255, 0.08);
    --lab-stat-n: #f1efe9;
    --lab-stat-label: #7f8390;
    --lab-footer-bg: #121419;
    --lab-footer-border: rgba(255, 255, 255, 0.07);
    --lab-footer-text: #ece9e1;
    --lab-dot: #ece9e1;
  }

  @keyframes lab-floaty {
    0%, 100% { transform: translateY(0) rotate(var(--r, 0deg)); }
    50%      { transform: translateY(-14px) rotate(var(--r, 0deg)); }
  }
  @keyframes lab-spin { to { transform: rotate(360deg); } }
</style>
