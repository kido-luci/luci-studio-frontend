---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";
import RepoCard from "../components/RepoCard.astro";
import { projectService } from "../services/projects";
import { buildLabCards } from "../utils/labCards";
import "../styles/lab-cards.css";
import { getLocaleFromUrl, useTranslations } from '../i18n';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const ACCENT = "#6c4cf1";

const projects = await projectService.getAll();
const { apps, sources } = buildLabCards(projects);
const repoCount = String(sources.length).padStart(2, "0");
---

<Layout
  title="Lab · Luci Studio"
  description="Public source repositories and released apps — mine, and a few others worth a look."
>
  <!-- Editorial display fonts (Space Mono is already loaded by Layout). -->
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400..900;1,400..900&family=Hanken+Grotesk:wght@400..800&display=swap"
  />

  <TopNav active="lab" />

  <div class="lab-root lab-palette" style={`--accent:${ACCENT};`}>

    <!-- decorative confetti -->
    <div style="position:absolute; inset:0; pointer-events:none; z-index:0;">
      <span style="position:absolute; left:24%; top:9%; width:7px; height:7px; border-radius:50%; background:var(--accent); --r:0deg; animation:lab-floaty 7s ease-in-out infinite;"></span>
      <span style="position:absolute; left:46%; top:6%; width:22px; height:3px; border-radius:3px; background:#ec5a9b; transform:rotate(-32deg); --r:-32deg; animation:lab-floaty 9s ease-in-out .4s infinite;"></span>
      <span style="position:absolute; left:62%; top:13%; width:9px; height:9px; border:2px solid #3aa0ff; border-radius:50%;"></span>
      <span style="position:absolute; left:74%; top:7%; width:6px; height:6px; border-radius:50%; background:#16a394;"></span>
      <span style="position:absolute; left:84%; top:20%; width:20px; height:3px; border-radius:3px; background:#3aa0ff; transform:rotate(40deg); --r:40deg; animation:lab-floaty 8s ease-in-out 1s infinite;"></span>
      <span style="position:absolute; left:12%; top:30%; width:8px; height:8px; border:2px solid var(--accent); border-radius:50%;"></span>
      <span style="position:absolute; left:33%; top:38%; width:18px; height:3px; border-radius:3px; background:#ec5a9b; transform:rotate(58deg); --r:58deg; animation:lab-floaty 10s ease-in-out .2s infinite;"></span>
      <span style="position:absolute; left:90%; top:34%; width:7px; height:7px; border-radius:50%; background:var(--accent);"></span>
      <span style="position:absolute; left:6%; top:64%; width:7px; height:7px; border:2px solid #ec5a9b; border-radius:50%;"></span>
      <span style="position:absolute; left:95%; top:58%; width:18px; height:3px; border-radius:3px; background:#16a394; transform:rotate(-24deg); --r:-24deg; animation:lab-floaty 9s ease-in-out .6s infinite;"></span>
    </div>

    <div style="position:relative; z-index:1; max-width:1180px; margin:0 auto; padding:0 40px;">

      <!-- released apps (top) -->
      {apps.length > 0 && (
        <div id="released-apps" style="padding:36px 0 18px; scroll-margin-top:96px;">
          <div style="font-family:'Space Mono',monospace; font-size:12px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent); margin-bottom:22px;">// {String(apps.length).padStart(2, "0")} apps</div>
          <h1 style="margin:0; font-family:'DM Serif Display',Georgia,serif; font-weight:400; font-size:clamp(40px,6.5vw,78px); line-height:1.1; letter-spacing:-.01em; color:var(--lab-text);">{t('lab.releasedApps')}<span style="color:var(--accent);">.</span></h1>
          <p style="margin:30px 0 0; max-width:540px; font-size:20px; line-height:1.5; color:var(--lab-muted);">{t('lab.labDescription')}</p>
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr)); gap:28px; margin-top:64px;">
            {apps.map((a) => (
              <RepoCard {...a} accent={ACCENT} />
            ))}
          </div>
        </div>
      )}

      <!-- public source -->
      <div id="public-source" style={`padding:${apps.length > 0 ? "96px" : "36px"} 0 18px; scroll-margin-top:96px;`}>
        <div style="font-family:'Space Mono',monospace; font-size:12px; letter-spacing:.22em; text-transform:uppercase; color:var(--accent); margin-bottom:22px;">// {repoCount} repositories</div>
        <h2 style="margin:0; font-family:'DM Serif Display',Georgia,serif; font-weight:400; font-size:clamp(34px,5vw,60px); line-height:1.1; letter-spacing:-.01em; color:var(--lab-text);">{t('lab.publicSource')}<span style="color:var(--accent);">.</span></h2>
        {apps.length === 0 && (
          <p style="margin:30px 0 0; max-width:540px; font-size:20px; line-height:1.5; color:var(--lab-muted);">{t('lab.labDescription')}</p>
        )}
        {sources.length > 0 ? (
          <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr)); gap:28px; margin-top:64px;">
            {sources.map((r) => (
              <RepoCard {...r} accent={ACCENT} />
            ))}
          </div>
        ) : (
          <p style="margin-top:64px; font-family:'Space Mono',monospace; font-size:13px; letter-spacing:.06em; text-transform:uppercase; color:var(--lab-stat-label);">{t('lab.noRepos')}</p>
        )}
      </div>

    </div>
  </div>
</Layout>

<style is:global>
  /* /lab is an editorial page inside the site shell (keeps the standard TopNav).
     Its --lab-* palette + keyframes come from the shared lab-cards.css (imported
     above, also used by the homepage LAB section). Only the page-level layout —
     an opaque themed surface covering the shell background — lives here. */
  .lab-root {
    position: relative;
    min-height: 100vh;
    width: 100%;
    background: var(--lab-bg);
    overflow: hidden;
    padding: 96px 0 100px;
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
    color: var(--lab-text);
  }
</style>
