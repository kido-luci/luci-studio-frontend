---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";

const SITE_URL = 'https://luci-studio.com';
const lastUpdated = 'May 13, 2026';
---

<Layout
  title="Privacy Policy | Luci Studio"
  description="Privacy Policy for Luci Studio, including local storage, comments, AI chat, Google login, and AdSense consent."
  canonical={`${SITE_URL}/privacy`}
  keywords="Luci Studio privacy, privacy policy, cookies, AdSense, Google login"
>
  <TopNav />

  <main class="legal-page pt-36 pb-24 px-4 md:px-6 min-h-screen">
    <article class="max-w-3xl mx-auto">
      <p class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-4">Legal</p>
      <h1 class="text-5xl md:text-7xl font-black tracking-tighter mb-4">Privacy Policy<span class="text-violet-500">.</span></h1>
      <p class="text-sm text-gray-500 mb-12">Last updated: {lastUpdated}</p>

      <div class="legal-copy">
        <section>
          <h2>Overview</h2>
          <p>
            Luci Studio is a personal portfolio and blog by Trung Lập. This policy explains how the site handles information from visitors, commenters, AI chat users, and Google sign-in users.
          </p>
          <p>
            This policy is provided for general information and is not legal advice.
          </p>
        </section>

        <section>
          <h2>Information You Provide</h2>
          <p>
            If you comment, contact Luci Studio by email, use Google login, or send messages to the AI chat, the site may process the information needed to provide those features. This can include your comment text, display identity from Google, email address if provided, and chat messages.
          </p>
        </section>

        <section>
          <h2>Local Storage and Required Features</h2>
          <p>
            The site uses browser local storage for required and user-requested features, including theme preference, liked posts, viewed-post or session markers, Google OAuth user token, chat history, and chat configuration. These features remain available even if you reject optional advertising cookies.
          </p>
          <p>
            The cookie consent choice is stored as <code>luci_cookie_consent</code> with a value of <code>accepted</code> or <code>rejected</code>.
          </p>
        </section>

        <section>
          <h2>Optional Advertising Cookies</h2>
          <p>
            Luci Studio may use Google AdSense. The AdSense script is only loaded after you choose "Accept optional" in the cookie notice. If you choose "Reject optional," AdSense is not loaded for that browser unless you later change your cookie settings.
          </p>
          <p>
            Google and its partners may use cookies or similar technologies for ad delivery, measurement, and personalization according to their own policies.
          </p>
        </section>

        <section>
          <h2>Third-Party Services and Media</h2>
          <p>
            Pages may load content or services from third parties, including Google login, Google AdSense after consent, hosted images and media, fonts, and CDNs. These providers may receive technical information such as IP address, browser details, referrer, and requested URLs.
          </p>
        </section>

        <section>
          <h2>AI Chat</h2>
          <p>
            Messages sent to the AI assistant may be sent to backend and model providers so the assistant can respond. Avoid sharing secrets, passwords, private keys, sensitive personal information, or confidential material in chat.
          </p>
        </section>

        <section>
          <h2>Data Retention and Choices</h2>
          <p>
            Browser-stored preferences remain until you clear site data or change them in the interface. Comments, login-related records, and server logs may be retained as needed to operate, protect, debug, and improve the site.
          </p>
          <p>
            You can reopen cookie choices through "Cookie Settings" links in the site footer.
          </p>
        </section>

        <section>
          <h2>Contact</h2>
          <p>
            For privacy questions, contact <a href="mailto:lapl1412.work@gmail.com">lapl1412.work@gmail.com</a>.
          </p>
        </section>
      </div>
    </article>
  </main>
</Layout>

<style>
  .legal-page {
    background: var(--bg-primary);
  }

  .legal-copy {
    display: grid;
    gap: 2.25rem;
  }

  .legal-copy h2 {
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .legal-copy p {
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.85;
    margin: 0.75rem 0 0;
  }

  .legal-copy code {
    color: var(--text-primary);
    font-size: 0.9em;
    padding: 0.1rem 0.3rem;
    border-radius: 0.35rem;
    background: rgba(255, 255, 255, 0.08);
  }

  .legal-copy a {
    color: rgb(167, 139, 250);
    font-weight: 700;
  }

  .legal-copy a:hover {
    color: #fff;
  }

  body.light-mode .legal-copy code {
    background: rgba(17, 24, 39, 0.08);
  }

  body.light-mode .legal-copy a:hover {
    color: rgb(109, 40, 217);
  }
</style>
