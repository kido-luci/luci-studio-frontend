---
import Layout from "../layouts/Layout.astro";
import TopNav from "../components/TopNav.astro";

const SITE_URL = 'https://luci-studio.com';
const lastUpdated = 'May 13, 2026';
---

<Layout
  title="Terms of Use | Luci Studio"
  description="Terms of Use for Luci Studio, a creative engineering space."
  canonical={`${SITE_URL}/terms/`}
  keywords="Luci Studio terms, terms of use"
>
  <TopNav />

  <main class="legal-page pt-36 pb-60 px-4 md:px-6 min-h-screen">
    <article class="max-w-3xl mx-auto">
      <p class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-4">Legal</p>
      <h1 class="text-5xl md:text-7xl font-black tracking-tighter mb-4">Terms of Use<span class="text-violet-500">.</span></h1>
      <p class="text-sm text-gray-500 mb-12">Last updated: {lastUpdated}</p>

      <div class="legal-copy">
        <section>
          <h2>Overview</h2>
          <p>
            Luci Studio is a creative engineering space. By using this site, you agree to these terms. If you do not agree, please do not use the site.
          </p>
          <p>
            These terms are provided for general information and are not legal advice.
          </p>
        </section>

        <section>
          <h2>Content and Ownership</h2>
          <p>
            Articles, portfolio materials, artwork, images, code samples, and other content on this site are owned by Luci Studio or used with permission unless stated otherwise. You may link to public pages and quote brief excerpts with attribution, but you may not copy, republish, sell, or imply endorsement without permission.
          </p>
        </section>

        <section>
          <h2>Comments, Login, and Community Use</h2>
          <p>
            Some pages may allow comments or reactions. You are responsible for what you post. Do not submit unlawful, abusive, misleading, infringing, spammy, or harmful content. Luci Studio may remove content or restrict access when needed to protect the site or other users.
          </p>
          <p>
            Google sign-in may be used for identity on comment features. You are responsible for keeping access to your Google account secure.
          </p>
        </section>

        <section>
          <h2>AI Chat</h2>
          <p>
            The AI assistant is provided for convenience and experimentation. Its responses may be incomplete, outdated, or incorrect. Do not rely on AI output as professional, legal, medical, financial, or security advice.
          </p>
        </section>

        <section>
          <h2>Third-Party Services</h2>
          <p>
            This site may use third-party services such as Google login, Google AdSense, hosted media, fonts, analytics-like delivery logs, and CDNs. Those services are governed by their own terms and policies.
          </p>
        </section>

        <section>
          <h2>No Warranty</h2>
          <p>
            The site is provided as-is. Luci Studio does not guarantee uninterrupted availability, error-free content, or that every example will fit your use case. Use code samples, opinions, and technical guidance at your own risk.
          </p>
        </section>

        <section>
          <h2>Changes</h2>
          <p>
            These terms may be updated as the site changes. The updated date above indicates the latest revision.
          </p>
        </section>

        <section>
          <h2>Contact</h2>
          <p>
            For questions about these terms, contact <a href="mailto:lapl1412.work@gmail.com">lapl1412.work@gmail.com</a>.
          </p>
        </section>
      </div>
    </article>
  </main>
</Layout>

<style>
  .legal-page {
    background: var(--bg-primary);
  }

  .legal-copy {
    display: grid;
    gap: 2.25rem;
  }

  .legal-copy h2 {
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .legal-copy p {
    color: var(--text-secondary);
    font-size: 0.98rem;
    line-height: 1.85;
    margin: 0.75rem 0 0;
  }

  .legal-copy a {
    color: rgb(167, 139, 250);
    font-weight: 700;
  }

  .legal-copy a:hover {
    color: #fff;
  }

  body.light-mode .legal-copy a:hover {
    color: rgb(109, 40, 217);
  }
</style>
