---
import Layout from "../../../layouts/Layout.astro";
import TopNav from "../../../components/TopNav.astro";
import { playlistService } from "../../../services/playlists";
import { buildPostSlug } from "../../../utils/blog";

const playlists = await playlistService.getAll();
const sorted = [...playlists].sort((a, b) =>
  new Date(b.created_at).getTime() - new Date(a.created_at).getTime()
);

const SITE_URL = 'https://luci-studio.com';
---

<Layout
  title="Playlists | Luci Studio"
  description={`${sorted.length} curated playlists — ordered reading lists of posts from Luci Studio.`}
  canonical={`${SITE_URL}/blog/playlists`}
  keywords="curated playlists, reading lists, blog collections, Luci Studio"
>

  <TopNav active="blog" />

  <main class="pt-36 pb-24 px-4 md:px-6 min-h-screen bg-[var(--bg-primary)]">
    <div class="max-w-7xl mx-auto">

      <!-- Header -->
      <div data-reveal class="mb-16">
        <span class="text-xs font-black text-violet-500 uppercase tracking-[0.3em] mb-3 block">Curated Collections</span>
        <h1 class="text-6xl md:text-8xl font-black tracking-tighter">PLAYLISTS<span class="text-violet-500">.</span></h1>
        <p class="text-gray-500 max-w-lg text-sm leading-relaxed mt-4">
          {sorted.length} {sorted.length === 1 ? 'playlist' : 'playlists'} — themed, ordered reading lists.
        </p>
        <div data-reveal class="line-draw h-px bg-gradient-to-r from-violet-500 to-transparent mt-6 max-w-xs"></div>
        <a href="/blog" class="inline-flex items-center gap-2 mt-6 text-xs font-black uppercase tracking-widest text-gray-400 hover:text-violet-400 transition-colors duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to Thoughts
        </a>
      </div>

      <!-- Empty state -->
      {sorted.length === 0 && (
        <div class="text-center py-24">
          <p class="text-gray-500 text-sm uppercase tracking-widest">No playlists yet</p>
        </div>
      )}

      <!-- Playlists Grid -->
      {sorted.length > 0 && (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 items-stretch md:auto-rows-fr gap-8">
          {sorted.map((p) => {
            const href = `/blog/playlists/${buildPostSlug(p.title, p.id)}/`;
            const count = p.post_ids?.length ?? 0;
            const img = p.cover_image_url || 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?auto=format&fit=crop&q=80&w=800';
            return (
              <a href={href} class="block h-full no-underline">
                <article class="tilt-card blog-card group flex h-full flex-col cursor-pointer p-5 sm:p-6 border-2 border-violet-500/[0.22] transition-all duration-500 bg-white/[0.02]">
                  <div class="blog-img-container aspect-video overflow-hidden mb-6 -mx-2 -mt-2 border-2 border-violet-500/[0.15] group-hover:border-violet-500/40 transition-all duration-500">
                    <img src={img} alt={p.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" onerror="this.style.opacity='0'" />
                  </div>
                  <div class="flex items-center gap-3 mb-4">
                    <span class="tag-label text-xs font-black text-violet-400 uppercase tracking-widest">Playlist</span>
                    <span class="w-1 h-1 bg-gray-700 rounded-full"></span>
                    <span class="text-xs text-gray-600">{count} {count === 1 ? 'post' : 'posts'}</span>
                  </div>
                  <h3 class="text-xl font-bold leading-snug group-hover:text-violet-400 transition-colors duration-300 line-clamp-2">{p.title}</h3>
                  {p.description && <p class="card-subtitle text-sm text-gray-500 mt-2 leading-relaxed line-clamp-3">{p.description}</p>}
                  <div class="mt-auto pt-4 border-t border-white/5 flex items-center justify-between">
                    <span class="text-xs text-gray-600">Explore →</span>
                  </div>
                </article>
              </a>
            );
          })}
        </div>
      )}

    </div>
  </main>

</Layout>

<style>
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .blog-card {
    opacity: 0;
    transform: translateY(28px);
    animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .blog-card:hover {
    border-color: rgba(139, 92, 246, 0.75) !important;
    box-shadow: 0 0 0 1px rgba(139, 92, 246, 0.25),
                0 12px 48px rgba(139, 92, 246, 0.18);
  }
  .blog-img-container {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(59, 130, 246, 0.10) 100%);
  }

  body.light-mode .blog-img-container {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.08) 0%, rgba(59, 130, 246, 0.05) 100%);
  }
  body.light-mode .tilt-card {
    background-color: rgba(255, 255, 255, 0.85) !important;
    border-color: rgba(0, 0, 0, 0.07) !important;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
  }
  body.light-mode .blog-card {
    border-color: rgba(0, 0, 0, 0.3) !important;
  }
  body.light-mode .tilt-card:hover {
    border-color: rgba(139, 92, 246, 0.25) !important;
    box-shadow: 0 8px 32px rgba(139, 92, 246, 0.1);
  }
  body.light-mode article.tilt-card h3 {
    color: rgb(17, 24, 39) !important;
  }
</style>
