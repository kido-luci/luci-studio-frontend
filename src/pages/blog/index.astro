---
import Layout from "../../layouts/Layout.astro";
import TopNav from "../../components/TopNav.astro";
import LabDecor from "../../components/LabDecor.astro";
import SeriesCard from "../../components/SeriesCard.astro";
import PostCard from "../../components/PostCard.astro";
import AffiliateCard from "../../components/AffiliateCard.astro";
import { postService } from "../../services/posts";
import { playlistService } from "../../services/playlists";
import { affiliateService } from "../../services/affiliates";
import { buildSeriesViews } from "../../utils/series";
import { buildPostSlug, readTimeFor, formatDate, coverGradient } from "../../utils/blog";

const rawPosts = await postService.getAll();
const rawPlaylists = await playlistService.getAll();

// Series view-models (stats + topics + year aggregated from the post list).
const playlists = buildSeriesViews(rawPlaylists, rawPosts);
// coverGradient lives in utils/blog and is shared with <PostCard>.

const allPosts = rawPosts
  .filter(p => !p.topics?.some(t => t.toLowerCase().startsWith('art')))
  .map(p => {
    const tags = (p.topics && p.topics.length > 0) ? p.topics : ['Engineering'];
    return {
      id: p.id,
      title: p.title,
      subtitle: p.subtitle || '',
      slug: buildPostSlug(p.title, p.id),
      tags,
      topics: p.topics || [],
      catLine: tags.join('  ·  '),
      coverWord: tags[0],
      cover: coverGradient(tags[0]),
      date: formatDate(p.created_at),
      read: readTimeFor(p),
      likes: p.likes ?? 0,
      views: p.views ?? 0,
      img: p.cover_image_url || '',
      search: `${p.title} ${p.subtitle || ''} ${tags.join(' ')}`.toLowerCase(),
    };
  });

const featured = allPosts[0];
const gridPosts = allPosts;

const API_URL = import.meta.env.PUBLIC_API_URL || '';
const SITE_URL = 'https://luci-studio.com';

// Sponsored cards — 2 distinct active links picked at build time (the blog page's
// fixed slot count). url points at the tracked redirect so admin click counts
// increment. [0] renders at the top, [1] at the end of the list.
const affiliates = await affiliateService.getCardsRandom(API_URL, 2);
// Topics ordered by how many posts carry them (most-used first); ties broken alphabetically.
const topicCounts = new Map<string, number>();
for (const p of allPosts) for (const t of p.topics) if (t) topicCounts.set(t, (topicCounts.get(t) || 0) + 1);
const allTopics = [...topicCounts.keys()].sort(
  (a, b) => (topicCounts.get(b)! - topicCounts.get(a)!) || a.localeCompare(b),
);
---

<Layout
  title="Blog | Luci Studio"
  description={`${allPosts.length} articles on engineering, architecture, and the craft of building software from Luci Studio.`}
  canonical={`${SITE_URL}/blog/`}
  keywords="Flutter, Go, technical blog, mobile development, engineering, clean architecture, Luci Studio"
>

  <TopNav active="blog" />

  <main class="pt-36 pb-24 px-4 md:px-6 min-h-screen bg-[var(--bg-primary)] relative" data-api-url={API_URL}>
    <LabDecor />
    <div class="max-w-7xl mx-auto tb-root">

      <!-- Header -->
      <div data-reveal class="tb-header">
        <div class="tb-head-main">
          <span class="tb-eyebrow">Raw Output</span>
          <h1 class="tb-title">Thoughts<span class="tb-dot">.</span></h1>
          <p class="tb-sub">
            {allPosts.length} {allPosts.length === 1 ? 'article' : 'articles'} on engineering, architecture, and the craft of building software.
          </p>
        </div>
        <div class="tb-head-count">
          <div class="tb-count" id="tb-count">{allPosts.length}</div>
          <div class="tb-count-label">Showing now</div>
        </div>
      </div>

      <!-- Controls: search + filter label -->
      <div class="tb-controls">
        <div class="tb-search-wrap">
          <svg class="tb-search-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
          <input id="tb-search" class="tb-search" type="text" placeholder="Search articles…" autocomplete="off" aria-label="Search articles" />
        </div>
        {allTopics.length > 0 && <div class="tb-filter-label">Filter by topic</div>}
      </div>

      <!-- Topic chips -->
      {allTopics.length > 0 && (
        <div class="tb-chips-wrap">
          <div class="tb-chips" id="topic-filters">
            <button class="topic-btn active-filter" data-topic="all">All</button>
            {allTopics.map(topic => (
              <button class="topic-btn" data-topic={topic}>{topic}</button>
            ))}
          </div>
          <button id="chips-toggle" class="tb-chips-toggle" type="button" hidden>Show all tags</button>
        </div>
      )}

      <!-- Featured hero (first post; hidden when filtering/searching) -->
      {featured && (
        <a id="tb-featured" href={`/blog/${featured.slug}/`} class="tb-featured" data-featured-id={String(featured.id)}>
          <div class="tb-feat-cover" style={!featured.img ? `background:${featured.cover}` : undefined}>
            {featured.img
              ? <img src={featured.img} alt={featured.title} class="tb-cover-img" loading="lazy" onerror="this.style.opacity='0'" />
              : <span class="tb-cover-word">{featured.coverWord}</span>}
            <span class="tb-badge tb-badge--feat">★ Featured</span>
          </div>
          <div class="tb-feat-body">
            <div class="tb-cat">{featured.catLine}</div>
            <h2 class="tb-feat-title">{featured.title}</h2>
            {featured.subtitle && <p class="tb-excerpt tb-excerpt--feat">{featured.subtitle}</p>}
            <div class="tb-spacer"></div>
            <div class="tb-meta"><span>{featured.date}</span><span class="tb-meta-dot">•</span><span>{featured.read} read</span></div>
            <div class="tb-feat-foot">
              <span class="tb-read">Read article <span class="tb-arrow">→</span></span>
              <div class="tb-stats">
                <span class="tile-view-area tb-stat" data-id={String(featured.id)}>
                  <svg class="tb-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <span class="tile-view-count">{featured.views}</span>
                </span>
                <span class="tile-like-area tb-stat tb-stat--like" data-id={String(featured.id)}>
                  <svg class="tile-like-icon tb-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  <span class="tile-like-count">{featured.likes}</span>
                </span>
              </div>
            </div>
          </div>
        </a>
      )}

      <!-- Sponsored / affiliate card — top slot (1st of the blog page's 2 cards; hidden while filtering/searching, like the featured hero) -->
      {affiliates.length > 0 && (
        <div id="tb-affiliate">
          <AffiliateCard
            label={affiliates[0].label}
            url={affiliates[0].url}
            network={affiliates[0].network}
            badge="Sponsored"
            cta={affiliates[0].cta || undefined}
            image={affiliates[0].image}
            imageAlt={affiliates[0].imageAlt}
            logo={affiliates[0].logo}
          />
        </div>
      )}

      <!-- Empty state -->
      <div id="empty-state" class="tb-empty hidden">
        <div class="tb-empty-title">Nothing here yet</div>
        <p class="tb-empty-sub">No articles match that filter. Try another topic.</p>
        <button id="tb-clear" class="tb-clear">Clear filters</button>
      </div>

      <!-- Posts Grid -->
      <div id="posts-grid" class="tb-grid">
        {gridPosts.map((p) => (
          <div class="post-item" data-id={p.id} data-topics={JSON.stringify(p.topics)} data-search={p.search} style="display:none">
            <PostCard
              href={`/blog/${p.slug}/`}
              title={p.title}
              subtitle={p.subtitle}
              tags={p.tags}
              date={p.date}
              read={p.read}
              img={p.img}
              id={p.id}
              views={p.views}
              likes={p.likes}
              interactive
            />
          </div>
        ))}
      </div>

      <!-- Pagination -->
      <div id="pagination" class="mt-16 hidden flex-col items-center gap-4">
        <div class="flex items-center gap-3">
          <button id="prev-btn" class="pag-arrow" aria-label="Previous page">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div id="page-numbers" class="flex items-center gap-2"></div>
          <button id="next-btn" class="pag-arrow" aria-label="Next page">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
        <p id="posts-count" class="text-xs text-gray-600 uppercase tracking-widest"></p>
      </div>

      <!-- Sponsored / affiliate card — end of list (2nd of the blog page's 2 cards; distinct from the top; hidden while filtering/searching like the top slot) -->
      {affiliates.length > 1 && (
        <div id="tb-affiliate-end" class="mt-16">
          <AffiliateCard
            label={affiliates[1].label}
            url={affiliates[1].url}
            network={affiliates[1].network}
            badge="Sponsored"
            cta={affiliates[1].cta || undefined}
            image={affiliates[1].image}
            imageAlt={affiliates[1].imageAlt}
            logo={affiliates[1].logo}
          />
        </div>
      )}

      <!-- Playlists strip (end of page) -->
      {playlists.length > 0 && (
        <section data-reveal class="mt-24">
          <div class="flex items-end justify-between gap-4 mb-6 flex-wrap">
            <div>
              <span class="text-xs font-black text-[#8b5cf6] uppercase tracking-[0.3em] mb-2 block">Curated Collections</span>
              <h2 class="text-4xl md:text-5xl" style="font-family:'DM Serif Display',Georgia,serif;font-weight:400;">Series<span class="text-[#8b5cf6]">.</span></h2>
            </div>
            <a href="/blog/series" class="see-all-btn">See all →</a>
          </div>
          <ol class="series-strip list-none p-0 m-0">
            {playlists.slice(0, 3).map((p) => (
              <li><SeriesCard series={p} /></li>
            ))}
          </ol>
        </section>
      )}

    </div>
  </main>

</Layout>

<style>
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ══ Thoughts Blog (Thoughts Blog.dc design) — theme-aware ══ */
  .tb-root {
    position: relative;
    z-index: 1;
    --tb-accent: #8b5cf6;
    --card-bg: #16161d; --card-bd: rgba(255,255,255,0.08);
    --card-shadow: 0 4px 14px -10px rgba(0,0,0,0.6);
    --card-shadow-hover: 0 24px 46px -22px rgba(0,0,0,0.85);
    --feat-shadow-hover: 0 30px 64px -28px rgba(0,0,0,0.9);
    --ink: #f3f3f6; --ink-soft: #c7cad3; --muted: #8b909c; --line: rgba(255,255,255,0.08);
    --chip-bg: rgba(255,255,255,0.04); --chip-bd: rgba(255,255,255,0.14); --chip-ink: #d6d8de;
    --search-bg: rgba(255,255,255,0.04); --search-bd: rgba(255,255,255,0.12);
    --badge-bg: rgba(20,20,28,0.82); --badge-ink: #f3f3f6;
    --feat-mat: #1c1c26;
  }
  body.light-mode .tb-root {
    --card-bg: #ffffff; --card-bd: #e9e6df;
    --card-shadow: 0 4px 14px -10px rgba(30,25,70,.2);
    --card-shadow-hover: 0 22px 44px -22px rgba(30,25,70,.36);
    --feat-shadow-hover: 0 28px 60px -26px rgba(30,25,70,.4);
    --ink: #161827; --ink-soft: #5b6070; --muted: #9ca3af; --line: #f0eee8;
    --chip-bg: #fff; --chip-bd: #e6e3dc; --chip-ink: #3a3d4d;
    --search-bg: #fff; --search-bd: #e6e3dc;
    --badge-bg: rgba(255,255,255,0.92); --badge-ink: #161827;
    --feat-mat: #f1efe9;
  }
  /* light-mode page glow to echo the design's backdrop */
  body.light-mode main[data-api-url] {
    background:
      radial-gradient(1100px 520px at 82% -8%, #efeaff 0%, rgba(244,243,239,0) 60%),
      radial-gradient(120% 80% at 80% -10%, #f9f7f3 0%, #fbfaf7 60%);
  }

  /* Header */
  .tb-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-bottom: clamp(36px,5vw,52px); }
  .tb-head-main { max-width: 640px; }
  .tb-eyebrow { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px; letter-spacing: 0.3em; text-transform: uppercase; color: var(--tb-accent); }
  .tb-title { font-family: 'DM Serif Display', Georgia, serif; font-weight: 400; font-size: clamp(3.4rem,9vw,7rem); line-height: 1; letter-spacing: -0.02em; color: var(--ink); margin: 14px 0 0; }
  .tb-dot { color: var(--tb-accent); }
  .tb-sub { font-size: 18px; line-height: 1.5; color: var(--muted); margin: 22px 0 0; max-width: 520px; }
  .tb-head-count { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; padding-bottom: 8px; }
  .tb-count { font-weight: 900; font-size: 46px; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  .tb-count-label { font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }

  /* Controls */
  .tb-controls { margin-top: clamp(34px,5vw,52px); display: flex; align-items: center; gap: 16px; flex-wrap: wrap; justify-content: space-between; }
  .tb-search-wrap { position: relative; display: inline-flex; align-items: center; }
  .tb-search-ic { position: absolute; left: 16px; pointer-events: none; color: var(--muted); }
  .tb-search { width: 320px; max-width: 64vw; padding: 13px 18px 13px 44px; border: 1.5px solid var(--search-bd); border-radius: 999px; background: var(--search-bg); font-weight: 500; font-size: 14.5px; color: var(--ink); outline: none; transition: border-color .2s ease; }
  .tb-search::placeholder { color: var(--muted); }
  .tb-search:focus { border-color: var(--tb-accent); }
  .tb-filter-label { font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }

  /* Chips */
  .tb-chips { margin-top: 18px; display: flex; flex-wrap: wrap; gap: 9px; }
  /* Clamp the topic list to two rows by default (height set by JS); extra rows are
     reachable via the toggle. Mobile keeps its single horizontal-scroll row. */
  .tb-chips.is-clamped { overflow: hidden; }
  .tb-chips-toggle {
    margin-top: 12px;
    background: none; border: none; padding: 2px;
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 11.5px;
    letter-spacing: 0.09em; text-transform: uppercase;
    color: var(--tb-accent); cursor: pointer;
  }
  .tb-chips-toggle:hover { text-decoration: underline; }
  .tb-chips-toggle[hidden] { display: none; }

  /* Shared card bits */
  .tb-badge { position: absolute; top: 14px; left: 14px; padding: 5px 11px; border-radius: 999px; background: var(--badge-bg); backdrop-filter: blur(6px); font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 9.5px; letter-spacing: 0.13em; text-transform: uppercase; color: var(--badge-ink); }
  .tb-badge--feat { top: 22px; left: 22px; padding: 7px 13px; font-size: 11px; letter-spacing: 0.14em; }
  .tb-cover-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .tb-cover-word { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: 0 16px; font-weight: 900; font-size: 62px; line-height: .85; letter-spacing: -.03em; color: rgba(255,255,255,.18); transform: rotate(-6deg); pointer-events: none; }
  .tb-cat { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 11px; line-height: 1.4; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tb-accent); }
  .tb-cat--clamp { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .tb-excerpt { font-size: 14.5px; line-height: 1.58; color: var(--muted); margin: 10px 0 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .tb-excerpt--feat { font-size: 16.5px; line-height: 1.62; color: var(--ink-soft); margin: 18px 0 0; -webkit-line-clamp: 4; }
  .tb-spacer { flex: 1; }
  .tb-meta { display: flex; align-items: center; gap: 12px; font-family: 'JetBrains Mono', monospace; font-weight: 500; font-size: 13.5px; color: var(--muted); }
  .tb-meta--sm { font-size: 12.5px; gap: 0; margin-top: 16px; }
  .tb-meta-dot { color: var(--line); }
  .tb-read { display: inline-flex; align-items: center; gap: 7px; font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px; letter-spacing: 0.04em; color: var(--tb-accent); }
  .tb-read--sm { font-size: 12.5px; }
  .tb-arrow { font-size: 15px; }
  .tb-stats { display: flex; align-items: center; gap: 18px; color: var(--muted); font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: 13.5px; }
  .tb-stats--sm { gap: 14px; font-size: 12.5px; }
  .tb-stat { display: inline-flex; align-items: center; gap: 6px; }
  .tb-stat--like { cursor: pointer; }
  .tb-ic { width: 16px; height: 16px; }
  .tb-stat--like .tile-like-icon { transition: color .2s ease, fill .2s ease; }
  .tb-stat--like:hover .tile-like-icon { color: #ef4d6b; }

  /* Featured hero */
  .tb-featured { display: grid; grid-template-columns: 1.08fr 1fr; gap: 0; margin-top: 44px; background: var(--card-bg); border: 1px solid var(--card-bd); border-radius: 22px; overflow: hidden; text-decoration: none; box-shadow: var(--card-shadow); transition: transform .25s ease, box-shadow .25s ease; }
  .tb-featured:hover { transform: translateY(-4px); box-shadow: var(--feat-shadow-hover); }
  .tb-feat-cover { position: relative; overflow: hidden; min-height: 320px; background: var(--feat-mat); display: flex; align-items: center; justify-content: center; padding: clamp(12px,1.5vw,16px); }
  .tb-feat-cover .tb-cover-img { position: static; inset: auto; width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 14px; }
  .tb-feat-body { padding: 46px 46px 40px; display: flex; flex-direction: column; }
  .tb-feat-title { font-weight: 800; font-size: clamp(26px,3vw,36px); line-height: 1.06; letter-spacing: -.02em; color: var(--ink); margin: 16px 0 0; }
  .tb-feat-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--line); }
  @media (max-width: 820px) { .tb-featured { grid-template-columns: 1fr; } .tb-feat-cover { min-height: 230px; } .tb-feat-body { padding: 30px 26px 28px; } }

  /* Grid */
  .tb-grid { margin-top: 48px; display: grid; grid-template-columns: repeat(auto-fill, minmax(322px, 1fr)); gap: 26px; }
  /* Grid card itself (cover/body/title/foot + shared bits) lives in PostCard.astro */
  /* Phone screens: keep topic filtering but collapse the chips into a single
     horizontal-scroll row instead of wrapping to fill the whole viewport */
  @media (max-width: 768px) {
    /* overflow-x:auto forces overflow-y to clip, which would cut off the active
       chip's drop-shadow — pad the scroll box vertically (and pull the next block
       back up) so the shadow has room without adding a big gap */
    .tb-chips { flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 8px 2px 18px; margin-bottom: -14px; }
    .tb-chips::-webkit-scrollbar { display: none; }
    .topic-btn { flex: 0 0 auto; }
    /* Hide the "17 / Showing now" counter on mobile */
    .tb-head-count { display: none; }
  }

  /* Empty state */
  .tb-empty { margin-top: 60px; padding: 72px 24px; text-align: center; background: var(--card-bg); border: 1px solid var(--card-bd); border-radius: 20px; }
  .tb-empty-title { font-weight: 800; font-size: 30px; color: var(--ink); }
  .tb-empty-sub { font-size: 15.5px; color: var(--muted); margin: 12px 0 24px; }
  .tb-clear { padding: 12px 22px; border-radius: 999px; border: none; background: var(--tb-accent); color: #fff; font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 13px; letter-spacing: 0.06em; cursor: pointer; }
  .tb-empty.hidden { display: none; }

  /* Blog card reveal */
  .blog-card {
    opacity: 0;
    transform: translateY(28px);
    background-color: #17171d;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.55);
  }
  .blog-card.card-visible {
    animation: fadeSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .blog-card:hover {
    border-color: rgba(139, 92, 246, 0.75) !important;
    box-shadow: 0 0 0 1px rgba(139, 92, 246, 0.25),
                0 12px 48px rgba(139, 92, 246, 0.18);
  }
  .blog-img-container {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(59, 130, 246, 0.10) 100%);
  }

  /* Light mode */
  body.light-mode .blog-img-container {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.08) 0%, rgba(59, 130, 246, 0.05) 100%);
  }
  body.light-mode .tilt-card {
    background-color: rgba(255, 255, 255, 0.85) !important;
    border-color: rgba(0, 0, 0, 0.07) !important;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.06);
  }
  body.light-mode .blog-card {
    border-color: rgba(0, 0, 0, 0.3) !important;
  }
  body.light-mode .tilt-card:hover {
    border-color: rgba(139, 92, 246, 0.25) !important;
    box-shadow: 0 8px 32px rgba(139, 92, 246, 0.1);
  }
  body.light-mode article.tilt-card h3 {
    color: rgb(17, 24, 39) !important;
  }
  body.light-mode .tile-like-count {
    color: rgb(107, 114, 128) !important;
  }

  /* Series strip — cards rendered by SeriesCard.astro */
  .series-strip { margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1.5rem; }

  .see-all-btn {
    padding: 0.5rem 1.1rem;
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    border-radius: 9999px;
    border: 1px solid rgba(139, 92, 246, 0.4);
    color: rgb(149, 128, 255);
    background: transparent;
    text-decoration: none;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .see-all-btn:hover {
    background: rgba(139, 92, 246, 0.12);
    border-color: rgba(139, 92, 246, 0.7);
  }
  body.light-mode .see-all-btn {
    border-color: rgba(139, 92, 246, 0.35);
    color: rgb(91, 58, 230);
  }
  body.light-mode .see-all-btn:hover {
    background: rgba(139, 92, 246, 0.08);
    border-color: rgba(139, 92, 246, 0.55);
  }

  /* Topic filter buttons */
  .topic-btn {
    padding: 9px 15px;
    border-radius: 999px;
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    font-size: 11.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1.5px solid var(--chip-bd);
    background: var(--chip-bg);
    color: var(--chip-ink);
    cursor: pointer;
    transition: all 0.16s ease;
  }
  .topic-btn:hover { border-color: var(--tb-accent); color: var(--tb-accent); }
  .topic-btn.active-filter {
    border-color: var(--tb-accent);
    background: var(--tb-accent);
    color: #fff;
    box-shadow: 0 6px 16px -7px var(--tb-accent);
  }

  /* Pagination arrow buttons */
  .pag-arrow {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: rgb(107, 114, 128);
    background: transparent;
    cursor: pointer;
    transition: all 0.2s;
  }
  .pag-arrow:hover:not(:disabled) {
    border-color: rgba(139, 92, 246, 0.5);
    color: white;
  }
  .pag-arrow:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  body.light-mode .pag-arrow {
    border-color: rgba(0, 0, 0, 0.1);
    color: rgb(107, 114, 128);
  }
  body.light-mode .pag-arrow:hover:not(:disabled) {
    border-color: rgba(139, 92, 246, 0.4);
    color: rgb(109, 40, 217);
  }
</style>

<script>
  import { invalidatePostStatsCache, refreshPostStats } from '../../utils/postStats';

  // Home links: use history.back() if we came from / (preserves scroll)
  document.querySelectorAll<HTMLAnchorElement>('a[href="/"]').forEach(link => {
    link.addEventListener('click', e => {
      try {
        const ref = document.referrer;
        if (ref && new URL(ref).pathname === '/') {
          e.preventDefault();
          history.back();
        }
      } catch (_) {}
    });
  });

  const POSTS_PER_PAGE = 9;
  let currentPage = 1;
  let currentTopic = 'all';

  const grid = document.getElementById('posts-grid')!;
  const allItems = Array.from(grid.querySelectorAll<HTMLElement>('.post-item'));
  const paginationEl = document.getElementById('pagination')!;
  const pageNumbers = document.getElementById('page-numbers')!;
  const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
  const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
  const postsCount = document.getElementById('posts-count')!;
  const emptyState = document.getElementById('empty-state')!;
  const searchInput = document.getElementById('tb-search') as HTMLInputElement | null;
  const tbCount = document.getElementById('tb-count');
  const featuredEl = document.getElementById('tb-featured') as HTMLElement | null;
  const featuredId = featuredEl?.dataset.featuredId;
  const affiliateEl = document.getElementById('tb-affiliate') as HTMLElement | null;
  const affiliateEndEl = document.getElementById('tb-affiliate-end') as HTMLElement | null;
  let query = '';

  function getMatches(): HTMLElement[] {
    return allItems.filter(item => {
      const topics = JSON.parse(item.dataset.topics || '[]') as string[];
      const okTopic = currentTopic === 'all' || topics.some(t => t.toLowerCase() === currentTopic.toLowerCase());
      const okQuery = !query || (item.dataset.search || '').includes(query);
      return okTopic && okQuery;
    });
  }

  function render() {
    const matches = getMatches();

    // Featured shows only in the default state (All + no search). Excluded from the grid
    // on every page so it never duplicates; displayed only on page 1.
    const featuredMode = !!featuredEl && currentTopic === 'all' && query === '' && matches.length > 0;
    const gridItems = featuredMode ? matches.filter(it => it.dataset.id !== featuredId) : matches;
    const showFeatured = featuredMode && currentPage === 1;
    if (featuredEl) featuredEl.style.display = showFeatured ? '' : 'none';
    // Affiliate cards mirror the featured hero: only in the default (unfiltered) view.
    const showAffiliate = featuredMode && matches.length > 0;
    if (affiliateEl) affiliateEl.style.display = showAffiliate ? '' : 'none';
    if (affiliateEndEl) affiliateEndEl.style.display = showAffiliate ? '' : 'none';

    if (tbCount) tbCount.textContent = String(matches.length);

    const totalPages = Math.max(1, Math.ceil(gridItems.length / POSTS_PER_PAGE));
    if (currentPage > totalPages) currentPage = totalPages;

    const start = (currentPage - 1) * POSTS_PER_PAGE;
    const end = start + POSTS_PER_PAGE;
    const pageItems = gridItems.slice(start, end);

    allItems.forEach(item => { item.style.display = 'none'; });

    if (matches.length === 0) {
      emptyState.classList.remove('hidden');
      paginationEl.style.display = 'none';
      postsCount.textContent = '';
      return;
    }

    emptyState.classList.add('hidden');
    pageItems.forEach((item, i) => {
      item.style.display = '';
      const card = item.querySelector<HTMLElement>('.tb-card');
      if (card) {
        card.classList.remove('card-visible');
        card.style.opacity = '0';
        card.style.transform = 'translateY(24px)';
        setTimeout(() => {
          card.style.animationDelay = `${(i % 3) * 0.08}s`;
          card.classList.add('card-visible');
        }, 16);
      }
    });

    paginationEl.style.display = totalPages <= 1 ? 'none' : 'flex';
    prevBtn.disabled = currentPage <= 1;
    nextBtn.disabled = currentPage >= totalPages;
    buildPageNumbers(totalPages);

    if (gridItems.length === 0) {
      postsCount.textContent = '';
    } else {
      const shownEnd = Math.min(end, gridItems.length);
      postsCount.textContent = `Showing ${start + 1}–${shownEnd} of ${gridItems.length}${showFeatured ? ' + featured' : ''}`;
    }
  }

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      query = searchInput.value.trim().toLowerCase();
      currentPage = 1;
      render();
    });
  }
  document.getElementById('tb-clear')?.addEventListener('click', () => {
    query = '';
    currentTopic = 'all';
    currentPage = 1;
    if (searchInput) searchInput.value = '';
    document.querySelectorAll('.topic-btn').forEach(b => {
      b.classList.toggle('active-filter', (b as HTMLElement).dataset.topic === 'all');
    });
    render();
  });

  function buildPageNumbers(totalPages: number) {
    pageNumbers.innerHTML = '';
    const MAX = 5;
    let s = Math.max(1, currentPage - Math.floor(MAX / 2));
    let e = Math.min(totalPages, s + MAX - 1);
    if (e - s < MAX - 1) s = Math.max(1, e - MAX + 1);

    if (s > 1) {
      pageNumbers.appendChild(makePageBtn(1));
      if (s > 2) pageNumbers.appendChild(makeEllipsis());
    }
    for (let i = s; i <= e; i++) pageNumbers.appendChild(makePageBtn(i));
    if (e < totalPages) {
      if (e < totalPages - 1) pageNumbers.appendChild(makeEllipsis());
      pageNumbers.appendChild(makePageBtn(totalPages));
    }
  }

  function makePageBtn(n: number): HTMLButtonElement {
    const active = n === currentPage;
    const btn = document.createElement('button');
    btn.textContent = String(n);
    btn.setAttribute('style', [
      'width:2.25rem',
      'height:2.25rem',
      'border-radius:9999px',
      `border:1px solid ${active ? 'rgba(139,92,246,0.8)' : 'rgba(255,255,255,0.1)'}`,
      `background:${active ? 'rgba(139,92,246,0.15)' : 'transparent'}`,
      `color:${active ? 'rgb(167,139,250)' : 'rgb(107,114,128)'}`,
      'font-size:0.7rem',
      'font-weight:800',
      'cursor:pointer',
      'display:flex',
      'align-items:center',
      'justify-content:center',
      'transition:all 0.2s',
    ].join(';'));
    if (!active) {
      btn.addEventListener('mouseenter', () => {
        btn.style.borderColor = 'rgba(139,92,246,0.5)';
        btn.style.color = 'white';
      });
      btn.addEventListener('mouseleave', () => {
        btn.style.borderColor = 'rgba(255,255,255,0.1)';
        btn.style.color = 'rgb(107,114,128)';
      });
    }
    btn.addEventListener('click', () => {
      currentPage = n;
      render();
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    return btn;
  }

  function makeEllipsis(): HTMLSpanElement {
    const s = document.createElement('span');
    s.textContent = '…';
    s.setAttribute('style', 'color:rgb(107,114,128);font-size:0.75rem;padding:0 2px;');
    return s;
  }

  prevBtn.addEventListener('click', () => {
    if (currentPage > 1) { currentPage--; render(); window.scrollTo({ top: 0, behavior: 'smooth' }); }
  });
  nextBtn.addEventListener('click', () => {
    if (nextBtn.disabled) return;
    currentPage++; render(); window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  document.querySelectorAll<HTMLElement>('.topic-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.topic-btn').forEach(b => b.classList.remove('active-filter'));
      btn.classList.add('active-filter');
      currentTopic = btn.dataset.topic || 'all';
      currentPage = 1;
      render();
    });
  });

  // Like buttons
  function burstHearts(anchor: HTMLElement) {
    const rect = anchor.getBoundingClientRect();
    for (let i = 0; i < 6; i++) {
      const h = document.createElement('span');
      h.textContent = '♥';
      const angle = (i / 6) * 360;
      const dist = 28 + Math.random() * 20;
      const dx = Math.cos((angle * Math.PI) / 180) * dist;
      const dy = Math.sin((angle * Math.PI) / 180) * dist - 18;
      h.setAttribute('style', `position:fixed;left:${rect.left + rect.width / 2}px;top:${rect.top + rect.height / 2}px;font-size:${9 + Math.random() * 7}px;color:#f43f5e;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);transition:transform 0.6s ease-out,opacity 0.6s ease-out;will-change:transform,opacity;`);
      document.body.appendChild(h);
      requestAnimationFrame(() => {
        h.style.transform = `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) scale(0)`;
        h.style.opacity = '0';
      });
      setTimeout(() => h.remove(), 650);
    }
  }

  function pulseIcon(icon: HTMLElement) {
    icon.style.transform = 'scale(1.6)';
    icon.style.transition = 'transform 0.15s ease-out';
    setTimeout(() => {
      icon.style.transform = 'scale(1)';
      icon.style.transition = 'transform 0.2s ease-in';
    }, 150);
  }

  const API_URL = (document.querySelector<HTMLElement>('main[data-api-url]'))?.dataset.apiUrl || '';

  document.querySelectorAll<HTMLElement>('.tile-like-area').forEach(el => {
    const postId = el.dataset.id;
    const icon = el.querySelector<HTMLElement>('.tile-like-icon');
    const countEl = el.querySelector<HTMLElement>('.tile-like-count');
    const likedKey = `liked_${postId}`;
    let liked = localStorage.getItem(likedKey) === '1';
    let pending = false;

    function applyLiked(state: boolean) {
      liked = state;
      if (state) {
        icon?.setAttribute('fill', '#f43f5e');
        icon?.setAttribute('stroke', '#f43f5e');
        countEl?.classList.add('text-rose-400');
        countEl?.classList.remove('text-gray-500');
      } else {
        icon?.setAttribute('fill', 'none');
        icon?.setAttribute('stroke', 'currentColor');
        countEl?.classList.remove('text-rose-400');
        countEl?.classList.add('text-gray-500');
      }
    }

    applyLiked(liked);

    el.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (pending) return;
      el.dataset.userInteracted = '1';
      const nextLiked = !liked;
      if (nextLiked) { burstHearts(el); if (icon) pulseIcon(icon); }
      const endpoint = liked ? 'unlike' : 'like';
      pending = true;
      el.setAttribute('aria-busy', 'true');
      fetch(`${API_URL}/posts/${postId}/${endpoint}`, { method: 'POST', cache: 'no-store' })
        .then(r => r.ok ? r.json() : Promise.reject(new Error(`like ${r.status}`)))
        .then(d => {
          if (d.likes != null && countEl) countEl.textContent = String(d.likes);
          applyLiked(nextLiked);
          localStorage.setItem(likedKey, nextLiked ? '1' : '0');
          invalidatePostStatsCache();
          refreshPostStats();
        })
        .catch(() => {})
        .finally(() => {
          pending = false;
          el.removeAttribute('aria-busy');
        });
    });
  });

  render();
  refreshPostStats();

  // Topic chips: clamp to two rows on wide viewports, with a toggle to reveal the rest.
  // Mobile keeps the single horizontal-scroll row (no clamp).
  const chipsEl = document.getElementById('topic-filters');
  const chipsToggle = document.getElementById('chips-toggle') as HTMLButtonElement | null;
  let chipsExpanded = false;

  function clampChips() {
    if (!chipsEl || !chipsToggle) return;
    // Bail until the chips have actually been laid out — otherwise we'd measure a
    // single zero-width row and wrongly conclude there's nothing to clamp.
    if (chipsEl.getBoundingClientRect().width === 0) return;
    chipsEl.classList.remove('is-clamped');
    chipsEl.style.maxHeight = '';
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    if (isMobile) { chipsToggle.hidden = true; return; }
    if (chipsExpanded) { chipsToggle.hidden = false; return; }
    const btns = Array.from(chipsEl.querySelectorAll<HTMLElement>('.topic-btn'));
    if (!btns.length) return;
    const tops = [...new Set(btns.map(b => Math.round(b.getBoundingClientRect().top)))].sort((a, b) => a - b);
    if (tops.length <= 2) { chipsToggle.hidden = true; return; }
    const chipH = btns[0].getBoundingClientRect().height;
    chipsEl.style.maxHeight = `${(tops[1] - tops[0]) + chipH + 2}px`;
    chipsEl.classList.add('is-clamped');
    chipsToggle.hidden = false;
    chipsToggle.textContent = 'Show all tags';
  }

  chipsToggle?.addEventListener('click', () => {
    chipsExpanded = !chipsExpanded;
    if (chipsExpanded) {
      chipsEl?.classList.remove('is-clamped');
      if (chipsEl) chipsEl.style.maxHeight = '';
      chipsToggle.textContent = 'Show fewer tags';
    } else {
      clampChips();
    }
  });

  let chipsResizeTimer: number;
  window.addEventListener('resize', () => {
    window.clearTimeout(chipsResizeTimer);
    chipsResizeTimer = window.setTimeout(() => { if (!chipsExpanded) clampChips(); }, 150);
  });

  // Measure after layout is committed (double rAF), again on full load, and once
  // webfonts settle (chip widths shift the row breaks) — covers every timing.
  const scheduleClamp = () => { if (!chipsExpanded) clampChips(); };
  requestAnimationFrame(() => requestAnimationFrame(scheduleClamp));
  window.addEventListener('load', scheduleClamp);
  if (document.fonts?.ready) document.fonts.ready.then(scheduleClamp);
</script>
