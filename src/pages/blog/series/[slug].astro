---
// Thin route wrapper. getStaticPaths (shared with the /vi counterpart via
// seriesPaths) emits one page per playlist; the body lives in SeriesDetailPage.
import SeriesDetailPage from "../../../components/pages/SeriesDetailPage.astro";
import { seriesPaths } from "../../../utils/i18nPaths";

export async function getStaticPaths() {
  return seriesPaths();
}

const { playlist } = Astro.props;

if (!playlist) {
  return Astro.redirect('/blog/series');
}
---
<SeriesDetailPage playlist={playlist} />
