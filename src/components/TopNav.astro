---
import { getLocaleFromUrl, useTranslations, localizedHref, switchLocalePath, isBilingualPath } from '../i18n';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Language switcher targets: the counterpart of the current page in each locale,
// so switching keeps the reader on the same page. Only shown on bilingual (blog)
// pages — the rest of the site is English-only.
const showLangSwitch = isBilingualPath(Astro.url.pathname);
const enHref = switchLocalePath(Astro.url.pathname, 'en');
const viHref = switchLocalePath(Astro.url.pathname, 'vi');

interface Props {
  active?: 'home' | 'blog' | 'portfolio' | 'lab' | 'games' | null;
  ctaLabel?: string;
  ctaHref?: string;
}

const { active = null, ctaLabel = t('nav.cta'), ctaHref = '/#contact' } = Astro.props;

// Shared blueprint nav links (ported from the blueprint homepage). UI chrome is
// English in every locale by design; Tools/Live link out to their standalone hosts.
const links = [
  { key: 'home', label: 'HOME',          href: localizedHref(locale, '/') },
  { key: 'blog', label: 'BLOG / SERIES', href: localizedHref(locale, '/blog') },
  { key: 'lab',  label: 'APPS / TOOLS',  href: localizedHref(locale, '/lab') },
  { key: 'games', label: 'GAMES',        href: '/games' },
];

// "X / Y" labels render on a diagonal: first word hugs the top-left, an
// oversized slash is the tilted axis, second word hangs at the bottom-right.
// Split here; the desktop nav applies the stagger (mobile stays flat).
const labelParts = (label: string) => {
  const parts = label.split(' / ');
  return parts.length === 2 ? parts : null;
};

// Color-scheme picker presets. The swatch shows each scheme's accent; `id` maps to
// the html[data-scheme=…] palette blocks in Layout.astro and to window.setScheme.
const schemes = [
  { id: 'violet', hex: '#8b5cf6', label: 'Violet' },
  { id: 'ocean',  hex: '#3b82f6', label: 'Ocean'  },
  { id: 'ember',  hex: '#f97316', label: 'Ember'  },
  { id: 'forest', hex: '#10b981', label: 'Forest' },
  { id: 'rose',   hex: '#f43f5e', label: 'Rose'   },
  { id: 'mono',   hex: '#a1a1aa', label: 'Mono'   },
];
---

<!-- Blueprint drafting nav — one shared bar for the whole site (the homepage
     mockup's nav, extracted). Sticky-in-flow on the blueprint homepage
     (html.bp-home), fixed overlay on every other page (they pad their own top). -->
<nav class="bp-nav" data-bp-nav>
  <div class="bp-nav-wrap bp-nav-inner">
    <a href={localizedHref(locale, '/')} class="bp-nav-logo">
      <img src="/images/logo_icon.png" alt="Luci Studio Logo" class="bp-nav-logo-img" />
      <span class="bp-nav-name">LUCI <span class="text-shimmer">STUDIO</span><span class="bp-nav-name-dot">.</span></span>
    </a>

    <div class="bp-nav-links bp-nav-mono">
      {links.map((l) => {
        const parts = labelParts(l.label);
        return (
          <a
            href={l.href}
            class={active === l.key ? 'is-active' : undefined}
          >{parts ? <span class="bp-nav-diag"><span class="bp-nav-diag-1">{parts[0]}</span><span class="bp-nav-diag-sl">/</span><span class="bp-nav-diag-2">{parts[1]}</span></span> : l.label}</a>
        );
      })}
    </div>

    <div class="bp-nav-actions">
      {showLangSwitch && (
        <div class="bp-nav-lang bp-nav-mono">
          <a href={enHref} class={locale === 'en' ? 'is-active' : undefined} aria-label="English">EN</a>
          <span aria-hidden="true">/</span>
          <a href={viHref} class={locale === 'vi' ? 'is-active' : undefined} aria-label="Tiếng Việt">VI</a>
        </div>
      )}

      <button type="button" id="theme-toggle" class="bp-nav-icon" aria-label={t('nav.toggleTheme')} onclick="window.toggleTheme && window.toggleTheme()">
        <svg class="bp-nav-svg dark-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
        <svg class="bp-nav-svg light-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
      </button>

      <div class="bp-scheme">
        <button type="button" id="scheme-toggle" class="bp-nav-icon" aria-label={t('nav.colorScheme')} aria-controls="scheme-popover" aria-expanded="false">
          <svg class="bp-nav-svg" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 0 0 5.304 0l6.401-6.402M6.75 21A3.75 3.75 0 0 1 3 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 0 0 3.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.88 2.88M6.75 17.25h.008v.008H6.75v-.008Z" /></svg>
        </button>
        <div id="scheme-popover" role="radiogroup" aria-label={t('nav.colorScheme')} class="bp-scheme-popover" hidden>
          {schemes.map((s) => (
            <button type="button" class="scheme-dot" role="radio" data-scheme={s.id} aria-checked="false" aria-label={s.label} title={s.label} style={`background:${s.hex}`}></button>
          ))}
        </div>
      </div>

      <a href={ctaHref} class="bp-nav-cta bp-nav-mono">{ctaLabel}</a>

      <button type="button" class="bp-nav-burger" aria-label="Menu" aria-expanded="false" onclick="var n=document.querySelector('[data-bp-nav]');var o=n.classList.toggle('menu-open');this.setAttribute('aria-expanded',String(o))">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="bp-nav-mobile bp-nav-mono">
    {links.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
    {showLangSwitch && (
      <div class="bp-nav-lang is-mobile">
        <a href={enHref} class={locale === 'en' ? 'is-active' : undefined} aria-label="English">EN</a>
        <span aria-hidden="true">/</span>
        <a href={viHref} class={locale === 'vi' ? 'is-active' : undefined} aria-label="Tiếng Việt">VI</a>
      </div>
    )}
    <a href={ctaHref} class="bp-nav-mobile-cta">{ctaLabel}</a>
  </div>
</nav>

<script>
  // Theme icon sync (sun/moon) — idempotent alongside the Layout theme script.
  const syncTheme = () => {
    const light = document.documentElement.classList.contains('light-mode');
    document.querySelectorAll('.dark-icon').forEach(el => el.classList.toggle('hidden', light));
    document.querySelectorAll('.light-icon').forEach(el => el.classList.toggle('hidden', !light));
  };
  syncTheme();
  document.getElementById('theme-toggle')?.addEventListener('click', () => requestAnimationFrame(syncTheme));

  // Color-scheme picker popover. window.setScheme + the swatch aria-checked sync
  // are provided globally by the Layout theme script; this only handles
  // opening/closing the popover and forwarding swatch clicks.
  const schemeToggle = document.getElementById('scheme-toggle');
  const schemePopover = document.getElementById('scheme-popover');
  if (schemeToggle && schemePopover) {
    const closeSchemePopover = () => {
      const hadFocus = schemePopover.contains(document.activeElement);
      schemePopover.hidden = true;
      schemeToggle.setAttribute('aria-expanded', 'false');
      if (hadFocus) schemeToggle.focus(); // return focus to the trigger
    };
    schemeToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = schemePopover.hidden;
      schemePopover.hidden = !willOpen;
      schemeToggle.setAttribute('aria-expanded', String(willOpen));
      if (willOpen) {
        // move focus to the active swatch (fallback: first) for keyboard users
        const target = schemePopover.querySelector('.scheme-dot[aria-checked="true"]')
          || schemePopover.querySelector('.scheme-dot');
        (target as HTMLElement | null)?.focus();
      }
    });
    schemePopover.querySelectorAll('.scheme-dot').forEach((d) => {
      d.addEventListener('click', () => {
        const name = (d as HTMLElement).dataset.scheme;
        const setScheme = (window as any).setScheme;
        if (name && typeof setScheme === 'function') setScheme(name);
        closeSchemePopover();
      });
    });
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!schemePopover.hidden && !schemePopover.contains(target) && !schemeToggle.contains(target)) {
        closeSchemePopover();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !schemePopover.hidden) closeSchemePopover();
    });
  }
</script>

<style>
  /* ── Blueprint nav (ported from the blueprint homepage) ──────────────────
     On html.bp-home the --bp-* tokens are inherited from the homepage's token
     block (fixed blueprint-blue accent). Everywhere else the fallbacks below
     map them onto the site's theme/scheme variables, so the accent follows
     the active color scheme like the rest of each page. */
  :global(html:not(.bp-home)) .bp-nav {
    --bp-ink: var(--text-primary);
    --bp-acc: var(--accent);
    --bp-bg: var(--bg-primary);
    --bp-muted: color-mix(in srgb, var(--text-primary) 58%, transparent);
    --bp-hair: rgba(255, 255, 255, 0.14);
    --bp-line2: rgba(255, 255, 255, 0.08);
  }
  :global(html:not(.bp-home) body.light-mode) .bp-nav {
    --bp-hair: rgba(22, 32, 43, 0.16);
    --bp-line2: rgba(22, 32, 43, 0.08);
  }

  .bp-nav {
    /* Define the nav-glass vars ON the nav element (navDimmer resolves
       var(--nav-bg-scroll) here on scroll). Non-home pages inherit the
       theme-aware :root values instead. */
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--bp-hair);
    transition: transform 0.3s ease;
  }
  /* Hide-on-scroll-down / reveal-on-scroll-up (toggled by navDimmer.ts).
     Never applied while the mobile dropdown is open — see navDimmer.ts. */
  .bp-nav.nav-hidden {
    transform: translateY(-100%);
  }
  /* Blueprint homepage: the nav is part of the drafting sheet — sticky in flow,
     with the sheet-tinted glass the mockup specifies. */
  :global(html.bp-home) .bp-nav {
    --nav-bg: rgba(10, 14, 20, 0.78);
    --nav-bg-scroll: rgba(10, 14, 20, 0.92);
    position: sticky;
    z-index: 40;
  }
  :global(html.bp-home body.light-mode) .bp-nav {
    --nav-bg: rgba(244, 242, 236, 0.82);
    --nav-bg-scroll: rgba(244, 242, 236, 0.94);
  }

  .bp-nav-wrap {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: clamp(20px, 5vw, 48px);
    padding-right: clamp(20px, 5vw, 48px);
  }
  .bp-nav-mono { font-family: "IBM Plex Mono", ui-monospace, monospace; }

  .bp-nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding-top: 15px; padding-bottom: 15px; }
  .bp-nav-logo { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
  .bp-nav-logo-img { width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0; }
  .bp-nav-name { font-family: "Limelight", sans-serif; font-weight: normal; font-size: 20px; letter-spacing: 0.02em; color: var(--bp-ink); white-space: nowrap; }
  .bp-nav-name-dot { color: var(--bp-acc); }
  .bp-nav-links { display: flex; align-items: center; gap: 30px; }
  .bp-nav-links a { position: relative; font-size: 12px; letter-spacing: 0.16em; color: var(--bp-muted); text-decoration: none; transition: color 0.2s ease; }
  .bp-nav-links a:hover, .bp-nav-links a.is-active { color: var(--bp-ink); }
  .bp-nav-links a.is-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -7px; height: 2px; background: var(--bp-acc); }
  /* Diagonal two-word labels (e.g. "BLOG / SERIES"): first word hugs the
     top-left, an oversized slash is the tilted axis, second word hangs at the
     bottom-right. The tall slash stretches the inline-flex so the align-self
     offsets read as a downward diagonal. */
  .bp-nav-diag { display: inline-flex; align-items: stretch; }
  .bp-nav-diag-1 { align-self: flex-start; }
  .bp-nav-diag-sl { display: inline-block; font-size: 1.45em; line-height: 0.8; font-weight: 400; color: var(--bp-muted); margin: 0 1px; transform: scaleX(0.62); }
  .bp-nav-diag-2 { align-self: flex-end; }
  .bp-nav-links a.is-active .bp-nav-diag-sl { color: var(--bp-acc); }
  .bp-nav-actions { display: flex; align-items: center; gap: 11px; }
  .bp-nav-lang { display: flex; align-items: center; gap: 6px; font-size: 11px; letter-spacing: 0.16em; }
  .bp-nav-lang a { color: var(--bp-muted); text-decoration: none; transition: color 0.2s ease; }
  .bp-nav-lang a:hover { color: var(--bp-ink); }
  .bp-nav-lang a.is-active { color: var(--bp-acc); }
  .bp-nav-lang span { color: var(--bp-hair); }
  .bp-nav-icon { width: 36px; height: 36px; border: 1.5px solid var(--bp-hair); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; color: var(--bp-muted); background: transparent; cursor: pointer; transition: border-color 0.2s ease, color 0.2s ease; }
  .bp-nav-icon:hover { border-color: var(--bp-ink); color: var(--bp-ink); }
  .bp-nav-svg { width: 18px; height: 18px; }

  /* Color-scheme picker (the global window.setScheme + theme.ts syncSchemeUI
     drive it, this only styles the popover). */
  .bp-scheme { position: relative; }
  .bp-scheme-popover {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.55rem;
    padding: 0.6rem;
    border-radius: 0.85rem;
    background: var(--nav-bg-scroll);
    border: 1px solid var(--bp-hair);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.28);
    z-index: 110;
  }
  .bp-scheme-popover[hidden] { display: none; }
  .scheme-dot {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    cursor: pointer;
    border: 2px solid transparent;
    box-shadow: 0 0 0 1px rgba(120, 120, 120, 0.45);
    transition: transform 0.15s ease;
  }
  .scheme-dot:hover { transform: scale(1.18); }
  .scheme-dot:focus-visible { outline: 2px solid var(--bp-ink); outline-offset: 2px; }
  .scheme-dot[aria-checked="true"] { box-shadow: 0 0 0 2px var(--nav-bg-scroll), 0 0 0 4px var(--bp-ink); }

  .bp-nav-cta { padding: 10px 20px; background: var(--bp-ink); color: var(--bp-bg); border-radius: 24px; font-size: 12px; letter-spacing: 0.1em; text-decoration: none; white-space: nowrap; text-transform: uppercase; transition: background 0.2s ease, color 0.2s ease; }
  .bp-nav-cta:hover { background: var(--bp-acc); color: #fff; }
  .bp-nav-burger { display: none; width: 40px; height: 40px; flex-direction: column; align-items: center; justify-content: center; gap: 4px; background: transparent; border: 1.5px solid var(--bp-hair); border-radius: 9px; cursor: pointer; }
  .bp-nav-burger span { display: block; width: 16px; height: 1.5px; background: var(--bp-ink); }
  .bp-nav-mobile { display: none; flex-direction: column; padding: 4px 0 14px; }
  .bp-nav-mobile a { padding: 12px clamp(20px, 5vw, 48px); font-size: 13px; letter-spacing: 0.16em; color: var(--bp-muted); text-decoration: none; }
  .bp-nav-mobile a:hover { color: var(--bp-ink); }
  .bp-nav-mobile .bp-nav-lang.is-mobile { padding: 12px clamp(20px, 5vw, 48px); font-size: 13px; }
  .bp-nav-mobile .bp-nav-lang.is-mobile a { padding: 0; }
  .bp-nav-mobile-cta { color: var(--bp-acc) !important; text-transform: uppercase; }
  @media (max-width: 860px) {
    .bp-nav-links, .bp-nav-cta { display: none; }
    .bp-nav-lang:not(.is-mobile) { display: none; }
    .bp-nav-burger { display: flex; }
    .bp-nav.menu-open .bp-nav-mobile { display: flex; }
    .bp-nav.menu-open { border-bottom-color: var(--bp-line2); }
  }
</style>
