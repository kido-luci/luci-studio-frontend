---
import { getLocaleFromUrl, useTranslations, localizedHref, switchLocalePath, isBilingualPath } from '../i18n';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

// Language switcher targets: the counterpart of the current page in each locale,
// so switching keeps the reader on the same page. Only shown on bilingual (blog)
// pages — the rest of the site is English-only.
const showLangSwitch = isBilingualPath(Astro.url.pathname);
const enHref = switchLocalePath(Astro.url.pathname, 'en');
const viHref = switchLocalePath(Astro.url.pathname, 'vi');

interface Props {
  active?: 'home' | 'blog' | 'series' | 'portfolio' | 'lab' | 'tools' | null;
  ctaLabel?: string;
  ctaHref?: string;
}

const { active = null, ctaLabel = t('nav.cta'), ctaHref = '/#contact' } = Astro.props;

const linkBase = "topnav-link text-xs font-bold transition-all duration-300 uppercase tracking-[0.2em]";
const linkIdle = "text-gray-400 hover:text-white";
const linkActive = "is-active text-violet-400";

const cls = (key: 'home' | 'blog' | 'series' | 'portfolio' | 'lab' | 'tools') => {
  if (active === key) return `${linkBase} ${linkActive}`;
  return `${linkBase} ${linkIdle}`;
};

const mobileBase = "mobile-nav-link text-4xl font-black tracking-tighter text-white hover:text-violet-500 transition-colors";
const mobileActive = "mobile-nav-link text-4xl font-black tracking-tighter text-violet-400";
const mobileSmallBase = "mobile-nav-link text-xl font-bold text-gray-300 uppercase tracking-widest";
const mobileSmallActive = "mobile-nav-link text-xl font-bold text-violet-400 uppercase tracking-widest";

// Color-scheme picker presets. The swatch shows each scheme's accent; `id` maps to
// the html[data-scheme=…] palette blocks in Layout.astro and to window.setScheme.
const schemes = [
  { id: 'violet', hex: '#8b5cf6', label: 'Violet' },
  { id: 'ocean',  hex: '#3b82f6', label: 'Ocean'  },
  { id: 'ember',  hex: '#f97316', label: 'Ember'  },
  { id: 'forest', hex: '#10b981', label: 'Forest' },
  { id: 'rose',   hex: '#f43f5e', label: 'Rose'   },
  { id: 'mono',   hex: '#a1a1aa', label: 'Mono'   },
];
---

<!-- NAV -->
<nav class="fixed top-0 w-full z-[100] border-b border-white/5" style="background:var(--nav-bg);backdrop-filter:blur(16px)">
  <div class="max-w-7xl mx-auto px-4 md:px-6 h-20 flex items-center justify-between">
    <a href={localizedHref(locale, '/')} class="flex items-center gap-3 group">
      <img src="/images/logo_icon.png" alt="Luci Studio Logo" class="h-9 w-9 rounded-xl shadow-lg group-hover:shadow-violet-500/50 transition-all duration-300" />
      <span class="text-xl font-normal tracking-wide" style="font-family: 'Limelight', sans-serif;">LUCI <span class="text-shimmer">STUDIO</span><span class="text-violet-500">.</span></span>
    </a>
    <div class="hidden md:flex items-center gap-8">
      <a href={localizedHref(locale, '/')} class={cls('home')}>{t('nav.home')}</a>
      <a href={localizedHref(locale, '/blog')} class={cls('blog')}>{t('nav.blog')}</a>
      <a href={localizedHref(locale, '/blog/series')} class={cls('series')}>{t('nav.series')}</a>
      <a href={localizedHref(locale, '/lab')} class={cls('lab')}>{t('nav.lab')}</a>
      <a href="/tools" class={cls('tools')}>Tools</a>
    </div>

    <div class="flex items-center gap-4">
      {showLangSwitch && (
        <div class="lang-switch hidden sm:flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest">
          <a href={enHref} class={locale === 'en' ? 'text-violet-400' : 'text-gray-400 hover:text-white transition-colors'} aria-label="English">EN</a>
          <span class="text-gray-600" aria-hidden="true">/</span>
          <a href={viHref} class={locale === 'vi' ? 'text-violet-400' : 'text-gray-400 hover:text-white transition-colors'} aria-label="Tiếng Việt">VI</a>
        </div>
      )}
      <button
        id="theme-toggle"
        onclick="window.toggleTheme()"
        class="topnav-theme-btn w-10 h-10 flex items-center justify-center rounded-full border border-white/10 hover:border-violet-500/40 hover:bg-white/5 transition-all duration-300 group"
        aria-label={t('nav.toggleTheme')}
      >
        <svg class="topnav-theme-icon w-5 h-5 text-gray-400 group-hover:text-white transition-colors dark-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
        </svg>
        <svg class="topnav-theme-icon w-5 h-5 text-gray-400 group-hover:text-white transition-colors light-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
        </svg>
      </button>

      <!-- Color-scheme picker: palette button + popover of accent swatches -->
      <div class="scheme-picker relative">
        <button
          id="scheme-toggle"
          type="button"
          class="topnav-theme-btn w-10 h-10 flex items-center justify-center rounded-full border border-white/10 hover:border-violet-500/40 hover:bg-white/5 transition-all duration-300 group"
          aria-label={t('nav.colorScheme')}
          aria-controls="scheme-popover"
          aria-expanded="false"
        >
          <svg class="topnav-theme-icon w-5 h-5 text-gray-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.098 19.902a3.75 3.75 0 0 0 5.304 0l6.401-6.402M6.75 21A3.75 3.75 0 0 1 3 17.25V4.125C3 3.504 3.504 3 4.125 3h5.25c.621 0 1.125.504 1.125 1.125v4.072M6.75 21a3.75 3.75 0 0 0 3.75-3.75V8.197M6.75 21h13.125c.621 0 1.125-.504 1.125-1.125v-5.25c0-.621-.504-1.125-1.125-1.125h-4.072M10.5 8.197l2.88-2.88c.438-.439 1.15-.439 1.59 0l3.712 3.713c.44.44.44 1.152 0 1.59l-2.88 2.88M6.75 17.25h.008v.008H6.75v-.008Z" />
          </svg>
        </button>
        <div id="scheme-popover" role="radiogroup" aria-label={t('nav.colorScheme')} class="scheme-popover" hidden>
          {schemes.map((s) => (
            <button
              type="button"
              class="scheme-dot"
              role="radio"
              data-scheme={s.id}
              aria-checked="false"
              aria-label={s.label}
              title={s.label}
              style={`background:${s.hex}`}
            ></button>
          ))}
        </div>
      </div>

      <a href={ctaHref} class="magnetic hidden sm:block px-5 py-2.5 bg-white text-black text-xs font-black rounded-full hover:bg-violet-500 hover:text-white transition-all duration-300 uppercase tracking-widest">{ctaLabel}</a>

      <button id="mobile-menu-toggle" class="md:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5 z-[100] group">
        <span class="w-6 h-0.5 transition-transform duration-300 group-[.active]:rotate-45 group-[.active]:translate-y-2" style="background-color: var(--text-primary);"></span>
        <span class="w-6 h-0.5 transition-opacity duration-300 group-[.active]:opacity-0" style="background-color: var(--text-primary);"></span>
        <span class="w-6 h-0.5 transition-transform duration-300 group-[.active]:-rotate-45 group-[.active]:-translate-y-2" style="background-color: var(--text-primary);"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 bg-black/95 backdrop-blur-3xl z-[90] flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-all duration-500">
  <a href={localizedHref(locale, '/')} class={active === 'home' ? mobileActive : mobileBase}>{t('nav.home')}</a>
  <a href={localizedHref(locale, '/blog')} class={active === 'blog' ? mobileActive : mobileBase}>{t('nav.blog')}</a>
  <a href={localizedHref(locale, '/blog/series')} class={active === 'series' ? mobileActive : mobileBase}>{t('nav.series')}</a>
  <div class="h-px w-12 bg-white/10 my-4"></div>
  <a href={localizedHref(locale, '/lab')} class={active === 'lab' ? mobileSmallActive : mobileSmallBase}>{t('nav.lab')}</a>
  <a href="/tools" class={active === 'tools' ? mobileSmallActive : mobileSmallBase}>Tools</a>
  {showLangSwitch && (
    <div class="flex items-center gap-3 mt-4 text-lg font-bold uppercase tracking-widest">
      <a href={enHref} class={locale === 'en' ? 'text-violet-400' : 'text-gray-300'} aria-label="English">EN</a>
      <span class="text-gray-600" aria-hidden="true">/</span>
      <a href={viHref} class={locale === 'vi' ? 'text-violet-400' : 'text-gray-300'} aria-label="Tiếng Việt">VI</a>
    </div>
  )}
  <a href={ctaHref} class="mobile-nav-link mt-8 px-8 py-4 bg-white text-black font-black rounded-full uppercase tracking-widest">{ctaLabel}</a>
</div>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu   = document.getElementById('mobile-menu');
  const links  = document.querySelectorAll('.mobile-nav-link');

  toggle?.addEventListener('click', () => {
    toggle.classList.toggle('active');
    menu?.classList.toggle('opacity-100');
    menu?.classList.toggle('pointer-events-auto');
    document.body.style.overflow = toggle.classList.contains('active') ? 'hidden' : '';
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      toggle?.classList.remove('active');
      menu?.classList.remove('opacity-100');
      menu?.classList.remove('pointer-events-auto');
      document.body.style.overflow = '';
    });
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 768 || window.matchMedia('(orientation: landscape)').matches) {
      if (toggle?.classList.contains('active')) {
        toggle.classList.remove('active');
        menu?.classList.remove('opacity-100', 'pointer-events-auto');
        document.body.style.overflow = '';
      }
    }
  });

  const syncTheme = () => {
    const light = document.documentElement.classList.contains('light-mode');
    document.querySelectorAll('.dark-icon').forEach(el => el.classList.toggle('hidden', light));
    document.querySelectorAll('.light-icon').forEach(el => el.classList.toggle('hidden', !light));
  };
  syncTheme();
  document.getElementById('theme-toggle')?.addEventListener('click', () => requestAnimationFrame(syncTheme));

  // Color-scheme picker popover
  const schemeToggle = document.getElementById('scheme-toggle');
  const schemePopover = document.getElementById('scheme-popover');
  if (schemeToggle && schemePopover) {
    const closeSchemePopover = () => {
      const hadFocus = schemePopover.contains(document.activeElement);
      schemePopover.hidden = true;
      schemeToggle.setAttribute('aria-expanded', 'false');
      if (hadFocus) schemeToggle.focus(); // return focus to the trigger
    };
    schemeToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = schemePopover.hidden;
      schemePopover.hidden = !willOpen;
      schemeToggle.setAttribute('aria-expanded', String(willOpen));
      if (willOpen) {
        // move focus to the active swatch (fallback: first) for keyboard users
        const target = schemePopover.querySelector('.scheme-dot[aria-checked="true"]')
          || schemePopover.querySelector('.scheme-dot');
        (target as HTMLElement | null)?.focus();
      }
    });
    schemePopover.querySelectorAll('.scheme-dot').forEach((d) => {
      d.addEventListener('click', () => {
        const name = (d as HTMLElement).dataset.scheme;
        const setScheme = (window as any).setScheme;
        if (name && typeof setScheme === 'function') setScheme(name);
        closeSchemePopover();
      });
    });
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!schemePopover.hidden && !schemePopover.contains(target) && !schemeToggle.contains(target)) {
        closeSchemePopover();
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !schemePopover.hidden) closeSchemePopover();
    });
  }
</script>

<style is:global>
  /* Brighter nav link text in dark mode for better contrast over the translucent nav bg */
  body:not(.light-mode) nav .topnav-link {
    color: rgb(229, 231, 235) !important; /* gray-200 */
  }
  body:not(.light-mode) nav .topnav-link:hover {
    color: #ffffff !important;
  }
  body:not(.light-mode) nav .topnav-link.is-active {
    color: var(--accent) !important; /* violet-400 keeps active state */
  }

  /* Theme toggle button — light-mode contrast fix */
  body.light-mode .topnav-theme-btn {
    border-color: rgba(17, 24, 39, 0.2) !important;
  }
  body.light-mode .topnav-theme-btn:hover {
    border-color: rgb(var(--accent-rgb) / 0.6) !important;
    background-color: rgb(var(--accent-rgb) / 0.08) !important;
  }
  body.light-mode .topnav-theme-icon {
    color: rgb(31, 41, 55) !important;
  }
  body.light-mode .topnav-theme-btn:hover .topnav-theme-icon {
    color: var(--accent) !important;
  }

  /* Color-scheme picker */
  .scheme-popover {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.55rem;
    padding: 0.6rem;
    border-radius: 0.85rem;
    background: var(--nav-bg-scroll);
    border: 1px solid var(--border-color);
    backdrop-filter: blur(16px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.3);
    z-index: 110;
  }
  .scheme-popover[hidden] { display: none; }
  .scheme-dot {
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    cursor: pointer;
    border: 2px solid transparent;
    box-shadow: 0 0 0 1px rgba(120, 120, 120, 0.45); /* visible ring on light + dark popover */
    transition: transform 0.15s ease;
  }
  .scheme-dot:hover { transform: scale(1.18); }
  .scheme-dot:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }
  .scheme-dot[aria-checked="true"] {
    box-shadow: 0 0 0 2px var(--bg-primary), 0 0 0 4px var(--text-primary);
  }

  /* Mobile menu overlay — always dark regardless of theme */
  body.light-mode #mobile-menu {
    background: rgba(0, 0, 0, 0.95) !important;
  }
  body.light-mode #mobile-menu .mobile-nav-link {
    color: white !important;
  }
  body.light-mode #mobile-menu .mobile-nav-link:hover {
    color: var(--accent) !important;
  }
  body.light-mode #mobile-menu a.text-violet-400,
  body.light-mode #mobile-menu .mobile-nav-link.text-violet-400 {
    color: var(--accent) !important;
  }
  /* "Let's Talk" button in mobile menu stays white bg / black text */
  body.light-mode #mobile-menu a[class*="bg-white"][class*="text-black"] {
    background: white !important;
    color: black !important;
  }
  /* Divider line in mobile menu */
  body.light-mode #mobile-menu .h-px {
    background-color: rgba(255, 255, 255, 0.1) !important;
  }
  /* Small links (LinkedIn, Portfolio) */
  body.light-mode #mobile-menu .text-gray-300 {
    color: rgb(209, 213, 219) !important;
  }
</style>
