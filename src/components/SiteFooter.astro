---
// Shared "END OF SHEET — LET'S BUILD" CTA + site footer — the blueprint
// drafting-sheet closer dropped at the bottom of every page's <main>. Extracted
// from the homepage so it's one source of truth; self-fetches profile so callers
// only need to pass `locale`. Relies on the host page's blueprint tokens
// (--bp-acc/--bp-ink/--bp-muted/--bp-faint/--bp-hair/--bp-line2, --accent-ink)
// already being in scope — every page in the blueprint rollout defines them.
import FooterLinks from "./FooterLinks.astro";
import { profileService } from "../services/profile";
import { localizedHref, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const profile = await profileService.getProfile();

const sitemapLinks = [
  { label: "Home", href: localizedHref(locale, "/") },
  { label: "Blog", href: localizedHref(locale, "/blog") },
  { label: "Series", href: localizedHref(locale, "/blog/series") },
  { label: "Lab", href: localizedHref(locale, "/lab") },
  { label: "Videos", href: "/videos/" },
];
const makeLinks = [
  { label: "Tools", href: "/lab#hubs", ext: false },
  { label: "Games", href: "/games/", ext: false },
  { label: "Apps", href: "/#work", ext: false },
  { label: "Art", href: "/#art", ext: false },
];
---

<section class="bp-cta" id="contact">
  <span class="bp-cta-graph" aria-hidden="true">
    <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
      <line class="bp-g-edge" x1="60" y1="60" x2="24" y2="30"></line>
      <line class="bp-g-edge" x1="60" y1="60" x2="98" y2="26"></line>
      <line class="bp-g-edge" x1="60" y1="60" x2="96" y2="94"></line>
      <line class="bp-g-edge" x1="60" y1="60" x2="28" y2="92"></line>
      <line class="bp-g-edge bp-g-edge--faint" x1="24" y1="30" x2="98" y2="26"></line>
      <line class="bp-g-edge bp-g-edge--faint" x1="28" y1="92" x2="96" y2="94"></line>
      <line class="bp-g-pulse bp-g-pulse--1" x1="60" y1="60" x2="24" y2="30"></line>
      <line class="bp-g-pulse bp-g-pulse--2" x1="60" y1="60" x2="98" y2="26"></line>
      <line class="bp-g-pulse bp-g-pulse--3" x1="60" y1="60" x2="96" y2="94"></line>
      <circle class="bp-g-node" cx="24" cy="30" r="2.6"></circle>
      <circle class="bp-g-node" cx="98" cy="26" r="2.6"></circle>
      <circle class="bp-g-node" cx="96" cy="94" r="2.6"></circle>
      <circle class="bp-g-node" cx="28" cy="92" r="2.6"></circle>
      <circle class="bp-g-hub" cx="60" cy="60" r="4"></circle>
      <circle class="bp-g-hub-ping" cx="60" cy="60" r="4"></circle>
    </svg>
  </span>
  <!-- Rotating blueprint ring — relocated here from the hero (the ocean scene
       took its spot on the homepage). Shown only when html.ocean-on so the
       non-ocean fallback keeps it in the hero; large + faint on the right,
       mirroring where it opened the page. -->
  <span class="bp-cta-ring" aria-hidden="true">
    <svg viewBox="0 0 420 420" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor">
      <circle cx="210" cy="210" r="200" stroke-opacity="0.10"></circle>
      <circle cx="210" cy="210" r="150" stroke-opacity="0.14"></circle>
      <circle cx="210" cy="210" r="96" class="cr-acc" stroke-width="2.5" stroke-opacity="0.7"></circle>
      <line x1="8" y1="210" x2="412" y2="210" stroke-opacity="0.08"></line>
      <line x1="210" y1="8" x2="210" y2="412" stroke-opacity="0.08"></line>
      <circle cx="210" cy="210" r="200" class="cr-acc cr-spin" stroke-opacity="0.45" stroke-dasharray="2 9"></circle>
      <rect x="280" y="256" width="12" height="12" stroke-opacity="0.2"></rect>
      <circle cx="210" cy="210" r="6" class="cr-ping"></circle>
      <circle cx="210" cy="210" r="5" class="cr-orange"></circle>
      <g class="cr-orbit cr-orbit-a"><circle cx="306" cy="114" r="4" class="cr-acc-fill"></circle></g>
      <g class="cr-orbit cr-orbit-b"><circle cx="138" cy="300" r="3" class="cr-orange"></circle></g>
    </svg>
  </span>
  <div class="bp-cta-inner bp-wrap">
    <div class="bp-cta-label" data-reveal>
      <span class="bp-coord-dot" aria-hidden="true"></span>
      <span class="bp-mono">END OF SHEET — LET'S BUILD</span>
    </div>
    <h2 class="bp-display bp-cta-title" data-reveal>Got a hard problem? Let's talk.</h2>
    <div class="bp-cta-actions" data-reveal>
      <a href="mailto:kidoluci.work@gmail.com" class="bp-btn bp-cta-btn">Let's talk →</a>
      <a href="mailto:kidoluci.work@gmail.com" class="bp-mono bp-cta-mail">kidoluci.work@gmail.com</a>
      <a href="https://www.linkedin.com/in/kido-luci/" target="_blank" rel="noopener noreferrer" class="bp-mono bp-cta-mail">LinkedIn ↗</a>
    </div>
  </div>
</section>

<footer class="bp-footer">
  <div class="bp-wrap bp-footer-cols">
    <div class="bp-footer-brand">
      <a href={localizedHref(locale, "/")} class="bp-footer-logo">
        <img src="/images/logo_icon.png" alt="Luci Studio Logo" loading="lazy" />
        <span class="bp-display">LUCI STUDIO<em class="bp-acc-dot">.</em></span>
      </a>
      <p class="bp-footer-blurb">A creative engineering studio turning hard problems into shipped products.</p>
    </div>
    <div class="bp-footer-col">
      <span class="bp-mono bp-footer-head">SITEMAP</span>
      {sitemapLinks.map((l) => <a href={l.href} class="bp-footer-link">{l.label}</a>)}
    </div>
    <div class="bp-footer-col">
      <span class="bp-mono bp-footer-head">MAKE</span>
      {makeLinks.map((l) => (
        <a href={l.href} class="bp-footer-link" {...(l.ext ? { target: "_blank", rel: "noopener noreferrer" } : {})}>{l.label}</a>
      ))}
    </div>
    <div class="bp-footer-col">
      <span class="bp-mono bp-footer-head">ELSEWHERE</span>
      {(profile?.social_links ?? []).map((l) => (
        <a href={l.url} target="_blank" rel="noopener" class="bp-footer-link">{l.label}</a>
      ))}
    </div>
  </div>
  <div class="bp-wrap bp-footer-base">
    <span class="bp-mono bp-footer-copy">{profile?.copyright ?? "© 2026 LUCI STUDIO — ALL RIGHTS RESERVED"}</span>
    <span class="bp-footer-legal"><FooterLinks linkColor="bp-footer-link" /></span>
    <span class="bp-mono bp-footer-rev" aria-hidden="true">REV 1.0 / ✛ N10°49′</span>
  </div>
</footer>

<style>
  /* ── shared blueprint atoms (self-contained: Astro scoping means the host
     page's copies of these classes don't reach this component's elements) ── */
  .bp-wrap {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: clamp(20px, 5vw, 48px);
    padding-right: clamp(20px, 5vw, 48px);
  }
  .bp-display {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em !important;
    color: var(--bp-ink);
  }
  .bp-acc-dot { color: var(--bp-acc); font-style: normal; }
  .bp-coord-dot { width: 7px; height: 7px; background: #ff5b1a; flex-shrink: 0; }
  .bp-btn {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 13px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 13px 24px;
    border-radius: 8px;
    text-decoration: none;
    border: 1.5px solid transparent;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }

  /* ── CTA (fixed dark drafting band, both themes) ── */
  .bp-cta { position: relative; z-index: 1; margin-top: clamp(40px, 6vw, 72px); background: #11161d; color: #eceae3; overflow: hidden; }
  .bp-cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(236, 234, 227, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(236, 234, 227, 0.05) 1px, transparent 1px);
    background-size: 36px 36px;
    pointer-events: none;
  }
  .bp-cta-inner { position: relative; z-index: 1; padding-top: clamp(64px, 9vw, 96px); padding-bottom: clamp(64px, 9vw, 96px); }
  .bp-cta-label { display: flex; align-items: center; gap: 10px; margin-bottom: 26px; font-size: 12px; letter-spacing: 0.14em; color: var(--bp-acc); }
  .bp-cta-title { color: #eceae3; font-size: clamp(2.2rem, 6vw, 4.6rem); line-height: 0.98; letter-spacing: -0.03em !important; max-width: 900px; }
  .bp-cta-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 22px; margin-top: 34px; }
  .bp-cta-btn { background: var(--bp-acc); color: var(--accent-ink); border: none; font-size: 14px; }
  .bp-cta-btn:hover { filter: brightness(1.08); }
  .bp-cta-mail { font-size: 14px; color: rgba(236, 234, 227, 0.72); text-decoration: none; border-bottom: 1px solid rgba(236, 234, 227, 0.35); padding-bottom: 4px; transition: color 0.2s ease, border-color 0.2s ease; }
  .bp-cta-mail:hover { color: #fff; border-color: #fff; }

  /* ── FOOTER ── */
  .bp-footer { position: relative; z-index: 1; border-top: 1.5px solid var(--bp-hair); }
  .bp-footer-cols { display: flex; flex-wrap: wrap; gap: 40px 56px; padding-top: 52px; padding-bottom: 40px; }
  .bp-footer-brand { flex: 1 1 260px; max-width: 320px; }
  .bp-footer-logo { display: inline-flex; align-items: center; gap: 11px; text-decoration: none; }
  .bp-footer-logo img { width: 30px; height: 30px; border-radius: 8px; }
  .bp-footer-logo span { font-size: 18px; letter-spacing: 0.02em; color: var(--bp-ink); }
  .bp-footer-blurb { margin-top: 14px; font-size: 14px; line-height: 1.55; color: var(--bp-muted); }
  .bp-footer-col { display: flex; flex-direction: column; gap: 12px; }
  .bp-footer-head { font-size: 11px; letter-spacing: 0.14em; color: var(--bp-muted); margin-bottom: 4px; }
  :global(.bp-footer-link) { font-size: 14px; color: var(--bp-muted); text-decoration: none; transition: color 0.2s ease; }
  :global(.bp-footer-link:hover) { color: var(--bp-acc); }
  .bp-footer-base { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; padding-top: 16px; padding-bottom: 30px; border-top: 1px solid var(--bp-line2); }
  .bp-footer-copy { font-size: 11px; letter-spacing: 0.06em; color: var(--bp-muted); }
  .bp-footer-legal { display: inline-flex; gap: 18px; flex-wrap: wrap; }
  /* FooterLinks renders its own <a>/<button> (its own Astro scope) + hardcodes a
     Tailwind `hover:text-white` that would vanish on the cream sheet — reach in and
     re-tone it to the blueprint palette (accent on hover, legible in both themes). */
  .bp-footer-legal :global(a),
  .bp-footer-legal :global(button) { color: var(--bp-muted); font-size: 11px; letter-spacing: 0.08em; }
  .bp-footer-legal :global(a:hover),
  .bp-footer-legal :global(button:hover) { color: var(--bp-acc); }
  .bp-footer-rev { font-size: 11px; letter-spacing: 0.06em; color: var(--bp-muted); }

  /* ── Decorative node-graph instrument in the CTA band's top-right corner: a
     signal travels the edges out from the orange hub. On the fixed-dark band, so
     colours are hardcoded light + the page accent. Hidden ≤900px (text reclaims
     the corner) and under reduced-motion / win-perf-mode. ── */
  .bp-cta-graph { position: absolute; top: 24px; right: 30px; width: 112px; height: 112px; opacity: 0.55; pointer-events: none; z-index: 1; }
  .bp-cta-graph svg { display: block; width: 100%; height: 100%; }
  .bp-g-edge { stroke: rgba(236, 234, 227, 0.20); stroke-width: 1; }
  .bp-g-edge--faint { stroke: rgba(236, 234, 227, 0.10); }
  .bp-g-node { fill: var(--bp-acc); }
  .bp-g-hub { fill: #ff5b1a; }
  .bp-g-hub-ping { fill: none; stroke: #ff5b1a; stroke-width: 1.2; transform-box: view-box; transform-origin: 60px 60px; animation: bpCtaPing 2.6s ease-out infinite; }
  .bp-g-pulse { stroke: var(--bp-acc); stroke-width: 2; stroke-linecap: round; fill: none; }
  .bp-g-pulse--1 { stroke-dasharray: 7 300; animation: bpCtaP1 1.9s linear infinite; }
  .bp-g-pulse--2 { stroke-dasharray: 7 300; animation: bpCtaP2 1.9s linear infinite; animation-delay: 0.5s; }
  .bp-g-pulse--3 { stroke-dasharray: 7 300; animation: bpCtaP3 1.9s linear infinite; animation-delay: 1s; }
  @keyframes bpCtaP1 { from { stroke-dashoffset: 46.9; } to { stroke-dashoffset: -7; } }
  @keyframes bpCtaP2 { from { stroke-dashoffset: 51; } to { stroke-dashoffset: -7; } }
  @keyframes bpCtaP3 { from { stroke-dashoffset: 49.5; } to { stroke-dashoffset: -7; } }
  @keyframes bpCtaPing { 0% { transform: scale(1); opacity: 0.5; } 70% { opacity: 0; } 100% { transform: scale(3); opacity: 0; } }
  @media (max-width: 900px) { .bp-cta-graph { display: none; } }
  @media (prefers-reduced-motion: reduce) { .bp-g-pulse { display: none; } .bp-g-hub-ping { animation: none; } }
  :global(body.win-perf-mode) .bp-g-pulse { display: none; }

  /* ── Relocated hero ring (html.ocean-on only) ────────────────────────────
     On the homepage the ocean scene replaced the hero's rotating ring; it's
     rehomed here as the closing sheet's decoration. Off by default so the
     footer stays clean everywhere else; on ocean-on it takes over the corner
     from the small node graph (which hides). */
  :global(html.ocean-on) .bp-cta-graph { display: none; }
  /* Default styled + visible; hidden only when the ocean scene is OFF (so it
     shows on the homepage, where it was relocated from, and nowhere else).
     Inverted on purpose: a standalone `.bp-cta-ring { display:none }` base
     gets merged with other display:none rules and wins the cascade over the
     show rule, so gate visibility with :not() instead. */
  .bp-cta-ring {
    display: block;
    position: absolute;
    top: 50%;
    right: -5%;
    transform: translateY(-50%);
    width: min(48vw, 480px);
    aspect-ratio: 1;
    color: #eceae3;
    opacity: 0.55;
    pointer-events: none;
    z-index: 0;
    -webkit-mask-image: radial-gradient(circle, #000 52%, transparent 80%);
    mask-image: radial-gradient(circle, #000 52%, transparent 80%);
  }
  :global(html:not(.ocean-on)) .bp-cta-ring { display: none; }
  .bp-cta-ring svg { display: block; width: 100%; height: 100%; }
  .cr-acc { stroke: var(--bp-acc); }
  .cr-acc-fill { fill: var(--bp-acc); }
  .cr-orange { fill: #ff5b1a; }
  .cr-spin { transform-box: fill-box; transform-origin: center; animation: crSpin 44s linear infinite; }
  .cr-orbit { transform-box: view-box; transform-origin: center; }
  .cr-orbit-a { animation: crSpin 30s linear infinite; }
  .cr-orbit-b { animation: crSpin 24s linear infinite reverse; }
  .cr-ping { fill: none; stroke: #ff5b1a; stroke-width: 1.4; opacity: 0; transform-box: view-box; transform-origin: center; animation: crPing 2.8s ease-out infinite; }
  @keyframes crSpin { to { transform: rotate(360deg); } }
  @keyframes crPing { 0% { transform: scale(1); opacity: 0.5; } 70% { opacity: 0; } 100% { transform: scale(3.4); opacity: 0; } }
  @media (max-width: 640px) { :global(html.ocean-on) .bp-cta-ring { display: none; } }
  @media (prefers-reduced-motion: reduce) { .cr-spin, .cr-orbit, .cr-ping { animation: none !important; } }
  :global(body.win-perf-mode) .cr-spin,
  :global(body.win-perf-mode) .cr-orbit,
  :global(body.win-perf-mode) .cr-ping { animation: none !important; }
  :global(body.win-perf-mode) .bp-g-hub-ping { animation: none; }
</style>
