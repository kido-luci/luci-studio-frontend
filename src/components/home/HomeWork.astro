---
import { getLocaleFromUrl, localizedHref } from "../../i18n";

const locale = getLocaleFromUrl(Astro.url);

// §01 SELECTED WORK — a hand-picked set (app · game · open source · writing series).
// Cover-less items fall back to the striped drafting-fig pattern. `ext` opens
// external links in a new tab; the series link stays in-tab.
const selectedWork = [
  {
    n: "01",
    title: "MemoirMe",
    badge: "APP",
    year: "2024",
    desc: "Zero-knowledge RSA/AES encrypted diary with geolocation mapping, AI features, and cross-platform sync.",
    img: "https://media.luci-studio.com/MEMOIRME.webp",
    href: "https://memoirme.app/",
    fig: "app screenshot",
    ext: true,
    demo: "",
  },
  {
    n: "02",
    title: "Faldrop",
    badge: "GAME",
    year: "2026",
    desc: "A 2.5D block-stacker — extruded-cube pieces, combos and a global leaderboard, at 60fps on one canvas.",
    img: "https://faldrop.luci-studio.com/og-image.png",
    href: "https://faldrop.luci-studio.com",
    fig: "game capture",
    ext: true,
    demo: "/videos/faldrop-demo.mp4",
  },
  {
    n: "03",
    title: "Flutter Starter Template",
    badge: "OPEN SOURCE",
    year: "2026",
    desc: "A production-ready Flutter foundation: modular Clean Architecture, offline-first sync, JWT auth, Firebase, and a Go reference backend.",
    img: "/images/flutter-starter-template.webp",
    href: "https://github.com/kido-luci/flutter-starter-template",
    fig: "repo preview",
    ext: true,
    demo: "",
  },
  {
    n: "04",
    title: "Flutter & Dart",
    badge: "SERIES",
    year: "2026",
    desc: "A written series — Flutter architecture, state management, testing, DI and advanced Dart concepts.",
    img: "https://media.luci-studio.com/posts/covers/1779710466887355000.jpg",
    href: localizedHref(locale, "/blog/series/flutter-dart-1b6c8568/"),
    fig: "series cover",
    ext: false,
    demo: "",
  },
];
---

<!-- ===================== §01 SELECTED WORK ===================== -->
<section class="bp-section" id="work">
  <div class="bp-work-band">
    <div class="bp-wrap">
      <div class="bp-sec-head" data-reveal>
        <span class="bp-dot" aria-hidden="true"></span>
        <span class="bp-mono bp-sec-label">§01 — SELECTED WORK</span>
        <span class="bp-rule" aria-hidden="true"></span>
        <span class="bp-mono bp-sec-count">{String(selectedWork.length).padStart(2, "0")} PROJECTS</span>
      </div>
      <div class="bp-sec-title-row" data-reveal>
        <h2 class="bp-display bp-h2" data-ml9>Things I've shipped.</h2>
        <a href={localizedHref(locale, "/lab")} class="bp-mono bp-more">ALL WORK →</a>
      </div>
    </div>
  </div>
  <div class="bp-wrap">
    <div class="bp-work-grid">
      {selectedWork.map((w) => (
        <a
          href={w.href || "#work"}
          class={`bp-work-card${w.demo ? " bp-work-card--demo" : ""}`}
          data-reveal
          {...(w.ext ? { target: "_blank", rel: "noopener noreferrer" } : {})}
        >
          <div class={`bp-fig${w.img || w.demo ? "" : " bp-fig--striped"}`}>
            {w.demo ? (
              <Fragment>
                <div class="bp-fig-toggle bp-mono" role="group" aria-label="Preview mode">
                  <span class="is-active" role="button" tabindex="0" data-fmode="cover">COVER</span>
                  <span role="button" tabindex="0" data-fmode="demo">DEMO</span>
                </div>
                <img class="bp-fig-cover-img" src={w.img} alt={w.title} loading="lazy" />
                <video class="bp-fig-video" muted loop playsinline preload="none" aria-label={`${w.title} gameplay demo`}>
                  <source src={w.demo} type="video/mp4" />
                </video>
              </Fragment>
            ) : (
              w.img && <img src={w.img} alt={w.title} loading="lazy" />
            )}
            <span class="bp-mono bp-callout">fig.{w.n} — {w.fig} · 16:10</span>
            <span class="bp-mono bp-node">◦</span>
          </div>
          <div class="bp-work-meta">
            <span class="bp-display bp-work-title">{w.title}</span>
            <span class="bp-mono bp-badge">{w.badge}</span>
            {w.year && <span class="bp-mono bp-work-year">{w.year}</span>}
          </div>
          {w.desc && <p class="bp-work-desc">{w.desc}</p>}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  /* Crisp blueprint headings — cancel the site's light-mode heading drop-shadow
     filter. Scoped to THIS component's own .bp-display elements only; each home
     section component carries its own copy for its headings. */
  :global(body.light-mode) .bp-display { filter: none !important; }

  /* §01's title row gets the same fixed-dark drafting band as the closing CTA
     (SiteFooter's .bp-cta) — full-bleed, independent of light/dark mode. Only
     the header (label + "Things I've shipped."); the work-card grid below it
     stays on the page's own background. Re-pointing the blueprint tokens here
     (rather than touching every child rule) is what keeps the existing
     title/label styles legible without a rewrite — --bp-acc is already a
     fixed blueprint-blue on this page, so it's untouched. */
  .bp-work-band {
    position: relative;
    z-index: 1;
    background: #11161d;
    color: #eceae3;
    overflow: hidden;
    padding-top: clamp(40px, 6vw, 64px);
    /* The band reaches half a card's height below the title so the work-card
       grid (pulled up by the same amount, below) overlaps it — top half of the
       cards sits on the dark sheet, bottom half on the page. --work-band-extra
       (= half the first card's measured height) is set on the section by the
       script below so both the band and its sibling grid-wrap can read it. */
    padding-bottom: calc(clamp(40px, 6vw, 64px) + var(--work-band-extra, 0px));
    margin-bottom: 0;
    --bp-ink: #eceae3;
    --bp-muted: rgba(236, 234, 227, 0.72);
    --bp-faint: rgba(236, 234, 227, 0.5);
    --bp-hair: rgba(236, 234, 227, 0.14);
  }
  .bp-work-band::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(236, 234, 227, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(236, 234, 227, 0.05) 1px, transparent 1px);
    background-size: 36px 36px;
    pointer-events: none;
  }
  .bp-work-band .bp-wrap { position: relative; z-index: 1; }
  .bp-work-band .bp-sec-title-row { margin-bottom: 0; }
  /* Overlap: lift the grid up by half a card so its top half straddles the dark
     band; z-index above the band so the cards paint over the dark sheet. */
  .bp-work-band + .bp-wrap {
    position: relative;
    z-index: 2;
    margin-top: calc(-1 * var(--work-band-extra, 0px));
  }

  /* ── §01 SELECTED WORK ── */
  .bp-work-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(20px, 3vw, 30px); }
  .bp-work-card { text-decoration: none; display: block; }
  .bp-fig {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--bp-card);
    border: 1px solid var(--bp-hair);
    border-radius: 10px;
    overflow: hidden;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .bp-fig img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bp-fig--striped {
    background-image: repeating-linear-gradient(45deg, var(--bp-line2) 0, var(--bp-line2) 1px, transparent 1px, transparent 12px);
  }
  .bp-work-card:hover .bp-fig { transform: translateY(-4px); border-color: color-mix(in srgb, var(--bp-acc) 45%, transparent); }
  .bp-callout { position: absolute; left: 14px; bottom: 12px; font-size: 10px; letter-spacing: 0.06em; color: var(--bp-muted); }
  .bp-node { position: absolute; top: 10px; right: 14px; font-size: 12px; color: var(--bp-acc); }
  .bp-work-meta { display: flex; align-items: center; gap: 12px; margin-top: 16px; }
  .bp-work-title { font-size: clamp(1.25rem, 2.4vw, 1.6rem); }
  .bp-work-year { font-size: 11px; color: var(--bp-muted); margin-left: auto; }
  .bp-work-desc { margin-top: 8px; font-size: 14px; line-height: 1.55; color: var(--bp-muted); }

  /* §01 demo card — COVER/DEMO toggle (Faldrop): the cover image crossfades to an
     autoplaying, muted, looping gameplay <video> (same treatment as /games). */
  .bp-fig-cover-img,
  .bp-fig-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    transition: opacity 0.3s ease;
  }
  .bp-fig-cover-img { object-fit: cover; opacity: 1; }
  .bp-fig-video { object-fit: contain; opacity: 0; background: #0a0e14; }
  .bp-work-card--demo.is-demo .bp-fig-cover-img { opacity: 0; }
  .bp-work-card--demo.is-demo .bp-fig-video { opacity: 1; }
  /* Don't lift the card while the demo is playing. */
  .bp-work-card--demo.is-demo:hover .bp-fig { transform: none; }
  .bp-fig-toggle {
    position: absolute;
    top: 12px;
    left: 14px;
    z-index: 4;
    display: inline-flex;
    border-radius: 7px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(10, 14, 20, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .bp-fig-toggle span {
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    padding: 5px 10px;
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .bp-fig-toggle span.is-active { background: var(--bp-acc); color: #fff; }
  .bp-fig-toggle span:focus-visible { outline: 2px solid #fff; outline-offset: -2px; }

  @media (max-width: 720px) {
    .bp-work-grid { grid-template-columns: 1fr; }
  }
</style>

<script is:inline>
  // §01 COVER/DEMO toggle — mirrors the /games featured card: the cover crossfades
  // to a muted, looping gameplay video that autoplays. An IntersectionObserver
  // auto-switches Cover -> Demo ~2s after the card scrolls into view (skipped on
  // reduced motion, or if the visitor toggles first). preload stays 'none' until in view.
  (function () {
    var card = document.querySelector(".bp-work-card--demo");
    if (!card) return;
    var video = card.querySelector(".bp-fig-video");
    var btns = card.querySelectorAll(".bp-fig-toggle [data-fmode]");
    var userActed = false, autoTimer = null;
    function setDemo(on) {
      card.classList.toggle("is-demo", on);
      btns.forEach(function (b) {
        b.classList.toggle("is-active", (b.getAttribute("data-fmode") === "demo") === on);
      });
      if (video) { if (on) video.play().catch(function () {}); else video.pause(); }
    }
    btns.forEach(function (b) {
      function handle(e) {
        e.preventDefault(); e.stopPropagation();
        userActed = true;
        if (autoTimer) { clearTimeout(autoTimer); autoTimer = null; }
        setDemo(b.getAttribute("data-fmode") === "demo");
      }
      b.addEventListener("click", handle);
      b.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") handle(e); });
    });
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce && "IntersectionObserver" in window && video) {
      var io = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          obs.disconnect();
          video.preload = "auto";
          autoTimer = setTimeout(function () { if (!userActed) setDemo(true); }, 2000);
        });
      }, { threshold: 0.5 });
      io.observe(card);
    }
  })();
</script>

<script is:inline>
  // §01 dark band — set --work-band-extra to half the first work-card's
  // rendered height (measured, not guessed: the card's height changes with
  // viewport width and the grid's column count). It's set on the SECTION, not
  // the band, so the band and its sibling grid-wrap can both inherit it — the
  // band reaches down by it, the grid lifts up by it, and the cards overlap.
  (function () {
    var section = document.getElementById("work");
    var firstCard = document.querySelector(".bp-work-grid .bp-work-card");
    if (!section || !firstCard) return;
    var raf = false;
    function apply() {
      raf = false;
      section.style.setProperty("--work-band-extra", firstCard.offsetHeight / 2 + "px");
    }
    function schedule() {
      if (raf) return;
      raf = true;
      requestAnimationFrame(apply);
    }
    schedule();
    window.addEventListener("resize", schedule, { passive: true });
  })();
</script>
