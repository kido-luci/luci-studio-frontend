---
import { buildPostSlug, needsVietnameseSerif } from "../utils/blog";
import { getLocaleFromUrl, localizedHref } from "../i18n";
import type { SeriesView } from "../utils/series";

interface Props {
  series: SeriesView;
  // "editorial" — the /blog list strip card (default, unchanged).
  // "blueprint" — the /blog/series page card, in the homepage drafting-sheet DNA.
  variant?: "editorial" | "blueprint";
  // 1-based list position, used only by the blueprint variant's fig.NN callout.
  index?: number;
}

const { series: p, variant = "editorial", index } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const href = localizedHref(locale, `/blog/series/${buildPostSlug(p.title, p.id)}/`);
const count = p.post_ids?.length ?? 0;
const cover = p.cover_image_url;
const isVi = needsVietnameseSerif(p.title);
const titleSerif = isVi ? "font-family:'Playfair Display',Georgia,serif" : undefined;
// Blueprint titles stay sans. Space Grotesk lacks full Vietnamese diacritics, so a VN
// title falls back to a system sans that covers the glyphs (not a serif).
const bpTitleStyle = isVi ? "font-family:system-ui,'Segoe UI',sans-serif" : undefined;
const figNo = String(index ?? 1).padStart(2, "0");
// Single expression — Astro strips the whitespace between two adjacent `{}` exprs.
const postLabel = `${count} ${count === 1 ? "post" : "posts"}`;
---

{variant === "blueprint" ? (
  <a
    href={href}
    class="playlist-row bpc no-underline"
    data-playlist-post-ids={JSON.stringify(p.post_ids ?? [])}
  >
    <div
      class={`bpc-fig${cover ? " has-cover" : " bpc-fig--striped"}`}
      style={cover ? `background-image:url('${cover}')` : ""}
    >
      <span class="bpc-node" aria-hidden="true">◦</span>
      <span class="bpc-callout">fig.{figNo} · {postLabel}</span>
    </div>

    <div class="bpc-body">
      <div class="bpc-meta">
        <span class="bpc-meta-kicker">SERIES</span>
        <span class="bpc-sep">/</span>
        <span>{postLabel.toUpperCase()}</span>
        <span class="bpc-sep">/</span>
        <span class="bpc-stat">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <span class="playlist-views-count">{p.totalViews.toLocaleString()}</span>
        </span>
        <span class="bpc-sep">/</span>
        <span class="bpc-stat">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span class="playlist-likes-count">{p.totalLikes.toLocaleString()}</span>
        </span>
        <span class="bpc-sep">/</span>
        <span>{p.year}</span>
      </div>

      <h2 class="bpc-title" style={bpTitleStyle}>{p.title}</h2>
      {p.description && <p class="bpc-desc">{p.description}</p>}

      {p.topics.length > 0 && (
        <div class="bpc-tags">
          {p.topics.map((tp) => <span class="bpc-tag">{tp}</span>)}
        </div>
      )}

      <span class="bpc-cta">READ THE SERIES →</span>
    </div>

    <span class="bpc-arrow" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </span>
  </a>
) : (
  <a
    href={href}
    class="playlist-row series-card no-underline"
    data-playlist-post-ids={JSON.stringify(p.post_ids ?? [])}
  >
    <div
      class={`series-thumb${cover ? ' has-cover' : ''}`}
      style={cover ? `background-image:url('${cover}')` : ''}
    >
      {!cover && (
        <>
          <span class="thumb-deco thumb-deco-tl">{'{ }'}</span>
          <span class="thumb-deco thumb-deco-tr">&lt;/&gt;</span>
          <span class="thumb-glyph">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </span>
          <div class="thumb-center">
            <h3 class="thumb-title" style={titleSerif}>{p.title}</h3>
            <span class="thumb-caption">Curated guides · tips</span>
          </div>
        </>
      )}
      <span class="thumb-pill">{count} {count === 1 ? 'post' : 'posts'} · {p.year}</span>
    </div>

    <div class="series-body">
      <div class="series-meta">
        <span class="series-meta-kicker">Series</span>
        <span class="series-meta-sep">/</span>
        <span>{count} {count === 1 ? 'post' : 'posts'}</span>
        <span class="series-meta-sep">/</span>
        <span class="series-meta-stat">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <span class="playlist-views-count">{p.totalViews.toLocaleString()}</span>
        </span>
        <span class="series-meta-sep">/</span>
        <span class="series-meta-stat">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span class="playlist-likes-count">{p.totalLikes.toLocaleString()}</span>
        </span>
      </div>

      <h2 class="series-title" style={titleSerif}>{p.title}</h2>
      {p.description && <p class="series-desc">{p.description}</p>}

      {p.topics.length > 0 && (
        <div class="series-tags">
          {p.topics.map((t) => <span class="series-tag">{t}</span>)}
        </div>
      )}

      <span class="series-cta">Read the series →</span>
    </div>

    <span class="series-arrow" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </span>
  </a>
)}

<style>
  /* ====== Shared Series card — editorial style ======
     Self-contained tokens so the card works on /blog/series, the home
     strip, and the /blog list strip without relying on a page wrapper. */
  .series-card {
    --series-accent: var(--accent);
    --series-ink: var(--text-primary);
    --series-muted: var(--text-secondary, #6b7280);
    --series-card-bg: rgba(255, 255, 255, 0.02);
    --series-card-border: rgb(var(--accent-rgb) / 0.16);

    position: relative;
    display: grid;
    grid-template-columns: clamp(190px, 24%, 300px) 1fr auto;
    align-items: stretch;
    gap: 2.25rem;
    padding: 1.5rem;
    border: 1px solid var(--series-card-border);
    border-radius: 1.25rem;
    background: var(--series-card-bg);
    color: inherit; text-decoration: none;
    transition: border-color 0.4s ease, box-shadow 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .series-card:hover {
    border-color: rgb(var(--accent-rgb) / 0.5);
    box-shadow: 0 22px 60px -28px rgb(var(--accent-rgb) / 0.5);
    transform: translateY(-3px);
  }

  /* ---- Thumbnail panel ---- */
  .series-thumb {
    position: relative; overflow: hidden;
    border-radius: 0.85rem;
    min-height: 230px;
    background-color: #161430;
    background-image: linear-gradient(150deg, #221a4d 0%, #14152a 55%, #2b1c5e 100%);
    background-size: cover; background-position: center;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    isolation: isolate;
  }
  .series-thumb.has-cover::after {
    content: ''; position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(to top, rgba(20, 21, 42, 0.88) 0%, rgba(20, 21, 42, 0.25) 42%, rgba(20, 21, 42, 0.05) 100%);
  }
  .thumb-deco {
    position: absolute; top: 0.9rem; z-index: 2;
    font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.35);
  }
  .thumb-deco-tl { left: 1rem; }
  .thumb-deco-tr { right: 1rem; }
  .thumb-glyph {
    position: relative; z-index: 2;
    width: 56px; height: 56px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 1px dashed rgb(var(--accent-rgb) / 0.55);
    color: rgb(var(--accent-rgb) / 0.9);
    margin-bottom: 1.1rem;
  }
  .thumb-center { position: relative; z-index: 2; text-align: center; padding: 0 1.1rem; }
  .thumb-title {
    font-family: 'DM Serif Display', Georgia, serif; font-weight: 400;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem); line-height: 1.15;
    color: #fff; margin: 0;
  }
  .thumb-caption {
    display: block; margin-top: 0.6rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; font-weight: 400;
    text-transform: uppercase; letter-spacing: 0.22em; color: rgba(255, 255, 255, 0.5);
  }
  .thumb-pill {
    position: absolute; bottom: 1.1rem; left: 50%; transform: translateX(-50%); z-index: 2;
    padding: 0.35rem 0.85rem; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18); background: rgba(255, 255, 255, 0.08);
    font-family: 'JetBrains Mono', monospace; font-size: 0.58rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.18em; color: rgba(255, 255, 255, 0.85);
    white-space: nowrap;
  }

  /* ---- Body ---- */
  .series-body { min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 0.5rem 0; }
  .series-meta {
    display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap;
    font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; letter-spacing: 0.04em;
    color: var(--series-muted); margin-bottom: 0.85rem;
  }
  .series-meta-kicker { color: var(--series-accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; }
  .series-meta-sep { color: rgb(var(--accent-rgb) / 0.4); }
  .series-meta-stat { display: inline-flex; align-items: center; gap: 0.32rem; }
  .series-meta-stat svg { opacity: 0.8; }

  .series-title {
    font-family: 'DM Serif Display', Georgia, serif; font-weight: 400;
    font-size: clamp(1.7rem, 3vw, 2.6rem); line-height: 1.08; letter-spacing: -0.01em;
    color: var(--series-ink); margin: 0 0 0.85rem;
    transition: color 0.3s ease;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .series-card:hover .series-title { color: var(--series-accent); }
  .series-desc {
    font-family: 'Inter', sans-serif; font-size: 0.95rem; line-height: 1.6;
    color: var(--series-muted); margin: 0; max-width: 46rem;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
  }
  .series-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.1rem; }
  .series-tag {
    padding: 0.3rem 0.8rem; border-radius: 999px;
    border: 1px solid var(--series-card-border);
    font-family: 'JetBrains Mono', monospace; font-size: 0.62rem; letter-spacing: 0.06em;
    color: var(--series-muted); white-space: nowrap;
  }
  .series-cta {
    display: inline-block; margin-top: 1.35rem;
    font-family: 'JetBrains Mono', monospace; font-size: 0.66rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.2em; color: var(--series-accent);
    transition: letter-spacing 0.3s ease;
  }
  .series-card:hover .series-cta { letter-spacing: 0.26em; }

  /* ---- Arrow button ---- */
  .series-arrow {
    align-self: center; flex-shrink: 0;
    width: 50px; height: 50px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--series-card-border); color: var(--series-accent);
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }
  .series-card:hover .series-arrow {
    background: var(--series-accent); border-color: var(--series-accent); color: #fff;
    transform: translateX(4px);
  }

  /* ---- Light mode ---- */
  :global(body.light-mode) .series-card {
    --series-ink: #14152a;
    --series-muted: #6b6c84;
    --series-card-bg: #ffffff;
    --series-card-border: rgba(20, 21, 42, 0.1);
    box-shadow: 0 1px 2px rgba(20, 21, 42, 0.04);
  }
  :global(body.light-mode) .series-card:hover {
    border-color: rgb(var(--accent-rgb) / 0.35);
    box-shadow: 0 22px 55px -30px rgb(var(--accent-rgb) / 0.45);
  }

  /* ---- Responsive ---- */
  @media (max-width: 860px) {
    .series-card { grid-template-columns: 150px 1fr; gap: 1.25rem; padding: 1.1rem; }
    .series-arrow { display: none; }
    .series-thumb { min-height: 180px; }
    .thumb-glyph { width: 44px; height: 44px; margin-bottom: 0.8rem; }
  }
  @media (max-width: 560px) {
    .series-card { grid-template-columns: 1fr; gap: 1.1rem; }
    .series-thumb { min-height: 170px; }
  }

  /* ══════════════════════════════════════════════════════════════════════
     Blueprint variant — /blog/series card in the homepage drafting-sheet DNA.
     Self-contained --bp-* tokens (accent follows the active color scheme, like
     the page nav); mirrors the home §01 work-card figure + mono callouts. */
  .bpc {
    --bp-acc: var(--accent);
    --bp-ink: var(--text-primary);
    --bp-muted: color-mix(in srgb, var(--text-primary) 64%, transparent);
    --bp-faint: color-mix(in srgb, var(--text-primary) 42%, transparent);
    --bp-line2: rgba(255, 255, 255, 0.08);
    --bp-card: rgba(255, 255, 255, 0.05);
    /* Opaque raised panel over the drafting sheet — hides the grid behind the
       text so the meta/title/desc read cleanly (a spec-callout box on the sheet). */
    --bp-panel: color-mix(in srgb, #ffffff 5%, var(--bp-bg));
    --bp-panel-hover: color-mix(in srgb, var(--bp-acc) 10%, var(--bp-panel));
    --bp-shadow: 0 12px 34px -22px rgba(0, 0, 0, 0.7);

    position: relative;
    display: grid;
    grid-template-columns: clamp(190px, 26%, 300px) 1fr auto;
    align-items: stretch;
    gap: clamp(1.25rem, 2.4vw, 2.25rem);
    padding: 16px;
    border: 1px solid var(--bp-hair);
    border-radius: 12px;
    background: var(--bp-panel);
    box-shadow: var(--bp-shadow);
    color: inherit; text-decoration: none;
    transition: border-color 0.3s ease, background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }
  .bpc:hover {
    border-color: color-mix(in srgb, var(--bp-acc) 45%, transparent);
    background: var(--bp-panel-hover);
    box-shadow: 0 22px 48px -26px color-mix(in srgb, var(--bp-acc) 50%, transparent);
    transform: translateY(-3px);
  }

  /* figure — mirrors home .bp-fig */
  .bpc-fig {
    position: relative;
    min-height: 190px;
    border: 1px solid var(--bp-hair);
    border-radius: 10px;
    background-color: var(--bp-card);
    background-size: cover; background-position: center;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }
  .bpc:hover .bpc-fig { border-color: color-mix(in srgb, var(--bp-acc) 45%, transparent); }
  .bpc-fig--striped {
    background-image: repeating-linear-gradient(45deg, var(--bp-line2) 0, var(--bp-line2) 1px, transparent 1px, transparent 12px);
  }
  .bpc-fig.has-cover::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(10, 14, 20, 0.6) 0%, rgba(10, 14, 20, 0.05) 55%);
  }
  .bpc-node { position: absolute; top: 10px; right: 14px; z-index: 2; font-size: 12px; color: var(--bp-acc); }
  .bpc-callout {
    position: absolute; left: 14px; bottom: 12px; z-index: 2;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.06em; color: var(--bp-muted);
  }
  .bpc-fig.has-cover .bpc-callout { color: rgba(255, 255, 255, 0.82); }

  /* body */
  .bpc-body { min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 6px 0; }
  .bpc-meta {
    display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 11px; letter-spacing: 0.06em; color: var(--bp-muted);
    margin-bottom: 0.85rem;
  }
  .bpc-meta-kicker { color: var(--bp-acc); }
  .bpc-sep { color: var(--bp-faint); }
  .bpc-stat { display: inline-flex; align-items: center; gap: 0.3rem; }
  .bpc-stat svg { opacity: 0.75; }

  .bpc-title {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700; letter-spacing: -0.02em;
    font-size: clamp(1.5rem, 2.8vw, 2.3rem); line-height: 1.05;
    color: var(--bp-ink); margin: 0 0 0.7rem;
    transition: color 0.3s ease;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .bpc:hover .bpc-title { color: var(--bp-acc); }
  .bpc-desc {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.95rem; line-height: 1.55; color: var(--bp-muted); margin: 0; max-width: 46rem;
    overflow: hidden; text-overflow: ellipsis;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  }
  .bpc-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
  .bpc-tag {
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.08em; color: var(--bp-acc);
    border: 1px solid color-mix(in srgb, var(--bp-acc) 40%, transparent);
    padding: 2px 7px; border-radius: 4px; white-space: nowrap;
  }
  .bpc-cta {
    display: inline-block; margin-top: 1.15rem;
    font-family: 'IBM Plex Mono', ui-monospace, monospace;
    font-size: 11px; letter-spacing: 0.16em; color: var(--bp-acc);
    transition: letter-spacing 0.3s ease;
  }
  .bpc:hover .bpc-cta { letter-spacing: 0.22em; }

  /* arrow — hairline round button like the home nav icons */
  .bpc-arrow {
    align-self: center; flex-shrink: 0;
    width: 46px; height: 46px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    border: 1.5px solid var(--bp-hair); color: var(--bp-muted);
    transition: background 0.3s ease, border-color 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }
  .bpc:hover .bpc-arrow { background: var(--bp-acc); border-color: var(--bp-acc); color: #fff; transform: translateX(4px); }

  /* blueprint light mode — cream figure fill + darker hairlines */
  :global(body.light-mode) .bpc {
    --bp-line2: rgba(22, 32, 43, 0.08);
    --bp-card: #e8e6df;
    --bp-muted: color-mix(in srgb, var(--text-primary) 62%, transparent);
    --bp-faint: color-mix(in srgb, var(--text-primary) 45%, transparent);
    /* White panel lifts off the cream sheet + soft shadow for depth. */
    --bp-panel: #ffffff;
    --bp-panel-hover: color-mix(in srgb, var(--bp-acc) 6%, #ffffff);
    --bp-shadow: 0 1px 2px rgba(20, 21, 42, 0.05), 0 12px 30px -24px rgba(20, 21, 42, 0.3);
  }

  @media (max-width: 860px) {
    .bpc { grid-template-columns: 150px 1fr; gap: 1.1rem; padding: 12px; }
    .bpc-arrow { display: none; }
    .bpc-fig { min-height: 150px; }
  }
  @media (max-width: 560px) {
    .bpc { grid-template-columns: 1fr; gap: 1rem; }
    .bpc-fig { min-height: 0; aspect-ratio: 16 / 10; }
  }
</style>
