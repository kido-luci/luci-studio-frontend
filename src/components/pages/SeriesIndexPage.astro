---
import Layout from "../../layouts/Layout.astro";
import TopNav from "../TopNav.astro";
import SeriesCard from "../SeriesCard.astro";
import SiteFooter from "../SiteFooter.astro";
import { postService } from "../../services/posts";
import { playlistService } from "../../services/playlists";
import { buildSeriesViews } from "../../utils/series";
import { getLocaleFromUrl, useTranslations, localizedHref, format, localized } from '../../i18n';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const [rawPosts, rawPlaylists] = await Promise.all([
  postService.getAll(),
  playlistService.getAll(),
]);

const localizedPlaylists = rawPlaylists.map(pl => localized(pl, locale));
const sorted = buildSeriesViews(localizedPlaylists, rawPosts);

const SITE_URL = 'https://luci-studio.com';
---

<Layout
  title="Series | Luci Studio"
  description={`${sorted.length} curated series — ordered reading lists of posts from Luci Studio.`}
  canonical={`${SITE_URL}/blog/series/`}
  keywords="curated series, reading lists, blog collections, Luci Studio"
>

  <TopNav active="blog" />

  <main class="bp-series">
    <div class="bp-grid" aria-hidden="true"></div>

    <div class="bp-wrap">

      <!-- Header -->
      <header class="bp-series-head">
        <a href={localizedHref(locale, '/blog')} class="bp-series-back bp-mono" data-reveal>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          {t('series.backToThoughts')}
        </a>

        <div class="bp-sec-head" data-reveal>
          <span class="bp-dot" aria-hidden="true"></span>
          <span class="bp-mono bp-sec-label">{t('series.eyebrow')}</span>
          <span class="bp-rule" aria-hidden="true"></span>
          <span class="bp-mono bp-sec-count">{String(sorted.length).padStart(2, '0')} COLLECTIONS</span>
          <span class="bp-cs" aria-hidden="true">
            <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
              <circle cx="24" cy="24" r="16" class="bp-cs-guide"></circle>
              <circle cx="24" cy="24" r="16" class="bp-cs-draw"></circle>
              <g class="bp-cs-arm"><line x1="24" y1="24" x2="40" y2="24"></line><circle cx="40" cy="24" r="2.4" class="bp-cs-tip"></circle></g>
              <circle cx="24" cy="24" r="1.8" class="bp-cs-pivot"></circle>
            </svg>
          </span>
        </div>

        <h1 class="bp-display bp-series-title" data-reveal>{t('series.title')}<span class="bp-acc-dot">.</span></h1>
        <p class="bp-series-sub" data-reveal>
          {format(t('series.sub'), { n: sorted.length })}
        </p>
      </header>

      <!-- Empty state -->
      {sorted.length === 0 && (
        <div class="bp-series-empty bp-mono" data-reveal>{t('series.empty')}</div>
      )}

      <!-- Series list -->
      {sorted.length > 0 && (
        <ol class="bp-series-list">
          {sorted.map((p, i) => (
            <li class="bp-series-item" data-reveal>
              <div class="bp-series-marker bp-mono">
                <span class="bp-series-marker-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="bp-series-marker-label">{t('series.collectionLabel')}</span>
                <span class="bp-series-marker-line" aria-hidden="true"></span>
              </div>
              <SeriesCard series={p} variant="blueprint" index={i + 1} />
            </li>
          ))}
        </ol>
      )}

    </div>

    <SiteFooter locale={locale} />
  </main>

</Layout>

<style>
  /* ══════════════════════════════════════════════════════════════════════
     Series index — homepage "blueprint" drafting-sheet DNA.
     Line grid + §-section header + Space Grotesk display + IBM Plex Mono
     labels. Accent follows the active color scheme (--accent), matching the
     shared nav on this page; the drafting-sheet bg still flips with light/dark.
     ══════════════════════════════════════════════════════════════════════ */
  .bp-series {
    --bp-ink: var(--text-primary);
    --bp-acc: var(--accent);
    --bp-line: rgba(255, 255, 255, 0.05);
    --bp-line2: rgba(255, 255, 255, 0.08);
    --bp-muted: color-mix(in srgb, var(--text-primary) 64%, transparent);
    --bp-faint: color-mix(in srgb, var(--text-primary) 42%, transparent);

    position: relative;
    min-height: 100vh;
    background: var(--bp-bg);
    color: var(--bp-ink);
    padding-top: clamp(120px, 15vh, 168px);
    padding-bottom: clamp(72px, 12vw, 128px);
    overflow-x: clip;
  }
  :global(body.light-mode) .bp-series {
    --bp-line: rgba(22, 32, 43, 0.05);
    --bp-line2: rgba(22, 32, 43, 0.08);
  }

  /* Drafting grid: fine 36px + major 180px, faded toward the bottom. */
  .bp-series .bp-grid {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--bp-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line) 1px, transparent 1px),
      linear-gradient(var(--bp-line2) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line2) 1px, transparent 1px);
    background-size: 36px 36px, 36px 36px, 180px 180px, 180px 180px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 55%, transparent 100%);
  }

  .bp-wrap {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: clamp(20px, 5vw, 48px);
    padding-right: clamp(20px, 5vw, 48px);
  }
  .bp-display {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700; letter-spacing: -0.02em; color: var(--bp-ink);
  }
  .bp-acc-dot { color: var(--bp-acc); font-style: normal; }

  /* ---- Header ---- */
  .bp-series-head { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .bp-series-back {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--bp-muted); text-decoration: none; margin-bottom: 2.2rem;
    transition: color 0.2s ease;
  }
  .bp-series-back:hover { color: var(--bp-acc); }
  .bp-series-back svg { transition: transform 0.2s ease; }
  .bp-series-back:hover svg { transform: translateX(-3px); }

  /* section-head motif (mirrors home .bp-sec-head) */
  .bp-sec-head { display: flex; align-items: center; gap: 14px; margin-bottom: clamp(20px, 3vw, 30px); }
  .bp-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--bp-acc); flex-shrink: 0; }
  .bp-sec-label { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bp-acc); white-space: nowrap; }
  .bp-rule { flex: 1; height: 1px; background: var(--bp-hair); }
  .bp-sec-count { font-size: 11px; letter-spacing: 0.16em; color: var(--bp-muted); white-space: nowrap; }
  /* Section-head compass instrument (mirrors the homepage §05 compass, sized
     down and inline at the row's end). Frozen under reduced-motion / win-perf. */
  .bp-cs { width: 26px; height: 26px; flex: none; }
  .bp-cs svg { display: block; width: 100%; height: 100%; }
  .bp-cs-guide { fill: none; stroke: var(--bp-hair); stroke-width: 1.2; }
  .bp-cs-draw { fill: none; stroke: var(--bp-acc); stroke-width: 1.8; stroke-linecap: round; stroke-dasharray: 20 81; transform-box: view-box; transform-origin: center; animation: bpCsSpin 5s linear infinite; }
  .bp-cs-arm { transform-box: view-box; transform-origin: center; animation: bpCsSpin 5s linear infinite; }
  .bp-cs-arm line { stroke: var(--bp-ink); stroke-width: 1.4; stroke-opacity: 0.55; }
  .bp-cs-tip { fill: var(--bp-acc); }
  .bp-cs-pivot { fill: var(--bp-ink); fill-opacity: 0.6; }
  @keyframes bpCsSpin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .bp-cs-draw, .bp-cs-arm { animation: none; } }
  :global(body.win-perf-mode) .bp-cs-draw,
  :global(body.win-perf-mode) .bp-cs-arm { animation: none; }

  .bp-series-title {
    font-size: clamp(3.2rem, 10vw, 7rem); line-height: 0.95; margin: 0;
  }
  .bp-series-sub {
    max-width: 34rem; margin: 1.4rem 0 0;
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-size: 1.02rem; line-height: 1.6; color: var(--bp-muted);
  }

  /* ---- List + per-series marker ---- */
  .bp-series-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: clamp(2.5rem, 4vw, 3.75rem); }
  .bp-series-marker { display: flex; align-items: center; gap: 0.85rem; margin-bottom: 1.25rem; }
  .bp-series-marker-num,
  .bp-series-marker-label {
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--bp-muted);
  }
  .bp-series-marker-num { color: var(--bp-acc); }
  .bp-series-marker-line { flex: 1; height: 1px; background: var(--bp-hair); }

  /* ---- Empty ---- */
  .bp-series-empty {
    text-align: center; padding: 5rem 0;
    font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--bp-muted);
  }

  @media (max-width: 560px) {
    .bp-series-head { margin-bottom: 2.5rem; }
  }
</style>
