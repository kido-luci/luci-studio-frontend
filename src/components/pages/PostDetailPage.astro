---
import Layout from "../../layouts/Layout.astro";
import PostCard from "../PostCard.astro";
import AffiliateCard from "../AffiliateCard.astro";
import { affiliateService } from "../../services/affiliates";
import { buildPostSlug, calculateReadTime, readTimeFor, formatDate, formatMarkdown } from "../../utils/blog";
import { getLocaleFromUrl, useTranslations, localizedHref, switchLocalePath, localized } from '../../i18n';
import type { Post } from "../../services/posts";
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);
const enHref = switchLocalePath(Astro.url.pathname, 'en');
const viHref = switchLocalePath(Astro.url.pathname, 'vi');

// Body component — getStaticPaths lives in the route files (en + vi) and passes
// the fetched post / related / slug in via props.
interface Props {
  post: Post;
  related: Post[];
  slug: string;
}
const { post: rawPost, related, slug } = Astro.props;
const post = localized(rawPost, locale);

const API_URL = import.meta.env.PUBLIC_API_URL || '';

const SITE_URL = 'https://luci-studio.com';

const readTime = post ? calculateReadTime(post.content, locale) : '';
const formattedDate = post ? formatDate(post.created_at, locale) : '';
const contentWithoutTitle = post ? post.content.replace(/^#\s+.*(\r?\n|$)/, '').replace(/^#\s/gm, '## ').trimStart() : '';
const htmlContent = contentWithoutTitle ? formatMarkdown(contentWithoutTitle) : '';

// Sponsored cards — 2 distinct active links picked at build time (the post page's
// fixed slot count; empty on failure). Two slots: one mid-article, one at the end.
// With ≥2 active links they show different sponsors; with exactly 1 we show it
// once (end only).
const affiliateCards = await affiliateService.getCardsRandom(API_URL, 2);
const midCard = affiliateCards.length >= 2 ? affiliateCards[0] : null;
const endCard = affiliateCards.length >= 2 ? affiliateCards[1] : (affiliateCards[0] ?? null);

// Mid-article injection point: htmlContent is block HTML joined by "\n", and every
// "<h2>" starts a standalone section block (utils/blog.ts), so splitting immediately
// before one is a safe boundary. Only inject on long posts (≥4 sections) so the card
// lands mid-read rather than next to the intro/outro; otherwise render in one piece.
let articleTop = htmlContent;
let articleBottom = '';
if (midCard && htmlContent) {
  const h2Indices: number[] = [];
  const h2Re = /<h2>/g;
  let h2Match: RegExpExecArray | null;
  while ((h2Match = h2Re.exec(htmlContent)) !== null) h2Indices.push(h2Match.index);
  if (h2Indices.length >= 4) {
    const mid = htmlContent.length / 2;
    // Skip the first heading so an intro stays above the card; pick the remaining
    // section boundary closest to the character midpoint.
    const candidates = h2Indices.slice(1);
    let splitAt = candidates[0];
    for (const idx of candidates) {
      if (Math.abs(idx - mid) < Math.abs(splitAt - mid)) splitAt = idx;
    }
    articleTop = htmlContent.slice(0, splitAt);
    articleBottom = htmlContent.slice(splitAt);
  }
}
const showMidCard = !!midCard && articleBottom !== '';

const tags = (post && post.topics && post.topics.length > 0) ? post.topics : ['Engineering'];

const relatedPosts = (related ?? []).map(rawP => { const p = localized(rawP, locale); return ({
  id: p.id,
  title: p.title,
  subtitle: p.subtitle || '',
  href: localizedHref(locale, `/blog/${buildPostSlug(p.title, p.id)}/`),
  tags: (p.topics && p.topics.length > 0) ? p.topics : ['Engineering'],
  date: formatDate(p.created_at, locale),
  read: readTimeFor(p, locale),
  // empty cover → PostCard renders the gradient + tag-word fallback (same as /blog)
  img: p.cover_image_url || '',
  views: p.views ?? 0,
  likes: p.likes ?? 0,
}); });

// SEO
const canonicalURL = `${SITE_URL}/blog/${slug}/`;
const blogURL = `${SITE_URL}/blog/`;
const _subtitle = post.subtitle?.trim();
const seoDescription = _subtitle
    ? _subtitle
    : (post.content.replace(/```[\s\S]*?```/g, '').replace(/[#*`>\[\]!_~]/g, '').replace(/\s+/g, ' ').trim().slice(0, 160) + '…');
const ogImage = post.cover_image_url || `${SITE_URL}/images/og-default.png`;

const wordCount = post.content.trim().split(/\s+/).length;

const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: seoDescription,
    image: { '@type': 'ImageObject', url: ogImage, width: 600 },
    url: canonicalURL,
    datePublished: post.created_at,
    dateModified: post.updated_at,
    wordCount,
    inLanguage: locale === 'vi' ? 'vi' : 'en',
    isAccessibleForFree: true,
    articleSection: post.topics?.[0] ?? 'Engineering',
    author: {
        '@type': 'Person',
        name: 'Trung Lập (Luci)',
        url: SITE_URL,
        sameAs: [
            'https://medium.com/@lapl1412.work',
            'https://www.linkedin.com/in/kido-luci/',
        ],
    },
    publisher: {
        '@type': 'Organization',
        name: 'Luci Studio',
        url: SITE_URL,
        logo: { '@type': 'ImageObject', url: `${SITE_URL}/images/logo_icon.png` },
    },
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
    ...(post.topics?.length ? { keywords: post.topics.join(', ') } : {}),
};

const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
        {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: `${SITE_URL}/`,
        },
        {
            '@type': 'ListItem',
            position: 2,
            name: 'Blog',
            item: blogURL,
        },
        {
            '@type': 'ListItem',
            position: 3,
            name: post.title,
            item: canonicalURL,
        },
    ],
};

const structuredData = [articleSchema, breadcrumbSchema];
---

{!post ? (
  <Layout title="Post Not Found">
    <nav class="fixed top-0 w-full z-50 border-b border-white/5" style="background:var(--nav-bg);backdrop-filter:blur(16px)">
      <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <a href={localizedHref(locale, '/')} class="flex items-center gap-3 group">
          <img src="/images/logo_icon.png" alt="Luci Studio Logo" class="h-9 w-9 rounded-xl shadow-lg group-hover:shadow-violet-500/50 transition-all duration-300" />
          <span class="text-xl font-normal tracking-wide" style="font-family: 'Limelight', sans-serif;">LUCI <span class="text-shimmer">STUDIO</span><span class="text-violet-500">.</span></span>
        </a>
      </div>
    </nav>
    <main class="pt-64 pb-24 px-6 min-h-screen bg-[var(--bg-primary)] text-center">
      <h1 class="text-4xl font-black text-[var(--text-primary)] mb-6">{t('post.notFoundTitle')}</h1>
      <p class="text-gray-400 mb-12 max-w-md mx-auto">{t('post.notFoundBody')}</p>
      <a href={localizedHref(locale, '/blog')} class="px-8 py-4 bg-white text-black font-black rounded-full hover:bg-violet-500 hover:text-white transition-all duration-300 uppercase tracking-widest">{t('post.notFoundBack')}</a>
    </main>
  </Layout>
) : (
<Layout
  title={`${post.title} | Luci Studio`}
  description={seoDescription}
  ogImage={ogImage}
  ogImageAlt={post.title}
  ogImageWidth={600}
  ogType="article"
  canonical={canonicalURL}
  keywords={post.topics?.join(', ')}
  structuredData={structuredData}
  articleMeta={{
    publishedTime: post.created_at,
    modifiedTime: post.updated_at,
    tags: post.topics,
    author: 'https://luci-studio.com',
  }}
>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css" rel="stylesheet" integrity="sha384-wFjoQjtV1y5jVHbt0p35Ui8aV8GVpEZkyF99OXWqP/eNJDU93D3Ugxkoyh6Y2I4A" crossorigin="anonymous" />
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js" integrity="sha384-06z5D//U/xpvxZHuUz92xBvq3DqBBFi7Up53HRrbV7Jlv7Yvh/MZ7oenfUe9iCEt" crossorigin="anonymous" is:inline></script>
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-dart.min.js" integrity="sha384-cfEVSC1pSQWFCAHLhuVkdGm1NrPSw0Jj4pAt0cnC/e9PP3eSnxKk77LgaFFSUqws" crossorigin="anonymous" is:inline></script>
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-go.min.js" integrity="sha384-YxCco6ByOY5rJ3jD18514fa8w5so07zigIyV6tZa3CWSE5vYrbDSuFkZ5zOknnZ6" crossorigin="anonymous" is:inline></script>
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-javascript.min.js" integrity="sha384-D44bgYYKvaiDh4cOGlj1dbSDpSctn2FSUj118HZGmZEShZcO2v//Q5vvhNy206pp" crossorigin="anonymous" is:inline></script>
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-typescript.min.js" integrity="sha384-PeOqKNW/piETaCg8rqKFy+Pm6KEk7e36/5YZE5XO/OaFdO+/Aw3O8qZ9qDPKVUgx" crossorigin="anonymous" is:inline></script>

  <nav class="fixed top-0 w-full z-50 border-b border-white/5" style="background:var(--nav-bg);backdrop-filter:blur(16px)">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href={localizedHref(locale, '/')} class="flex items-center gap-3 group">
        <img src="/images/logo_icon.png" alt="Luci Studio Logo" class="h-9 w-9 rounded-xl shadow-lg group-hover:shadow-violet-500/50 transition-all duration-300" />
        <span class="text-xl font-normal tracking-wide" style="font-family: 'Limelight', sans-serif;">LUCI <span class="text-shimmer">STUDIO</span><span class="text-violet-500">.</span></span>
      </a>
      <div class="flex items-center gap-4">
        <div class="lang-switch flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest">
          <a href={enHref} class={locale === 'en' ? 'text-violet-400' : 'text-gray-400 hover:text-white transition-colors'} aria-label="English">EN</a>
          <span class="text-gray-600" aria-hidden="true">/</span>
          <a href={viHref} class={locale === 'vi' ? 'text-violet-400' : 'text-gray-400 hover:text-white transition-colors'} aria-label="Tiếng Việt">VI</a>
        </div>
        <button
          onclick="window.toggleTheme()"
          class="w-10 h-10 flex items-center justify-center rounded-full border border-white/10 hover:border-violet-500/40 hover:bg-white/5 transition-all duration-300 group"
          aria-label={t('nav.toggleTheme')}
        >
          <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors dark-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
          <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors light-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
        </button>
        <a href={localizedHref(locale, '/blog')} class="text-xs font-bold text-gray-400 hover:text-white transition-all duration-300 uppercase tracking-[0.2em] flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          <span class="hidden sm:inline">{t('post.backToBlog')}</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Floating like pill -->
  <div id="floating-like" class="fixed bottom-5 right-5 sm:bottom-8 sm:right-8 z-40 opacity-0 pointer-events-none transition-all duration-500 translate-y-4">
    <button id="floating-like-btn" aria-label={t('post.likeAriaLabel')} class="relative flex items-center gap-2 pl-3 pr-3.5 py-2 sm:gap-3 sm:pl-4 sm:pr-5 sm:py-3 rounded-full border border-white/10 bg-black/70 backdrop-blur-2xl shadow-2xl hover:border-rose-500/50 transition-all duration-300 group">
      <div id="floating-glow" class="absolute inset-0 rounded-full opacity-0 transition-opacity duration-500 pointer-events-none" style="background:radial-gradient(ellipse at center,rgba(244,63,94,0.25) 0%,transparent 70%);"></div>
      <svg id="floating-like-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 sm:w-5 sm:h-5 text-gray-400 group-hover:text-rose-400 transition-colors duration-300 relative z-10">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      <span id="floating-like-count" class="text-xs sm:text-sm font-black text-gray-400 tabular-nums relative z-10">{post.likes ?? '—'}</span>
    </button>
  </div>

  <main class="pt-32 pb-24 px-6 min-h-screen bg-[var(--bg-primary)]" data-post-id={post.id} data-api-url={API_URL}>

    <div class="max-w-4xl mx-auto">

      <header class="bd-header" data-reveal>
        <!-- Topic pills -->
        <div class="bd-tags">
          {tags.map(t => (
            <span class="bd-tag"><span class="bd-tag-dot"></span>{t}</span>
          ))}
        </div>

        <!-- Title -->
        <h1 class="bd-title">{post.title}</h1>

        <div class="bd-rule"></div>

        <!-- Byline -->
        <div class="bd-byline">
          <div class="bd-byline-left">
            <div class="bd-avatar"><img src="/images/logo_icon.png" alt="Trung Lập (Luci)" width="46" height="46" loading="lazy" /></div>
            <div class="bd-author">
              <p class="bd-author-name">Trung Lập <span>(Luci)</span></p>
              <div class="bd-meta">
                <span>{formattedDate}</span>
                <span class="bd-dot">·</span>
                <span>{readTime} {t('post.read')}</span>
                <span class="bd-dot">·</span>
                <span class="bd-meta-ic" title="Views">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <span id="view-count">{post.views ?? '—'}</span>
                </span>
                <span class="bd-dot">·</span>
                <span class="bd-meta-ic" title="Likes">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  <span id="like-count-header">{post.likes ?? '—'}</span>
                </span>
              </div>
            </div>
          </div>
          <div class="bd-byline-right">
            <button type="button" data-share-trigger class="bd-share" aria-label={t('post.shareAriaLabel')}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
              {t('post.shareText')}
            </button>
            <button type="button" id="bd-bookmark" class="bd-iconbtn" aria-label={t('post.saveAriaLabel')}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            </button>
          </div>
        </div>

        <div class="bd-rule"></div>
      </header>

      <!-- Content -->
      <article class="prose-custom markdown-content" set:html={articleTop}>
      </article>

      <!-- Mid-article sponsored card (long posts only; distinct from the end-of-article one) -->
      {showMidCard && midCard && (
        <div class="my-12">
          <AffiliateCard
            label={midCard.label}
            url={midCard.url}
            network={midCard.network}
            badge="Sponsored"
            cta={midCard.cta || undefined}
            image={midCard.image}
            imageAlt={midCard.imageAlt}
            logo={midCard.logo}
          />
        </div>
      )}

      {articleBottom && (
        <article class="prose-custom markdown-content" set:html={articleBottom}>
        </article>
      )}

      <!-- Like + Support card -->
      <div class="support-card mt-24 rounded-3xl border border-white/10 bg-white/[0.02] px-6 py-12 md:px-12 flex flex-col items-center text-center gap-4">
        <p class="text-[10px] font-black text-gray-600 uppercase tracking-[0.35em]">{t('post.enjoyedRead')}</p>
        <button id="like-btn" aria-label={t('post.likeAriaLabel')} class="relative group outline-none">
          <div id="like-ring" class="absolute -inset-3 rounded-full opacity-0 transition-all duration-700 pointer-events-none" style="background:radial-gradient(circle,rgba(244,63,94,0.18) 0%,transparent 70%);"></div>
          <div id="like-ring-border" class="absolute -inset-3 rounded-full border border-rose-500/0 transition-all duration-500 pointer-events-none"></div>
          <div class="w-20 h-20 rounded-full border border-white/10 bg-white/[0.03] flex items-center justify-center transition-all duration-300 group-hover:border-rose-500/40 group-hover:bg-rose-500/5 relative z-10">
            <svg id="like-icon" xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500 group-hover:text-rose-400 transition-colors duration-300">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
          </div>
        </button>
        <div>
          <span id="like-count" class="text-2xl font-black text-white tabular-nums">{post.likes ?? '—'}</span>
          <span class="text-[10px] font-black text-gray-600 uppercase tracking-[0.3em] ml-2">{t('post.likes')}</span>
        </div>

        <div class="w-full max-w-xs border-t border-white/5 mt-6 mb-2"></div>

        <p class="text-[10px] font-black text-gray-600 uppercase tracking-[0.35em]">{t('post.foundHelpful')}</p>
        <h3 class="text-2xl md:text-3xl font-black text-white">{t('post.supportWork')}<span class="text-violet-500">.</span></h3>
        <p class="text-sm text-gray-400 max-w-md leading-relaxed">{t('post.supportBody')}</p>
        <a href="https://paypal.me/TrungLapTieu?locale.x=en_US&country.x=VN" target="_blank" rel="noopener noreferrer"
           class="group mt-2 inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full font-black text-sm uppercase tracking-widest text-white bg-[#0070ba] hover:bg-[#005ea6] transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(0,112,186,0.4)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          {t('post.supportCta')}
        </a>

        <div class="mt-3 flex flex-col items-center gap-1.5">
          <img src="/images/paypal-qr.png" alt="Scan to support via PayPal" width="96" height="96" loading="lazy" class="w-24 h-24 rounded-lg bg-white p-1" />
          <span class="text-[10px] text-gray-600 uppercase tracking-[0.2em]">{t('post.scanToPay')}</span>
        </div>
      </div>

      <!-- End-of-article sponsored card (distinct from the mid-article one) -->
      {endCard && (
        <div class="mt-16">
          <AffiliateCard
            label={endCard.label}
            url={endCard.url}
            network={endCard.network}
            badge="Sponsored"
            cta={endCard.cta || undefined}
            image={endCard.image}
            imageAlt={endCard.imageAlt}
            logo={endCard.logo}
          />
        </div>
      )}

      {relatedPosts.length > 0 && (
        <section class="more-posts mt-20 pt-12 border-t border-white/5">
          <div class="flex items-end justify-between mb-8 flex-wrap gap-4">
            <div>
              <span class="text-[10px] font-black uppercase tracking-[0.3em]" style="color:var(--text-tertiary);">{t('post.continueReading')}</span>
              <h2 class="text-2xl md:text-3xl font-black tracking-wide mt-2" style="color:var(--text-primary);">{t('post.morePosts')}<span class="text-violet-500">.</span></h2>
            </div>
            <a href={localizedHref(locale, '/blog')} class="text-xs font-bold uppercase tracking-widest flex items-center gap-2 group" style="color:var(--text-secondary);">
              {t('post.viewAll')}
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {relatedPosts.map(p => (
              <PostCard
                href={p.href}
                title={p.title}
                subtitle={p.subtitle}
                tags={p.tags}
                date={p.date}
                read={p.read}
                img={p.img}
                views={p.views}
                likes={p.likes}
                compact
              />
            ))}
          </div>
        </section>
      )}

      <!-- ── Comments i18n strings (read by post-engagement-comments.js) ── -->
      <script type="application/json" id="comments-i18n" set:html={JSON.stringify({
        noComments:           t('comments.noComments'),
