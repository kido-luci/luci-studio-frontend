  /* ── Blog detail header (theme-aware) ───────────────────────────── */
  .bd-header { margin-bottom: clamp(34px, 5vw, 52px); }

  .bd-tags { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: clamp(20px, 3vw, 30px); }
