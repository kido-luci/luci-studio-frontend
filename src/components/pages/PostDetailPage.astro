              ></div>
              <div style="border-top:1px solid var(--comment-divider,rgba(255,255,255,0.08));display:flex;align-items:center;gap:0.5rem;padding:0.625rem 1rem;">
                <button id="fmt-bold" type="button" title="Bold" class="fmt-btn" style="padding:0.25rem 0.4rem;border-radius:0.375rem;font-size:0.75rem;font-weight:700;background:transparent;border:none;cursor:pointer;color:var(--text-secondary);transition:background 0.15s;" onmouseover="this.style.background='rgba(99,102,241,0.1)'" onmouseout="this.style.background='transparent'"><b>B</b></button>
                <button id="fmt-italic" type="button" title="Italic" class="fmt-btn" style="padding:0.25rem 0.4rem;border-radius:0.375rem;font-size:0.75rem;font-weight:700;background:transparent;border:none;cursor:pointer;color:var(--text-secondary);font-style:italic;transition:background 0.15s;" onmouseover="this.style.background='rgba(99,102,241,0.1)'" onmouseout="this.style.background='transparent'">I</button>
                <button id="fmt-underline" type="button" title="Underline" class="fmt-btn" style="padding:0.25rem 0.4rem;border-radius:0.375rem;font-size:0.75rem;font-weight:700;background:transparent;border:none;cursor:pointer;color:var(--text-secondary);text-decoration:underline;transition:background 0.15s;" onmouseover="this.style.background='rgba(99,102,241,0.1)'" onmouseout="this.style.background='transparent'">U</button>
                <div style="width:1px;height:1rem;background:var(--comment-divider,rgba(255,255,255,0.1));margin:0 0.375rem;"></div>
                <div style="position:relative;">
                  <button id="fmt-emoji" type="button" title="Emoji" class="emoji-picker-btn" style="padding:0.25rem 0.375rem;border-radius:0.375rem;background:transparent;border:none;cursor:pointer;transition:background 0.15s;display:flex;align-items:center;" onmouseover="this.style.background='rgba(99,102,241,0.1)'" onmouseout="this.style.background='transparent'"><img src="https://cdn.jsdelivr.net/gh/twitter/twemoji@v14.0.2/assets/svg/1f60a.svg" width="18" height="18" alt="😊" style="pointer-events:none;"></button>
                </div>
                <div style="flex:1;"></div>
                <span id="char-count" style="font-size:0.65rem;color:var(--text-tertiary);margin-right:0.5rem;"></span>
                <button id="sign-out-btn" type="button" style="font-size:0.7rem;color:var(--text-tertiary);background:transparent;border:none;cursor:pointer;padding:0.375rem 0.625rem;border-radius:0.375rem;transition:background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background='transparent'">{t('post.signOut')}</button>
                <button type="submit" style="padding:0.5rem 1.25rem;border-radius:0.5rem;font-size:0.8rem;font-weight:700;background:#7c3aed;color:#fff;border:none;cursor:pointer;transition:background 0.2s;white-space:nowrap;" onmouseover="this.style.background='#6d28d9'" onmouseout="this.style.background='#7c3aed'">{t('post.submitComment')}</button>
              </div>
            </form>
          </div>
        </div>

        <!-- Comments list header -->
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.25rem;">
          <div style="display:flex;align-items:center;gap:0.625rem;">
            <span style="font-size:1rem;font-weight:700;color:var(--text-primary);">{t('post.commentsLabel')}</span>
            <span id="comment-count-badge" style="display:none;padding:0.1rem 0.5rem;border-radius:9999px;font-size:0.7rem;font-weight:700;background:rgba(99,102,241,0.15);color:#818cf8;"></span>
          </div>
          <button id="sort-toggle" type="button" style="display:flex;align-items:center;gap:0.375rem;font-size:0.75rem;color:var(--text-tertiary);background:transparent;border:none;cursor:pointer;padding:0.25rem 0.5rem;border-radius:0.375rem;transition:background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background='transparent'">
            <svg id="sort-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l4-4 4 4"/><path d="M7 5v14"/><path d="M21 15l-4 4-4-4"/><path d="M17 19V5"/></svg>
            <span id="sort-label">{t('post.commentsSortNewest')}</span>
          </button>
        </div>

        <!-- Comment list -->
        <div id="comment-list" class="flex flex-col">
          <div id="comments-loading" style="padding:3rem 0;text-align:center;">
            <p style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.15em;color:var(--text-tertiary);">Loading…</p>
          </div>
        </div>

        <!-- Load more -->
        <div style="display:flex;justify-content:center;padding:0.5rem 0 0.25rem;">
          <button id="load-more-comments" type="button" style="display:none;align-items:center;gap:0.4rem;font-size:0.75rem;font-weight:600;color:var(--text-secondary);background:transparent;border:1px solid var(--border-color, rgba(255,255,255,0.12));cursor:pointer;padding:0.5rem 1.1rem;border-radius:9999px;transition:background 0.15s,color 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.06)'" onmouseout="this.style.background='transparent'">{t('post.loadMoreComments')}</button>
        </div>
      </section>
    </div>
  </main>
</Layout>
)}

<script defer src="https://cdn.jsdelivr.net/npm/twemoji@14.0.2/dist/twemoji.min.js" integrity="sha384-32KMvAMS4DUBcQtHG6fzADguo/tpN1Nh6BAJa2QqZc6/i0K+YPQE+bWiqBRAWuFs" crossorigin="anonymous"></script>

<script is:inline>
  // Preserve scroll position across reloads (F5 / Ctrl+R).
  // Use the pathname as key so each post has its own saved position.
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  var _scrollKey = 'scrollPos:' + location.pathname;
  var _savedScroll = sessionStorage.getItem(_scrollKey);
  if (_savedScroll) {
    // Restore after the DOM is ready so layout is stable.
    window.scrollTo(0, parseInt(_savedScroll, 10));
    sessionStorage.removeItem(_scrollKey);
  } else {
    window.scrollTo(0, 0);
  }
  window.addEventListener('beforeunload', function() {
    sessionStorage.setItem(_scrollKey, window.scrollY);
  });
</script>

