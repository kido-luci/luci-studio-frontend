---
import Layout from "../../layouts/Layout.astro";
import TopNav from "../TopNav.astro";
import RepoCard from "../RepoCard.astro";
import { projectService } from "../../services/projects";
import { buildLabCards } from "../../utils/labCards";
import "../../styles/lab-cards.css";
import { getLocaleFromUrl, useTranslations, localized } from '../../i18n';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const rawProjects = await projectService.getAll();
const projects = rawProjects.map(p => localized(p, locale));
const { apps, sources } = buildLabCards(projects);
const repoCount = String(sources.length).padStart(2, "0");
---

<Layout
  title="Lab · Luci Studio"
  description="Public source repositories and released apps — mine, and a few others worth a look."
>
  <TopNav active="lab" />

  <main class="bp-lab lab-palette">
    <div class="bp-grid" aria-hidden="true"></div>
    <div class="bp-wrap">

      <!-- released apps (top) -->
      {apps.length > 0 && (
        <section id="released-apps" class="bp-lab-sec" style="scroll-margin-top:96px;">
          <div class="bp-sec-head">
            <span class="bp-dot" aria-hidden="true"></span>
            <span class="bp-mono bp-sec-label">APPS</span>
            <span class="bp-rule" aria-hidden="true"></span>
            <span class="bp-mono bp-sec-count">{String(apps.length).padStart(2, "0")} SHIPPED</span>
          </div>
          <h1 class="bp-display bp-lab-title">{t('lab.releasedApps')}<span class="bp-acc-dot">.</span></h1>
          <p class="bp-lab-sub">{t('lab.labDescription')}</p>
          <div class="bp-lab-grid">
            {apps.map((a) => (
              <RepoCard {...a} variant="blueprint" />
            ))}
          </div>
        </section>
      )}

      <!-- public source -->
      <section id="public-source" class="bp-lab-sec" style="scroll-margin-top:96px;">
        <div class="bp-sec-head">
          <span class="bp-dot" aria-hidden="true"></span>
          <span class="bp-mono bp-sec-label">SOURCE</span>
          <span class="bp-rule" aria-hidden="true"></span>
          <span class="bp-mono bp-sec-count">{repoCount} REPOS</span>
        </div>
        <h2 class="bp-display bp-lab-title bp-lab-title--sub">{t('lab.publicSource')}<span class="bp-acc-dot">.</span></h2>
        {apps.length === 0 && (
          <p class="bp-lab-sub">{t('lab.labDescription')}</p>
        )}
        {sources.length > 0 ? (
          <div class="bp-lab-grid">
            {sources.map((r) => (
              <RepoCard {...r} variant="blueprint" />
            ))}
          </div>
        ) : (
          <p class="bp-lab-empty bp-mono">{t('lab.noRepos')}</p>
        )}
      </section>

    </div>
  </main>
</Layout>

<style>
  /* /lab — homepage "blueprint" drafting-sheet DNA. Line grid + §-section
     headers + Space Grotesk display + IBM Plex Mono. Accent follows the active
     color scheme; the sheet flips cream/navy with light/dark. The RepoCards are
     rendered in their own blueprint variant (RepoCard.astro). */
  .bp-lab {
    --bp-bg: #0a0e14;
    --bp-ink: var(--text-primary);
    --bp-acc: var(--accent);
    --bp-line: rgba(255, 255, 255, 0.05);
    --bp-line2: rgba(255, 255, 255, 0.08);
    --bp-hair: rgba(255, 255, 255, 0.14);
    --bp-muted: color-mix(in srgb, var(--text-primary) 58%, transparent);
    --bp-faint: color-mix(in srgb, var(--text-primary) 42%, transparent);

    position: relative;
    min-height: 100vh;
    width: 100%;
    background: var(--bp-bg);
    color: var(--bp-ink);
    padding-top: clamp(120px, 15vh, 168px);
    padding-bottom: clamp(72px, 12vw, 128px);
    overflow-x: clip;
    font-family: "Space Grotesk", system-ui, sans-serif;
  }
  :global(body.light-mode) .bp-lab {
    --bp-bg: #f4f2ec;
    --bp-line: rgba(22, 32, 43, 0.05);
    --bp-line2: rgba(22, 32, 43, 0.08);
    --bp-hair: rgba(22, 32, 43, 0.16);
  }

  .bp-lab .bp-grid {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--bp-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line) 1px, transparent 1px),
      linear-gradient(var(--bp-line2) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line2) 1px, transparent 1px);
    background-size: 36px 36px, 36px 36px, 180px 180px, 180px 180px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 35%, transparent 85%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 35%, transparent 85%);
  }

  .bp-wrap { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; padding-left: clamp(20px, 5vw, 40px); padding-right: clamp(20px, 5vw, 40px); }
  .bp-mono { font-family: "IBM Plex Mono", ui-monospace, monospace; }
  .bp-display { font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700; letter-spacing: -0.02em; color: var(--bp-ink); }
  .bp-acc-dot { color: var(--bp-acc); font-style: normal; }

  .bp-sec-head { display: flex; align-items: center; gap: 14px; }
  .bp-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--bp-acc); flex-shrink: 0; }
  .bp-sec-label { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bp-acc); white-space: nowrap; }
  .bp-rule { flex: 1; height: 1px; background: var(--bp-hair); }
  .bp-sec-count { font-size: 11px; letter-spacing: 0.16em; color: var(--bp-faint); white-space: nowrap; }

  .bp-lab-sec { padding-top: clamp(28px, 5vw, 40px); }
  .bp-lab-sec + .bp-lab-sec { padding-top: clamp(64px, 9vw, 104px); }
  .bp-lab-title { font-size: clamp(2.6rem, 7vw, 5rem); line-height: 1.0; margin: clamp(16px, 2.5vw, 24px) 0 0; }
  .bp-lab-title--sub { font-size: clamp(2.1rem, 5vw, 3.75rem); }
  .bp-lab-sub { margin: 1.4rem 0 0; max-width: 34rem; font-size: 1.05rem; line-height: 1.6; color: var(--bp-muted); }
  .bp-lab-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr)); gap: 26px; margin-top: clamp(36px, 5vw, 60px); }
  .bp-lab-empty { margin-top: clamp(36px, 5vw, 60px); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bp-faint); }
</style>
