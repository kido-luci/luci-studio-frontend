---
// LUCI STUDIO — "Blueprint" homepage.
// A technical drafting-sheet redesign, adapted to the site's existing design
// tokens so it keeps dark/light mode, the 6 accent color-schemes, the shared
// TopNav and the GSAP reveal system. Every content slot is wired to the live API
// (projects / posts / gallery / profile); the blueprint's placeholder copy was
// mapped onto real work. The homepage is English-only (there is no /vi/ route).
import Layout from "../../layouts/Layout.astro";
import TopNav from "../TopNav.astro";
import SiteFooter from "../SiteFooter.astro";
import AdSlot from "../AdSlot.astro";
import { getLocaleFromUrl } from "../../i18n";
import HomeCapabilities from "../home/HomeCapabilities.astro";
import HomeDirectory from "../home/HomeDirectory.astro";
import HomeTools from "../home/HomeTools.astro";
import HomeVideos from "../home/HomeVideos.astro";
import HomeStudio from "../home/HomeStudio.astro";
import HomeWork from "../home/HomeWork.astro";
import HomeArt from "../home/HomeArt.astro";
import HomeGamesRail from "../home/HomeGamesRail.astro";
import HomeBlogRail from "../home/HomeBlogRail.astro";
import HomeHero from "../home/HomeHero.astro";

const locale = getLocaleFromUrl(Astro.url);
const API_URL = import.meta.env.PUBLIC_API_URL || "";

const SITE_URL = "https://luci-studio.com";
const homepageSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Luci Studio",
  url: SITE_URL,
  description: "A creative engineering studio — technical blog, browser tools & games, digital art, and high-performance cross-platform applications.",
  logo: { "@type": "ImageObject", url: `${SITE_URL}/images/logo_icon.png` },
  sameAs: ["https://medium.com/@lapl1412.work", "https://www.linkedin.com/in/kido-luci/"],
};
---

<Layout
  title="Luci Studio | Creative Engineering — Tech Blog, Digital Art & Cross-Platform Apps"
  description="Luci Studio is a creative engineering studio — a technical blog, browser tools & games, digital art, and high-performance cross-platform apps built with rigorous architecture."
  canonical={`${SITE_URL}/`}
  keywords="Flutter, Dart, Go, mobile development, tech blog, digital art, cross-platform, clean architecture, Luci Studio"
  structuredData={homepageSchema}
  ogImage={`${SITE_URL}/images/og/home.png`}
  ogImageAlt="Luci Studio — creative engineering"
  ogImageWidth={1200}
  ogImageHeight={630}
>
  <Fragment slot="head">
    <!-- Mark the homepage: (1) home-anim gates the scroll-reveal hidden states so
         JS-off / GSAP-fail / reduced-motion all fall back to visible content; (2)
         bp-home suppresses the shared particle canvas (the blueprint grid is the bg);
         (3) ocean-on arms the 3D ocean hero band (cheap probe: WebGL2 API present +
         no oceanHero="off" kill switch) so the hero lays out single-column from the
         first paint — no post-load swap/CLS. The scene script demotes the class if
         real GL init later fails, restoring the constellation + ring fallback.
         Inline + in <head> so all land before first paint. -->
    <script is:inline>document.documentElement.classList.add('home-anim');document.documentElement.classList.add('bp-home');(function(){try{if(localStorage.getItem('oceanHero')==='off')return;}catch(e){}if('WebGL2RenderingContext' in window)document.documentElement.classList.add('ocean-on');})();</script>
  </Fragment>

  <TopNav active="home" ctaHref="#contact" />

  <main class="bp" data-api-url={API_URL}>
    <div class="bp-grid" aria-hidden="true"></div>

    <HomeHero />

    <HomeDirectory />

    <div class="bp-conn-wrap"><span data-connector class="bp-conn"></span></div>

    <HomeWork />

    <div class="bp-conn-wrap"><span data-connector class="bp-conn"></span></div>

    <HomeGamesRail />

    <div class="bp-conn-wrap"><span data-connector class="bp-conn"></span></div>

    <HomeVideos />

    <HomeTools />

    <HomeCapabilities />

    <div class="bp-conn-wrap"><span data-connector class="bp-conn"></span></div>

    <HomeBlogRail />

    <div class="bp-conn-wrap"><span data-connector class="bp-conn"></span></div>

    <!-- §04 ART is a full-bleed drafting sheet (desktop + no-reduced-motion; see
         .bp-stack CSS): opaque, 100dvh, centered. Falls back to normal document
         flow otherwise. (§05 STUDIO scrolls normally, outside this wrapper.) -->
    <div class="bp-stack">
      <HomeArt />
    </div><!-- /.bp-stack -->

    <div class="bp-conn-wrap"><span data-connector class="bp-conn"></span></div>

    <HomeStudio />

    <div class="bp-wrap">
      <AdSlot placement="home" />
    </div>

    <SiteFooter locale={locale} />
  </main>
</Layout>

<style>
  /* ══════════════════════════════════════════════════════════════════════
     LUCI STUDIO — Blueprint homepage. Scoped styles.
     Cream drafting-sheet in light mode, dark blueprint in dark mode; the blue
     accent follows the active color-scheme (--accent). Orange is a fixed
     decorative secondary (art + coordinate markers), like the site's other
     intentionally-fixed accents.
     ══════════════════════════════════════════════════════════════════════ */
  /* Blueprint tokens live on html.bp-home so BOTH the sticky nav and <main.bp>
     inherit them (the nav is a sibling of main, not a child). Dark by default;
     the .light-mode variant paints the cream sheet. --bp-acc follows the site accent
     (var(--accent) — the default scheme is the blueprint blue), so schemes recolor it; orange is
     the fixed decorative secondary. The --nav-bg-scroll override retunes
     the scrolled glass the shared navDimmer toggles on. */
  :global(html.bp-home) {
    --bp-ink: var(--text-primary);
    --bp-acc: var(--accent);
    --bp-orange: #ff5b1a;
    --bp-line: rgba(255, 255, 255, 0.05);
    --bp-line2: rgba(255, 255, 255, 0.08);
    --bp-card: rgba(255, 255, 255, 0.035);
    --bp-muted: color-mix(in srgb, var(--bp-ink) 64%, transparent);
    --bp-faint: color-mix(in srgb, var(--bp-ink) 42%, transparent);
    --bp-hover: color-mix(in srgb, var(--bp-acc) 8%, transparent);
    /* Desk-lamp glow ramp: peak color, a gradient interpolation hint, and a
       transparent END that stays the SAME hue as the peak. The end is NOT the
       bare `transparent` keyword — that resolves to transparent *black*, so the
       fade drifts through muddy blue-grey; on the cream sheet that reads as a
       dirty smudge (invisible on navy, hence dark looked fine). rgb(var(--accent-rgb) / 0)
       is the accent hue at alpha 0, so the fade keeps that hue the whole way.
       The gradient also interpolates `in oklab` (see .bp-grid) for a
       perceptually smooth ramp with no grey midtone. The hint curves the
       falloff. Light mode hides this glow entirely (--bp-lamp set to a
       transparent blue below) so the cream sheet shows only the grid +
       the twinkling constellation; dark mode keeps the blue corner pool. */
    --bp-lamp: var(--bp-acc);
    --bp-lamp-hint: 20%;
    --bp-lamp-size: 650px 500px;
    --bp-lamp-end: rgb(var(--accent-rgb) / 0); /* transparent accent (== --bp-acc, alpha 0) */
  }
  :global(html.bp-home.light-mode) {
    --bp-lamp: rgb(var(--accent-rgb) / 0); /* hide the corner glow on the cream sheet — the twinkling stars carry the corner alone */
    --bp-line: rgba(22, 32, 43, 0.05);
    --bp-line2: rgba(22, 32, 43, 0.08);
    --bp-card: #e8e6df;
  }
  .bp {
    position: relative;
    background: var(--bp-bg);
    color: var(--bp-ink);
    /* Clear the fixed nav overlay (~69px) so the hero isn't tucked under it. The
       .bp-grid sheet is absolute inset:0, so it still fills from the true top
       (behind the nav glass) — padding only shifts the in-flow content down. */
    padding-top: 72px;
    font-family: "Space Grotesk", system-ui, sans-serif;
    /* overflow-x only (not `overflow: clip`) so it never becomes a scroll container
       that would trap the §04 sticky background. Matches the old layout, where only
       html had overflow-x: clip. */
    overflow-x: clip;
  }
  /* Crisp blueprint headings — cancel the site's light-mode heading drop-shadow
     filter. Scoped to THIS component's own .bp-display elements only; each home
     section component carries its own copy for its headings. (Deliberately NOT a
     reach-into-children :global — that form also caught SiteFooter's
     .bp-cta-title, which keeps the site-wide drop-shadow.) */
  :global(body.light-mode) .bp-display { filter: none !important; }

  /* Drafting grid: fine 36px + major 180px, spanning the whole sheet. */
  .bp-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* Desk-lamp glow's horizontal anchor: top-LEFT (0%) on desktop so it pairs
       with the constellation (also top-left ≥900px, opposite the hero ring);
       flipped to top-RIGHT (100%) at ≤900px where the ring moves up and both
       accents shift to the free top-right corner (see media query below). */
    --bp-lamp-x: 0%;
    background-image:
      linear-gradient(var(--bp-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line) 1px, transparent 1px),
      linear-gradient(var(--bp-line2) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line2) 1px, transparent 1px),
      /* Desk-lamp glow at the sheet's top corner (--bp-lamp-x: 0% desktop /
         100% ≤900px), dissolving fast so the hero label/copy stay legible
         (ramp tokens above). Kept compact (650×500) — a bigger ellipse floods
         half the hero. Plain gradient, no blur filter — win-perf-mode safe.
         `in oklab` + a same-hue transparent end (--bp-lamp-end) keep the fade
         clean (no muddy grey), which is what made light mode look smudged before. */
      radial-gradient(ellipse var(--bp-lamp-size) at var(--bp-lamp-x) 0% in oklab, var(--bp-lamp), var(--bp-lamp-hint), var(--bp-lamp-end) 75%);
    background-size: 36px 36px, 36px 36px, 180px 180px, 180px 180px, auto;
  }

  /* ≤900px the hero stacks and the ring moves up, freeing the top-right corner:
     the desk-lamp glow shifts there via --bp-lamp-x. (The constellation's half
     of this move lives in HomeHero.astro, which owns that markup.) */
  @media (max-width: 900px) {
    .bp-grid { --bp-lamp-x: 100%; }
  }

  /* Reach-into-children form (:global(:where(.bp) .X)): these atoms are used
     both by markup that stays directly in this component (hero, §04 art) and by
     markup now living in child section components (HomeDirectory/HomeWork/
     HomeVideos/HomeTools/HomeCapabilities/HomeStudio/
     HomeGamesRail/HomeBlogRail). The zero-specificity :where(.bp) guard keeps
     each rule page-local while :global() lets it match elements stamped with a
     child's own Astro scope id. Deliberately (0,1,0): before the split these
     atoms sat EARLIER in this style block than every section-specific rule, so
     at the old equal (0,2,0) specificity they lost all cascade ties by source
     order. Now that section rules live in child chunks (which Vite may emit in
     any order), the atoms are kept one class WEAKER instead — any scoped rule
     (min 0,2,0: class + cid attribute) in this or a child component still beats
     them, order-independent, reproducing the pre-split cascade exactly. */
  :global(:where(.bp) .bp-wrap) {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding-left: clamp(20px, 5vw, 48px);
    padding-right: clamp(20px, 5vw, 48px);
  }
  :global(:where(.bp) .bp-section) {
    padding-top: clamp(52px, 8vw, 88px);
    padding-bottom: clamp(52px, 8vw, 88px);
  }

  /* ══ §04 ART — full-bleed drafting sheet ═════════════════════════════════
     Desktop + no-reduced-motion only: the art section becomes an opaque,
     full-viewport sheet, centered and clearing the fixed nav. Pure CSS
     `position: sticky` (no GSAP pin), so it never fights Lenis, the games-rail
     ScrollTrigger pin, or the fixed art lightbox. Guarded query, so mobile /
     reduced-motion keep the normal document flow untouched.
     .bp-stack stays in this component (<main class="bp">'s direct child); the
     `section`/`.bp-art` it targets now live in HomeArt.astro, so both parts of
     each selector are :global()-wrapped to reach across the component boundary
     — `.bp-stack > :global(section)` compiles to `.bp-stack[cid] > section`
     (one attribute weaker than the pre-split `.bp-stack[cid] > section[cid]`).
     Nothing else sets position/min-height/padding on a `section` or `.bp-art`
     element under `.bp-stack` at a competing specificity, so this still wins
     the cascade the same way. */
  @media (min-width: 901px) and (prefers-reduced-motion: no-preference) {
    .bp-stack > :global(section) {
      position: sticky;
      top: 0;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      /* clear the fixed nav for the sheet's top-most content */
      padding-top: max(88px, 8vh);
      padding-bottom: 8vh;
    }
    /* The upward shadow lifts the sheet off the section above it. The base
       sticky bg (sticky 100vh photo inside the clip-path wrapper) is kept on
       desktop too: §04 is the deck's only sheet now, so its own sticky never
       engages and there is no sticky-inside-sticky double-pin — while an
       absolute bg would keep its base height:100vh and leave any gallery
       overflow past the first viewport uncovered. */
    .bp-stack > :global(.bp-art) { box-shadow: 0 -24px 50px -18px rgba(0, 0, 0, 0.5); }
  }

  /* ── shared motif atoms ── */
  :global(:where(.bp) .bp-display) {
    font-family: "Space Grotesk", system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em !important;
    color: var(--bp-ink);
  }
  :global(:where(.bp) .bp-sec-head) {
    margin-bottom: clamp(22px, 3vw, 34px);
  }
  :global(:where(.bp) .bp-sec-title-row) {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: clamp(26px, 4vw, 44px);
  }
  :global(:where(.bp) .bp-h2) {
    font-size: clamp(2.1rem, 6vw, 3.75rem);
    line-height: 1.0;
  }
  :global(:where(.bp) .bp-more) {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--bp-ink);
    text-decoration: none;
    border-bottom: 1.5px solid var(--bp-ink);
    padding-bottom: 3px;
    white-space: nowrap;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  :global(:where(.bp) .bp-more):hover { color: var(--bp-acc); border-color: var(--bp-acc); }

  /* :global(:where(.bp) …) reach-into-children form (see the comment block
     above .bp-wrap): .bp-badge marks up the §01 work-card badge (HomeWork.astro)
     and the games-rail BETA chip (HomeGamesRail.astro) — neither instance lives
     directly in this component anymore, so the plain scoped selector would
     never match — the zero-specificity :where(.bp) guard keeps it page-local
     while :global() lets it reach each child's own Astro scope id. */
  :global(:where(.bp) .bp-badge) {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--bp-acc);
    border: 1px solid color-mix(in srgb, var(--bp-acc) 40%, transparent);
    padding: 2px 7px;
    border-radius: 4px;
    white-space: nowrap;
  }


  /* ── ANNEX A / §03 rails — shared pin machinery ──
     :global(:where(.bp) …) reach-into-children form (see the comment block
     above .bp-wrap): the ANNEX A games rail and the §03 writing rail each
     moved out to their own component (HomeGamesRail.astro / HomeBlogRail.astro)
     but both still carry class .bp-rail-sec and both get a shared
     .bp-rail-viewport clip, so this base pin/height machinery stays here,
     reach-form, at its original file position — each rail's own card-track
     styling (marquee + bento plates / .bp-write-cards bento) now lives with
     its component. units.gr-style bento inside a horizontal rail: the track is
     a 2-row column-flow grid; default = native overflow-x swipe strip (mobile
     / reduced-motion / no-CDN fallback); homeRails.ts adds .is-pinned on
     desktop and GSAP scrubs the track sideways with page scroll. Full-bleed on
     purpose — the rail breaking out of the bp-wrap column is the
     layout-variance beat between two contained sections. */
  :global(:where(.bp) .bp-rail-sec) { position: relative; z-index: 1; --rail-h: clamp(440px, 66vh, 720px); }
  /* Pinned mode (desktop, JS-added): fill the viewport and centre the content;
     GSAP translates each rail's own track instead of the strip scrolling. The
     .bp-rail-viewport clip is shared too; each rail's own track override
     (.bp-rail-track for games, .bp-write-cards for blog) lives with its
     component. */
  :global(:where(.bp) .bp-rail-sec.is-pinned) { min-height: 100dvh; display: flex; flex-direction: column; justify-content: center; padding-top: 10px; padding-bottom: 10px; }
  :global(:where(.bp) .bp-rail-sec.is-pinned .bp-rail-viewport) { overflow: hidden; }
  /* Narrow viewports: shorter rail so the swipe strip doesn't dominate (each
     rail's own card-width overrides for narrow viewports live with its
     component). */
  @media (max-width: 900px) {
    :global(:where(.bp) .bp-rail-sec) { --rail-h: clamp(360px, 52vh, 440px); }
  }

  /* ── connectors (dimension lines between sections) ── */
  .bp-conn-wrap { position: relative; z-index: 1; display: flex; justify-content: center; padding: 6px 0; }
  /* Section connectors read as vertical drafting "dimension" marks: an extension
     tick at the top and a small measurement node at the bottom tip. The GSAP
     scaleY draw (see homeScrollAnimations) still animates the whole mark in. */
  .bp-conn { position: relative; width: 1px; height: 44px; background: linear-gradient(var(--bp-hair), color-mix(in srgb, var(--bp-hair) 35%, transparent)); display: block; }
  .bp-conn::before { content: ""; position: absolute; top: 0; left: 50%; width: 10px; height: 1px; margin-left: -5px; background: color-mix(in srgb, var(--bp-acc) 50%, transparent); }
  .bp-conn::after { content: ""; position: absolute; bottom: -1.5px; left: 50%; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: var(--bp-acc); }

</style>

<!-- Home scroll-animation hidden initial-states — gated on html.home-anim so JS-off /
     GSAP-fail / reduced-motion fall back to visible content (the failsafe drops the class). -->
<style is:global>
  html.home-anim [data-connector] { transform: scaleY(0); transform-origin: top center; }
  @media (prefers-reduced-motion: reduce) {
    html.home-anim [data-connector] { transform: none; }
  }
</style>

<script>
  import { initHomeReveals } from "../../scripts/homeReveals";
  initHomeReveals();
</script>
<script>
  import { initHomeHeaderReveals } from "../../scripts/homeHeaderReveals";
  initHomeHeaderReveals();
</script>
<script>
  import { initHomeScrollAnimations } from "../../scripts/homeScrollAnimations";
  initHomeScrollAnimations();
</script>

<!-- PROTOTYPE (units.gr-inspired): scramble-in for the mono section labels — the
     IBM Plex Mono eyebrows decode like a terminal readout as they scroll into
     view. Mono font → fixed advance width, so the scramble never reflows text.
     Skipped under reduced motion; label text is restored verbatim at the end. -->
<script is:inline defer src="https://cdn.jsdelivr.net/npm/gsap@3.13.0/dist/ScrambleTextPlugin.min.js" integrity="sha384-QsPhgdP78a1erQNT34dj/oyh7uPCXUnT/FkptUa/56LnSGsbTBmdiAOfB7j+8K4A" crossorigin="anonymous"></script>
<script is:inline>
  (function () {
    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    var tries = 0;
    (function boot() {
      var g = window.gsap, ST = window.ScrollTrigger, SC = window.ScrambleTextPlugin;
      if (!g || !ST || !SC) { if (tries++ < 100) setTimeout(boot, 80); return; }
      g.registerPlugin(SC);
      document.querySelectorAll(".bp-sec-label, .bp-sec-count").forEach(function (el) {
        var text = el.textContent;
        ST.create({
          trigger: el,
          start: "top 88%",
          once: true,
          onEnter: function () {
            g.to(el, { duration: 0.9, scrambleText: { text: text, chars: "01/—·+×", speed: 0.35 } });
          },
        });
      });
    })();
  })();
</script>
