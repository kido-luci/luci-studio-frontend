  border-color: rgb(var(--accent-rgb) / 0.55);
}

/* ── Art item scroll-triggered reveal ── */
@keyframes artFadeIn {
  from { opacity: 0; transform: scale(0.88) translateY(24px); }
  to   { opacity: 1; transform: scale(1)    translateY(0); }
}
[data-art-card] {
  opacity: 0;
}
[data-art-card].card-visible {
  animation: artFadeIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
}
/* Art item glow on hover */
[data-art-card]:hover .art-img-frame {
  box-shadow: 0 8px 32px rgb(var(--accent-rgb) / 0.25);
}

/* Art lightbox (popup) — replaces the old /art/[slug] detail page */
.art-lightbox {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 4vh 4vw;
  background: rgba(0, 0, 0, 0.92);
  opacity: 0;
  visibility: hidden;
  /* Fade opacity, but flip visibility instantly on show (0s) and only delay it
     on hide (0s ease 0.3s) — so the dialog is immediately focusable on open. */
  transition: opacity 0.3s ease, visibility 0s ease 0.3s;
}
.art-lightbox.is-open {
  opacity: 1;
  visibility: visible;
  transition: opacity 0.3s ease, visibility 0s ease 0s;
}
.art-lightbox-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  filter: blur(80px) brightness(0.18) saturate(1.5);
  transform: scale(1.15);
  pointer-events: none;
}
.art-lightbox-figure {
  position: relative;
  z-index: 10;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  max-width: 100%;
  max-height: 92vh;
  transform: scale(0.96);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}
.art-lightbox.is-open .art-lightbox-figure {
  transform: scale(1);
}
.art-lightbox-img {
  max-width: 100%;
  max-height: 78vh;
  width: auto;
  height: auto;
  object-fit: contain;
  border-radius: 0.5rem;
  box-shadow: 0 40px 120px rgba(0, 0, 0, 0.8);
}
.art-lightbox-caption {
  width: 100%;
  max-width: 64rem;
  padding: 1.25rem 0.25rem 0;
  text-align: left;
}
.art-lightbox-close {
  position: absolute;
  top: 1.25rem;
  right: 1.25rem;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 9999px;
  color: #fff;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(8px);
  transition: background 0.2s ease;
}
.art-lightbox-close:hover {
  background: rgba(255, 255, 255, 0.22);
}

#art-bg {
  background-image: url('https://media.luci-studio.com/ChatGPT%20Image%20May%205%2C%202026%2C%2011_03_29%20AM.jpg');
}
@media (max-width: 767px) {
  #art-bg {
    background-image: url('https://media.luci-studio.com/ef8036c5a8709482e3e4ecc1090cb8ae.jpg') !important;
  }
}

.hero-bg-img {
  background-image: url('https://media.luci-studio.com/hero/luci-hero-portrait.webp');
}
@media (orientation: landscape) {
  .hero-bg-img {
    background-image: url('https://media.luci-studio.com/hero/luci-hero-landscape.webp');
  }
}

/* ── MY STORY section animations ─────────────────────────────────── */
@keyframes storyPhotoIn {
  from { opacity: 0; transform: translateX(-48px) scale(0.97); }
  to   { opacity: 1; transform: translateX(0)     scale(1); }
}
@keyframes storyLabelIn {
  from { opacity: 0; transform: translateY(14px); letter-spacing: 0.6em; }
  to   { opacity: 1; transform: translateY(0);    letter-spacing: 0.3em; }
}
@keyframes storyParaIn {
  from { opacity: 0; transform: translateY(22px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes storyBadgeIn {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

[data-story-photo] {
  opacity: 0;
  transform: translateX(-48px) scale(0.97);
}
[data-story-photo].story-visible {
  animation: storyPhotoIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
}
[data-story-badge] {
  opacity: 0;
  transform: translateY(20px);
}
[data-story-badge].story-visible {
  animation: storyBadgeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
  animation-delay: 0.45s;
}
[data-story-label] {
  opacity: 0;
  transform: translateY(14px);
}
[data-story-label].story-visible {
  animation: storyLabelIn 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
}
[data-story-para] {
  opacity: 0;
  transform: translateY(22px);
}
[data-story-para].story-visible {
  animation: storyParaIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}
</style>

<!-- ── Home scroll-animation hidden initial-states ──────────────────────────
  Render-blocking + gated on html.home-anim so they exist before first paint
  (no FOUC) and vanish when the foundation script drops .home-anim (JS off,
  GSAP CDN failed, or reduced-motion). GSAP owns the in-motion; this only hides
  the start. Targets PostCard/RepoCard/SeriesCard roots, which carry their own
  Astro scope attr — so this MUST be is:global, not the scoped block above. -->
<style is:global>
  /* Step 2 — blog grid curtain: cards start invisible, GSAP owns the transform. */
  html.home-anim #home-blog-grid > .tb-card-link { opacity: 0; }

  /* Step 3 — section connectors draw downward (collapsed from the top). */
  html.home-anim [data-connector] { transform: scaleY(0); transform-origin: top center; }

  /* Step 5 — Lab + Series cards start invisible (GSAP clip-reveals each);
     the Lab underline draws left→right from a collapsed scaleX. */
  html.home-anim .lab-palette > *,
  html.home-anim .series-strip > li { opacity: 0; }
  html.home-anim [data-lab-underline] { transform: scaleX(0); transform-origin: left center; }

  @media (prefers-reduced-motion: reduce) {
    html.home-anim #home-blog-grid > .tb-card-link { opacity: 1; }
    html.home-anim [data-connector] { transform: none; }
    html.home-anim .lab-palette > *,
    html.home-anim .series-strip > li { opacity: 1; }
    html.home-anim [data-lab-underline] { transform: none; }
  }
</style>

