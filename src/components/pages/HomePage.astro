/* ── Role Badge ── */
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 18px;
  margin-bottom: 2rem;
  border: 1px solid rgb(var(--accent-rgb) / 0.3);
  border-radius: 999px;
  background: rgb(var(--accent-rgb) / 0.07);
  backdrop-filter: blur(8px);
}
.hero-badge-dot {
  width: 7px; height: 7px;
  border-radius: 50%;
