<script is:inline>
  // §01 COVER/DEMO toggle — mirrors the /games featured card: the cover crossfades
  // to a muted, looping gameplay video that autoplays. An IntersectionObserver
  // auto-switches Cover -> Demo ~2s after the card scrolls into view (skipped on
  // reduced motion, or if the visitor toggles first). preload stays 'none' until in view.
  (function () {
    var card = document.querySelector(".bp-work-card--demo");
    if (!card) return;
    var video = card.querySelector(".bp-fig-video");
    var btns = card.querySelectorAll(".bp-fig-toggle [data-fmode]");
    var userActed = false, autoTimer = null;
    function setDemo(on) {
      card.classList.toggle("is-demo", on);
      btns.forEach(function (b) {
        b.classList.toggle("is-active", (b.getAttribute("data-fmode") === "demo") === on);
      });
      if (video) { if (on) video.play().catch(function () {}); else video.pause(); }
    }
    btns.forEach(function (b) {
      function handle(e) {
        e.preventDefault(); e.stopPropagation();
        userActed = true;
        if (autoTimer) { clearTimeout(autoTimer); autoTimer = null; }
        setDemo(b.getAttribute("data-fmode") === "demo");
      }
      b.addEventListener("click", handle);
      b.addEventListener("keydown", function (e) { if (e.key === "Enter" || e.key === " ") handle(e); });
    });
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduce && "IntersectionObserver" in window && video) {
      var io = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          obs.disconnect();
          video.preload = "auto";
          autoTimer = setTimeout(function () { if (!userActed) setDemo(true); }, 2000);
        });
      }, { threshold: 0.5 });
      io.observe(card);
    }
  })();
</script>

<script>
  // Color-scheme picker popover (blueprint nav). window.setScheme + the swatch
  // aria-checked sync are provided globally by the Layout theme script; this only
  // handles opening/closing the popover and forwarding swatch clicks.
  const schemeToggle = document.getElementById("scheme-toggle");
  const schemePopover = document.getElementById("scheme-popover") as HTMLElement | null;
  if (schemeToggle && schemePopover) {
    const close = () => {
      const hadFocus = schemePopover.contains(document.activeElement);
      schemePopover.hidden = true;
      schemeToggle.setAttribute("aria-expanded", "false");
      if (hadFocus) (schemeToggle as HTMLElement).focus();
    };
    schemeToggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const willOpen = schemePopover.hidden;
      schemePopover.hidden = !willOpen;
      schemeToggle.setAttribute("aria-expanded", String(willOpen));
      if (willOpen) {
        const target = schemePopover.querySelector('.scheme-dot[aria-checked="true"]')
          || schemePopover.querySelector(".scheme-dot");
        (target as HTMLElement | null)?.focus();
      }
    });
    schemePopover.querySelectorAll(".scheme-dot").forEach((d) => {
      d.addEventListener("click", () => {
        const name = (d as HTMLElement).dataset.scheme;
        const setScheme = (window as any).setScheme;
        if (name && typeof setScheme === "function") setScheme(name);
        close();
      });
    });
    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (!schemePopover.hidden && !schemePopover.contains(t) && !schemeToggle.contains(t)) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !schemePopover.hidden) close();
    });
  }
</script>
