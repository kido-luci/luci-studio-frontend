  height: 1px;
  background: linear-gradient(90deg, transparent, rgb(var(--accent-rgb) / 0.5), rgba(59,130,246,0.4), transparent);
  opacity: 0;
  animation: divider-expand 1.2s cubic-bezier(0.16,1,0.3,1) 0.8s forwards;
}
.hero-divider-diamond {
  font-size: 0.55rem;
  color: rgb(var(--accent-rgb) / 0.7);
  animation: diamond-spin 8s linear infinite;
  flex-shrink: 0;
}

/* ── Subtitle ── */
.hero-subtitle {
  font-family: 'SN Pro', sans-serif;
  font-size: clamp(0.95rem, 2vw, 1.25rem);
  color: rgb(75, 85, 99) !important;
  max-width: 720px;
  margin: 0 auto 2rem;
  line-height: 1.75;
  padding: 0 0.5rem;
  min-height: 6.5em;
  /* Balance line lengths so the last line isn't a lone orphan word ("products.").
     Applied before SplitText reads the wrap, so the animated lines inherit it too. */
  text-wrap: balance;
}

/* ── Hero pillars: studio products (Blog · Tools · Games · Apps · Art) ── */
.hero-pillars {
  display: grid;
  /* auto-fit so the 5 products fill one row on wide screens and wrap gracefully
     as the viewport narrows (5 → 4 → … → 2 columns) without per-breakpoint rules. */
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  width: 100%;
  margin: 0;
  border-top: 1px solid rgba(17, 24, 39, 0.12);
  background: rgba(255, 255, 255, 0.25);
  box-shadow: 0 -8px 32px rgba(17, 24, 39, 0.08);
}
.hp-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.55rem;
  padding: 1.35rem 1.5rem 1.5rem;
  text-align: left;
  text-decoration: none;
  border-left: 1px solid rgba(255, 255, 255, 0.22);
  /* Soft dark shadow lifts text off the busy photo without touching the bg */
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
  transition: background 0.4s ease;
}
.hp-card:first-child { border-left: none; }
.hp-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: var(--hp);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}
.hp-card:hover::before { transform: scaleX(1); }
.hp-card:hover { background: rgba(255, 255, 255, 0.4); }
.hp-num {
  font-family: ui-monospace, 'SF Mono', 'SFMono-Regular', Menlo, monospace;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  color: var(--hp);
  text-shadow: none;
}
.hp-title {
  font-family: 'SN Pro', 'Inter', sans-serif;
  font-size: clamp(1.15rem, 2.3vw, 1.7rem);
  font-weight: 800;
  letter-spacing: -0.01em;
  color: #ffffff;
  transition: color 0.3s ease;
}
.hp-card:hover .hp-title { color: var(--hp); }
.hp-sub {
  font-family: ui-monospace, 'SF Mono', 'SFMono-Regular', Menlo, monospace;
  font-size: 0.74rem;
  font-weight: 500;
  letter-spacing: 0.01em;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.5;
}
.hp-arrow {
  position: absolute;
  top: 1.3rem; right: 1.35rem;
  font-size: 1rem;
  color: var(--hp);
  opacity: 0;
  transform: translateX(-5px);
  transition: opacity 0.3s ease, transform 0.3s ease;
}
.hp-card:hover .hp-arrow { opacity: 1; transform: translateX(0); }

/* Scroll cue — floats above the bottom bar to signal there is more below */
.hero-scroll-cue {
  position: absolute;
  left: 50%;
  bottom: 100%;
  transform: translateX(-50%);
  margin-bottom: 16px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  color: rgba(255, 255, 255, 0.9);
  text-decoration: none;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
  animation: heroScrollBounce 2s ease-in-out infinite;
  transition: opacity 0.3s ease;
}
.hero-scroll-cue:hover { opacity: 0.65; }
.hero-scroll-text {
  font-family: ui-monospace, 'SF Mono', 'SFMono-Regular', Menlo, monospace;
  font-size: 0.58rem;
  font-weight: 600;
  letter-spacing: 0.28em;
  text-indent: 0.28em;
}
.hero-scroll-chev {
  width: 18px;
  height: 18px;
}
@keyframes heroScrollBounce {
  0%, 100% { transform: translateX(-50%) translateY(0); }
  50%      { transform: translateX(-50%) translateY(6px); }
}

body.light-mode .hero-pillars {
  background: rgba(255, 255, 255, 0.4);
  border-top-color: rgba(17, 24, 39, 0.10);
}

@media (max-width: 720px) {
  /* Compact the product cards + drop the sub-line; the auto-fit grid wraps them
     across rows so only num + title show on small screens. */
  .hp-card {
    padding: 0.85rem 0.6rem 0.95rem;
    gap: 0.3rem;
  }
  .hp-num {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }
  .hp-title {
    font-size: clamp(0.78rem, 3.2vw, 1.05rem);
    letter-spacing: 0;
  }
  .hp-sub {
    display: none;
  }
}

/* ── Timeline ── */
.timeline-item.active {
  background: linear-gradient(135deg, rgba(204, 95, 150, 0.1) 0%, rgba(3, 3, 3, 1) 40%, rgba(3, 3, 3, 1) 100%) !important;
  border-color: rgba(236, 72, 153, 0.4) !important;
  box-shadow: 0 20px 40px -20px rgba(236, 72, 153, 0.2);
}

/* ── Mobile overrides (< 480px) ── */
@media (max-width: 480px) {
  .hero-badge {
    margin-bottom: 1.2rem;
  }
  .hero-headline {
    margin-bottom: 1.2rem;
  }
  .hero-line {
    /* Stack each word on its own line on very small screens */
    flex-direction: column;
    align-items: center;
    gap: 0.05em;
  }
  .hero-line-top {
    /* Each word becomes its own full-width line */
    font-size: clamp(2.6rem, 18vw, 4.5rem);
    letter-spacing: -0.03em;
  }
  .hero-line-bottom {
    font-size: clamp(1.1rem, 7vw, 1.6rem);
    letter-spacing: 0.05em;
  }
  .hero-divider {
    width: 70vw;
    margin: 0.4rem 0 0.2rem;
  }
  .hero-subtitle {
    font-size: 0.88rem;
    margin-bottom: 1.5rem;
    line-height: 1.65;
  }
}

/* ── Tablet overrides (480–768px) ── */
@media (min-width: 481px) and (max-width: 768px) {
  .hero-line-top {
    font-size: clamp(2.4rem, 9vw, 6rem);
  }
  .hero-line-bottom {
    font-size: clamp(1.1rem, 3vw, 1.8rem);
  }
}

/* ── Pinterest-style masonry for art section ── */
.masonry-art-grid {
  columns: 2;
  column-gap: 0.75rem;
}
@media (min-width: 640px) {
  .masonry-art-grid {
    columns: 3;
    column-gap: 1rem;
  }
}
@media (min-width: 1024px) {
  .masonry-art-grid {
    columns: 4;
    column-gap: 1rem;
  }
}
.masonry-art-item {
  break-inside: avoid;
  margin-bottom: 0.75rem;
  display: block;
}
@media (min-width: 640px) {
  .masonry-art-item {
    margin-bottom: 1rem;
  }
}
/* Art image frame border */
.art-img-frame {
  border-color: rgb(var(--accent-rgb) / 0.35);
}
body.light-mode .art-img-frame {
  border-color: rgb(var(--accent-rgb) / 0.25);
}

/* Blog cards now render via <PostCard> (data-reveal handles their reveal). */

/* ── Home playlists below blog grid ── */
.home-playlists {
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}
.series-strip {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
.playlist-see-all {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 2.5rem;
  padding: 0.55rem 1rem;
  border: 1px solid rgb(var(--accent-rgb) / 0.35);
  border-radius: 9999px;
  color: var(--accent);
  font-size: 0.7rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.14em;
