---
import Layout from "../../layouts/Layout.astro";
import TopNav from "../TopNav.astro";
import SiteFooter from "../SiteFooter.astro";
import "../../styles/lab-cards.css";

// Games are hosted as standalone deploys and linked out from here (same model
// as ToolsPage). Faldrop is the first game; add more entries to grow the grid.
const GAMES = [
  {
    slug: 'faldrop',
    title: 'Faldrop',
    tagline: '2.5D isometric block-stacker',
    blurb: 'Rotate and drop extruded isometric blocks, clear full levels, and chase your high score. Runs entirely in your browser — nothing to install.',
    image: 'https://faldrop.luci-studio.com/og-image.png',
    video: '/videos/faldrop-demo.mp4',
    href: 'https://faldrop.luci-studio.com',
    host: 'faldrop.luci-studio.com',
    tags: ['Arcade', 'Browser', 'No install'],
    beta: false,
  },
  {
    slug: 'stakrise',
    title: 'Stakrise',
    tagline: '2.5D isometric stack-tower',
    blurb: 'One tap: drop the sliding slab on the tower. Overhangs slice away, perfect drops grow it back — how high can you stack?',
    image: 'https://stakrise.luci-studio.com/og-image.png?v=2',
    href: 'https://stakrise.luci-studio.com',
    host: 'stakrise.luci-studio.com',
    tags: ['Arcade', 'Browser', 'No install'],
    beta: true,
  },
  {
    slug: 'sumfall',
    title: 'Sumfall',
    tagline: '2.5D isometric merge-drop puzzle',
    blurb: 'Drop numbered cubes and merge equal neighbours — chain the cascades and climb the values before the columns overflow.',
    image: 'https://sumfall.luci-studio.com/og-image.png?v=2',
    href: 'https://sumfall.luci-studio.com',
    host: 'sumfall.luci-studio.com',
    tags: ['Puzzle', 'Browser', 'No install'],
    beta: true,
  },
  {
    slug: 'huefall',
    title: 'Huefall',
    tagline: '2.5D isometric falling match-3',
    blurb: 'Steer falling three-cube bars and line up colours in any direction — clears cascade, chains double, and the well keeps speeding up.',
    image: 'https://huefall.luci-studio.com/og-image.png?v=2',
    href: 'https://huefall.luci-studio.com',
    host: 'huefall.luci-studio.com',
    tags: ['Puzzle', 'Browser', 'No install'],
    beta: true,
  },
  {
    slug: 'slithgrid',
    title: 'Slithgrid',
    tagline: 'Snake on a deep isometric grid',
    blurb: 'Classic snake, re-cut in 2.5D — eat, grow, and thread an ever-faster snake around a full 10×10 isometric board.',
    image: 'https://slithgrid.luci-studio.com/og-image.png?v=2',
    href: 'https://slithgrid.luci-studio.com',
    host: 'slithgrid.luci-studio.com',
    tags: ['Arcade', 'Browser', 'No install'],
    beta: true,
  },
] as const;

const totalGames: number = GAMES.length;
const featured = GAMES[0];
const rest = GAMES.slice(1);
---

<Layout
  title="Games · Luci Studio"
  description="Browser-native games you can play instantly — no install, no account. Built from scratch at Luci Studio."
>
  <TopNav active="games" />

  <main class="bp-games lab-palette">
    <div class="bp-grid" aria-hidden="true"></div>
    <div class="bp-wrap">

      <!-- page header -->
      <header class="bp-games-head">
        <div class="bp-sec-head">
          <span class="bp-dot" aria-hidden="true"></span>
          <span class="bp-mono bp-sec-label">ARCADE</span>
          <span class="bp-rule" aria-hidden="true"></span>
          <span class="bp-mono bp-sec-count">{String(totalGames).padStart(2, "0")} {totalGames === 1 ? "GAME" : "GAMES"}</span>
        </div>
        <h1 class="bp-display bp-games-title">Play a game<span class="bp-acc-dot">.</span></h1>
        <p class="bp-games-sub">Browser-native games built from scratch — instant play, no install, no account. Just open and go.</p>
      </header>

      <!-- featured game -->
      <a href={featured.href} target="_blank" rel="noopener noreferrer" class="game-feature">
        <div class={`game-feature-media${featured.video ? " game-feature-media--demo" : ""}`}>
          {featured.beta && <span class="game-beta bp-mono">Beta</span>}
          {featured.video ? (
            <Fragment>
              <img class="game-feature-cover" src={featured.image} alt={`${featured.title} — ${featured.tagline}`} loading="lazy" width="1200" height="630" />
              <video
                class="game-feature-video"
                muted
                loop
                playsinline
                preload="none"
                width="1056"
                height="1844"
                aria-label={`${featured.title} gameplay demo`}
              >
                <source src={featured.video} type="video/mp4" />
              </video>
              <div class="game-feature-toggle bp-mono" role="group" aria-label="Media view">
                <span class="game-feature-toggle-btn is-active" role="button" tabindex="0" data-demo="off">Cover</span>
                <span class="game-feature-toggle-btn" role="button" tabindex="0" data-demo="on">Demo</span>
              </div>
            </Fragment>
          ) : (
            <img src={featured.image} alt={`${featured.title} — ${featured.tagline}`} loading="lazy" width="1200" height="630" />
          )}
          <span class="game-feature-node" aria-hidden="true">◦</span>
        </div>
        <div class="game-feature-body">
          <div class="bp-mono game-feature-eyebrow">{featured.tagline}</div>
          <h2 class="bp-display game-feature-title">{featured.title}</h2>
          <p class="game-feature-blurb">{featured.blurb}</p>
          <div class="game-feature-tags">
            {featured.tags.map((tag) => (<span class="bp-mono game-tag">{tag}</span>))}
          </div>
          <span class="bp-mono game-feature-cta">Play now ↗</span>
          <span class="bp-mono game-feature-host"><span class="game-feature-dot"></span>{featured.host}</span>
        </div>
      </a>

      <!-- more games (grid grows as games are added) -->
      {rest.length > 0 && (
        <section class="bp-games-more">
          <div class="bp-sec-head">
            <span class="bp-dot" aria-hidden="true"></span>
            <span class="bp-mono bp-sec-label">MORE</span>
            <span class="bp-rule" aria-hidden="true"></span>
            <span class="bp-mono bp-sec-count">{String(rest.length).padStart(2, "0")} MORE</span>
          </div>
          <h2 class="bp-display bp-games-h2">More games<span class="bp-acc-dot">.</span></h2>
          <div class="bp-games-grid">
            {rest.map((game) => (
              <a href={game.href} target="_blank" rel="noopener noreferrer" class="game-card">
                <div class="game-card-media">{game.beta && <span class="game-beta bp-mono">Beta</span>}<img src={game.image} alt={`${game.title} — ${game.tagline}`} loading="lazy" width="1200" height="630" /></div>
                <div class="game-card-body">
                  <div class="bp-display game-card-title">{game.title}</div>
                  <div class="game-card-desc">{game.blurb}</div>
                </div>
                <div class="bp-mono game-card-footer">
                  <span class="game-card-host"><span class="game-card-dot"></span>{game.host}</span>
                  <span class="game-card-arrow">↗</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>

    <SiteFooter locale="en" />
  </main>

  <!-- Cover / Demo toggle on the featured card. The pills live inside the
       card's <a>, so cancel the click/keydown to stop it opening the game.
       Once the card scrolls into view it auto-switches Cover -> Demo after a
       short delay (skipped on reduced-motion, or if the user toggles first). -->
  <script is:inline>
    (function () {
      var media = document.querySelector('.game-feature-media--demo');
      if (!media) return;
      var video = media.querySelector('.game-feature-video');
      var btns = media.querySelectorAll('.game-feature-toggle-btn');
      var userActed = false;
      var autoTimer = null;
      function setDemo(on) {
        media.classList.toggle('is-demo', on);
        btns.forEach(function (b) {
          b.classList.toggle('is-active', (b.getAttribute('data-demo') === 'on') === on);
        });
        if (on) { video.play().catch(function () {}); } else { video.pause(); }
      }
      btns.forEach(function (b) {
        function handle(e) {
          e.preventDefault();
          e.stopPropagation();
          userActed = true;
          if (autoTimer) { clearTimeout(autoTimer); autoTimer = null; }
          setDemo(b.getAttribute('data-demo') === 'on');
        }
        b.addEventListener('click', handle);
        b.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { handle(e); }
        });
      });

      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce && 'IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (entries, obs) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            obs.disconnect();
            video.preload = 'auto';   // start buffering once it's in view
            autoTimer = setTimeout(function () {
              if (!userActed) setDemo(true);
            }, 2000);
          });
        }, { threshold: 0.5 });
        io.observe(media);
      }
    })();
  </script>
</Layout>

<style>
  /* /games — homepage "blueprint" drafting-sheet DNA. Line grid + §-headers +
     Space Grotesk display + IBM Plex Mono. Accent follows the color scheme; the
     Cover⇄Demo toggle on the featured card (script above) is preserved. */
  .bp-games {
    --bp-bg: #0a0e14;
    --bp-ink: var(--text-primary);
    --bp-acc: var(--accent);
    --bp-line: rgba(255, 255, 255, 0.05);
    --bp-line2: rgba(255, 255, 255, 0.08);
    --bp-hair: rgba(255, 255, 255, 0.14);
    --bp-fig: rgba(255, 255, 255, 0.05);
    --bp-muted: color-mix(in srgb, var(--text-primary) 64%, transparent);
    --bp-faint: color-mix(in srgb, var(--text-primary) 42%, transparent);
    --bp-panel: color-mix(in srgb, #ffffff 5%, var(--bp-bg));
    --bp-shadow: 0 12px 34px -22px rgba(0, 0, 0, 0.7);
    --bp-screen: #0a0e14;

    position: relative;
    min-height: 100vh;
    width: 100%;
    background: var(--bp-bg);
    color: var(--bp-ink);
    padding-top: clamp(120px, 15vh, 168px);
    padding-bottom: clamp(72px, 12vw, 128px);
    overflow-x: clip;
    font-family: "Space Grotesk", system-ui, sans-serif;
  }
  :global(body.light-mode) .bp-games {
    --bp-bg: #f4f2ec;
    --bp-line: rgba(22, 32, 43, 0.05);
    --bp-line2: rgba(22, 32, 43, 0.08);
    --bp-hair: rgba(22, 32, 43, 0.16);
    --bp-fig: #e8e6df;
    --bp-panel: #ffffff;
    --bp-shadow: 0 1px 2px rgba(20, 21, 42, 0.05), 0 12px 30px -24px rgba(20, 21, 42, 0.3);
  }

  .bp-games .bp-grid {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--bp-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line) 1px, transparent 1px),
      linear-gradient(var(--bp-line2) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line2) 1px, transparent 1px);
    background-size: 36px 36px, 36px 36px, 180px 180px, 180px 180px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 35%, transparent 85%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 35%, transparent 85%);
  }

  .bp-wrap { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; padding-left: clamp(20px, 5vw, 40px); padding-right: clamp(20px, 5vw, 40px); }
  .bp-mono { font-family: "IBM Plex Mono", ui-monospace, monospace; }
  .bp-display { font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700; letter-spacing: -0.02em; color: var(--bp-ink); }
  .bp-acc-dot { color: var(--bp-acc); font-style: normal; }

  .bp-sec-head { display: flex; align-items: center; gap: 14px; }
  .bp-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--bp-acc); flex-shrink: 0; }
  .bp-sec-label { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bp-acc); white-space: nowrap; }
  .bp-rule { flex: 1; height: 1px; background: var(--bp-hair); }
  .bp-sec-count { font-size: 11px; letter-spacing: 0.16em; color: var(--bp-muted); white-space: nowrap; }

  .bp-games-head { margin-bottom: clamp(30px, 5vw, 48px); }
  .bp-games-title { font-size: clamp(2.8rem, 8vw, 6rem); line-height: 0.98; margin: clamp(16px, 2.5vw, 24px) 0 0; }
  .bp-games-sub { margin: 1.4rem 0 0; max-width: 34rem; font-size: 1.05rem; line-height: 1.6; color: var(--bp-muted); }
  .bp-games-more { padding-top: clamp(56px, 9vw, 96px); }
  .bp-games-h2 { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.0; margin: clamp(14px, 2vw, 20px) 0 0; }
  .bp-games-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 22px; margin-top: clamp(28px, 4vw, 40px); }

  /* ── Featured game — blueprint panel (media left, body right) ── */
  .game-feature {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    text-decoration: none; color: inherit;
    background: var(--bp-panel);
    border: 1px solid var(--bp-hair);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--bp-shadow);
    margin-top: clamp(30px, 4vw, 48px);
    transition: transform 0.25s ease, box-shadow 0.25s, border-color 0.25s;
  }
  .game-feature:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 56px -30px color-mix(in srgb, var(--bp-acc) 45%, transparent);
    border-color: color-mix(in srgb, var(--bp-acc) 40%, transparent);
  }
  .game-feature-media {
    position: relative; overflow: hidden;
    background: var(--bp-screen);
    border-right: 1px solid var(--bp-hair);
  }
  .game-feature-media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s cubic-bezier(0.2,0.7,0.3,1); }
  .game-feature:hover .game-feature-media img { transform: scale(1.04); }
  .game-feature-node { position: absolute; top: 12px; right: 14px; z-index: 2; font-size: 12px; color: var(--bp-acc); }

  /* Cover ⇄ Demo cross-fade layers (dark screen so aspect ratios blend). */
  .game-feature-media--demo { min-height: 340px; }
  .game-feature-media--demo .game-feature-cover,
  .game-feature-media--demo .game-feature-video {
    position: absolute; inset: 0; width: 100%; height: 100%;
    transition: opacity 0.45s ease, transform 0.4s cubic-bezier(0.2,0.7,0.3,1);
  }
  .game-feature-media--demo .game-feature-cover { object-fit: cover; opacity: 1; }
  .game-feature-media--demo .game-feature-video { object-fit: contain; opacity: 0; }
  .game-feature-media--demo.is-demo .game-feature-cover { opacity: 0; }
  .game-feature-media--demo.is-demo .game-feature-video { opacity: 1; }

  /* Cover / Demo toggle pills (blueprint mono) */
  .game-feature-toggle {
    position: absolute; z-index: 3; left: 14px; bottom: 14px;
    display: inline-flex; gap: 3px; padding: 3px;
    border-radius: 8px;
    background: rgba(10, 14, 20, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  .game-feature-toggle-btn {
    /* Direct font-family to beat the global `[role="button"]` Boldonse rule in Layout. */
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase;
    padding: 5px 11px; border-radius: 6px;
    color: rgba(255, 255, 255, 0.72); cursor: pointer; user-select: none;
    transition: background 0.2s, color 0.2s;
  }
  .game-feature-toggle-btn:hover { color: #fff; }
  .game-feature-toggle-btn.is-active { background: var(--bp-acc); color: #fff; }

  .game-feature-body { padding: clamp(28px, 3vw, 40px); display: flex; flex-direction: column; align-items: flex-start; }
  .game-feature-eyebrow { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--bp-acc); }
  .game-feature-title { margin: 14px 0 0; font-size: clamp(1.9rem, 4vw, 2.8rem); line-height: 1.02; }
  .game-feature-blurb { margin: 16px 0 0; font-size: 1rem; line-height: 1.6; color: var(--bp-muted); }
  .game-feature-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 22px; }
  .game-tag {
    font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 5px;
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--bp-acc) 40%, transparent);
    color: var(--bp-acc);
  }
  .game-feature-cta {
    margin-top: 26px; display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 22px; border-radius: 999px;
    background: var(--bp-acc); color: var(--accent-ink);
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    transition: opacity 0.2s;
  }
  .game-feature:hover .game-feature-cta { opacity: 0.88; }
  .game-feature-host { display: flex; align-items: center; gap: 8px; margin-top: 20px; font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--bp-muted); }
  .game-feature-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--bp-acc); }

  @media (max-width: 760px) {
    .game-feature { grid-template-columns: 1fr; }
    .game-feature-media { aspect-ratio: 1200 / 630; border-right: none; border-bottom: 1px solid var(--bp-hair); }
    .game-feature-media--demo { aspect-ratio: 4 / 3; min-height: 0; }
    .game-feature-body { padding: 28px 24px; }
  }

  /* ── Secondary game cards ── */
  .game-card {
    display: flex; flex-direction: column;
    text-decoration: none; color: inherit;
    background: var(--bp-panel);
    border: 1px solid var(--bp-hair);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: none;
    transition: transform 0.25s ease, box-shadow 0.25s, border-color 0.25s;
  }
  .game-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 44px -26px color-mix(in srgb, var(--bp-acc) 45%, transparent);
    border-color: color-mix(in srgb, var(--bp-acc) 45%, transparent);
  }
  .game-card-media { position: relative; aspect-ratio: 1200 / 630; overflow: hidden; background: var(--bp-screen); }
  .game-card-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .game-card-body { padding: 20px 22px 16px; flex: 1; }
  .game-card-title { font-size: 1.2rem; line-height: 1.2; color: var(--bp-ink); }
  .game-card-desc { margin-top: 10px; font-size: 0.92rem; line-height: 1.55; color: var(--bp-muted); }
  .game-card-footer {
    display: flex; align-items: center; justify-content: space-between;
    padding: 13px 22px; border-top: 1px solid var(--bp-hair);
    background: transparent;
    font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--bp-muted);
  }
  .game-card-host { display: flex; align-items: center; gap: 8px; }
  .game-card-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--bp-acc); }
  .game-card-arrow { font-size: 14px; }

  /* BETA badge overlaid on a game's media */
  .game-beta {
    position: absolute; top: 12px; left: 12px; z-index: 2;
    font-size: 9px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
    padding: 4px 9px; border-radius: 5px;
    color: #fff; background: var(--bp-acc);
  }
</style>
