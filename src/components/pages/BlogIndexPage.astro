---
import Layout from "../../layouts/Layout.astro";
import TopNav from "../TopNav.astro";
import SeriesCard from "../SeriesCard.astro";
import PostCard from "../PostCard.astro";
import SiteFooter from "../SiteFooter.astro";
import { postService } from "../../services/posts";
import { playlistService } from "../../services/playlists";
import { buildSeriesViews } from "../../utils/series";
import { buildPostSlug, readTimeFor, formatDate, coverGradient } from "../../utils/blog";
import { getLocaleFromUrl, useTranslations, localizedHref, format, localized } from '../../i18n';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const rawPosts = await postService.getAll();
const rawPlaylists = await playlistService.getAll();

// Series view-models (stats + topics + year aggregated from the post list).
const playlists = buildSeriesViews(rawPlaylists, rawPosts);
// coverGradient lives in utils/blog and is shared with <PostCard>.

const allPosts = rawPosts
  .filter(p => !p.topics?.some(t => t.toLowerCase().startsWith('art')))
  .map(rawP => {
    const p = localized(rawP, locale);
    const tags = (p.topics && p.topics.length > 0) ? p.topics : ['Engineering'];
    return {
      id: p.id,
      title: p.title,
      subtitle: p.subtitle || '',
      // Slug must use the canonical (English) title so it matches the page emitted by
      // postPaths(); the localized VI title would build a slug that doesn't exist → 404.
      slug: buildPostSlug(rawP.title, rawP.id),
      tags,
      topics: p.topics || [],
      catLine: tags.join('  ·  '),
      coverWord: tags[0],
      cover: coverGradient(tags[0]),
      date: formatDate(p.created_at, locale),
      read: readTimeFor(p, locale),
      likes: p.likes ?? 0,
      views: p.views ?? 0,
      img: p.cover_image_url || '',
      search: `${p.title} ${p.subtitle || ''} ${tags.join(' ')}`.toLowerCase(),
    };
  });

const featured = allPosts[0];
const gridPosts = allPosts;

const API_URL = import.meta.env.PUBLIC_API_URL || '';
const SITE_URL = 'https://luci-studio.com';

// Topics ordered by how many posts carry them (most-used first); ties broken alphabetically.
const topicCounts = new Map<string, number>();
for (const p of allPosts) for (const t of p.topics) if (t) topicCounts.set(t, (topicCounts.get(t) || 0) + 1);
const allTopics = [...topicCounts.keys()].sort(
  (a, b) => (topicCounts.get(b)! - topicCounts.get(a)!) || a.localeCompare(b),
);
---

<Layout
  title="Blog | Luci Studio"
  description={`${allPosts.length} articles on engineering, architecture, and the craft of building software from Luci Studio.`}
  canonical={`${SITE_URL}/blog/`}
  keywords="Flutter, Go, technical blog, mobile development, engineering, clean architecture, Luci Studio"
  ogImage={`${SITE_URL}/images/og/blog.png`}
  ogImageAlt="Luci Studio — blog"
  ogImageWidth={1200}
  ogImageHeight={630}
>

  <TopNav active="blog" />

  <main class="bp-blog" data-api-url={API_URL}>
    <div class="bp-grid" aria-hidden="true"></div>
    <div class="bp-wrap">

      <!-- Header -->
      <header class="bp-blog-head" data-reveal>
        <div class="bp-sec-head">
          <span class="bp-dot" aria-hidden="true"></span>
          <span class="bp-mono bp-sec-label">{t('blog.eyebrow')}</span>
          <span class="bp-rule" aria-hidden="true"></span>
          <span class="bp-mono bp-sec-count">{String(allPosts.length).padStart(2, '0')} POSTS</span>
        </div>
        <div class="bp-blog-title-row">
          <div class="bp-blog-title-main">
            <h1 class="bp-display bp-blog-title">{t('blog.title')}<span class="bp-acc-dot">.</span></h1>
            <p class="bp-blog-sub">
              {format(t(allPosts.length === 1 ? 'blog.subOne' : 'blog.subOther'), { n: allPosts.length })}
            </p>
          </div>
          <div class="bp-blog-count">
            <div class="bp-blog-count-num" id="tb-count">{allPosts.length}</div>
            <div class="bp-mono bp-blog-count-label">{t('blog.countLabel')}</div>
          </div>
        </div>
      </header>

      <!-- Controls: search + filter label -->
      <div class="bp-blog-controls" data-reveal>
        <div class="bp-search-wrap">
          <svg class="bp-search-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
          <input id="tb-search" class="bp-search" type="text" placeholder={t('blog.searchPlaceholder')} autocomplete="off" aria-label={t('blog.searchAriaLabel')} />
        </div>
        {allTopics.length > 0 && <div class="bp-mono bp-blog-filter-label">{t('blog.filterLabel')}</div>}
      </div>

      <!-- Topic chips -->
      {allTopics.length > 0 && (
        <div class="bp-chips-wrap">
          <div class="bp-chips" id="topic-filters">
            <button class="topic-btn active-filter" data-topic="all">{t('blog.filterAll')}</button>
            {allTopics.map(topic => (
              <button class="topic-btn" data-topic={topic}>{topic}</button>
            ))}
          </div>
          <button id="chips-toggle" class="bp-chips-toggle bp-mono" type="button" hidden data-show-all={t('blog.showAllTags')} data-show-fewer={t('blog.showFewerTags')}>{t('blog.showAllTags')}</button>
        </div>
      )}

      <!-- Featured hero (first post; hidden when filtering/searching) -->
      {featured && (
        <a id="tb-featured" href={localizedHref(locale, `/blog/${featured.slug}/`)} class="bp-feat" data-featured-id={String(featured.id)}>
          <div class="bp-feat-fig" style={!featured.img ? `background:${featured.cover}` : undefined}>
            {featured.img
              ? <img src={featured.img} alt={featured.title} class="tb-cover-img" loading="lazy" onerror="this.style.opacity='0'" />
              : <span class="tb-cover-word">{featured.coverWord}</span>}
            <span class="bp-mono bp-feat-callout">fig.00 — featured</span>
            <span class="bp-mono bp-feat-badge">{t('blog.featuredBadge')}</span>
            <span class="bp-feat-node" aria-hidden="true">◦</span>
            <span class="bp-feat-dim" aria-hidden="true">
              <span class="bp-feat-dim-tick"></span>
              <span class="bp-feat-dim-rule"></span>
              <span class="bp-feat-dim-tick"></span>
            </span>
          </div>
          <div class="bp-feat-body">
            <div class="bp-mono bp-feat-cat">{featured.catLine}</div>
            <h2 class="bp-display bp-feat-title">{featured.title}</h2>
            {featured.subtitle && <p class="bp-feat-excerpt">{featured.subtitle}</p>}
            <div class="bp-feat-spacer"></div>
            <div class="bp-mono bp-feat-meta"><span>{featured.date}</span><span class="bp-feat-dot">·</span><span>{featured.read} read</span></div>
            <div class="bp-feat-foot">
              <span class="bp-mono bp-feat-read">{t('blog.readArticle')} <span class="bp-feat-arrow">→</span></span>
              <div class="bp-feat-stats bp-mono">
                <span class="tile-view-area bp-stat" data-id={String(featured.id)}>
                  <svg class="bp-stat-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                  <span class="tile-view-count">{featured.views}</span>
                </span>
                <span class="tile-like-area bp-stat bp-stat--like" data-id={String(featured.id)}>
                  <svg class="tile-like-icon bp-stat-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                  <span class="tile-like-count">{featured.likes}</span>
                </span>
              </div>
            </div>
          </div>
        </a>
      )}

      <!-- Empty state -->
      <div id="empty-state" class="bp-empty hidden">
        <div class="bp-display bp-empty-title">{t('blog.emptyTitle')}</div>
        <p class="bp-empty-sub">{t('blog.emptySub')}</p>
        <button id="tb-clear" class="bp-clear bp-mono">{t('blog.clearFilters')}</button>
      </div>

      <!-- Posts Grid -->
      <div id="posts-grid" class="bp-blog-grid">
        {gridPosts.map((p) => (
          <div class="post-item" data-id={p.id} data-topics={JSON.stringify(p.topics)} data-search={p.search} style="display:none">
            <PostCard
              href={localizedHref(locale, `/blog/${p.slug}/`)}
              title={p.title}
              subtitle={p.subtitle}
              tags={p.tags}
              date={p.date}
              read={p.read}
              img={p.img}
              id={p.id}
              views={p.views}
              likes={p.likes}
              interactive
              variant="blueprint"
            />
          </div>
        ))}
      </div>

      <!-- Pagination -->
      <div id="pagination" class="bp-pagination hidden"
        data-showing-tpl={t('blog.showing')}
        data-featured-suffix={t('blog.featuredSuffix')}
      >
        <div class="bp-pag-row">
          <button id="prev-btn" class="bp-pag-arrow" aria-label={t('blog.prevPage')}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
          <div id="page-numbers" class="bp-pag-nums"></div>
          <button id="next-btn" class="bp-pag-arrow" aria-label={t('blog.nextPage')}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        </div>
        <p id="posts-count" class="bp-mono bp-pag-count"></p>
      </div>

      <!-- Series strip (end of page) -->
      {playlists.length > 0 && (
        <section class="bp-strip-sec" data-reveal>
          <div class="bp-sec-head">
            <span class="bp-dot" aria-hidden="true"></span>
            <span class="bp-mono bp-sec-label">{t('blog.seriesEyebrow')}</span>
            <span class="bp-rule" aria-hidden="true"></span>
            <a href={localizedHref(locale, '/blog/series')} class="bp-mono bp-more">{t('blog.seeAll')}</a>
          </div>
          <div class="bp-sec-title-row">
            <h2 class="bp-display bp-blog-h2">{t('blog.seriesHeader')}<span class="bp-acc-dot">.</span></h2>
          </div>
          <ol class="bp-strip">
            {playlists.slice(0, 3).map((p, i) => (
              <li><SeriesCard series={p} variant="blueprint" index={i + 1} /></li>
            ))}
          </ol>
        </section>
      )}

    </div>

    <SiteFooter locale={locale} />
  </main>

</Layout>

<style>
  /* ══════════════════════════════════════════════════════════════════════
     Blog index — homepage "blueprint" drafting-sheet DNA.
     Line grid + §-section headers + Space Grotesk display + IBM Plex Mono.
     Accent follows the active color scheme; sheet flips cream/navy per theme.
     Interactive hooks (#tb-*, .topic-btn, .post-item, .tile-*) are unchanged.
     ══════════════════════════════════════════════════════════════════════ */
  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .bp-blog {
    --bp-ink: var(--text-primary);
    --bp-acc: var(--accent);
    --bp-line: rgba(255, 255, 255, 0.05);
    --bp-line2: rgba(255, 255, 255, 0.08);
    --bp-fig: rgba(255, 255, 255, 0.05);
    --bp-muted: color-mix(in srgb, var(--text-primary) 64%, transparent);
    --bp-faint: color-mix(in srgb, var(--text-primary) 42%, transparent);
    --bp-panel: color-mix(in srgb, #ffffff 5%, var(--bp-bg));
    --bp-shadow: 0 12px 34px -22px rgba(0, 0, 0, 0.7);

    position: relative;
    min-height: 100vh;
    background: var(--bp-bg);
    color: var(--bp-ink);
    padding-top: clamp(120px, 15vh, 168px);
    padding-bottom: clamp(72px, 12vw, 128px);
    overflow-x: clip;
  }
  :global(body.light-mode) .bp-blog {
    --bp-line: rgba(22, 32, 43, 0.05);
    --bp-line2: rgba(22, 32, 43, 0.08);
    --bp-fig: #e8e6df;
    --bp-panel: #ffffff;
    --bp-shadow: 0 1px 2px rgba(20, 21, 42, 0.05), 0 12px 30px -24px rgba(20, 21, 42, 0.3);
  }

  .bp-blog .bp-grid {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--bp-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line) 1px, transparent 1px),
      linear-gradient(var(--bp-line2) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line2) 1px, transparent 1px);
    background-size: 36px 36px, 36px 36px, 180px 180px, 180px 180px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 92%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 92%);
  }

  .bp-wrap { position: relative; z-index: 1; max-width: 1280px; margin: 0 auto; padding-left: clamp(20px, 5vw, 48px); padding-right: clamp(20px, 5vw, 48px); }

  .bp-sec-title-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-top: clamp(16px, 2vw, 22px); }
  .bp-more { font-size: 12px; letter-spacing: 0.08em; color: var(--bp-ink); text-decoration: none; border-bottom: 1.5px solid var(--bp-ink); padding-bottom: 3px; white-space: nowrap; transition: color 0.2s ease, border-color 0.2s ease; }
  .bp-more:hover { color: var(--bp-acc); border-color: var(--bp-acc); }
  .bp-blog-h2 { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.0; margin: 0; }

  /* ── Header ── */
  .bp-blog-head { margin-bottom: clamp(30px, 4vw, 46px); }
  .bp-blog-title-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-top: clamp(18px, 2.5vw, 26px); }
  .bp-blog-title-main { max-width: 640px; }
  .bp-blog-title { font-size: clamp(3.2rem, 9vw, 7rem); line-height: 0.95; margin: 0; }
  .bp-blog-sub { margin: 1.3rem 0 0; max-width: 32rem; font-family: "Space Grotesk", system-ui, sans-serif; font-size: 1.02rem; line-height: 1.6; color: var(--bp-muted); }
  .bp-blog-count { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; padding-bottom: 6px; }
  .bp-blog-count-num { font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700; letter-spacing: -0.02em; font-size: 46px; line-height: 1; color: var(--bp-ink); font-variant-numeric: tabular-nums; }
  .bp-blog-count-label { font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bp-muted); }

  /* ── Controls: search + filter label ── */
  .bp-blog-controls { margin-top: clamp(30px, 4vw, 46px); display: flex; align-items: center; gap: 16px; flex-wrap: wrap; justify-content: space-between; }
  .bp-search-wrap { position: relative; display: inline-flex; align-items: center; }
  .bp-search-ic { position: absolute; left: 16px; pointer-events: none; color: var(--bp-faint); }
  .bp-search { width: 320px; max-width: 64vw; padding: 12px 18px 12px 44px; border: 1px solid var(--bp-hair); border-radius: 999px; background: transparent; font-family: "Space Grotesk", system-ui, sans-serif; font-size: 14px; color: var(--bp-ink); outline: none; transition: border-color 0.2s ease; }
  .bp-search::placeholder { color: var(--bp-faint); }
  .bp-search:focus { border-color: var(--bp-acc); }
  .bp-blog-filter-label { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bp-muted); }

  /* ── Topic chips (JS sets clamp height + toggles) ── */
  .bp-chips-wrap { margin-top: 20px; }
  .bp-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .bp-chips.is-clamped { overflow: hidden; }
  .bp-chips-toggle { margin-top: 12px; background: none; border: none; padding: 2px; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--bp-acc); cursor: pointer; }
  .bp-chips-toggle:hover { text-decoration: underline; }
  .bp-chips-toggle[hidden] { display: none; }

  /* ── Featured hero — a blueprint feature panel (fig left, body right) ── */
  .bp-feat { display: grid; grid-template-columns: 1.05fr 1fr; gap: 0; margin-top: clamp(30px, 4vw, 48px); border: 1px solid var(--bp-hair); border-radius: 14px; background: var(--bp-panel); overflow: hidden; text-decoration: none; box-shadow: var(--bp-shadow); transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease; }
  .bp-feat:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--bp-acc) 40%, transparent); box-shadow: 0 26px 56px -30px color-mix(in srgb, var(--bp-acc) 45%, transparent); }
  .bp-feat-fig { position: relative; overflow: hidden; min-height: 300px; background: var(--bp-fig); border-right: 1px solid var(--bp-hair); display: flex; align-items: center; justify-content: center; padding: clamp(14px, 2vw, 20px); }
  .bp-feat-fig .tb-cover-img { position: static; inset: auto; width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain; border-radius: 8px; }
  .bp-feat-fig .tb-cover-word { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; text-align: center; padding: 0 16px; font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700; font-size: 58px; line-height: .85; letter-spacing: -.03em; color: color-mix(in srgb, var(--bp-ink) 14%, transparent); transform: rotate(-6deg); pointer-events: none; }
  .bp-feat-callout { position: absolute; left: 14px; bottom: 12px; font-size: 10px; letter-spacing: 0.06em; color: var(--bp-muted); }
  .bp-feat-badge { position: absolute; top: 14px; left: 14px; padding: 5px 10px; border-radius: 5px; border: 1px solid color-mix(in srgb, var(--bp-acc) 40%, transparent); background: color-mix(in srgb, var(--bp-bg) 55%, transparent); font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--bp-acc); backdrop-filter: blur(4px); }
  .bp-feat-node { position: absolute; top: 12px; right: 14px; font-size: 12px; color: var(--bp-acc); animation: bpFeatNode 2.6s ease-in-out infinite; }
  /* Dimension mark in the fig's bottom-right: tick—rule—tick draws in on load,
     as if the featured figure were being measured. Static under reduced motion
     and win-perf-mode. */
  .bp-feat-dim { position: absolute; right: 14px; bottom: 14px; width: 110px; display: flex; align-items: center; }
  .bp-feat-dim-tick { width: 1px; height: 10px; background: color-mix(in srgb, var(--bp-acc) 70%, transparent); flex: none; }
  .bp-feat-dim-rule { flex: 1; height: 1px; background: color-mix(in srgb, var(--bp-acc) 50%, transparent); transform: scaleX(0); transform-origin: left center; animation: bpFeatDim 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards; }
  @keyframes bpFeatDim { to { transform: scaleX(1); } }
  @keyframes bpFeatNode { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) {
    .bp-feat-node { animation: none; }
    .bp-feat-dim-rule { animation: none; transform: scaleX(1); }
  }
  :global(body.win-perf-mode) .bp-feat-node { animation: none; }
  :global(body.win-perf-mode) .bp-feat-dim-rule { animation: none; transform: scaleX(1); }
  .bp-feat-body { padding: clamp(28px, 3vw, 44px); display: flex; flex-direction: column; }
  .bp-feat-cat { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bp-acc); }
  .bp-feat-title { font-size: clamp(1.7rem, 3vw, 2.5rem); line-height: 1.05; margin: 14px 0 0; }
  .bp-feat-excerpt { font-family: "Space Grotesk", system-ui, sans-serif; font-size: 1rem; line-height: 1.6; color: var(--bp-muted); margin: 16px 0 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .bp-feat-spacer { flex: 1; min-height: 20px; }
  .bp-feat-meta { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--bp-muted); margin-top: 22px; }
  .bp-feat-dot { color: var(--bp-hair); }
  .bp-feat-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--bp-hair); }
  .bp-feat-read { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; letter-spacing: 0.06em; color: var(--bp-acc); }
  .bp-feat-arrow { font-size: 14px; }
  .bp-feat-stats { display: flex; align-items: center; gap: 16px; color: var(--bp-muted); font-size: 12px; }
  .bp-stat { display: inline-flex; align-items: center; gap: 6px; }
  .bp-stat--like { cursor: pointer; }
  .bp-stat-ic { width: 15px; height: 15px; }
  .bp-stat--like .tile-like-icon { transition: color .2s ease; }
  .bp-stat--like:hover .tile-like-icon { color: #ef4d6b; }
  @media (max-width: 820px) { .bp-feat { grid-template-columns: 1fr; } .bp-feat-fig { min-height: 220px; border-right: none; border-bottom: 1px solid var(--bp-hair); } }

  /* ── Grid ── */
  .bp-blog-grid { margin-top: clamp(32px, 4vw, 48px); display: grid; grid-template-columns: repeat(auto-fill, minmax(322px, 1fr)); gap: 24px; }

  /* Phone: collapse chips to a single horizontal-scroll row + hide the counter. */
  @media (max-width: 768px) {
    .bp-chips { flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 8px 2px 18px; margin-bottom: -14px; }
    .bp-chips::-webkit-scrollbar { display: none; }
    .topic-btn { flex: 0 0 auto; }
    .bp-blog-count { display: none; }
  }

  /* ── Empty state ── */
  .bp-empty { margin-top: 60px; padding: 64px 24px; text-align: center; border: 1px solid var(--bp-hair); border-radius: 14px; background: var(--bp-panel); }
  .bp-empty-title { font-size: clamp(1.6rem, 3vw, 2rem); }
  .bp-empty-sub { font-family: "Space Grotesk", system-ui, sans-serif; font-size: 0.95rem; color: var(--bp-muted); margin: 12px 0 24px; }
