---
import Layout from "../../layouts/Layout.astro";
import TimelineItem from "../TimelineItem.astro";
import TopNav from "../TopNav.astro";
import SiteFooter from "../SiteFooter.astro";
import { workService } from "../../services/work";
import { profileService } from "../../services/profile";
import { skillsService } from "../../services/skills";
import { getLocaleFromUrl, useTranslations, localizedHref, localized } from '../../i18n';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const rawProfile = await profileService.getProfile();
const profile = rawProfile ? localized(rawProfile, locale) : null;
const skills = await skillsService.getAll();
const work = await workService.getAll();

const highlightYear = (s?: string) => (s ?? "").replace(/\b(\d{4})\b/, '<span class="sk-year">$1</span>');
const localizedWork = work.map(w => localized(w, locale));
const localizedSkills = skills.map(s => localized(s, locale));
const toTimelineShape = (w: (typeof work)[number]) => ({
  id: w.title,
  year: w.period,
  role: w.role ?? "",
  company: w.company ?? "",
  location: w.location ?? "",
  desc: w.summary ?? "",
  details: w.achievements,
  tech: w.tech,
  img: w.card_image_url,
  logo: w.logo_url || undefined,
  links: w.links,
});
const experience    = localizedWork.filter(w => w.category === 'paid').map(toTimelineShape);
const indieProjects = localizedWork.filter(w => w.category === 'indie').map(toTimelineShape);

// Skills header stats (computed from the live data)
const disciplineCount = localizedSkills.length;
const totalItems = localizedSkills.reduce((n, c) => n + (c.items?.length ?? 0), 0);
const toolsLabel = totalItems >= 5 ? `${Math.floor(totalItems / 5) * 5}+` : String(totalItems);

// Number every category globally (01..0N in sort order), then split wide vs narrow for the grid.
const numberedSkills = (localizedSkills ?? []).map((cat, i) => ({ cat, num: String(i + 1).padStart(2, "0") }));
const narrowSkills = numberedSkills.filter((x) => !x.cat.wide);
const wideSkills = numberedSkills.filter((x) => x.cat.wide);
---

<Layout
  title="Portfolio · Luci Studio"
  description="Trung Lập (Luci) — Full Stack Flutter & Go Developer. My story, experience, and skills."
  ogImage="https://luci-studio.com/images/og/portfolio.png"
  ogImageAlt="Luci Studio — portfolio"
  ogImageWidth={1200}
  ogImageHeight={630}
>

  <TopNav active="portfolio" />

  <main class="bp-portfolio">
    <div class="bp-grid" aria-hidden="true"></div>

    <!-- MY STORY -->
    <section id="about" class="bp-wrap bp-po-sec bp-po-sec--first">
      <div class="bp-sec-head" data-reveal>
        <span class="bp-dot" aria-hidden="true"></span>
        <span class="bp-mono bp-sec-label">{t('portfolio.thePersonEyebrow')}</span>
        <span class="bp-rule" aria-hidden="true"></span>
        <span class="bp-mono bp-sec-count">01 · STORY</span>
      </div>
      <div class="bp-po-story">
        <!-- Left: Photo -->
        <div data-story-photo class="bp-po-photo">
          <img src={profile?.story_photo_url} alt="Trung Lap" class="bp-po-photo-img" />
          <div data-story-badge class="bp-po-badge">
            <p class="bp-mono bp-po-badge-label">{t('portfolio.basedIn')}</p>
            <p class="bp-po-badge-value">{profile?.story_location}</p>
          </div>
        </div>

        <!-- Right: Content -->
        <div class="bp-po-story-text">
          <h2 class="bp-display bp-po-title" data-reveal>{t('portfolio.myStory')}<span class="bp-acc-dot">.</span></h2>
          <div class="bp-po-paras">
            {(profile?.bio_paragraphs ?? []).map((para, i) => (
              <p data-story-para={String(i)} class="bp-po-para" set:html={para} />
            ))}
          </div>
          <div class="bp-po-facts">
            {(profile?.story_facts ?? []).map((f, fi) => (
              <div data-reveal="scale" data-delay={String(fi + 1)} class="bp-po-fact">
                <p class="bp-mono bp-po-fact-label">{f.label}</p>
                <p class="bp-po-fact-value">{f.value}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section class="bp-wrap bp-po-stats-sec">
      <div class="bp-po-stats">
        {(profile?.portfolio_stats ?? []).map((s, i) => (
          <div data-reveal data-delay={String(i+1)} class="bp-po-stat">
            <div class="bp-display bp-po-stat-num">
              <span class="count-up" data-count={s.number} data-suffix={s.suffix}>0{s.suffix}</span>
            </div>
            <div class="bp-po-stat-title">{s.label}</div>
            <div class="bp-mono bp-po-stat-sub">{s.sub}</div>
          </div>
        ))}
      </div>
    </section>

    <!-- EXPERIENCE -->
    <section id="experience" class="bp-wrap bp-po-sec">
      <div class="bp-sec-head" data-reveal>
        <span class="bp-dot" aria-hidden="true"></span>
        <span class="bp-mono bp-sec-label">{t('portfolio.theRecord')}</span>
        <span class="bp-rule" aria-hidden="true"></span>
        <span class="bp-mono bp-sec-count">02 · WORK</span>
      </div>
      <h2 class="bp-display bp-po-title" data-reveal>{t('portfolio.experience')}<span class="bp-acc-dot">.</span></h2>

      <div class="bp-po-tl-group">
        <h3 class="bp-mono bp-po-tl-label" data-reveal>{t('portfolio.paidWork')}<span class="bp-po-tl-rule" aria-hidden="true"></span></h3>
        <div class="timeline-container bp-po-tl">
          {experience.map((j, i) => (
            <TimelineItem {...j} index={i} />
          ))}
        </div>
      </div>
      <div class="bp-po-tl-group">
        <h3 class="bp-mono bp-po-tl-label" data-reveal>{t('portfolio.ownBets')}<span class="bp-po-tl-rule" aria-hidden="true"></span></h3>
        <div class="timeline-container bp-po-tl">
          {indieProjects.map((j, i) => (
            <TimelineItem {...j} index={i} />
          ))}
        </div>
      </div>
    </section>

    <!-- SKILLS -->
    <section id="skills" class="bp-wrap bp-po-sec">
      <div class="sk-header" data-reveal>
        <div>
          <div class="bp-sec-head">
            <span class="bp-dot" aria-hidden="true"></span>
            <span class="bp-mono bp-sec-label">{t('portfolio.theStack')}</span>
          </div>
          <h2 class="bp-display bp-po-title">{t('portfolio.skills')}<span class="bp-acc-dot">.</span></h2>
        </div>
        <div class="sk-stats">
          <div>
            <div class="bp-display sk-stat-num tabular-nums">{disciplineCount}</div>
            <div class="bp-mono sk-stat-label">{t('portfolio.disciplines')}</div>
          </div>
          <div>
            <div class="bp-display sk-stat-num tabular-nums">{toolsLabel}</div>
            <div class="bp-mono sk-stat-label">{t('portfolio.toolsAndCrafts')}</div>
          </div>
        </div>
      </div>

      <div class="sk-grid">
        {narrowSkills.map(({ cat, num }) => (
          <div data-reveal class="sk-card">
            <div class="sk-head">
              <div class="sk-head-left">
                <span class="sk-dot"></span>
                <span class="bp-mono sk-label">{cat.name}</span>
              </div>
              <span class="bp-mono sk-num">{num}</span>
            </div>
            <div class="sk-chips">
              {cat.items.map((s) => (<span class="sk-chip">{s}</span>))}
            </div>
          </div>
        ))}
      </div>

      {wideSkills.map(({ cat, num }) => (
        <div data-reveal class="sk-card sk-card--wide">
          <div class="sk-wide-left">
            <div class="sk-head">
              <div class="sk-head-left">
                <span class="sk-dot"></span>
                <span class="bp-mono sk-label">{cat.name}</span>
              </div>
              <span class="bp-mono sk-num">{num}</span>
            </div>
            {cat.description && <p class="sk-desc" set:html={highlightYear(cat.description)} />}
          </div>
          <div class="sk-chips sk-chips--wide">
            {cat.items.map((s) => (<span class="sk-chip">{s}</span>))}
          </div>
        </div>
      ))}
    </section>

    <SiteFooter locale={locale} />

  </main>

</Layout>

<style>
  /* /portfolio — homepage "blueprint" drafting-sheet DNA. Line grid + §-headers +
     Space Grotesk display + IBM Plex Mono. Accent follows the color scheme. The
     story / count-up / timeline reveal JS hooks (data-story-*, .count-up,
     .timeline-container) are unchanged. */
  .bp-portfolio {
    --bp-ink: var(--text-primary);
    --bp-acc: var(--accent);
    --bp-line: rgba(255, 255, 255, 0.05);
    --bp-line2: rgba(255, 255, 255, 0.08);
    --bp-fig: rgba(255, 255, 255, 0.05);
    --bp-muted: color-mix(in srgb, var(--text-primary) 64%, transparent);
    --bp-faint: color-mix(in srgb, var(--text-primary) 42%, transparent);
    --bp-panel: color-mix(in srgb, #ffffff 5%, var(--bp-bg));
    --bp-panel-hover: color-mix(in srgb, var(--bp-acc) 8%, var(--bp-panel));
    --bp-shadow: 0 12px 34px -22px rgba(0, 0, 0, 0.7);

    position: relative;
    min-height: 100vh;
    width: 100%;
    background: var(--bp-bg);
    color: var(--bp-ink);
    padding-top: clamp(96px, 12vh, 140px);
    padding-bottom: clamp(72px, 12vw, 128px);
    overflow-x: clip;
    font-family: "Space Grotesk", system-ui, sans-serif;
  }
  :global(body.light-mode) .bp-portfolio {
    --bp-line: rgba(22, 32, 43, 0.05);
    --bp-line2: rgba(22, 32, 43, 0.08);
    --bp-fig: #e8e6df;
    --bp-panel: #ffffff;
    --bp-shadow: 0 1px 2px rgba(20, 21, 42, 0.05), 0 12px 30px -24px rgba(20, 21, 42, 0.3);
  }

  /* Drafting grid — a top-anchored header band, fading into the clean sheet. */
  .bp-portfolio .bp-grid {
    position: absolute; top: 0; left: 0; right: 0; height: 900px; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--bp-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line) 1px, transparent 1px),
      linear-gradient(var(--bp-line2) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line2) 1px, transparent 1px);
    background-size: 36px 36px, 36px 36px, 180px 180px, 180px 180px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%);
  }

  .bp-wrap { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; padding-left: clamp(20px, 5vw, 40px); padding-right: clamp(20px, 5vw, 40px); }

  .bp-po-sec { padding-top: clamp(48px, 8vw, 88px); padding-bottom: clamp(24px, 4vw, 40px); }
  .bp-po-sec--first { padding-top: clamp(20px, 3vw, 32px); }
  .bp-po-title { font-size: clamp(2.6rem, 7vw, 5rem); line-height: 1.0; margin: clamp(16px, 2.5vw, 26px) 0 0; }

  /* ── My story ── */
  .bp-po-story { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; margin-top: clamp(28px, 4vw, 44px); }
  .bp-po-photo { position: relative; border: 1px solid var(--bp-hair); border-radius: 14px; overflow: hidden; background: var(--bp-fig); box-shadow: var(--bp-shadow); aspect-ratio: 4 / 5; }
  .bp-po-photo-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .bp-po-photo:hover .bp-po-photo-img { transform: scale(1.04); }
  .bp-po-badge { position: absolute; left: 18px; right: 18px; bottom: 18px; padding: 16px 18px; border-radius: 10px; border: 1px solid rgba(255, 255, 255, 0.16); background: rgba(10, 14, 20, 0.55); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .bp-po-badge-label { font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--bp-acc); margin: 0 0 4px; }
  .bp-po-badge-value { font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700; font-size: 1.05rem; color: #fff; margin: 0; }
  .bp-po-story-text { min-width: 0; }
  .bp-po-story-text .bp-po-title { margin-top: 4px; }
  .bp-po-paras { display: flex; flex-direction: column; gap: 1.1rem; margin-top: 1.6rem; }
  .bp-po-para { font-size: 1.05rem; line-height: 1.65; color: var(--bp-muted); margin: 0; }
  /* Bio emphasis arrives as set:html (`.text-white font-bold`) baked for the dark
     theme; retint to blueprint ink so it reads on the sheet in both modes. */
  .bp-po-para :global(.text-white),
  .bp-po-para :global(strong),
  .bp-po-para :global(b) { color: var(--bp-ink); font-weight: 700; }
  .bp-po-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 2rem; }
  .bp-po-fact { padding: 14px 16px; border: 1px solid var(--bp-hair); border-radius: 10px; background: var(--bp-panel); transition: border-color 0.2s ease, background 0.2s ease; }
  .bp-po-fact:hover { border-color: color-mix(in srgb, var(--bp-acc) 40%, transparent); background: var(--bp-panel-hover); }
  .bp-po-fact-label { font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bp-muted); margin: 0 0 4px; }
  .bp-po-fact-value { font-size: 0.92rem; font-weight: 600; color: var(--bp-ink); margin: 0; }

  /* ── Stats ── */
  .bp-po-stats-sec { padding-top: clamp(40px, 6vw, 64px); }
  .bp-po-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 170px), 1fr)); gap: 14px; }
  .bp-po-stat { padding: clamp(20px, 3vw, 32px); border: 1px solid var(--bp-hair); border-radius: 12px; background: var(--bp-panel); text-align: center; transition: border-color 0.3s ease; }
  .bp-po-stat:hover { border-color: color-mix(in srgb, var(--bp-acc) 40%, transparent); }
  .bp-po-stat-num { font-size: clamp(2.8rem, 6vw, 4rem); line-height: 1; color: var(--bp-ink); margin-bottom: 8px; font-variant-numeric: tabular-nums; }
  .bp-po-stat-title { font-weight: 700; color: var(--bp-ink); margin-bottom: 4px; }
  .bp-po-stat-sub { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bp-muted); }

  /* ── Experience ── */
  .bp-po-tl-group { margin-top: clamp(40px, 6vw, 64px); }
  .bp-po-tl-label { display: flex; align-items: center; gap: 16px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--bp-muted); margin: 0 0 clamp(20px, 3vw, 30px); }
  .bp-po-tl-rule { flex: 1; height: 1px; background: var(--bp-hair); }
  .bp-po-tl { display: flex; flex-direction: column; gap: 1rem; }

  /* ── Skills ── */
  .sk-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-bottom: clamp(32px, 5vw, 52px); }
  .sk-header .bp-po-title { margin-top: clamp(14px, 2vw, 20px); }
  .sk-stats { display: flex; gap: 36px; padding-bottom: 10px; }
  .sk-stat-num { font-size: 2rem; line-height: 1; color: var(--bp-ink); }
  .sk-stat-label { margin-top: 5px; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bp-muted); }

  .sk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .sk-card { position: relative; border-radius: 12px; padding: 22px 22px 24px; overflow: hidden; background: var(--bp-panel); border: 1px solid var(--bp-hair); box-shadow: none; transition: border-color 0.25s ease, background 0.25s ease; }
  .sk-card:hover { border-color: color-mix(in srgb, var(--bp-acc) 35%, transparent); background: var(--bp-panel-hover); }
  .sk-card--wide { margin-top: 18px; display: grid; grid-template-columns: minmax(240px, 330px) 1fr; gap: clamp(28px, 4vw, 56px); align-items: start; }
  .sk-head { position: relative; display: flex; align-items: center; justify-content: space-between; padding-bottom: 14px; margin-bottom: 16px; border-bottom: 1px solid var(--bp-hair); }
  .sk-head-left { display: flex; align-items: center; gap: 10px; }
  .sk-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--bp-acc); box-shadow: 0 0 0 4px color-mix(in srgb, var(--bp-acc) 20%, transparent); }
  .sk-label { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bp-acc); }
  .sk-num { font-size: 12px; letter-spacing: 0.1em; color: var(--bp-muted); }
  .sk-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .sk-chips--wide { align-content: flex-start; }
  .sk-chip { display: inline-flex; align-items: center; padding: 7px 13px; border-radius: 999px; background: transparent; border: 1px solid var(--bp-hair); color: var(--bp-muted); font-size: 12.5px; letter-spacing: -0.01em; cursor: default; transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease, color 0.18s ease; }
  .sk-chip:hover { transform: translateY(-2px); background: color-mix(in srgb, var(--bp-acc) 12%, transparent); border-color: var(--bp-acc); color: var(--bp-ink); }
  .sk-desc { margin: 0; font-size: 0.95rem; line-height: 1.6; color: var(--bp-muted); max-width: 34ch; }
  /* .sk-year arrives via set:html (highlightYear), so it isn't scoped — target it globally. */
  .sk-desc :global(.sk-year) { color: var(--bp-acc); font-weight: 700; }
  @media (max-width: 720px) { .sk-card--wide { grid-template-columns: 1fr; } }

  /* ── CTA ── */

  /* ── Story reveal (IntersectionObserver-driven; classes/attrs unchanged) ── */
  @keyframes storyPhotoIn { from { opacity: 0; transform: translateX(-40px) scale(0.98); } to { opacity: 1; transform: translateX(0) scale(1); } }
  @keyframes storyParaIn { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes storyBadgeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  [data-story-photo] { opacity: 0; transform: translateX(-40px) scale(0.98); }
  [data-story-photo].story-visible { animation: storyPhotoIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) both; }
  [data-story-badge] { opacity: 0; transform: translateY(20px); }
  [data-story-badge].story-visible { animation: storyBadgeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: 0.45s; }
  [data-story-para] { opacity: 0; transform: translateY(22px); }
  [data-story-para].story-visible { animation: storyParaIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both; }

  /* ── Mobile ── */
  @media (max-width: 900px) {
    .bp-po-story { grid-template-columns: 1fr; }
    .bp-po-photo { max-width: 440px; aspect-ratio: 4 / 3; }
    .sk-header { align-items: flex-start; }
  }
  @media (max-width: 560px) {
    .bp-po-facts { grid-template-columns: 1fr; }
  }
</style>

<script>
  // EXPERIENCE timeline
  (function () {
    const items = document.querySelectorAll<HTMLElement>('[data-timeline-item]');
    if (!items.length) return;
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => { if (!e.isIntersecting) return; e.target.classList.add('tl-visible'); obs.unobserve(e.target); });
    }, { threshold: 0.12, rootMargin: '0px 0px -20px 0px' });
    items.forEach(el => obs.observe(el));
  })();

  // MY STORY animations
  (function () {
    const photo = document.querySelector<HTMLElement>('[data-story-photo]');
    const badge = document.querySelector<HTMLElement>('[data-story-badge]');
    const label = document.querySelector<HTMLElement>('[data-story-label]');
    const paras = Array.from(document.querySelectorAll<HTMLElement>('[data-story-para]'));
    if (photo) {
      const obs = new IntersectionObserver(entries => {
        entries.forEach(e => { if (!e.isIntersecting) return; photo.classList.add('story-visible'); badge?.classList.add('story-visible'); obs.disconnect(); });
      }, { threshold: 0.15, rootMargin: '0px 0px -20px 0px' });
      obs.observe(photo);
    }
    if (paras.length) {
      const obs = new IntersectionObserver(entries => {
        entries.forEach(e => { if (!e.isIntersecting) return; label?.classList.add('story-visible'); paras.forEach((p, i) => { p.style.animationDelay = `${0.08 + i * 0.13}s`; p.classList.add('story-visible'); }); obs.disconnect(); });
      }, { threshold: 0.1, rootMargin: '0px 0px -20px 0px' });
      obs.observe(paras[0]);
    }
  })();

  // Count-up animation for stats
  setTimeout(() => {
    document.querySelectorAll<HTMLElement>('.count-up').forEach(el => {
      const target = parseInt(el.dataset.count ?? '0', 10);
      const suffix = el.dataset.suffix ?? '';
      if (isNaN(target) || target === 0) return;
      const duration = 900;
      const start = performance.now();
      const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1);
        el.textContent = String(Math.round(easeOut(progress) * target)) + suffix;
        if (progress < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    });
  }, 300);
</script>
