---
import Layout from "../../layouts/Layout.astro";
import TopNav from "../TopNav.astro";
import SiteFooter from "../SiteFooter.astro";
import { getLocaleFromUrl, useTranslations } from '../../i18n';
const locale = getLocaleFromUrl(Astro.url);
const t = useTranslations(locale);

const SITE_URL = 'https://luci-studio.com';
const lastUpdated = 'June 30, 2026';
---

<Layout
  title="License | Luci Studio"
  description="Copyright and usage license for the content, code samples, and games on Luci Studio."
  canonical={`${SITE_URL}/license/`}
  keywords="Luci Studio license, content license, copyright, usage rights"
>
  <TopNav />

  <main class="bp-legal">
    <div class="bp-grid" aria-hidden="true"></div>
    <article class="bp-legal-inner">
      <div class="bp-sec-head">
        <span class="bp-dot" aria-hidden="true"></span>
        <span class="bp-mono bp-sec-label">{t('legal.eyebrow')}</span>
        <span class="bp-rule" aria-hidden="true"></span>
      </div>
      <h1 class="bp-display bp-legal-title">{t('legal.licenseTitle')}<span class="bp-acc-dot">.</span></h1>
      <p class="bp-mono bp-legal-updated">{t('legal.lastUpdated')} {lastUpdated}</p>

      <div class="legal-copy">
        <section>
          <h2>Overview</h2>
          <p>
            This page explains who owns the material on Luci Studio and how you may use it. It covers articles, artwork, designs, code samples, and the games and tools published or linked from this site. It is provided for general information and is not legal advice.
          </p>
          <p>
            Unless a specific item says otherwise, everything here is &copy; Luci Studio. Where an item carries its own license, that license governs it.
          </p>
        </section>

        <section>
          <h2>Content and Copyright</h2>
          <p>
            Articles, portfolio materials, artwork, images, written copy, and visual designs on this site are owned by Luci Studio or used with permission. You may link to public pages and quote brief excerpts with clear attribution, but you may not copy, republish, sell, redistribute, or imply endorsement without prior written permission.
          </p>
        </section>

        <section>
          <h2>Code Samples</h2>
          <p>
            Code snippets shown inside articles are shared so you can learn from and adapt them in your own projects, including commercial ones. Attribution is appreciated but not required for short snippets. The code is provided as-is, without warranty of any kind; you are responsible for testing and using it safely.
          </p>
        </section>

        <section>
          <h2>Games and Interactive Content</h2>
          <p>
            The games and interactive experiences published or linked from this site &mdash; including Faldrop &mdash; are owned by Luci Studio. They are free to play in your browser for personal, non-commercial enjoyment. You may not redistribute, rehost, sell, decompile, reverse-engineer, or create derivative works from them without permission. Any third-party libraries they bundle remain under their own licenses (see below).
          </p>
        </section>

        <section>
          <h2>Trademarks</h2>
          <p>
            "Luci Studio", the Luci Studio logo, and product names such as "Faldrop" are marks of Luci Studio. Please do not use them in a way that suggests affiliation or endorsement without permission.
          </p>
        </section>

        <section>
          <h2>Third-Party Open-Source Licenses</h2>
          <p>
            This site, its games, and its tools rely on open-source software and web fonts &mdash; for example PixiJS, GSAP, and Prism.js &mdash; each distributed under its own license by its respective authors. Those licenses govern that software, not this page, and all rights in those works remain with their owners.
          </p>
        </section>

        <section>
          <h2>Requesting Permission</h2>
          <p>
            Want to reuse something beyond what is allowed above? Reach out and describe what you have in mind. Permission is often granted for non-commercial, educational, and community use.
          </p>
        </section>

        <section>
          <h2>Changes</h2>
          <p>
            This license may be updated as the site and its projects change. The date above indicates the latest revision.
          </p>
        </section>

        <section>
          <h2>Contact</h2>
          <p>
            For licensing questions or permission requests, contact <a href="mailto:kidoluci.work@gmail.com">kidoluci.work@gmail.com</a>.
          </p>
        </section>
      </div>
    </article>

    <SiteFooter locale={locale} />
  </main>
</Layout>

<style>
  /* Legal pages — homepage "blueprint" drafting-sheet DNA (shared by
     terms / privacy / license). Line grid header band + §-header + Space Grotesk
     title + IBM Plex Mono labels; the legal copy stays a readable document. */
  .bp-legal {
    --bp-bg: #0a0e14;
    --bp-ink: var(--text-primary);
    --bp-acc: var(--accent);
    --bp-line: rgba(255, 255, 255, 0.05);
    --bp-line2: rgba(255, 255, 255, 0.08);
    --bp-hair: rgba(255, 255, 255, 0.14);
    --bp-fig: rgba(255, 255, 255, 0.05);
    --bp-muted: color-mix(in srgb, var(--text-primary) 58%, transparent);
    --bp-faint: color-mix(in srgb, var(--text-primary) 42%, transparent);

    position: relative;
    min-height: 100vh;
    background: var(--bp-bg);
    color: var(--bp-ink);
    padding-top: clamp(120px, 15vh, 168px);
    padding-bottom: clamp(80px, 14vw, 160px);
    overflow-x: clip;
    font-family: "Space Grotesk", system-ui, sans-serif;
  }
  :global(body.light-mode) .bp-legal {
    --bp-bg: #f4f2ec;
    --bp-line: rgba(22, 32, 43, 0.05);
    --bp-line2: rgba(22, 32, 43, 0.08);
    --bp-hair: rgba(22, 32, 43, 0.16);
    --bp-fig: #e8e6df;
  }
  .bp-legal .bp-grid {
    position: absolute; top: 0; left: 0; right: 0; height: 560px; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(var(--bp-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line) 1px, transparent 1px),
      linear-gradient(var(--bp-line2) 1px, transparent 1px),
      linear-gradient(90deg, var(--bp-line2) 1px, transparent 1px);
    background-size: 36px 36px, 36px 36px, 180px 180px, 180px 180px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%);
            mask-image: linear-gradient(to bottom, #000 0%, #000 40%, transparent 100%);
  }
  .bp-legal-inner { position: relative; z-index: 1; max-width: 48rem; margin: 0 auto; padding-left: clamp(20px, 5vw, 40px); padding-right: clamp(20px, 5vw, 40px); }
  .bp-mono { font-family: "IBM Plex Mono", ui-monospace, monospace; }
  .bp-display { font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700; letter-spacing: -0.02em; color: var(--bp-ink); }
  .bp-acc-dot { color: var(--bp-acc); font-style: normal; }
  .bp-sec-head { display: flex; align-items: center; gap: 14px; }
  .bp-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--bp-acc); flex-shrink: 0; }
  .bp-sec-label { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bp-acc); white-space: nowrap; }
  .bp-rule { flex: 1; height: 1px; background: var(--bp-hair); }
  .bp-sec-count { font-size: 11px; letter-spacing: 0.16em; color: var(--bp-faint); white-space: nowrap; }

  .bp-legal-title { font-size: clamp(2.8rem, 8vw, 5.5rem); line-height: 0.98; margin: clamp(16px, 2.5vw, 24px) 0 0; }
  .bp-legal-updated { font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bp-faint); margin: 1.2rem 0 0; }

  .legal-copy { display: grid; gap: 0; margin-top: clamp(40px, 6vw, 64px); }
  .legal-copy section { padding: clamp(24px, 3.5vw, 34px) 0; border-top: 1px solid var(--bp-hair); }
  .legal-copy section:first-child { border-top: none; padding-top: 0; }
  .legal-copy h2 { font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700; font-size: 1.2rem; letter-spacing: -0.01em; text-transform: none; color: var(--bp-ink); margin: 0 0 0.9rem; }
  .legal-copy p { color: var(--bp-muted); font-size: 0.98rem; line-height: 1.8; margin: 0.7rem 0 0; }
  .legal-copy p:first-of-type { margin-top: 0; }
  .legal-copy a { color: var(--bp-acc); font-weight: 600; text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--bp-acc) 40%, transparent); }
  .legal-copy a:hover { border-bottom-color: var(--bp-acc); }
  .legal-copy code { font-family: "IBM Plex Mono", ui-monospace, monospace; color: var(--bp-ink); font-size: 0.88em; padding: 0.1rem 0.35rem; border-radius: 5px; background: var(--bp-fig); border: 1px solid var(--bp-hair); }
</style>
