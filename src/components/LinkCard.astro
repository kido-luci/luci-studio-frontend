---
// Link-unfurl card for /lab "Public Source" projects (git repos).
// Derives the thumbnail from the GitHub social-preview OG image via the repo
// URL — no fetch, always current. Non-GitHub links fall back to a gradient.
interface Props {
  title: string;
  desc: string;
  links?: { label: string; url: string }[];
  tech?: string[];
  index?: number;
}

const { title, desc, links = [], tech = [], index = 0 } = Astro.props;

// Primary link: prefer a GitHub repo link, else the first link.
const primary = links.find((l) => /github\.com/i.test(l.url)) ?? links[0];
const url = primary?.url ?? '';

let host = '';
let ogImage = '';
try {
  if (url) {
    const u = new URL(url);
    host = u.hostname.replace(/^www\./, '');
    if (/(^|\.)github\.com$/i.test(u.hostname)) {
      const parts = u.pathname.split('/').filter(Boolean);
      if (parts.length >= 2) {
        const owner = parts[0];
        const repo = parts[1].replace(/\.git$/, '');
        // The first path segment is a cache key GitHub ignores when rendering.
        ogImage = `https://opengraph.githubassets.com/lab/${owner}/${repo}`;
      }
    }
  }
} catch (_) {
  // malformed url → gradient fallback
}

const favicon = host ? `https://www.google.com/s2/favicons?domain=${host}&sz=64` : '';
const initials = (host || title).slice(0, 2).toUpperCase();
---

<a
  href={url || '#'}
  target="_blank"
  rel="noopener noreferrer"
  style={`--i:${index}`}
  class="link-card group relative flex flex-col rounded-2xl border border-white/5 bg-white/[0.02] overflow-hidden transition-colors duration-500 hover:border-violet-500/30 hover:bg-white/[0.04]"
>
  <!-- Thumbnail: GitHub OG image (2:1) or gradient fallback -->
  <div class="relative aspect-[2/1] overflow-hidden border-b border-white/5">
    {ogImage ? (
      <img
        src={ogImage}
        alt={title}
        loading="lazy"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
      />
    ) : (
      <div class="absolute inset-0 bg-gradient-to-br from-violet-600/25 to-blue-600/10 flex items-center justify-center">
        <span class="text-5xl font-black text-white/15 tracking-tighter">{initials}</span>
      </div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
  </div>

  <!-- Body -->
  <div class="flex flex-col flex-1 p-5 sm:p-6">
    {host && (
      <div class="flex items-center gap-2 mb-3">
        {favicon && <img src={favicon} alt="" width="16" height="16" loading="lazy" class="w-4 h-4 rounded-sm" />}
        <span class="text-[11px] font-bold uppercase tracking-widest text-gray-500 group-hover:text-violet-400 transition-colors">{host}</span>
        <svg class="w-3.5 h-3.5 text-gray-600 group-hover:text-violet-400 transition-colors ml-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 7l-10 10M17 7H7M17 7v10"/></svg>
      </div>
    )}

    <h3 class="text-2xl font-black tracking-tight leading-tight mb-2">{title}<span class="text-violet-500">.</span></h3>

    {desc && (
      <p class="text-gray-400 text-sm leading-relaxed mb-4 line-clamp-2 group-hover:text-gray-300 transition-colors">{desc}</p>
    )}

    {tech.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-2 pt-1">
        {tech.map((t) => (
          <span class="text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 rounded-full border border-white/10 bg-white/[0.03] text-gray-400">{t}</span>
        ))}
      </div>
    )}
  </div>
</a>

<style>
  /* Pure-CSS entrance on load — animates ONLY transform, never opacity, so the
     card is always visible (never stuck hidden if animations are paused, e.g. a
     backgrounded tab). No JS/IntersectionObserver dependency. Small per-card
     stagger via --i. Respects reduced-motion. */
  @keyframes linkCardIn {
    from { transform: translateY(18px); }
    to   { transform: translateY(0); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .link-card {
      animation: linkCardIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(var(--i, 0) * 0.08s);
    }
  }
</style>
