---
// Floating button — navigates to /chat page.
---

<a
	href="/chat"
	id="luci-chat-fab"
	class="luci-chat-fab"
	aria-label="Chat with Kido AI"
	title="Chat with Kido AI"
>
	<!-- AI Sparkle icon -->
	<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="currentColor">
		<!-- Large central star -->
		<path d="M12 2 L13.09 8.26 L19 9 L13.09 9.74 L12 16 L10.91 9.74 L5 9 L10.91 8.26 Z"/>
		<!-- Small top-right star -->
		<path d="M19 2 L19.55 4.45 L22 5 L19.55 5.55 L19 8 L18.45 5.55 L16 5 L18.45 4.45 Z"/>
		<!-- Small bottom-left star -->
		<path d="M5 16 L5.55 18.45 L8 19 L5.55 19.55 L5 22 L4.45 19.55 L2 19 L4.45 18.45 Z"/>
	</svg>
</a>

<style>
	@keyframes fab-pulse {
		0%, 100% { box-shadow: 0 12px 32px rgba(99,102,241,0.35), 0 2px 6px rgba(0,0,0,0.25), 0 0 0 0 rgba(139,92,246,0.4); }
		50%       { box-shadow: 0 12px 32px rgba(99,102,241,0.5),  0 2px 6px rgba(0,0,0,0.25), 0 0 0 8px rgba(139,92,246,0); }
	}
	@keyframes fab-spin {
		from { transform: rotate(0deg); }
		to   { transform: rotate(360deg); }
	}
	.luci-chat-fab {
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		z-index: 9990;
		width: 56px;
		height: 56px;
		border-radius: 9999px;
		border: 1px solid rgba(139, 92, 246, 0.45);
		background: linear-gradient(135deg, rgba(139, 92, 246, 0.95), rgba(99, 102, 241, 0.95));
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		animation: fab-pulse 2.8s ease-in-out infinite;
		transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}
	.luci-chat-fab svg {
		animation: fab-spin 8s linear infinite;
		animation-play-state: paused;
		transition: transform 220ms ease;
	}
	.luci-chat-fab:hover {
		transform: translateY(-3px) scale(1.08);
	}
	.luci-chat-fab:hover svg {
		animation-play-state: running;
	}
	.luci-chat-fab:active { transform: scale(0.95); }

	@media (max-width: 480px) {
		.luci-chat-fab { right: 0.85rem; bottom: 0.85rem; }
	}
</style>
