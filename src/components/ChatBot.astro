---
// Floating button — navigates to /chat page.
---

<a
	href="/chat"
	id="luci-chat-fab"
	class="luci-chat-fab"
	aria-label="Chat with Kido"
	title="Chat with Kido"
>
	<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
		<path fill="currentColor" d="M12 3C6.48 3 2 6.94 2 11.8c0 2.3 1.04 4.4 2.74 5.98-.1.78-.43 2-1.27 3.32-.12.18-.13.41-.04.6.1.2.3.32.51.32 1.96 0 3.58-.66 4.77-1.4 1.06.25 2.18.38 3.29.38 5.52 0 10-3.94 10-8.8S17.52 3 12 3Z"/>
	</svg>
</a>

<style>
	.luci-chat-fab {
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		z-index: 9990;
		width: 56px;
		height: 56px;
		border-radius: 9999px;
		border: 1px solid rgba(139, 92, 246, 0.35);
		background: linear-gradient(135deg, rgba(139, 92, 246, 0.95), rgba(99, 102, 241, 0.95));
		color: #fff;
		display: flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 12px 32px rgba(99, 102, 241, 0.35), 0 2px 6px rgba(0,0,0,0.25);
		text-decoration: none;
		transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 200ms ease;
	}
	.luci-chat-fab:hover {
		transform: translateY(-3px) scale(1.06);
		box-shadow: 0 16px 40px rgba(99, 102, 241, 0.45), 0 2px 8px rgba(0,0,0,0.3);
	}
	.luci-chat-fab:active { transform: scale(0.95); }

	@media (max-width: 480px) {
		.luci-chat-fab { right: 0.85rem; bottom: 0.85rem; }
	}
</style>
