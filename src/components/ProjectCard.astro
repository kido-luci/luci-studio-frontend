---
interface Props {
  title: string;
  year: string;
  desc: string;
  tags: string[];
  img: string;
  index: number;
}

const { title, year, desc, tags, img, index } = Astro.props;
---

<div data-project={title} data-reveal="scale" data-delay={String((index % 2) + 1)} class="tilt-card group relative aspect-[4/3] rounded-[40px] overflow-hidden border border-white/10 hover:border-violet-500/40 transition-all duration-700 cursor-pointer bg-white/[0.03]">
  <div class="absolute inset-0 bg-gradient-to-br from-pink-500/20 via-violet-500/10 to-transparent opacity-100"></div>
  <img src={img} alt={title} class="absolute inset-0 w-full h-full object-cover transition-all duration-700 group-hover:scale-110 brightness-100" />
  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
  <div class="absolute inset-0 p-10 flex flex-col justify-between">
    <div class="flex items-center justify-between">
      <span class="text-xs font-bold uppercase tracking-widest text-gray-400 bg-black/40 px-3 py-1 rounded-full border border-white/10">{year}</span>
      <span class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white opacity-40 group-hover:opacity-100 transition-all duration-500">↗</span>
    </div>
    <div class="translate-y-0 transition-transform duration-500">
      <h3 class="text-4xl font-black tracking-tight mb-3 text-shimmer" style="filter: drop-shadow(0 8px 16px rgba(0,0,0,0.9));">{title}</h3>
      <p class="text-gray-300 text-sm mb-5 opacity-90 transition-opacity duration-500">{desc}</p>
      <div class="flex gap-2">
        {tags.map(t => (
          <span class="text-xs font-bold bg-white/10 px-3 py-1 rounded-full border border-white/10">{t}</span>
        ))}
      </div>
    </div>
  </div>
</div>
