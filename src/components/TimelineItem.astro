---
interface Props {
  id: string;
  year: string;
  role: string;
  company: string;
  location: string;
  desc: string;
  details: string[];
  tech: string[];
  links: { label: string; url: string }[];
  index: number;
  img?: string;
  logo?: string;
}

const { id, year, role, company, location, desc, details, tech, links, index, img, logo } = Astro.props;
const monogram = (company || role || "?").trim().charAt(0).toUpperCase();
---

<!--
  Layout:  [rail: dot + line] | [period label + card]
  The rail line extends -16px below to bridge the .space-y-4 gap between items.
  All content is always visible (no accordion); the scroll-reveal is driven by
  `.tl-visible` on this wrapper, added by the IntersectionObserver in PortfolioPage.
-->
<div id={id} data-timeline-item={String(index)} class="tl-item">

  {/* ── Rail ── */}
  <div class="tl-rail">
    <div class="tl-dot"></div>
    <div class="tl-line"></div>
  </div>

  {/* ── Period label + card ── */}
  <div class="tl-body">
    <div class="tl-period">{year}</div>

    <div class="tl-card-reveal">
      <div class="tl-card">

        {/* Header */}
        <div class="tl-head">
          <div class="tl-icon">
            {logo
              ? <img src={logo} alt={`${company} logo`} loading="lazy" />
              : <span>{monogram}</span>}
          </div>
          <div class="tl-headtext">
            <h3 class="tl-role">{role}</h3>
            <div class="tl-company">— {company}</div>
            <div class="tl-loc">{location}</div>
          </div>
        </div>

        <p class="tl-summary">{desc}</p>

        <div class="tl-divider"></div>

        {/* Two-column: achievements | media + stack + links */}
        <div class="tl-grid">
          <div class="tl-col-ach">
            <div class="tl-label">Key achievements</div>
            <ul class="tl-achlist">
              {details.map(item => (
                <li class="tl-ach">
                  <span class="tl-bullet"></span>
                  <span class="tl-ach-text">{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="tl-col-side">
            {img
              ? <div class="tl-media"><img src={img} alt={`${company} preview`} loading="lazy" /></div>
              : <div class="tl-media tl-media--empty"><span>▦</span></div>}

            <div class="tl-label">Stack</div>
            <div class="tl-chips">
              {tech.map(t => (<span class="tl-chip">{t}</span>))}
            </div>

            {links.length > 0 && (
              <div class="tl-links-block">
                <div class="tl-label">Links</div>
                <div class="tl-links">
                  {links.map(l => (
                    <a href={l.url} target="_blank" rel="noopener" class="tl-link">{l.label} ↗</a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<style>
  /* Blueprint timeline — drafting-sheet DNA. Accent follows the color scheme.
     Structure + reveal classes (.tl-visible + .tl-dot/line/period/card-reveal)
     are unchanged, so PortfolioPage's IntersectionObserver still drives it.
     Self-contained --bp-* tokens (light/dark) so the card reads on any sheet. */
  .tl-item {
    --bp-acc: var(--accent);
    --bp-ink: var(--text-primary);
    --bp-muted: color-mix(in srgb, var(--text-primary) 64%, transparent);
    --bp-faint: color-mix(in srgb, var(--text-primary) 42%, transparent);
    --bp-hair: rgba(255, 255, 255, 0.14);
    --bp-line2: rgba(255, 255, 255, 0.08);
    --bp-bg: #0a0e14;
    --bp-fig: rgba(255, 255, 255, 0.05);
    --bp-panel: color-mix(in srgb, #ffffff 5%, var(--bp-bg));
    --bp-mono: "IBM Plex Mono", ui-monospace, monospace;
    display: flex; gap: 20px;
  }
  :global(body.light-mode) .tl-item {
    --bp-hair: rgba(22, 32, 43, 0.16);
    --bp-line2: rgba(22, 32, 43, 0.08);
    --bp-bg: #f4f2ec;
    --bp-fig: #e8e6df;
    --bp-panel: #ffffff;
    --bp-muted: color-mix(in srgb, var(--text-primary) 62%, transparent);
    --bp-faint: color-mix(in srgb, var(--text-primary) 45%, transparent);
  }

  .tl-rail { flex: none; width: 16px; display: flex; flex-direction: column; align-items: center; padding-top: 3px; }
  .tl-body { flex: 1; min-width: 0; padding-bottom: 6px; }
  .tl-period { font-family: var(--bp-mono); font-size: 12px; letter-spacing: 0.16em; color: var(--bp-muted); margin-bottom: 13px; }

  /* Rail: dot + connecting line */
  .tl-dot { width: 13px; height: 13px; border-radius: 50%; background: var(--bp-acc); box-shadow: 0 0 0 4px color-mix(in srgb, var(--bp-acc) 20%, transparent); }
  .tl-line { flex: 1; width: 1px; margin-top: 8px; margin-bottom: -16px; background: linear-gradient(to bottom, color-mix(in srgb, var(--bp-acc) 40%, transparent), var(--bp-hair) 42%, transparent); }

  /* Card */
  .tl-card { background: var(--bp-panel); border: 1px solid var(--bp-hair); border-radius: 14px; padding: 28px 30px; box-shadow: none; transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
  .tl-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--bp-acc) 40%, transparent); box-shadow: 0 18px 44px -26px color-mix(in srgb, var(--bp-acc) 40%, transparent); }

  /* Header */
  .tl-head { display: flex; align-items: flex-start; gap: 16px; }
  .tl-icon { flex: none; width: 52px; height: 52px; border-radius: 12px; overflow: hidden; background: var(--bp-fig); border: 1px solid var(--bp-hair); display: flex; align-items: center; justify-content: center; font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700; font-size: 20px; color: var(--bp-ink); }
  .tl-icon img { width: 100%; height: 100%; object-fit: cover; }
  .tl-headtext { flex: 1; min-width: 0; }
  .tl-role { font-family: "Space Grotesk", system-ui, sans-serif; font-weight: 700; font-size: 1.6rem; line-height: 1.12; letter-spacing: -0.02em; color: var(--bp-ink); margin: 0; }
  .tl-company { font-weight: 600; font-size: 1rem; color: var(--bp-acc); margin-top: 5px; }
  .tl-loc { font-family: var(--bp-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--bp-muted); margin-top: 9px; }

  /* Summary + divider */
  .tl-summary { font-size: 1rem; line-height: 1.55; color: var(--bp-muted); margin: 20px 0 0; max-width: 62ch; }
  .tl-divider { height: 1px; background: var(--bp-hair); margin: 24px 0; }

  /* Two-column grid */
  .tl-grid { display: grid; grid-template-columns: 1.32fr 1fr; gap: 40px; }
  .tl-col-ach, .tl-col-side { min-width: 0; }
  .tl-label { font-family: var(--bp-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--bp-muted); }
  .tl-col-ach .tl-label { margin-bottom: 14px; }
  .tl-col-side .tl-label { margin-bottom: 11px; }

  /* Achievements */
  .tl-achlist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .tl-ach { display: flex; gap: 12px; }
  .tl-bullet { flex: none; width: 6px; height: 6px; background: var(--bp-acc); transform: rotate(45deg); margin-top: 7px; }
  .tl-ach-text { font-size: 0.9rem; line-height: 1.5; color: var(--bp-muted); }

  /* Media */
  .tl-media { height: 188px; border-radius: 10px; overflow: hidden; border: 1px solid var(--bp-hair); margin-bottom: 20px; }
  .tl-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tl-media--empty { display: flex; align-items: center; justify-content: center; background-color: var(--bp-fig); color: var(--bp-faint); font-size: 20px; background-image: repeating-linear-gradient(135deg, var(--bp-line2) 0 10px, transparent 10px 20px); }

  /* Stack chips */
  .tl-chips { display: flex; flex-wrap: wrap; gap: 7px; }
  .tl-chip { font-family: var(--bp-mono); font-size: 11px; letter-spacing: 0.02em; color: var(--bp-muted); background: transparent; border: 1px solid var(--bp-hair); border-radius: 999px; padding: 6px 12px; }

  /* Links */
  .tl-links-block { margin-top: 20px; }
  .tl-links { display: flex; flex-wrap: wrap; gap: 7px; }
  .tl-link { font-family: var(--bp-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--bp-acc); background: transparent; border: 1px solid color-mix(in srgb, var(--bp-acc) 40%, transparent); border-radius: 999px; padding: 7px 14px; text-decoration: none; transition: background 0.14s ease, color 0.14s ease; }
  .tl-link:hover { background: var(--bp-acc); color: #fff; }

  /* Scroll reveal (triggered by .tl-visible on the wrapper) */
  @keyframes tlDotPop    { from { opacity: 0; transform: scale(0); }                         to { opacity: 1; transform: scale(1); } }
  @keyframes tlLineFade  { from { opacity: 0; }                                              to { opacity: 1; } }
  @keyframes tlLineDraw  { from { opacity: 1; transform: scaleY(0); }                        to { opacity: 1; transform: scaleY(1); } }
  @keyframes tlPeriodIn  { from { opacity: 0; transform: translateX(14px); }                to { opacity: 1; transform: translateX(0); } }
  @keyframes tlCardIn    { from { opacity: 0; transform: translateX(36px) translateY(10px); } to { opacity: 1; transform: translateX(0) translateY(0); } }

  .tl-dot         { opacity: 0; transform: scale(0); }
  .tl-line        { opacity: 0; transform: scaleY(0); transform-origin: top center; }
  .tl-period      { opacity: 0; transform: translateX(14px); }
  .tl-card-reveal { opacity: 0; transform: translateX(36px) translateY(10px); }

  .tl-visible .tl-dot         { animation: tlDotPop   0.45s cubic-bezier(0.34, 1.56, 0.64, 1) 0s    both; }
  .tl-visible .tl-line        { animation: tlLineDraw 0.7s  cubic-bezier(0.16, 1, 0.3, 1)     0.22s both; }
  /* Reduced motion: keep the original opacity fade (no new movement). */
  @media (prefers-reduced-motion: reduce) {
    .tl-line { transform: none; }
    .tl-visible .tl-line { animation: tlLineFade 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.22s both; }
  }
  .tl-visible .tl-period      { animation: tlPeriodIn 0.4s  cubic-bezier(0.16, 1, 0.3, 1)     0.12s both; }
  .tl-visible .tl-card-reveal { animation: tlCardIn   0.65s cubic-bezier(0.16, 1, 0.3, 1)     0.18s both; }

  /* Mobile */
  @media (max-width: 640px) {
    .tl-item { gap: 14px; }
    .tl-card { padding: 24px 22px; border-radius: 12px; }
    .tl-role { font-size: 1.35rem; }
    .tl-grid { grid-template-columns: 1fr; gap: 28px; }
  }
</style>
