---
interface Props {
  id: string;
  y: string;
  role: string;
  co: string;
  loc: string;
  desc: string;
  details: string[];
  tech: string[];
  links: { label: string; url: string }[];
  index: number;
  img?: string;
  logo?: string;
}

const { id, y, role, co, loc, desc, details, tech, links, index, img, logo } = Astro.props;
---

<!--
  Layout:  [dot + line] | [year label + card]
  The line extends -1rem below each wrapper to bridge the space-y-4 gap.
-->
<div id={id} data-reveal data-delay={String(index + 1)} class="timeline-item-wrapper flex flex-col md:flex-row gap-5">

  {/* ── Rail: horizontal (dot + line) on mobile, vertical on desktop ── */}
  <div class="flex items-center md:flex-none md:flex-col md:pt-[3px]">
    <div class="w-3 h-3 rounded-full bg-gray-300"></div>
    <div class="flex-1 h-px md:w-px md:h-auto md:mt-2 bg-gradient-to-r md:bg-gradient-to-b from-gray-400/70 via-gray-500/30 to-transparent md:-mb-4"></div>
  </div>

  {/* ── Right side: year label + card ── */}
  <div class="flex-1 min-w-0 pb-4">

    {/* Year label row */}
    <div class="flex items-center gap-3 mb-3 h-[18px]">
      <span class="text-xs font-black text-gray-400 uppercase tracking-widest leading-none">{y}</span>
    </div>

    {/* ── Card ── */}
    <div class="timeline-item group cursor-pointer p-5 sm:p-8 rounded-2xl border border-white/10 hover:border-pink-500/30 bg-[#151515]/60 group-[.active]:bg-[#1a1a1a]/70 backdrop-blur-md transition-all duration-500 overflow-hidden shadow-2xl">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">

        {/* Content */}
        <div class="md:col-span-9">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-2 gap-4">
            <div class="flex items-center gap-4">
              {logo && (
                <div class="w-12 h-12 rounded-xl overflow-hidden border border-white/10 shrink-0 shadow-lg group-hover:border-pink-500/30 transition-colors">
                  <img src={logo} alt={`${co} Logo`} class="w-full h-full object-cover" />
                </div>
              )}
              <h3 class="text-2xl font-black text-white drop-shadow-xl flex flex-col sm:flex-row sm:items-baseline sm:gap-2">
                <span style="color: var(--text-primary)">{role}</span>
                <span class="text-gray-400 font-medium text-lg whitespace-nowrap">— {co}</span>
              </h3>
            </div>
          </div>
          <p class="text-xs text-pink-500/70 uppercase tracking-widest mb-4">{loc}</p>
          <p class="text-gray-400 text-sm leading-relaxed mb-0 group-[.active]:mb-6 transition-all duration-500">{desc}</p>

          {/* Preview (collapsed) */}
          <div class="group-[.active]:opacity-0 group-[.active]:h-0 mt-4 transition-all duration-500 overflow-hidden">
            <div class="grid grid-cols-2 gap-4 opacity-50">
              <div>
                <h4 class="text-[9px] font-black text-gray-400 uppercase tracking-[0.2em] mb-2">Key Achievements</h4>
                <ul class="space-y-1">
                  {details.slice(0, 3).map(item => (
                    <li class="flex items-start gap-1 text-[10px] leading-tight text-gray-300">
                      <span class="text-pink-500/50">▹</span>
                      <span class="truncate">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="text-[9px] font-black text-gray-400 uppercase tracking-[0.2em] mb-2">Stack</h4>
                <div class="flex flex-wrap gap-1">
                  {tech.slice(0, 3).map(t => (
                    <span class="px-2 py-0.5 bg-white/5 border border-white/10 rounded-full text-[8px] font-black text-gray-300 uppercase tracking-wider">{t}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>

          {/* Expand indicator arrow */}
          <div class="group-[.active]:hidden flex justify-center mt-3 opacity-50 group-hover:opacity-100 transition-all duration-500">
            <svg class="w-4 h-4 text-pink-500/80 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"/>
            </svg>
          </div>

          {/* Expanded details */}
          <div class="timeline-details h-0 opacity-0 group-[.active]:h-auto group-[.active]:opacity-100 transition-all duration-500">
            <div class="pt-6 border-t border-white/5">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <div>
                  <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-4">Key Achievements</h4>
                  <ul class="space-y-3">
                    {details.map(item => (
                      <li class="flex items-start gap-3 text-sm text-gray-300 leading-snug">
                        <span class="text-pink-500 mt-1">▹</span>
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-4">Stack</h4>
                  <div class="flex flex-wrap gap-2 mb-8">
                    {tech.map(t => (
                      <span class="px-3 py-1 bg-white/5 border border-white/10 rounded-full text-[10px] font-black text-gray-300 uppercase tracking-wider">{t}</span>
                    ))}
                  </div>
                  <h4 class="text-xs font-black text-gray-400 uppercase tracking-[0.2em] mb-4">Links</h4>
                  <div class="flex flex-wrap gap-3">
                    {links.map(l => (
                      <a href={l.url} target="_blank" class="magnetic px-4 py-2 bg-pink-500/10 border border-pink-500/20 rounded-full text-[10px] font-black text-pink-500 uppercase tracking-widest hover:bg-pink-500 hover:text-white transition-all duration-300">
                        {l.label} ↗
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="md:col-span-3 flex flex-col items-center md:items-end justify-center order-first md:order-last mb-8 md:mb-0">
          {img && (
            <div class="relative group/preview rounded-2xl overflow-hidden border border-white/5 shadow-2xl w-full md:max-w-[240px] bg-white/5 transition-all duration-700 group-hover:border-pink-500/30 group-hover:shadow-pink-500/10">
              <img src={img} alt={`${co} Preview`} class="w-full h-auto block transition-all duration-700 group-hover/preview:scale-110" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover/preview:opacity-100 transition-opacity duration-500"></div>
            </div>
          )}
        </div>

      </div>
    </div>

  </div>
</div>
