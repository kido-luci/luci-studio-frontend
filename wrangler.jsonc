{
  "name": "luci-dev",
  "compatibility_date": "2024-04-20",
  "assets": {
    // Astro 7 / @astrojs/cloudflare 14 emit static output under dist/client
    // (dist/server is an empty build leftover).
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    { "binding": "SESSION", "id": "0fb6562772d64e1fa4383fc794fcdc4f" }
  ]
}
