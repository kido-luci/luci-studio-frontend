# Base URL of the blog backend API.
# Used at build time to fetch posts for static generation.
PUBLIC_API_URL=http://localhost:3000

# Optional: Google Search Console verification token.
# When set, a <meta name="google-site-verification"> tag is emitted.
# PUBLIC_GSC_VERIFICATION=

# Optional: Sentry error monitoring (errors-only). With no DSN the SDK is disabled.
# DSN is the project's "Client Keys (DSN)" from sentry.io → Project → Settings.
# PUBLIC_SENTRY_DSN=
# PUBLIC_SENTRY_ENVIRONMENT=production
# Build-time source-map upload (non-public) — makes prod stack traces readable.
# Auth token: sentry.io → Settings → Auth Tokens (scope: project:releases).
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
